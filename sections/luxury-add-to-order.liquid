{%- comment -%}
  -----------------------------------------------------------------------------
  SECTION: LUXURY ADD THESE TO YOUR ORDER
  - 100% Real Shopify Data
  - Interactive carousel of complementary products
  - Customizable in Shopify Theme Customizer (heading, discount, product picker)
  - Pre-selected with Mahjiva add-on essentials
  - Only visible on Mahjong Set products (configurable)
  -----------------------------------------------------------------------------
{%- endcomment -%}

<div class="lp-container pdp-container">
  {%- render 'luxury-add-to-order',
    section_id: section.id,
    heading: section.settings.heading,
    subheading: section.settings.subheading,
    discount_percent: section.settings.discount_percent,
    products: section.settings.products,
    button_text: section.settings.button_text,
    button_color: section.settings.button_color,
    card_bg: section.settings.card_bg,
    only_mahjong_sets: section.settings.only_mahjong_sets,
    product: product
  -%}
</div>

{% schema %}
{
  "name": "Add These to Your Order",
  "tag": "section",
  "class": "section-luxury-add-to-order",
  "settings": [
    {
      "type": "checkbox",
      "id": "only_mahjong_sets",
      "label": "Only show for Mahjong Set products",
      "default": true,
      "info": "When enabled, this section will automatically hide on mats, racks, tile bags, and dice."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Add These to Your Order"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose any. Each one is 10% off."
    },
    {
      "type": "range",
      "id": "discount_percent",
      "label": "Discount Percentage",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 10,
      "unit": "%"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Select Products to Feature",
      "limit": 10
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Add & Save"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#163327"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Container Background Color",
      "default": "#FAF8F5"
    }
  ],
  "presets": [
    {
      "name": "Add These to Your Order"
    }
  ]
}
{% endschema %}
