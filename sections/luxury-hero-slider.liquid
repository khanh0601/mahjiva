{%- comment -%}
  Luxury Hero Slider - Pure Real Shopify Data, Zero Mocks
  Full Screen Viewport Dynamic Slider with 100% Real Customizer Controls
{%- endcomment -%}

{%- style -%}
  #LuxuryHero-{{ section.id }},
  #LuxuryHero-{{ section.id }} * {
    box-sizing: border-box !important;
  }

  .luxury-hero-slider {
    position: relative !important;
    width: 100% !important;
    touch-action: pan-y !important;
    {%- case section.settings.desktop_height -%}
      {%- when 'fit_screen' -%}
        height: calc(100vh - var(--header-height, 70px)) !important;
        min-height: 520px !important;
      {%- when 'adapt_image' -%}
        height: auto !important;
        aspect-ratio: 2060 / 763 !important;
        max-height: calc(100vh - var(--header-height, 70px)) !important;
      {%- when '80vh' -%}
        height: 80vh !important;
        min-height: 520px !important;
      {%- when '70vh' -%}
        height: 70vh !important;
        min-height: 480px !important;
      {%- when '90vh' -%}
        height: 90vh !important;
        min-height: 560px !important;
      {%- when '800px' -%}
        height: 800px !important;
      {%- when '650px' -%}
        height: 650px !important;
      {%- when '100vh' -%}
        height: 100vh !important;
        min-height: 580px !important;
      {%- else -%}
        height: calc(100vh - var(--header-height, 70px)) !important;
        min-height: 520px !important;
    {%- endcase -%}
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
    background-color: #0E1210 !important;
  }

  @media (max-width: 739px) {
    .luxury-hero-slider {
      {%- case section.settings.mobile_height -%}
        {%- when 'fit_screen' -%}
          height: calc(100dvh - var(--header-height, 60px)) !important;
          min-height: 480px !important;
        {%- when 'adapt_image' -%}
          height: auto !important;
          aspect-ratio: 800 / 1200 !important;
          max-height: calc(100dvh - var(--header-height, 60px)) !important;
        {%- when '85vh' -%}
          height: 85dvh !important;
        {%- when '75vh' -%}
          height: 75dvh !important;
        {%- when '550px' -%}
          height: 550px !important;
        {%- when '100vh' -%}
          height: 100dvh !important;
          min-height: 480px !important;
        {%- else -%}
          height: calc(100dvh - var(--header-height, 60px)) !important;
          min-height: 480px !important;
      {%- endcase -%}
    }
  }

  /* Slide Track */
  .lhs-track {
    position: relative !important;
    width: 100% !important;
    height: 100% !important;
    touch-action: pan-y !important;
  }

  /* Individual Slide */
  .lhs-slide {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    opacity: 0 !important;
    visibility: hidden !important;
    transition: opacity 0.9s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.9s ease !important;
    z-index: 1 !important;
  }

  .lhs-slide.is-active {
    opacity: 1 !important;
    visibility: visible !important;
    z-index: 2 !important;
  }

  /* Responsive Background Image */
  .lhs-bg-wrapper {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    overflow: hidden !important;
  }

  .lhs-bg-picture,
  .lhs-bg-image {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
    transform: scale(1.03) !important;
    transition: transform 7s ease-out !important;
  }

  .lhs-slide.is-active .lhs-bg-image,
  .lhs-slide.is-active .lhs-bg-picture img {
    transform: scale(1) !important;
  }

  /* Multi-Layer Cinematic Scrim: Gradient sâu xuống đáy banner (100% trong suốt phía trên, KHÔNG blur để giữ ảnh nét căng) */
  .lhs-overlay {
    display: block !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: 2 !important;
    pointer-events: none !important;
    opacity: 1 !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    background: 
      /* 1. Gradient dọc: mờ dần xuống đen sâu ở đáy banner */
      linear-gradient(
        180deg,
        rgba(9, 23, 16, 0) 0%,
        rgba(9, 23, 16, 0.04) 20%,
        rgba(9, 23, 16, 0.25) 42%,
        rgba(7, 18, 12, 0.65) 62%,
        rgba(5, 14, 9, 0.88) 78%,
        rgba(4, 12, 8, 0.98) 92%,
        #020704 100%
      ),
      /* 2. Đệm sáng tối góc dưới bên chữ (Bottom Reading Scrim Anchor), giữ nửa trên banner 100% trong suốt */
      {% if section.settings.text_alignment == 'center' %}
        radial-gradient(
          ellipse 90% 65% at 50% 100%,
          rgba(4, 12, 8, 0.75) 0%,
          rgba(4, 12, 8, 0.35) 50%,
          rgba(4, 12, 8, 0) 85%
        )
      {% else %}
        radial-gradient(
          ellipse 85% 65% at 0% 100%,
          rgba(4, 12, 8, 0.80) 0%,
          rgba(4, 12, 8, 0.45) 45%,
          rgba(4, 12, 8, 0.12) 75%,
          rgba(4, 12, 8, 0) 100%
        )
      {% endif %} !important;
  }

  @media (max-width: 739px) {
    .lhs-overlay {
      display: block !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      background: 
        linear-gradient(
          180deg,
          rgba(9, 23, 16, 0) 0%,
          rgba(9, 23, 16, 0.06) 18%,
          rgba(9, 23, 16, 0.32) 36%,
          rgba(7, 18, 12, 0.72) 54%,
          rgba(5, 14, 9, 0.92) 72%,
          rgba(4, 12, 8, 0.98) 88%,
          #020704 100%
        ) !important;
    }
  }

  /* Slide Content Area */
  .lhs-content-container {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 clamp(24px, 4.5vw, 64px) !important;
    display: flex !important;
    align-items: flex-end !important;
    padding-bottom: {{ section.settings.content_padding_bottom | default: 50 }}px !important;
    z-index: 10 !important;
    pointer-events: none !important;
    {% if section.settings.text_alignment == 'center' %}
      justify-content: center !important;
      text-align: center !important;
    {% else %}
      justify-content: flex-start !important;
      text-align: left !important;
    {% endif %}
  }

  .lhs-content-box {
    max-width: 780px !important;
    pointer-events: auto !important;
    opacity: 0 !important;
    transform: translateY(20px) !important;
    transition: opacity 0.8s ease 0.15s, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s !important;
    display: flex !important;
    flex-direction: column !important;
    {% if section.settings.text_alignment == 'center' %}
      align-items: center !important;
      text-align: center !important;
      margin: 0 auto !important;
    {% else %}
      align-items: flex-start !important;
      text-align: left !important;
    {% endif %}
  }

  .lhs-slide.is-active .lhs-content-box {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }

  /* Slide đầu tiên hiển thị ngay lập tức, không bị giật CSS khi vừa load trang */
  .lhs-slide:first-child.is-active .lhs-content-box {
    opacity: 1 !important;
    transform: translateY(0) !important;
    transition: none !important;
  }

  .lhs-badge-chip {
    display: inline-flex !important;
    align-items: center !important;
    padding: 6px 16px !important;
    border-radius: 9999px !important;
    background: rgba(9, 23, 16, 0.90) !important;
    background-color: rgba(9, 23, 16, 0.90) !important;
    border: 1px solid rgba(226, 199, 142, 0.45) !important;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.45) !important;
    color: #E2C78E !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    font-size: 10.5px !important;
    font-weight: 700 !important;
    letter-spacing: 0.2em !important;
    text-transform: uppercase !important;
    margin-bottom: 18px !important;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8) !important;
  }

  {%- assign hero_title_font = "'Cormorant Garamond', Georgia, serif" -%}
  {%- case section.settings.title_font_family -%}
    {%- when 'cinzel' -%}
      {%- assign hero_title_font = "'Cinzel', Georgia, serif" -%}
    {%- when 'georgia' -%}
      {%- assign hero_title_font = "Georgia, serif" -%}
    {%- when 'sans_serif' -%}
      {%- assign hero_title_font = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" -%}
  {%- endcase -%}

  .lhs-title {
    font-family: {{ hero_title_font }} !important;
    font-size: {{ section.settings.title_size_desktop | default: 52 }}px !important;
    font-weight: {{ section.settings.title_weight | default: '400' }} !important;
    line-height: 1.15 !important;
    color: {{ section.settings.title_color | default: '#FAF8F5' }} !important;
    letter-spacing: -0.01em !important;
    margin: 0 0 16px 0 !important;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.85), 0 1px 4px rgba(0, 0, 0, 0.95) !important;
  }

  .lhs-title em {
    font-style: italic !important;
    color: {{ section.settings.accent_color | default: '#E2C78E' }} !important;
  }

  @media (max-width: 739px) {
    .lhs-title {
      font-size: {{ section.settings.title_size_mobile | default: 32 }}px !important;
    }
  }

  .lhs-subtitle {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    font-size: 15.5px !important;
    font-weight: 450 !important;
    line-height: 1.6 !important;
    color: {{ section.settings.subtitle_color | default: '#D6E2DB' }} !important;
    letter-spacing: 0.03em !important;
    margin: 0 0 26px 0 !important;
    max-width: 580px !important;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.85), 0 1px 3px rgba(0, 0, 0, 0.95) !important;
  }

  .lhs-subtitle p {
    margin: 0 0 8px 0 !important;
  }

  .lhs-cta-btn {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    padding: 13px 30px !important;
    border: 1.5px solid rgba(226, 199, 142, 0.75) !important;
    background: #0E1A14 !important;
    background-color: #0E1A14 !important;
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.55) !important;
    color: #FAF8F5 !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.2em !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    border-radius: 2px !important;
    transition: transform 0.22s ease, background-color 0.22s ease, border-color 0.22s ease, color 0.22s ease, box-shadow 0.22s ease !important;
  }

  .lhs-cta-btn:hover {
    background: #E2C78E !important;
    background-color: #E2C78E !important;
    color: #0E1A14 !important;
    border-color: #E2C78E !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.7) !important;
  }

  /* Slide Capsule Pagination */
  .lhs-capsule-counter {
    position: absolute !important;
    bottom: {{ section.settings.content_padding_bottom | default: 50 }}px !important;
    right: clamp(24px, 4.5vw, 64px) !important;
    z-index: 25 !important;
    background-color: #E8E6E1 !important;
    border-radius: 9999px !important;
    padding: 7px 16px !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 12px !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25) !important;
    border: 1px solid rgba(255, 255, 255, 0.4) !important;
  }

  .lhs-progress-bars {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
  }

  .lhs-progress-bar {
    width: 20px !important;
    height: 2.5px !important;
    border-radius: 2px !important;
    background-color: #C0BEB9 !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    cursor: pointer !important;
    transition: background-color 0.4s ease, width 0.4s ease !important;
  }

  .lhs-progress-bar.is-active {
    background-color: {{ section.settings.accent_color | default: '#B89768' }} !important;
    width: 32px !important;
  }

  .lhs-capsule-arrows {
    display: flex !important;
    align-items: center !important;
    gap: 4px !important;
    border-left: 1px solid #D5D2CB !important;
    padding-left: 10px !important;
    margin-left: 2px !important;
  }

  .lhs-arrow-btn {
    background: transparent !important;
    border: none !important;
    padding: 2px 4px !important;
    margin: 0 !important;
    color: #1C1B1A !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    opacity: 0.75 !important;
    transition: opacity 0.2s ease, color 0.2s ease, transform 0.2s ease !important;
  }

  .lhs-arrow-btn:hover {
    opacity: 1 !important;
    color: {{ section.settings.accent_color | default: '#B89768' }} !important;
    transform: scale(1.1) !important;
  }

  .lhs-arrow-btn svg {
    width: 12px !important;
    height: 12px !important;
    stroke: currentColor !important;
  }

  /* Mobile Pagination: Sequential dashes indicator aligned Left / Center / Right per schema */
  @media (max-width: 739px) {
    .lhs-capsule-counter {
      bottom: clamp(18px, 4vw, 30px) !important;
      padding: 6px 14px !important;
      gap: 0 !important;
      {% case section.settings.mobile_pagination_position %}
        {% when 'left' %}
          left: clamp(20px, 5vw, 32px) !important;
          right: auto !important;
          transform: none !important;
        {% when 'right' %}
          right: clamp(20px, 5vw, 32px) !important;
          left: auto !important;
          transform: none !important;
        {% else %}
          left: 50% !important;
          right: auto !important;
          transform: translateX(-50%) !important;
      {% endcase %}
    }

    .lhs-capsule-arrows {
      display: none !important;
    }

    .lhs-progress-bar {
      width: 18px !important;
      height: 2.5px !important;
    }

    .lhs-progress-bar.is-active {
      width: 28px !important;
    }
  }
{%- endstyle -%}

{%- assign slide_count = section.blocks.size -%}
{%- if slide_count > 0 -%}
  {%- liquid
    assign hero_heading = blank
    for block in section.blocks
      if block.settings.title != blank
        assign hero_heading = block.settings.title
        break
      endif
    endfor
    if hero_heading == blank
      capture hero_heading
        echo shop.name
        echo ' | American Mahjong Sets & Accessories'
      endcapture
    endif
  -%}
  <div class="luxury-hero-slider" id="LuxuryHero-{{ section.id }}" data-section-id="{{ section.id }}" data-autoplay="{{ section.settings.auto_rotate }}" data-duration="{{ section.settings.slide_duration | default: 6 }}">
    <div class="lhs-track">
      {%- for block in section.blocks -%}
        <div class="lhs-slide {% if forloop.first %}is-active{% endif %}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="lhs-bg-wrapper">
            {%- if block.settings.image_mobile != blank -%}
              <picture class="lhs-bg-picture">
                <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | image_url: width: 800 }} 800w, {{ block.settings.image_mobile | image_url: width: 1200 }} 1200w" sizes="100vw">
                <img 
                  src="{{ block.settings.image | default: block.settings.image_mobile | image_url: width: 1920 }}" 
                  srcset="{{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1920 }} 1920w, {{ block.settings.image | image_url: width: 2400 }} 2400w"
                  sizes="100vw"
                  alt="{{ block.settings.image.alt | default: block.settings.title | default: shop.name | escape }}" 
                  class="lhs-bg-image" 
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                  decoding="{% if forloop.first %}sync{% else %}async{% endif %}"
                  width="{{ block.settings.image.width | default: 1920 }}"
                  height="{{ block.settings.image.height | default: 1080 }}"
                >
              </picture>
            {%- elsif block.settings.image != blank -%}
              <img 
                src="{{ block.settings.image | image_url: width: 1920 }}" 
                srcset="{{ block.settings.image | image_url: width: 1000 }} 1000w, {{ block.settings.image | image_url: width: 1600 }} 1600w, {{ block.settings.image | image_url: width: 1920 }} 1920w, {{ block.settings.image | image_url: width: 2400 }} 2400w"
                sizes="100vw"
                alt="{{ block.settings.image.alt | default: block.settings.title | default: shop.name | escape }}" 
                class="lhs-bg-image" 
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                decoding="{% if forloop.first %}sync{% else %}async{% endif %}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {%- endif -%}
            <div class="lhs-overlay" aria-hidden="true">&nbsp;</div>
          </div>

          {%- assign has_content = false -%}
          {%- if block.settings.show_badge and block.settings.badge != blank -%}
            {%- assign has_content = true -%}
          {%- elsif block.settings.title != blank or block.settings.subtitle != blank or block.settings.button_label != blank -%}
            {%- assign has_content = true -%}
          {%- endif -%}

          {%- if has_content -%}
            <div class="lhs-content-container">
              <div class="lhs-content-box">
                {%- if block.settings.show_badge and block.settings.badge != blank -%}
                  <div class="lhs-badge-chip">{{ block.settings.badge }}</div>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  {%- if forloop.first -%}
                    <h1 class="lhs-title">{{ block.settings.title }}</h1>
                  {%- else -%}
                    <h2 class="lhs-title">{{ block.settings.title }}</h2>
                  {%- endif -%}
                {%- endif -%}

                {%- if block.settings.subtitle != blank -%}
                  <div class="lhs-subtitle">{{ block.settings.subtitle }}</div>
                {%- endif -%}

                {%- assign btn_label_clean = block.settings.button_label | strip -%}
                {%- if btn_label_clean != blank -%}
                  <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="lhs-cta-btn">
                    <span>{{ btn_label_clean }}</span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <!-- Slide Capsule Pagination (Desktop: --- | < >, Mobile: --- only) -->
    {%- if slide_count > 1 -%}
      <div class="lhs-capsule-counter" id="lhsCapsule-{{ section.id }}">
        <div class="lhs-progress-bars" id="lhsProgress-{{ section.id }}">
          {%- for i in (1..slide_count) -%}
            <button type="button" class="lhs-progress-bar {% if forloop.first %}is-active{% endif %}" data-target-index="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
        <div class="lhs-capsule-arrows">
          <button type="button" class="lhs-arrow-btn" id="lhsPrev-{{ section.id }}" aria-label="Previous Slide">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="lhs-arrow-btn" id="lhsNext-{{ section.id }}" aria-label="Next Slide">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>
    {%- endif -%}
  </div>

  <script>
    (function() {
      function initHero() {
        const sectionEl = document.getElementById('LuxuryHero-{{ section.id }}');
        if (!sectionEl) return;
        const slides = sectionEl.querySelectorAll('.lhs-slide');
        const progressBars = sectionEl.querySelectorAll('.lhs-progress-bar');
        const prevBtn = document.getElementById('lhsPrev-{{ section.id }}');
        const nextBtn = document.getElementById('lhsNext-{{ section.id }}');
        const total = slides.length;
        if (total <= 1) return;

        let currentIndex = 0;
        let timer = null;
        const autoPlay = sectionEl.getAttribute('data-autoplay') === 'true';
        const duration = parseInt(sectionEl.getAttribute('data-duration') || '6', 10) * 1000;

        function showSlide(idx) {
          currentIndex = (idx + total) % total;
          slides.forEach((s, i) => s.classList.toggle('is-active', i === currentIndex));
          progressBars.forEach((p, i) => p.classList.toggle('is-active', i === currentIndex));
        }

        function startAuto() {
          if (!autoPlay) return;
          stopAuto();
          timer = setInterval(() => showSlide(currentIndex + 1), duration);
        }
        function stopAuto() { if (timer) { clearInterval(timer); timer = null; } }

        if (nextBtn) nextBtn.addEventListener('click', () => { showSlide(currentIndex + 1); startAuto(); });
        if (prevBtn) prevBtn.addEventListener('click', () => { showSlide(currentIndex - 1); startAuto(); });
        progressBars.forEach(b => b.addEventListener('click', function() {
          showSlide(parseInt(this.getAttribute('data-target-index'), 10));
          startAuto();
        }));

        sectionEl.addEventListener('mouseenter', stopAuto);
        sectionEl.addEventListener('mouseleave', startAuto);

        // Touch & Gesture Swiping on Mobile & iPad
        let touchStartX = 0;
        let touchStartY = 0;
        let touchEndX = 0;
        let touchEndY = 0;
        let isTouching = false;
        const swipeMinDistance = 35;

        sectionEl.addEventListener('touchstart', function(e) {
          if (!e.touches || e.touches.length === 0) return;
          isTouching = true;
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
          touchEndX = touchStartX;
          touchEndY = touchStartY;
          stopAuto();
        }, { passive: true });

        sectionEl.addEventListener('touchmove', function(e) {
          if (!isTouching || !e.touches || e.touches.length === 0) return;
          touchEndX = e.touches[0].clientX;
          touchEndY = e.touches[0].clientY;
        }, { passive: true });

        const finishSwipe = function() {
          if (!isTouching) return;
          isTouching = false;
          const diffX = touchStartX - touchEndX;
          const diffY = touchStartY - touchEndY;
          // Must be horizontal gesture (> diffY) and at least 35px
          if (Math.abs(diffX) > swipeMinDistance && Math.abs(diffX) > Math.abs(diffY)) {
            if (diffX > 0) {
              showSlide(currentIndex + 1);
            } else {
              showSlide(currentIndex - 1);
            }
          }
          startAuto();
        };

        sectionEl.addEventListener('touchend', function(e) {
          if (e.changedTouches && e.changedTouches.length > 0) {
            touchEndX = e.changedTouches[0].clientX;
            touchEndY = e.changedTouches[0].clientY;
          }
          finishSwipe();
        }, { passive: true });

        sectionEl.addEventListener('touchcancel', finishSwipe, { passive: true });

        // Pointer event support for iPad Apple Pencil, trackpads, and stylus
        let isPointerDown = false;
        let pointerStartX = 0;
        let pointerStartY = 0;

        sectionEl.addEventListener('pointerdown', function(e) {
          if (e.pointerType === 'touch') return; // Handled by touch events
          isPointerDown = true;
          pointerStartX = e.clientX;
          pointerStartY = e.clientY;
          stopAuto();
        }, { passive: true });

        sectionEl.addEventListener('pointerup', function(e) {
          if (!isPointerDown) return;
          isPointerDown = false;
          const pDiffX = pointerStartX - e.clientX;
          const pDiffY = pointerStartY - e.clientY;
          if (Math.abs(pDiffX) > 40 && Math.abs(pDiffX) > Math.abs(pDiffY)) {
            if (pDiffX > 0) {
              showSlide(currentIndex + 1);
            } else {
              showSlide(currentIndex - 1);
            }
          }
          startAuto();
        }, { passive: true });

        startAuto();
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initHero);
      else initHero();
    })();
  </script>
{%- endif -%}

