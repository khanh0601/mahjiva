            {%- assign spot_prod_2 = collections['all'].products[1] -%}
          {%- else -%}
            {%- for col in collections -%}
              {%- if col.products.size > 1 -%}
                {%- assign spot_prod_2 = col.products[1] -%}
                {%- break -%}
              {%- elsif col.products.size == 1 and spot_prod_1.id != col.products[0].id -%}
                {%- assign spot_prod_2 = col.products[0] -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
