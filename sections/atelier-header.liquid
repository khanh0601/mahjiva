                    <button 
                      type="button" 
                      class="lh-drawer-curr-opt-btn{% if country.iso_code == localization.country.iso_code %} is-active{% endif %}"
                      data-country-code="{{ country.iso_code }}"
                      data-currency="{{ country.currency.iso_code }}"
                    >
                      <div class="lh-curr-btn-left">
                        {% render 'country-flag', country: country, country_code: country.iso_code %}
                        <span class="lh-curr-country-name">{{ country.name }}</span>
                      </div>
                      <span class="lh-drawer-currency-tag">
                        {{ country.currency.iso_code }} {{ country.currency.symbol }}
                      </span>
                    </button>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</header>

{%- if settings.cart_type == "notification" -%}
  {%- render 'cart-notification', color_scheme: 'scheme-1', desktop_menu_type: 'dropdown' -%}
{%- endif -%}

<script>
  (function() {
    // 1. Mobile Luxury Side Drawer Open/Close Logic
    const toggleBtn = document.getElementById('lhMobileToggle');
    const closeBtn = document.getElementById('lhDrawerClose');
    const drawer = document.getElementById('lhMobileDrawer');
    const backdrop = document.getElementById('lhDrawerBackdrop');
    const headerWrapper = document.getElementById('MaisonLuxuryHeader');

    function openDrawer() {
      if (headerWrapper) headerWrapper.classList.remove('is-hovered');
      if (drawer) {
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
      }
      if (backdrop) {
        backdrop.classList.add('is-open');
        backdrop.setAttribute('aria-hidden', 'false');
      }
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (drawer) {
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
      }
      if (backdrop) {
        backdrop.classList.remove('is-open');
        backdrop.setAttribute('aria-hidden', 'true');
      }
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (headerWrapper) {
        headerWrapper.classList.remove('is-hovered');
        handleScrollState();
      }
    }

    if (toggleBtn) toggleBtn.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (backdrop) backdrop.addEventListener('click', closeDrawer);

    // Submenu Accordions in Mobile Drawer
    document.querySelectorAll('.lh-drawer-sub-toggle').forEach(function(subToggle) {
      subToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        const parentRow = this.closest('.lh-drawer-parent-row');
        if (!parentRow) return;
        const subList = parentRow.nextElementSibling;
        if (!subList || !subList.classList.contains('lh-drawer-sublist')) return;
        const isHidden = subList.hasAttribute('hidden');
        if (isHidden) {
          subList.removeAttribute('hidden');
          this.setAttribute('aria-expanded', 'true');
        } else {
          subList.setAttribute('hidden', 'true');
          this.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // Drawer Currency Selector Popover
    const drawerCurrBtn = document.getElementById('lhDrawerCurrBtn');
    const drawerCurrMenu = document.getElementById('lhDrawerCurrMenu');
    const drawerCurrCode = document.getElementById('DrawerCountryCode') || document.getElementById('DrawerCurrencyCode');
    const drawerCurrForm = document.getElementById('DrawerCountryForm') || document.getElementById('DrawerCurrencyForm');

    if (drawerCurrBtn && drawerCurrMenu) {
      drawerCurrBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        const isHidden = drawerCurrMenu.hasAttribute('hidden');
        if (isHidden) {
          drawerCurrMenu.removeAttribute('hidden');
          drawerCurrBtn.setAttribute('aria-expanded', 'true');
        } else {
          drawerCurrMenu.setAttribute('hidden', 'true');
          drawerCurrBtn.setAttribute('aria-expanded', 'false');
        }
      });

      document.querySelectorAll('.lh-drawer-curr-opt-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const code = this.getAttribute('data-country-code');
          if (code && drawerCurrCode && drawerCurrForm) {
            drawerCurrCode.value = code;
            drawerCurrForm.submit();
          }
        });
      });
    }

    // 2. Dynamic Scroll & Hover Header (No touch lock-in!)
    function handleScrollState() {
      if (!headerWrapper) return;
      if (window.scrollY > 20) {
        headerWrapper.classList.add('is-scrolled');
      } else {
        headerWrapper.classList.remove('is-scrolled');
      }
    }

    // Only enable hover effect for genuine mouse pointer devices (prevent mobile touch sticky hover bug)
    const supportsHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (headerWrapper && supportsHover) {
      headerWrapper.addEventListener('mouseenter', function() {
        headerWrapper.classList.add('is-hovered');
      });
      headerWrapper.addEventListener('mouseleave', function() {
        headerWrapper.classList.remove('is-hovered');
      });
    }

    let scrollTicking = false;
    window.addEventListener('scroll', function() {
      if (!scrollTicking) {
        window.requestAnimationFrame(function() {
          handleScrollState();
          scrollTicking = false;
        });
        scrollTicking = true;
      }
    }, { passive: true });
    handleScrollState();

    // 3. Currency Dropdown Popover (Desktop)
    const currToggle = document.getElementById('lhCurrencyToggle');
    const currMenu = document.getElementById('lhCurrencyMenu');
    const currCodeInput = document.getElementById('HeaderCountryCode') || document.getElementById('HeaderCurrencyCode');
    const currForm = document.getElementById('HeaderCountryForm') || document.getElementById('HeaderCurrencyForm');

    if (currToggle && currMenu) {
      currToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        closeSearch();

        const isHidden = currMenu.hasAttribute('hidden');
        if (isHidden) {
          currMenu.removeAttribute('hidden');
          currToggle.setAttribute('aria-expanded', 'true');
        } else {
          currMenu.setAttribute('hidden', 'true');
          currToggle.setAttribute('aria-expanded', 'false');
        }
      });

      document.querySelectorAll('.lh-curr-select-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const code = this.getAttribute('data-country-code');
          if (code && currCodeInput && currForm) {
            currCodeInput.value = code;
            currForm.submit();
          } else {
            const label = currToggle.querySelector('.lh-curr-current');
            if (label) label.textContent = this.textContent.trim();
            currMenu.setAttribute('hidden', 'true');
            currToggle.setAttribute('aria-expanded', 'false');
          }
        });
      });

      // Real-time Country Search Filter
      document.querySelectorAll('.lh-curr-search-input').forEach(function(input) {
        input.addEventListener('input', function() {
          const q = this.value.toLowerCase().trim();
          const parentMenu = this.closest('.lh-curr-menu, .lh-drawer-curr-menu');
          if (!parentMenu) return;
          parentMenu.querySelectorAll('li').forEach(function(item) {
            const text = item.textContent.toLowerCase();
            item.style.display = text.includes(q) ? '' : 'none';
          });
        });
        input.addEventListener('click', function(e) {
          e.stopPropagation();
        });
      });
    }

    // 4. Search Floating Modal Popup (Desktop + Mobile Centered with Backdrop)
    const searchTrigger = document.getElementById('lhSearchTrigger');
    const searchCard = document.getElementById('lhSearchFloatCard');
    const searchInput = document.getElementById('lhSearchMiniInput');
    const searchBackdrop = document.getElementById('lhSearchBackdrop');
    const searchCloseBtn = document.getElementById('lhSearchCloseBtn');

    function openSearch() {
      if (currMenu) currMenu.setAttribute('hidden', 'true');
      if (currToggle) currToggle.setAttribute('aria-expanded', 'false');
      if (searchCard) {
        searchCard.removeAttribute('hidden');
        if (searchTrigger) searchTrigger.setAttribute('aria-expanded', 'true');
        if (searchBackdrop) searchBackdrop.classList.add('is-open');
        setTimeout(function() {
          if (searchInput) searchInput.focus();
        }, 60);
      }
    }

    function closeSearch() {
      if (searchCard) {
        searchCard.setAttribute('hidden', 'true');
        if (searchTrigger) searchTrigger.setAttribute('aria-expanded', 'false');
      }
      if (searchBackdrop) searchBackdrop.classList.remove('is-open');
    }

    if (searchTrigger) {
      searchTrigger.addEventListener('click', function(e) {
        e.stopPropagation();
        if (searchCard && !searchCard.hasAttribute('hidden')) {
          closeSearch();
        } else {
          openSearch();
        }
      });
    }

    if (searchCloseBtn) {
      searchCloseBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        closeSearch();
      });
    }

    if (searchBackdrop) {
      searchBackdrop.addEventListener('click', closeSearch);
    }

    // Trending quick search tags handler
    const trendingChips = document.querySelectorAll('.lh-search-tag-chip');
    trendingChips.forEach(function(chip) {
      chip.addEventListener('click', function(e) {
        e.preventDefault();
        const query = chip.getAttribute('data-search-query');
        if (searchInput && query) {
          searchInput.value = query;
          const searchForm = chip.closest('.lh-search-float-card').querySelector('form');
          if (searchForm) searchForm.submit();
        }
      });
    });

    // 5. Close popovers when clicking outside or pressing Escape
    document.addEventListener('click', function(e) {
      if (currMenu && !currMenu.hasAttribute('hidden')) {
        if (!e.target.closest('.lh-curr-dropdown-wrapper')) {
          currMenu.setAttribute('hidden', 'true');
          if (currToggle) currToggle.setAttribute('aria-expanded', 'false');
        }
      }
      if (searchCard && !searchCard.hasAttribute('hidden')) {
        if (!e.target.closest('.lh-search-box-wrapper') && !e.target.closest('.lh-search-float-card')) {
          closeSearch();
        }
      }
    });

    if (drawer) {
      drawer.querySelectorAll('a').forEach(function(link) {
        link.addEventListener('click', closeDrawer);
      });
    }

    // 6. Curated Collections Mega Menu Hover Buffer (180ms debounce)
    const megaItems = document.querySelectorAll('.lh-nav-item.has-mega-menu');
    megaItems.forEach(function(item) {
      let leaveTimer = null;
      const dropdown = item.querySelector('.lh-mega-dropdown');
      if (!dropdown) return;

      function openMega() {
        if (leaveTimer) {
          clearTimeout(leaveTimer);
          leaveTimer = null;
        }
        item.classList.add('is-mega-open');
        const link = item.querySelector('.lh-nav-link');
        if (link) link.setAttribute('aria-expanded', 'true');
        if (headerWrapper) headerWrapper.classList.add('is-hovered');
      }

      function closeMega() {
        leaveTimer = setTimeout(function() {
          item.classList.remove('is-mega-open');
          const link = item.querySelector('.lh-nav-link');
          if (link) link.setAttribute('aria-expanded', 'false');
          if (headerWrapper) {
            headerWrapper.classList.remove('is-hovered');
            handleScrollState();
          }
        }, 180); // 180ms hover buffer to avoid abrupt closure
      }

      item.addEventListener('mouseenter', openMega);
      item.addEventListener('mouseleave', closeMega);

      item.addEventListener('focusin', openMega);
      item.addEventListener('focusout', function(e) {
        if (!item.contains(e.relatedTarget)) {
          closeMega();
        }
      });
    });
  })();
</script>

