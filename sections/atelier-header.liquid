        </ul>
      </nav>
      {%- endif -%}
    </div>

    <!-- RIGHT CLUSTER: Localization, Account, Apps, Search, Cart -->
    <div class="lh-header-right">
      
      <!-- 1. Native Shopify Currency Dropdown -->
      {%- if section.settings.enable_country_selector -%}
        <div class="lh-curr-dropdown-wrapper">
          {%- form 'localization', id: 'HeaderCountryForm', class: 'lh-currency-form' -%}
            <input type="hidden" name="country_code" id="HeaderCountryCode" value="{{ localization.country.iso_code }}">
            <button 
              type="button" 
              class="lh-curr-toggle" 
              id="lhCurrencyToggle" 
              aria-expanded="false" 
              aria-label="Shipping Destination & Currency"
              {% if localization.available_countries.size <= 1 %}style="cursor: default;"{% endif %}
            >
              <span class="lh-curr-flag">{% render 'country-flag', country: localization.country, country_code: localization.country.iso_code %}</span>
              <span class="lh-curr-current">{{ localization.country.currency.iso_code }} ({{ localization.country.currency.symbol }})</span>
              {%- if localization.available_countries.size > 1 -%}
                <svg class="lh-curr-arrow" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              {%- endif -%}
            </button>

            {%- if localization.available_countries.size > 1 -%}
              <div class="lh-curr-menu" id="lhCurrencyMenu" hidden>
                <div class="lh-curr-header">Shipping Destination & Currency</div>
                
                <div class="lh-curr-search-box">
                  <input 
                    type="search" 
                    class="lh-curr-search-input" 
                    id="lhCurrSearchDesktop" 
                    placeholder="Search region or currency..." 
                    aria-label="Search region or currency"
                    autocomplete="off"
                  >
                </div>

                <ul class="lh-curr-options" role="list">
                  {%- for country in localization.available_countries -%}
                    <li class="lh-curr-option-item">
                      <button 
                        type="button" 
                        class="lh-curr-select-btn{% if country.iso_code == localization.country.iso_code %} is-active{% endif %}"
                        data-country-code="{{ country.iso_code }}"
                        data-currency="{{ country.currency.iso_code }}"
                      >
                        <div class="lh-curr-btn-left">
                          {% render 'country-flag', country: country, country_code: country.iso_code %}
                          <span class="lh-curr-country-name">{{ country.name }}</span>
                        </div>
                        <span class="lh-curr-currency-tag">
                          {{ country.currency.iso_code }} {{ country.currency.symbol }}
                        </span>
                      </button>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      <!-- 2. Real Customer Account Link -->
      {%- if section.settings.enable_account != false -%}
        {%- if shop.customer_accounts_enabled -%}
          <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="lh-action-link header__icon header__icon--account" aria-label="{{ 'customer.account_fallback' | t }}">
            {%- if section.settings.enable_customer_avatar -%}
              <account-icon>
                {%- if customer and customer.has_avatar? -%}
                  {{ customer | avatar }}
                {%- else -%}
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                {%- endif -%}
              </account-icon>
            {%- else -%}
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            {%- endif -%}
          </a>
        {%- else -%}
          <a href="{{ routes.account_login_url | default: '/account/login' }}" class="lh-action-link header__icon header__icon--account" aria-label="Account">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </a>
        {%- endif -%}
      {%- endif -%}

      <!-- 3. Minimalist Search with Modal Popup Effect -->
      {%- if section.settings.enable_search != false -%}
        <div class="lh-search-box-wrapper">
          <button 
            type="button" 
            class="lh-action-btn lh-search-btn" 
            id="lhSearchTrigger" 
            aria-label="Search" 
            aria-expanded="false"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>

          <!-- Search Backdrop (Dimming overlay for mobile popup) -->
          <div class="lh-search-backdrop" id="lhSearchBackdrop" aria-hidden="true"></div>

          <!-- Search Floating / Popup Card -->
          <div class="lh-search-float-card" id="lhSearchFloatCard" hidden>
            <div class="lh-search-card-header">
              <span class="lh-search-card-title">Search Repertoire</span>
              <button type="button" class="lh-search-card-close" id="lhSearchCloseBtn" aria-label="Close search">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
            <form action="{{ routes.search_url }}" method="get" role="search" class="lh-search-mini-form">
              <div class="lh-search-pill">
                <input 
                  type="search" 
                  name="q" 
                  class="lh-search-pill-input" 
                  id="lhSearchMiniInput"
                  placeholder="{{ section.settings.search_placeholder | default: 'Search the Atelier repertoire...' }}"
                  autocomplete="off"
                >
                <button type="submit" class="lh-search-pill-submit" aria-label="Search">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                </button>
              </div>
              <input type="hidden" name="options[prefix]" value="last">
            </form>

            <!-- Trending Searches / Quick Links -->
            <div class="lh-search-trending">
              <span class="lh-search-trending-title">Quick Discoveries:</span>
              <div class="lh-search-trending-tags">
                <button type="button" class="lh-search-tag-chip" data-search-query="Imperial Suites">Imperial Suites</button>
                <button type="button" class="lh-search-tag-chip" data-search-query="Burl Walnut">Burl Walnut Racks</button>
                <button type="button" class="lh-search-tag-chip" data-search-query="Acoustic Mats">Acoustic Mats</button>
                <button type="button" class="lh-search-tag-chip" data-search-query="Bespoke Trunks">Bespoke Trunks</button>
                <button type="button" class="lh-search-tag-chip" data-search-query="Nephrite Jade">Nephrite Jade Grade A</button>
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}

      <!-- 4. Dynamic Shopify App Blocks (@app) -->
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="lh-app-block" {{ block.shopify_attributes }}>
              {% render block %}
            </div>
        {%- endcase -%}
      {%- endfor -%}

      <!-- 5. Real Shopify Cart Drawer & Live Count Bubble (#cart-icon-bubble) -->
      {%- if section.settings.enable_cart != false -%}
      <a href="{{ routes.cart_url }}" class="lh-action-link header__icon header__icon--cart link focus-inset" id="cart-icon-bubble" aria-label="{{ 'templates.cart.cart' | t }}">
        <svg class="lh-cart-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 8h12l1 13H5L6 8z"></path>
          <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
        </svg>
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty and cart.item_count > 0 -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
      {%- endif -%}

    </div>

  </div>

  <!-- Mobile Drawer Backdrop Overlay -->
  <div class="lh-drawer-backdrop" id="lhDrawerBackdrop" aria-hidden="true"></div>

