                <svg width="8" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            </div>
            <ul class="lh-drawer-sublist" hidden>
              <li class="lh-drawer-subitem"><a href="{% if collections['tiles'] != blank %}{{ collections['tiles'].url }}{% else %}/collections/all{% endif %}" class="lh-drawer-sublink">01 • The 144-Tile Suites</a></li>
              <li class="lh-drawer-subitem"><a href="{% if collections['racks'] != blank %}{{ collections['racks'].url }}{% else %}/collections/all{% endif %}" class="lh-drawer-sublink">02 • Pushers & Racks</a></li>
              <li class="lh-drawer-subitem"><a href="{% if collections['mats'] != blank %}{{ collections['mats'].url }}{% else %}/collections/all{% endif %}" class="lh-drawer-sublink">03 • Acoustic Tablecraft</a></li>
              <li class="lh-drawer-subitem"><a href="{% if collections['tile-bag'] != blank %}{{ collections['tile-bag'].url }}{% else %}/pages/contact{% endif %}" class="lh-drawer-sublink">04 • Bespoke Trunks & Cases</a></li>
            </ul>
          </li>
          <li class="lh-drawer-item"><a href="/collections/all" class="lh-drawer-link">The 144-Tile Suites</a></li>
          <li class="lh-drawer-item"><a href="/collections/all" class="lh-drawer-link">Tablecraft & Pushers</a></li>
          <li class="lh-drawer-item"><a href="/pages/contact" class="lh-drawer-link">Private Bespoke</a></li>
          <li class="lh-drawer-item"><a href="/pages/about" class="lh-drawer-link">Atelier Story</a></li>
        {%- endif -%}
      </ul>
    </nav>

