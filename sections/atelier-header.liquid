              <a href="/collections/all" class="lh-nav-link" aria-expanded="false" aria-haspopup="true">
                <span>Collections</span>
                <svg viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.3" style="width:7px; height:5px; margin-left:4px;">
                  <path d="M1 1L5 5L9 1" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              {{ mega_dropdown_fallback_html }}
            </li>
            <li class="lh-nav-item"><a href="/collections/all" class="lh-nav-link"><span>The 144-Tile Suites</span></a></li>
            <li class="lh-nav-item"><a href="/collections/all" class="lh-nav-link"><span>Tablecraft & Pushers</span></a></li>
            <li class="lh-nav-item"><a href="/pages/contact" class="lh-nav-link"><span>Private Bespoke</span></a></li>
            <li class="lh-nav-item"><a href="/pages/about" class="lh-nav-link"><span>Atelier Story</span></a></li>
