          {%- else -%}
            {%- for col in collections -%}
              {%- if col.products.size > 0 -%}
                {%- assign spot_prod_1 = col.products[0] -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}

