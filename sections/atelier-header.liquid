          {%- for link in linklists[menu_handle].links -%}
            {%- assign is_drawer_mega = false -%}
            {%- assign link_title_down = link.title | downcase | strip -%}
            {%- assign link_url_down = link.url | downcase | strip -%}

            {%- assign is_drawer_all_prods = false -%}
            {%- if link_title_down contains 'all pro' or link_title_down contains 'all prod' or link_title_down == 'all' or link_url_down == '/collections/all' or link_title_down contains 'tất cả sản phẩm' or link_title_down contains 'toàn bộ sản phẩm' -%}
              {%- assign is_drawer_all_prods = true -%}
            {%- endif -%}

            {%- assign is_drawer_mahjong_set = false -%}
            {%- if link_title_down contains 'mahjong' or link_url_down contains 'mahjong' or link_title_down contains 'tiles' or link_url_down contains '/collections/tiles' -%}
              {%- assign is_drawer_mahjong_set = true -%}
            {%- endif -%}

            {%- assign is_drawer_accessories = false -%}
            {%- if link_title_down contains 'accessories' or link_url_down == '/collections' -%}
              {%- assign is_drawer_accessories = true -%}
            {%- endif -%}

            {%- assign is_drawer_mega = false -%}
            {%- if is_drawer_accessories or link_title_down contains 'collection' or link_title_down contains 'repertoire' or link_title_down contains 'suite' -%}
              {%- unless is_drawer_all_prods or is_drawer_mahjong_set -%}
                {%- assign is_drawer_mega = true -%}
              {%- endunless -%}
            {%- endif -%}

            {%- if is_drawer_all_prods or is_drawer_mahjong_set -%}
