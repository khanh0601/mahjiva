{%- style -%}
  /* =========================================================================
     1. LAYOUT ARCHITECTURE: HOMEPAGE (OVERLAY HEADER) & SUBPAGES (SOLID & STICKY)
     ========================================================================= */

  /* HOMEPAGE (template == 'index'): Hero Banner starts at Y = 0 under transparent Header */
  body.template-index #MainContent {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }
  body.template-index .shopify-section-group-header-group {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 0 !important;
    overflow: visible !important;
    z-index: 99999 !important;
  }

  /* PRODUCT PAGE & ALL SUBPAGES:
     - Header pinned sticky at top: position: sticky; top: 0; z-index: 1000;
     - Solid background #FCFAF8 (never transparent, prevents product imagery overlap)
     - Subtle border-bottom: 0.5px solid #ECE8E1;
  */
  body:not(.template-index) {
    display: flex !important;
    flex-direction: column !important;
  }
  body:not(.template-index) #MainContent {
    flex: 1 0 auto !important;
  }
  body:not(.template-index) .shopify-section-group-header-group {
    position: sticky !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: auto !important;
    z-index: 1000 !important;
    background-color: #FCFAF8 !important;
  }
  
  /* Scoped Reset to override Shopify Base.css styles */
  #MaisonLuxuryHeader,
  #MaisonLuxuryHeader * {
    box-sizing: border-box !important;
  }

  /* =========================================================================
     LUXURY THEME SYSTEM: LIQUID GLASS MIRROR
     ========================================================================= */
  .luxury-header-wrapper,
  .luxury-header-wrapper.theme-glass,
  .luxury-header-wrapper.theme-ivory {
    --lh-bg: transparent;
    --lh-bg-scrolled: {{ section.settings.bg_color_scrolled | default: '#FDFBF8' }};
    --lh-border: rgba(255, 255, 255, 0.25);
    --lh-border-scrolled: {{ section.settings.border_bottom_color | default: '#EAE6DF' }};
    --lh-text: #FFFFFF;
    --lh-text-scrolled: {{ section.settings.text_color | default: '#16181B' }};
    --lh-text-muted: rgba(255, 255, 255, 0.85);
    --lh-text-muted-scrolled: #7E7A73;
    --lh-accent: #E5C38D;
    --lh-accent-scrolled: {{ section.settings.accent_hover_color | default: '#B89768' }};
    --lh-shadow: none;
    --lh-shadow-scrolled: 0 4px 24px rgba(0, 0, 0, 0.08);
    --lh-bubble-bg: {{ section.settings.accent_hover_color | default: '#B89768' }};
    --lh-bubble-text: #FFFFFF;
  }

  .luxury-header-wrapper.theme-pure_white {
    --lh-bg: transparent;
    --lh-bg-scrolled: #FFFFFF;
    --lh-border: rgba(255, 255, 255, 0.3);
    --lh-border-scrolled: rgba(196, 164, 112, 0.35);
    --lh-text: #FFFFFF;
    --lh-text-scrolled: #16181B;
    --lh-text-muted: rgba(255, 255, 255, 0.85);
    --lh-text-muted-scrolled: #7E7A73;
    --lh-accent: #E5C38D;
    --lh-accent-scrolled: #B89768;
    --lh-shadow: none;
    --lh-shadow-scrolled: 0 4px 20px rgba(0, 0, 0, 0.06);
    --lh-bubble-bg: #16181B;
    --lh-bubble-text: #FFFFFF;
  }

  .luxury-header-wrapper.theme-dark {
    --lh-bg: rgba(14, 32, 26, 0.35);
    --lh-bg-scrolled: rgba(10, 24, 19, 0.96);
    --lh-border: rgba(255, 255, 255, 0.12);
    --lh-border-scrolled: rgba(212, 175, 55, 0.22);
    --lh-text: #F5F2EB;
    --lh-text-scrolled: #F5F2EB;
    --lh-text-muted: #C5A880;
    --lh-text-muted-scrolled: #C5A880;
    --lh-accent: #D4AF37;
    --lh-accent-scrolled: #D4AF37;
    --lh-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    --lh-shadow-scrolled: 0 4px 20px rgba(0, 0, 0, 0.2);
    --lh-bubble-bg: #D4AF37;
    --lh-bubble-text: #10241E;
  }

  /* Header Wrapper chung */
  .luxury-header-wrapper {
    width: 100% !important;
    position: {% if section.settings.enable_sticky != false %}fixed{% else %}absolute{% endif %} !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 99999 !important;
    background-color: var(--lh-bg) !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    border-bottom: none !important;
    box-shadow: var(--lh-shadow) !important;
    transition: background-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.35s ease,
                box-shadow 0.35s ease,
                backdrop-filter 0.35s ease,
                -webkit-backdrop-filter 0.35s ease !important;
  }

  /* =========================================================================
     HEADER ARCHITECTURE ON PRODUCT & SUBPAGES (SOLID & STICKY):
     - Solid background: #FCFAF8
     - Sticky pinned at top: position: sticky; top: 0; z-index: 1000;
     - Bottom border: 0.5px solid #ECE8E1;
     - Never transparent, prevents product imagery overlap
     ========================================================================= */
  body:not(.template-index) .luxury-header-wrapper,
  .luxury-header-wrapper.is-subpage-header,
  .luxury-header-wrapper.is-solid-header {
    position: sticky !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    z-index: 1000 !important;
    background-color: #FCFAF8 !important;
    border-bottom: 0.5px solid #ECE8E1 !important;
    box-shadow: 0 2px 14px rgba(20, 21, 23, 0.04) !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  /* Text, Icons & Navigation on subpages: High-contrast Noir (#16181B) */
  body:not(.template-index) .luxury-header-wrapper .lh-mobile-toggle,
  body:not(.template-index) .luxury-header-wrapper .lh-nav-link,
  body:not(.template-index) .luxury-header-wrapper .lh-curr-toggle,
  body:not(.template-index) .luxury-header-wrapper .lh-action-btn,
  body:not(.template-index) .luxury-header-wrapper .lh-action-link,
  body:not(.template-index) .luxury-header-wrapper .lh-brand-title,
  body:not(.template-index) .luxury-header-wrapper .lh-curr-current,
  .is-subpage-header .lh-mobile-toggle,
  .is-subpage-header .lh-nav-link,
  .is-subpage-header .lh-curr-toggle,
  .is-subpage-header .lh-action-btn,
  .is-subpage-header .lh-action-link,
  .is-subpage-header .lh-brand-title,
  .is-subpage-header .lh-curr-current {
    color: #16181B !important;
    text-shadow: none !important;
    filter: none !important;
  }

  body:not(.template-index) .luxury-header-wrapper .lh-nav-link:hover,
  body:not(.template-index) .luxury-header-wrapper .lh-nav-item:hover > .lh-nav-link,
  body:not(.template-index) .luxury-header-wrapper .lh-curr-toggle:hover,
  body:not(.template-index) .luxury-header-wrapper .lh-action-btn:hover,
  body:not(.template-index) .luxury-header-wrapper .lh-action-link:hover,
  .is-subpage-header .lh-nav-link:hover,
  .is-subpage-header .lh-nav-item:hover > .lh-nav-link,
  .is-subpage-header .lh-curr-toggle:hover,
  .is-subpage-header .lh-action-btn:hover,
  .is-subpage-header .lh-action-link:hover {
    color: #B89768 !important;
  }

  body:not(.template-index) .luxury-header-wrapper .lh-divider,
  .is-subpage-header .lh-divider {
    background-color: rgba(196, 164, 112, 0.3) !important;
  }

  /* Smooth transition for text & icons */
  .lh-nav-link,
  .lh-curr-toggle,
  .lh-action-btn,
  .lh-action-link,
  .lh-mobile-toggle,
  .lh-divider {
    transition: color 0.3s ease,
                background-color 0.3s ease,
                filter 0.3s ease,
                text-shadow 0.3s ease !important;
  }

  /* STATE 1: UNSCROLLED & UNHOVERED ON HOMEPAGE (Transparent overlay above Hero Banner) */
  body.template-index .luxury-header-wrapper:not(.is-scrolled):not(:hover):not(.is-hovered) {
    background-color: var(--lh-bg) !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    border-bottom: none !important;
    box-shadow: none !important;
  }

  body.template-index .luxury-header-wrapper:not(.is-scrolled):not(:hover):not(.is-hovered) .lh-mobile-toggle {
    color: #FFFFFF !important;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.65)) !important;
  }

  body.template-index .luxury-header-wrapper:not(.is-scrolled):not(:hover):not(.is-hovered) .lh-nav-link {
    color: #FFFFFF !important;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.45) !important;
  }
  body.template-index .luxury-header-wrapper:not(.is-scrolled):not(:hover):not(.is-hovered) .lh-nav-link:hover,
  body.template-index .luxury-header-wrapper:not(.is-scrolled):not(:hover):not(.is-hovered) .lh-nav-item:hover > .lh-nav-link {
    color: var(--lh-accent) !important;
  }

  body.template-index .luxury-header-wrapper:not(.is-scrolled):not(:hover):not(.is-hovered) .lh-curr-toggle {
    color: #FFFFFF !important;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.45) !important;
  }
  body.template-index .luxury-header-wrapper:not(.is-scrolled):not(:hover):not(.is-hovered) .lh-curr-toggle:hover {
    color: var(--lh-accent) !important;
  }

  body.template-index .luxury-header-wrapper:not(.is-scrolled):not(:hover):not(.is-hovered) .lh-action-btn,
  body.template-index .luxury-header-wrapper:not(.is-scrolled):not(:hover):not(.is-hovered) .lh-action-link {
    color: #FFFFFF !important;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.5)) !important;
  }
  body.template-index .luxury-header-wrapper:not(.is-scrolled):not(:hover):not(.is-hovered) .lh-action-btn:hover,
  body.template-index .luxury-header-wrapper:not(.is-scrolled):not(:hover):not(.is-hovered) .lh-action-link:hover {
    color: var(--lh-accent) !important;
  }

  body.template-index .luxury-header-wrapper:not(.is-scrolled):not(:hover):not(.is-hovered) .lh-divider {
    background-color: rgba(255, 255, 255, 0.35) !important;
  }

  /* STATE 2: ON HOVER OR SCROLLED DOWN
     -> Smooth transition to luminous frosted pearl background, high-contrast Noir typography */
  .luxury-header-wrapper:hover,
  .luxury-header-wrapper.is-hovered,
  .luxury-header-wrapper.is-scrolled {
    background-color: var(--lh-bg-scrolled) !important;
    backdrop-filter: blur(20px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
    border-bottom: 1px solid var(--lh-border-scrolled) !important;
    box-shadow: var(--lh-shadow-scrolled) !important;
  }

  .luxury-header-wrapper:hover .lh-mobile-toggle,
  .luxury-header-wrapper.is-hovered .lh-mobile-toggle,
  .luxury-header-wrapper.is-scrolled .lh-mobile-toggle {
    color: var(--lh-text-scrolled, #16181B) !important;
    filter: none !important;
  }

  .luxury-header-wrapper:hover .lh-nav-link,
  .luxury-header-wrapper.is-hovered .lh-nav-link,
  .luxury-header-wrapper.is-scrolled .lh-nav-link {
    color: var(--lh-text-scrolled) !important;
    text-shadow: none !important;
  }
  .luxury-header-wrapper:hover .lh-nav-link:hover,
  .luxury-header-wrapper:hover .lh-nav-item:hover > .lh-nav-link,
  .luxury-header-wrapper.is-hovered .lh-nav-link:hover,
  .luxury-header-wrapper.is-hovered .lh-nav-item:hover > .lh-nav-link,
  .luxury-header-wrapper.is-scrolled .lh-nav-link:hover,
  .luxury-header-wrapper.is-scrolled .lh-nav-item:hover > .lh-nav-link {
    color: var(--lh-accent-scrolled) !important;
  }

  .luxury-header-wrapper:hover .lh-curr-toggle,
  .luxury-header-wrapper.is-hovered .lh-curr-toggle,
  .luxury-header-wrapper.is-scrolled .lh-curr-toggle {
    color: var(--lh-text-scrolled) !important;
    text-shadow: none !important;
  }
  .luxury-header-wrapper:hover .lh-curr-toggle:hover,
  .luxury-header-wrapper.is-hovered .lh-curr-toggle:hover,
  .luxury-header-wrapper.is-scrolled .lh-curr-toggle:hover {
    color: var(--lh-accent-scrolled) !important;
  }

  .luxury-header-wrapper:hover .lh-action-btn,
  .luxury-header-wrapper:hover .lh-action-link,
  .luxury-header-wrapper.is-hovered .lh-action-btn,
  .luxury-header-wrapper.is-hovered .lh-action-link,
  .luxury-header-wrapper.is-scrolled .lh-action-btn,
  .luxury-header-wrapper.is-scrolled .lh-action-link {
    color: var(--lh-text-scrolled) !important;
    filter: none !important;
  }
  .luxury-header-wrapper:hover .lh-action-btn:hover,
  .luxury-header-wrapper:hover .lh-action-link:hover,
  .luxury-header-wrapper.is-hovered .lh-action-btn:hover,
  .luxury-header-wrapper.is-hovered .lh-action-link:hover,
  .luxury-header-wrapper.is-scrolled .lh-action-btn:hover,
  .luxury-header-wrapper.is-scrolled .lh-action-link:hover {
    color: var(--lh-accent-scrolled) !important;
  }

  .luxury-header-wrapper:hover .lh-divider,
  .luxury-header-wrapper.is-hovered .lh-divider,
  .luxury-header-wrapper.is-scrolled .lh-divider {
    background-color: rgba(196, 164, 112, 0.3) !important;
  }

  /* Full width container: Left Cluster (Logo + Nav) & Right Cluster (Actions) */
  .luxury-header-container {
    width: 100% !important;
    max-width: 1360px !important;
    height: {{ section.settings.header_height | default: 68 }}px !important;
    margin: 0 auto !important;
    padding: 0 20px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    position: static !important;
  }

  @media (min-width: 1024px) {
    .luxury-header-container {
      padding: 0 36px !important;
    }
  }

  /* LEFT CLUSTER: Brand Logo + Menu */
  .lh-header-left {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 36px !important;
    flex: 1 1 auto !important;
  }

  /* Brand Logo (Unconstrained scaling - PC & Mobile) */
  .lh-brand-link {
    display: inline-flex !important;
    align-items: center !important;
    gap: 12px !important;
    text-decoration: none !important;
    color: inherit !important;
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    flex-shrink: 0 !important;
  }

  .lh-logo-img {
    display: block !important;
    height: auto !important;
    max-height: {{ logo_h_pc }}px !important;
    width: auto !important;
    max-width: none !important;
    object-fit: contain !important;
    transition: transform 0.2s ease, max-height 0.2s ease !important;
  }

  /* Fallback Brand Seal & Typography if no image logo uploaded */
  .lh-seal-box {
    width: 34px !important;
    height: 34px !important;
    border: 1px solid #D4AF37 !important;
    background: rgba(255, 255, 255, 0.08) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: 17px !important;
    font-weight: 600 !important;
    color: var(--lh-accent) !important;
    border-radius: 4px !important;
    line-height: 1 !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2) !important;
    flex-shrink: 0 !important;
  }

  .lh-brand-text {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    line-height: 1.15 !important;
  }

  .lh-brand-title {
    font-family: var(--font-heading-family, var(--font-body-family, 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif)) !important;
    font-size: {{ brand_size_pc }}px !important;
    font-weight: 700 !important;
    letter-spacing: {{ section.settings.brand_letter_spacing | default: 2 }}px !important;
    color: #FFFFFF !important;
    text-transform: uppercase !important;
    margin: 0 !important;
    white-space: nowrap !important;
  }

  .luxury-header-wrapper:hover .lh-brand-title,
  .luxury-header-wrapper.is-hovered .lh-brand-title,
  .luxury-header-wrapper.is-scrolled .lh-brand-title {
    color: var(--lh-text-scrolled, #16181B) !important;
  }

  .lh-brand-sub {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    font-size: 8px !important;
    font-weight: 500 !important;
    letter-spacing: 0.24em !important;
    color: var(--lh-text-muted) !important;
    text-transform: uppercase !important;
    margin-top: 2px !important;
    white-space: nowrap !important;
  }

  /* Main Navigation Menu right next to Logo */
  .lh-header-nav {
    display: flex !important;
    align-items: center !important;
  }

  {%- assign menu_font_selected = "var(--font-body-family, 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif)" -%}
  {%- case section.settings.menu_font_family -%}
    {%- when 'cormorant' -%}
      {%- assign menu_font_selected = "'Cormorant Garamond', Georgia, serif" -%}
    {%- when 'cinzel' -%}
      {%- assign menu_font_selected = "'Cinzel', Georgia, serif" -%}
    {%- when 'georgia' -%}
      {%- assign menu_font_selected = "Georgia, serif" -%}
    {%- else -%}
      {%- assign menu_font_selected = "var(--font-body-family, 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif)" -%}
  {%- endcase -%}

  .lh-nav {
    display: flex !important;
    align-items: center !important;
    gap: {{ section.settings.menu_gap | default: 24 }}px !important;
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .lh-nav-item {
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
    position: relative !important;
  }

  .lh-nav-link {
    font-family: {{ menu_font_selected }} !important;
    font-size: {{ section.settings.menu_font_size | default: 13 }}px !important;
    font-weight: 500 !important;
    letter-spacing: 0.05em !important;
    color: var(--lh-text) !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    transition: color 0.25s ease, font-weight 0.2s ease !important;
    padding: 8px 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 5px !important;
    background: transparent !important;
    border: none !important;
