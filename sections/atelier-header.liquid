          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="lh-drawer-brand-mark" style="margin-left: auto; font-family: var(--font-body-family, 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif); font-size: 12px; letter-spacing: 0.08em; color: rgba(255, 255, 255, 0.6); font-weight: 600; text-transform: uppercase;">
        {{ section.settings.brand_name | default: 'MAHJIVA' }}
