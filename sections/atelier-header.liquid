  .lh-mobile-drawer {
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    bottom: 0 !important;
    width: 320px !important;
    max-width: 82vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    background: linear-gradient(165deg, #181A1D 0%, #101114 100%) !important;
    border-right: 1px solid rgba(255, 255, 255, 0.08) !important;
    z-index: 99999 !important;
    padding: 24px 24px 32px 24px !important;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch !important;
    box-shadow: 12px 0 48px rgba(0, 0, 0, 0.5) !important;
    transform: translateX(-100%) !important;
    visibility: hidden !important;
    transition: transform 0.42s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.42s ease !important;
  }

  .lh-mobile-drawer.is-open {
    transform: translateX(0) !important;
    visibility: visible !important;
  }

  /* Staggered Cascade Entry Animation for Menu Items */
  .lh-mobile-drawer.is-open .lh-drawer-item {
    animation: lhDrawerCascade 0.42s cubic-bezier(0.16, 1, 0.3, 1) backwards !important;
  }
  .lh-mobile-drawer.is-open .lh-drawer-item:nth-child(1) { animation-delay: 0.06s !important; }
  .lh-mobile-drawer.is-open .lh-drawer-item:nth-child(2) { animation-delay: 0.11s !important; }
  .lh-mobile-drawer.is-open .lh-drawer-item:nth-child(3) { animation-delay: 0.16s !important; }
  .lh-mobile-drawer.is-open .lh-drawer-item:nth-child(4) { animation-delay: 0.21s !important; }
  .lh-mobile-drawer.is-open .lh-drawer-item:nth-child(5) { animation-delay: 0.26s !important; }
  .lh-mobile-drawer.is-open .lh-drawer-item:nth-child(6) { animation-delay: 0.31s !important; }
  .lh-mobile-drawer.is-open .lh-drawer-footer {
    animation: lhDrawerFadeUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.26s backwards !important;
  }

  @keyframes lhDrawerCascade {
    from {
      opacity: 0;
      transform: translateX(-16px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes lhDrawerFadeUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Drawer Top Close Button (Elevated circular icon) */
  .lh-drawer-header {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    margin-bottom: 28px !important;
  }

  .lh-drawer-close {
    width: 36px !important;
    height: 36px !important;
    border-radius: 50% !important;
    background: rgba(255, 255, 255, 0.12) !important;
    border: 1px solid rgba(255, 255, 255, 0.22) !important;
    padding: 0 !important;
    margin: 0 !important;
    color: #FFFFFF !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    opacity: 0.95 !important;
    transition: background 0.22s ease, transform 0.22s ease, border-color 0.22s ease !important;
  }

  .lh-drawer-close:hover,
  .lh-drawer-close:active {
    background: rgba(255, 255, 255, 0.22) !important;
    border-color: rgba(255, 255, 255, 0.4) !important;
    transform: rotate(90deg) scale(1.05) !important;
  }

  /* Drawer Navigation Links */
  .lh-drawer-nav {
    flex: 1 1 auto !important;
  }

  .lh-drawer-list {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 16px !important;
  }

  .lh-drawer-item {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .lh-drawer-parent-row {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    width: 100% !important;
  }

  .lh-drawer-link {
    font-family: var(--font-body-family, 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif) !important;
    font-size: 16px !important;
    font-weight: 600 !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase !important;
    color: #FAF8F5 !important;
    text-decoration: none !important;
    display: inline-block !important;
    line-height: 1.3 !important;
    transition: color 0.2s ease, transform 0.2s ease !important;
  }

  .lh-drawer-link:hover {
    color: #E8D3B3 !important;
    transform: translateX(3px) !important;
  }

  .lh-drawer-sub-toggle {
    background: transparent !important;
    border: none !important;
    color: #FFFFFF !important;
    opacity: 0.75 !important;
    padding: 6px 10px !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: transform 0.25s ease, opacity 0.2s ease, color 0.2s ease !important;
  }

  .lh-drawer-sub-toggle:hover {
    opacity: 1 !important;
    color: #E8D3B3 !important;
  }

  .lh-drawer-sub-toggle[aria-expanded="true"] {
    transform: rotate(90deg) !important;
    color: #E8D3B3 !important;
    opacity: 1 !important;
  }

  .lh-drawer-sublist {
    list-style: none !important;
    margin: 10px 0 4px 6px !important;
    padding: 4px 0 6px 14px !important;
    border-left: 1px solid rgba(255, 255, 255, 0.25) !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 10px !important;
  }

  .lh-drawer-sublist[hidden] {
    display: none !important;
  }

  .lh-drawer-sublink {
    font-family: var(--font-body-family, 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif) !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase !important;
    color: rgba(255, 255, 255, 0.85) !important;
    text-decoration: none !important;
    transition: color 0.2s ease !important;
  }

  .lh-drawer-sublink:hover {
    color: #E8D3B3 !important;
  }

  /* Drawer Footer (LOGIN + Currency) */
  .lh-drawer-footer {
    margin-top: auto !important;
    padding-top: 32px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 16px !important;
    border-top: 1px solid rgba(255, 255, 255, 0.18) !important;
  }

  .lh-drawer-account {
    display: flex !important;
    align-items: center !important;
  }

  .lh-drawer-login-btn {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    font-size: 11.5px !important;
    font-weight: 600 !important;
    letter-spacing: 0.18em !important;
    text-transform: uppercase !important;
    color: #EDE9E1 !important;
    text-decoration: none !important;
    transition: color 0.2s ease, opacity 0.2s ease !important;
  }

  .lh-drawer-login-btn svg {
    width: 16px !important;
    height: 16px !important;
    stroke: currentColor !important;
  }

  .lh-drawer-login-btn:hover {
    color: #FFFFFF !important;
    opacity: 1 !important;
  }

  .lh-drawer-currency {
    position: relative !important;
    display: flex !important;
    align-items: center !important;
  }

  .lh-drawer-currency-form {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
  }

  .lh-drawer-curr-btn {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    font-family: var(--font-body-family, 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif) !important;
    font-size: 13.5px !important;
    font-weight: 600 !important;
    letter-spacing: 0.03em !important;
    color: #FAF8F5 !important;
    cursor: pointer !important;
    transition: color 0.2s ease !important;
  }

  .lh-drawer-curr-btn:hover {
    color: #FFFFFF !important;
  }

  .lh-drawer-curr-flag {
    display: inline-flex !important;
    align-items: center !important;
    line-height: 1 !important;
  }

  .lh-drawer-curr-arrow {
    transition: transform 0.2s ease !important;
    opacity: 0.8 !important;
  }

  .lh-drawer-curr-btn[aria-expanded="true"] .lh-drawer-curr-arrow {
    transform: rotate(180deg) !important;
  }

  .lh-drawer-curr-menu {
    position: absolute !important;
    bottom: calc(100% + 10px) !important;
    left: 0 !important;
    background: #181A1E !important;
    border-radius: 12px !important;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.08) !important;
    border: 1px solid rgba(197, 168, 128, 0.25) !important;
    min-width: 220px !important;
    max-width: 280px !important;
    padding: 8px !important;
    z-index: 100010 !important;
    backdrop-filter: blur(16px) !important;
    -webkit-backdrop-filter: blur(16px) !important;
  }

  .lh-drawer-curr-menu[hidden] {
    display: none !important;
  }

  .lh-drawer-curr-header {
    font-size: 10px !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.14em !important;
    color: rgba(255, 255, 255, 0.45) !important;
    padding: 6px 10px 10px !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
    user-select: none !important;
  }

  .lh-drawer-curr-options {
    list-style: none !important;
    margin: 0 !important;
    padding: 4px 0 !important;
    max-height: 240px !important;
    overflow-y: auto !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 2px !important;
  }

  .lh-drawer-curr-opt-btn {
    width: 100% !important;
    background: transparent !important;
    border: none !important;
    padding: 8px 10px !important;
    border-radius: 6px !important;
    text-align: left !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    font-size: 12.5px !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    transition: all 0.18s ease !important;
  }

  .lh-drawer-curr-opt-btn .lh-curr-country-name {
    color: rgba(255, 255, 255, 0.9) !important;
    font-size: 12px !important;
  }

  .lh-drawer-currency-tag {
    font-size: 11px !important;
    font-weight: 600 !important;
    color: rgba(255, 255, 255, 0.6) !important;
    background: rgba(255, 255, 255, 0.08) !important;
    padding: 3px 7px !important;
    border-radius: 5px !important;
    flex-shrink: 0 !important;
    margin-left: 8px !important;
  }

  .lh-drawer-curr-opt-btn:hover {
    background: rgba(255, 255, 255, 0.08) !important;
  }

  .lh-drawer-curr-opt-btn.is-active {
    background: rgba(197, 168, 128, 0.18) !important;
  }

  .lh-drawer-curr-opt-btn.is-active .lh-curr-country-name {
    color: #E8D3B3 !important;
    font-weight: 600 !important;
  }

  .lh-drawer-curr-opt-btn.is-active .lh-drawer-currency-tag {
    background: #C5A880 !important;
    color: #181A1E !important;
  }

  /* =========================================================================
     MOBILE RESPONSIVE RULES (@media max-width: 991px)
     ========================================================================= */
  @media (max-width: 991px) {
    .luxury-header-wrapper {
      background: #FFFFFF !important;
      border-bottom: 1px solid rgba(20, 21, 23, 0.08) !important;
      box-shadow: 0 2px 14px rgba(0, 0, 0, 0.04) !important;
    }

    .luxury-header-container {
      position: relative !important;
      height: 64px !important;
      padding: 0 16px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
    }

    /* Left: Hamburger */
    .lh-header-left {
      display: flex !important;
      align-items: center !important;
      flex: 0 0 auto !important;
      gap: 0 !important;
    }

    .lh-mobile-toggle {
      width: 40px !important;
      height: 40px !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      background: transparent !important;
      border: none !important;
      color: #141517 !important;
      cursor: pointer !important;
      padding: 0 !important;
      z-index: 12 !important;
      transition: opacity 0.2s ease, transform 0.15s ease !important;
    }

    .lh-mobile-toggle:active {
      transform: scale(0.92) !important;
    }

    .lh-mobile-toggle svg {
      width: 22px !important;
      height: 22px !important;
      stroke-width: 2.2 !important;
      stroke: #141517 !important;
    }

    /* Center: Logo (Scalable on mobile without limits) */
    .lh-brand-link {
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
      z-index: 10 !important;
      text-align: center !important;
      justify-content: center !important;
      margin: 0 !important;
      max-width: calc(100% - 130px) !important;
    }

    .lh-logo-img {
      max-height: {{ logo_h_mb }}px !important;
      min-height: 38px !important;
      max-width: calc(100vw - 130px) !important;
      width: auto !important;
      object-fit: contain !important;
      filter: contrast(1.15) brightness(0.96) !important;
      image-rendering: -webkit-optimize-contrast !important;
    }

    .lh-brand-title {
      font-size: {{ brand_size_mb }}px !important;
      color: #141517 !important;
      font-weight: 700 !important;
    }

    /* Desktop Navigation hidden on mobile */
    .lh-header-nav {
      display: none !important;
    }

    /* Right: Search + Cart */
    .lh-header-right {
      display: flex !important;
      align-items: center !important;
      justify-content: flex-end !important;
      gap: 8px !important;
      flex: 0 0 auto !important;
      margin-left: auto !important;
      z-index: 12 !important;
    }

    .lh-action-btn,
    .lh-action-link {
      width: 38px !important;
      height: 38px !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      color: #141517 !important;
    }

    .lh-action-btn svg,
    .lh-action-link svg {
      width: 20px !important;
      height: 20px !important;
      stroke-width: 2 !important;
      stroke: #141517 !important;
    }

    /* Hide Currency & Account from top bar on mobile - they live in the mobile drawer */
    .lh-curr-dropdown-wrapper,
    .lh-header-right .header__icon--account {
      display: none !important;
    }

    /* Mobile Search: Centered Popup Modal with Zoom-in Animation */
    .lh-search-float-card {
      position: fixed !important;
      top: 70px !important;
      left: 50% !important;
      right: auto !important;
      transform: translateX(-50%) !important;
      width: calc(100vw - 28px) !important;
      max-width: 480px !important;
      padding: 16px 18px !important;
      border-radius: 16px !important;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.32), 0 2px 10px rgba(0, 0, 0, 0.08) !important;
      border: 1px solid rgba(197, 168, 128, 0.35) !important;
      animation: lhSearchPopupMobile 0.28s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }
  }
{%- endstyle -%}

{%- assign is_home = false -%}
{%- if template == 'index' or template.name == 'index' or request.page_type == 'index' -%}
  {%- assign is_home = true -%}
{%- endif -%}

<header class="luxury-header-wrapper header-wrapper header-localization theme-{{ section.settings.header_color_scheme | default: 'ivory' }}{% if is_home %} is-home-header{% else %} is-subpage-header is-solid-header{% endif %}" id="MaisonLuxuryHeader">
  <div class="luxury-header-container">
    
    <!-- LEFT CLUSTER: Brand Logo + Menu right next to logo -->
    <div class="lh-header-left">
      <button type="button" class="lh-mobile-toggle" id="lhMobileToggle" aria-label="Menu" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      {%- assign header_logo = section.settings.logo | default: settings.logo -%}
      {%- if header_logo != blank -%}
        <a href="{{ routes.root_url }}" class="lh-brand-link" aria-label="{{ shop.name }}">
          {%- if section.settings.show_seal_badge -%}
            <div class="lh-seal-box" aria-hidden="true">玉</div>
          {%- endif -%}
          <img 
            src="{{ header_logo | image_url: width: 800 }}" 
            alt="{{ header_logo.alt | default: shop.name | escape }}"
            class="lh-logo-img"
            width="{{ header_logo.width }}"
            height="{{ header_logo.height }}"
            loading="eager"
          >
        </a>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="lh-brand-link" aria-label="{{ shop.name }}">
          {%- if section.settings.show_seal_badge -%}
            <div class="lh-seal-box" aria-hidden="true">玉</div>
          {%- endif -%}
          <div class="lh-brand-text">
            <span class="lh-brand-title">{{ section.settings.brand_name | default: shop.name }}</span>
            {%- if section.settings.brand_subtitle != blank -%}<span class="lh-brand-sub">{{ section.settings.brand_subtitle }}</span>{%- endif -%}
          </div>
        </a>
      {%- endif -%}

      <!-- Main Navigation Menu placed close to Logo -->
      {%- if section.settings.show_menu != false -%}

        <style>
          /* Reset all columns and elements inside mega dropdown */
          .lh-nav-item.has-mega-menu,
          .lh-nav-item.has-dropdown:has(.lh-mega-dropdown) {
            position: static !important;
          }

          .lh-mega-dropdown,
          .lh-mega-dropdown * {
            box-sizing: border-box !important;
          }

          .lh-mega-dropdown a {
            text-decoration: none !important;
            color: inherit !important;
          }

          /* Hide Mahjong Set and New Arrivals items ONLY in Accessories navigation list */
          .lh-mega-nav-list a.lh-mega-item[href*="mahjong-set"],
          .lh-mega-nav-list a.lh-mega-item[href*="new-array"],
          .lh-mega-nav-list a.lh-mega-item[href*="new-arrival"] {
            display: none !important;
          }

          /* Mega dropdown container: hidden by default */
          .lh-mega-dropdown {
            display: none !important;
            position: absolute !important;
            top: 100% !important;
            left: 0 !important;
            width: 100vw !important;
            background-color: #FCFAF8 !important; /* Solid background covering hero */
            border-top: 0.5px solid #ECE8E1 !important;
            border-bottom: 1px solid rgba(22, 51, 39, 0.15) !important;
            box-shadow: 0 24px 50px -10px rgba(13, 26, 20, 0.1) !important;
            z-index: 999999 !important;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s ease;
            transform: translateY(8px);
          }

          /* Buffer pseudo-element to bridge hover gap seamlessly */
          .lh-mega-dropdown::before {
            content: '' !important;
            position: absolute !important;
            top: -16px !important;
            left: 0 !important;
            width: 100% !important;
            height: 16px !important;
            background: transparent !important;
          }

          /* Display dropdown on hover or active state */
          .lh-nav-item.has-dropdown:hover .lh-mega-dropdown,
          .lh-nav-item.has-dropdown.is-active .lh-mega-dropdown,
          .lh-nav-item.has-dropdown.is-mega-open .lh-mega-dropdown,
          .lh-nav-item.has-mega-menu:hover .lh-mega-dropdown,
          .lh-nav-item.has-mega-menu.is-mega-open .lh-mega-dropdown {
            display: block !important;
            opacity: 1 !important;
            pointer-events: auto !important;
            transform: translateY(0);
          }

          .lh-nav-item.has-dropdown:hover .lh-dropdown-arrow,
          .lh-nav-item.has-mega-menu:hover .lh-dropdown-arrow,
          .lh-nav-item.has-mega-menu.is-mega-open .lh-dropdown-arrow {
            transform: rotate(180deg) !important;
            color: #B89768 !important;
          }

          .lh-mega-container {
            max-width: 880px !important;
            margin: 0 auto !important;
            padding: 20px 24px 18px !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
          }

          /* Collections navigation list: Elegant vertical column */
          .lh-mega-nav-list {
            display: flex !important;
            flex-direction: column !important;
            gap: 4px !important;
            width: 100% !important;
            max-width: 260px !important;
          }

          .lh-mega-eyebrow {
            font-family: var(--font-body-family, 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif) !important;
            font-size: 10px !important;
            letter-spacing: 0.12em !important;
            text-transform: uppercase !important;
            font-weight: 700 !important;
            color: #B89768 !important;
            margin-bottom: 8px !important;
            padding: 0 12px !important;
            display: block !important;
            text-align: left !important;
          }

          .lh-mega-item {
            display: block !important;
            padding: 8px 12px !important;
            border-radius: 6px !important;
            background: transparent !important;
            border: 1px solid transparent !important;
            transition: background-color 0.2s ease, transform 0.2s ease, border-color 0.2s ease !important;
            text-decoration: none !important;
          }

          .lh-mega-item:hover {
            background-color: #FAF6F0 !important;
            border-color: #ECE8E1 !important;
            transform: translateX(4px) !important;
          }

          .lh-mega-item-title {
            font-family: var(--font-body-family, 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif) !important;
            font-size: 13.5px !important;
            color: #141517 !important;
            font-weight: 500 !important;
            line-height: 1.35 !important;
            letter-spacing: 0 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
