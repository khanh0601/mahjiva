              <li class="lh-drawer-item">
                <a href="{{ link.url }}" class="lh-drawer-link">{{ link.title }}</a>
              </li>
            {%- elsif is_drawer_mega -%}
              <li class="lh-drawer-item has-submenu has-dropdown">
                <div class="lh-drawer-parent-row">
                  <a href="{{ link.url }}" class="lh-drawer-link">{{ link.title }}</a>
                  <button type="button" class="lh-drawer-sub-toggle" aria-expanded="false" aria-label="Toggle {{ link.title }}">
                    <svg width="8" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </button>
                </div>
                <ul class="lh-drawer-sublist" hidden>
                  {%- if link.links.size > 0 -%}
                    {%- for childlink in link.links -%}
                      {%- if is_drawer_accessories -%}
                        {%- if childlink.handle == 'mahjong-set' or childlink.title contains 'Mahjong' or childlink.url contains 'mahjong-set' or childlink.handle contains 'new-array' or childlink.handle contains 'new-arrival' or childlink.url contains 'new-array' or childlink.url contains 'new-arrival' or childlink.title contains 'New Arrival' or childlink.title contains 'New arrival' or childlink.handle contains 'best-seller' or childlink.handle contains 'bestseller' or childlink.url contains 'best-seller' or childlink.title contains 'Best Seller' or childlink.title contains 'Best seller' -%}
                          {%- continue -%}
                        {%- endif -%}
                      {%- endif -%}
                      <li class="lh-drawer-subitem"><a href="{{ childlink.url }}" class="lh-drawer-sublink">{{ childlink.title }}</a></li>
                    {%- endfor -%}
                  {%- else -%}
                    {%- for col in collections -%}
                      {%- if col.handle == 'frontpage' or col.handle == 'all' -%}{%- continue -%}{%- endif -%}
                      {%- if is_drawer_accessories -%}
                        {%- if col.handle == 'mahjong-set' or col.title contains 'Mahjong' or col.handle contains 'new-array' or col.handle contains 'new-arrival' or col.title contains 'New Arrival' or col.title contains 'New arrival' or col.handle contains 'best-seller' or col.handle contains 'bestseller' or col.title contains 'Best Seller' or col.title contains 'Best seller' -%}
                          {%- continue -%}
                        {%- endif -%}
                      {%- endif -%}
                      <li class="lh-drawer-subitem"><a href="{{ col.url }}" class="lh-drawer-sublink">{{ col.title }}</a></li>
                    {%- endfor -%}
                  {%- endif -%}
                </ul>
              </li>
            {%- elsif link.links != blank -%}
              <li class="lh-drawer-item has-submenu has-dropdown">
                <div class="lh-drawer-parent-row">
                  <a href="{{ link.url }}" class="lh-drawer-link">{{ link.title }}</a>
                  <button type="button" class="lh-drawer-sub-toggle" aria-expanded="false" aria-label="Toggle {{ link.title }}">
                    <svg width="8" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </button>
                </div>
                <ul class="lh-drawer-sublist" hidden>
                  {%- for childlink in link.links -%}
                    <li class="lh-drawer-subitem{% if childlink.links != blank %} has-submenu has-dropdown{% endif %}">
                      {%- if childlink.links != blank -%}
                        <div class="lh-drawer-parent-row">
                          <a href="{{ childlink.url }}" class="lh-drawer-sublink">{{ childlink.title }}</a>
                          <button type="button" class="lh-drawer-sub-toggle" aria-expanded="false" aria-label="Toggle {{ childlink.title }}">
                            <svg width="7" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                          </button>
                        </div>
                        <ul class="lh-drawer-sublist lh-drawer-sublist-level3" hidden style="margin-left: 12px; padding-left: 10px; border-left: 1px solid rgba(255, 255, 255, 0.15);">
                          {%- for grandchildlink in childlink.links -%}
                            <li class="lh-drawer-subitem">
                              <a href="{{ grandchildlink.url }}" class="lh-drawer-sublink" style="font-size: 11.5px; opacity: 0.8;">{{ grandchildlink.title }}</a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- else -%}
                        <a href="{{ childlink.url }}" class="lh-drawer-sublink">{{ childlink.title }}</a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </li>
            {%- else -%}
              <li class="lh-drawer-item">
                <a href="{{ link.url }}" class="lh-drawer-link">{{ link.title }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <li class="lh-drawer-item has-submenu has-dropdown">
            <div class="lh-drawer-parent-row">
