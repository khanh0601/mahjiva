                  {%- if col.handle == 'mahjong-set' or col.title contains 'Mahjong' or col.handle contains 'new-array' or col.handle contains 'new-arrival' or col.title contains 'New Arrival' or col.title contains 'New arrival' or col.handle contains 'best-seller' or col.handle contains 'bestseller' or col.title contains 'Best Seller' or col.title contains 'Best seller' -%}
