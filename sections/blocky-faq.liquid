  Unauthorized copying, distribution, or reproduction in any form will result in legal action.
{% endcomment %}

{% style %}
#blocky-faq-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.background_color }};
}
#blocky-faq-{{ section.id }} .blocky-page-width {
  max-width: {{ section.settings.page_width }}px;
  margin-left: auto;
  margin-right: auto;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
  width: 100%;
  box-sizing: border-box;
}
#blocky-faq-{{ section.id }} .blocky-flex-container {
  display: flex;
}
#blocky-faq-{{ section.id }} .blocky-faq-table-under {
  display: flex;
  flex-direction: column-reverse;
  align-items: center;
  gap: 2.5rem;
  width: 100%;
}
#blocky-faq-{{ section.id }} .blocky-faq-table-under > * {
  width: 100% !important;
  max-width: 100%;
}
#blocky-faq-{{ section.id }} .blocky-title {
  font-family: var(--font-heading-family, serif);
  font-size: {{ section.settings.title_size | default: 42 }}px;
  color: {{ section.settings.title_color }};
  text-align: {{ section.settings.desktop_content_alignment }};
  margin: 0;
  line-height: 1.25;
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
#blocky-faq-{{ section.id }} .blocky-button,
.blocky-faq .blocky-button {
  background-color: #163327 !important;
  color: #ffffff !important;
  border: 1px solid #163327 !important;
  box-shadow: 0 2px 6px rgba(22, 51, 39, 0.15);
  font-weight: 600;
  letter-spacing: 1.5px;
}
#blocky-faq-{{ section.id }} .blocky-button *,
.blocky-faq .blocky-button * {
  color: #ffffff !important;
}
#blocky-faq-{{ section.id }} .blocky-button:hover,
.blocky-faq .blocky-button:hover {
  background-color: #1f4534 !important;
  color: #ffffff !important;
  border-color: #1f4534 !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 4px 14px rgba(22, 51, 39, 0.28) !important;
}
#blocky-faq-{{ section.id }} .blocky-button:hover *,
.blocky-faq .blocky-button:hover * {
  color: #ffffff !important;
}
#blocky-faq-{{ section.id }} .blocky-media-text-container {
  width: 100%;
  text-align: {{ section.settings.desktop_content_alignment }};
}
#blocky-faq-{{ section.id }} .bky-accordion-carot {
  color: var(--icon-color, #7F5260);
  flex-shrink: 0;
  margin-left: 1rem;
}
#blocky-faq-{{ section.id }} .blocky-faq-item {
  border-radius: var(--faq-border-radius);
  overflow: hidden;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
#blocky-faq-{{ section.id }} .blocky-faq-item:hover {
  border-color: #d8d0c7;
}
#blocky-faq-{{ section.id }} .blocky-faq-question {
  border-radius: var(--faq-border-radius);
  transition: background-color 0.15s ease;
}
#blocky-faq-{{ section.id }} .blocky-faq-question:hover {
  background-color: rgba(0, 0, 0, 0.015);
  opacity: 1;
}
#blocky-faq-{{ section.id }} .blocky-faq-question.active {
  border-radius: var(--faq-border-radius) var(--faq-border-radius) 0px 0px;
}
#blocky-faq-{{ section.id }} .blocky-faq-answer {
  border-radius: 0px 0px var(--faq-border-radius) var(--faq-border-radius);
}
#blocky-faq-{{ section.id }} .blocky-faq-question-text {
  font-family: var(--font-body-family, sans-serif);
  font-size: {{ section.settings.question_font_size | default: 17 }}px;
  font-weight: 500;
  color: {{ section.settings.question_text_color }};
  letter-spacing: 0.01em;
}
#blocky-faq-{{ section.id }} .blocky-faq-question-text span {
  font-weight: 500;
}
@media screen and (max-width: 749px) {
  #blocky-faq-{{ section.id }} {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }
  #blocky-faq-{{ section.id }} .blocky-title {
    font-size: calc({{ section.settings.title_size }}px * 0.85);
    text-align: {{ section.settings.mobile_content_alignment }};
  }
  #blocky-faq-{{ section.id }} .blocky-media-text-container {
    text-align: {{ section.settings.mobile_content_alignment }};
  }
}

.blocky-faq-text-align-top {
  align-self: flex-start;
}
.blocky-faq-text-align-middle {
  align-self: center;
}
.blocky-faq-text-align-bottom {
  align-self: flex-end;
}
@media screen and (max-width: 749px) {
  .blocky-faq-flex {
    flex-direction: column-reverse !important;
    row-gap: 3rem !important;
  }
  .blocky-faq-flex > * {
    width: 100% !important;
    flex-grow: 1 !important;
  }
}
@media screen and (min-width: 750px) {
  .blocky-faq-table-under {
    flex-direction: column-reverse;
    row-gap: 4rem !important;
  }
}
.blocky-faq-table-under > * {
  width: 100% !important;
  flex-grow: 1 !important;
}

@media screen and (min-width: 749px) {
  .blocky-faq-columns {
    display: flex;
    gap: 2rem;
  }
}

.blocky-faq-column {
  flex:1; 
  min-width:0;
}

.blocky-faq-question {
  border: none;
  width: 100%;
  padding: var(--question-padding);
  font-size: 16px;
  text-align: left;
  cursor: pointer;
  border-radius: 5px;
  transition: all .125s ease-in-out;
  font-size: calc(var(--question-font-size) * .85);
  color: var(--question-text-color);
  font-weight: 400 !important;
}
.blocky-faq-question.active {
  border-radius: 5px 5px 0px 0px;
}
.blocky-faq-question.active .bky-accordion-carot {
  transform: rotate(180deg);
}
.blocky-faq-question.active .bar-vertical {
  display: none;
}
.bky-accordion-carot {
  transition: transform .25s;
}
.blocky-faq-question:hover {
  opacity: 0.65;
}
.blocky-faq-question-text {
  display: flex; 
  align-items: center; 
  gap: .7rem;
  font-weight: 400 !important;
}
.blocky-faq-question-text span,
.blocky-faq-question-text strong,
.blocky-faq-question-text b {
  font-weight: 400 !important;
}
.blocky-faq-answer {
  overflow: hidden;
  border-radius: 0px 0px 5px 5px;
  transition: all 0.125s ease-in-out;
  padding: 0px var(--question-padding) 0px var(--question-padding);
  max-height: 0;
  font-size: calc(var(--answer-font-size) * .85);
  color: var(--answer-text-color);
}
.blocky-faq-answer.active {
  max-height: 1000px;
  padding: var(--question-padding);
  padding-top: 0px;
}
.blocky-faq-icon {
  font-size: calc(var(--question-font-size)) !important;
  height: calc(var(--question-font-size));
  width: calc(var(--question-font-size));          
}
@media screen and (min-width: 750px) {
  .blocky-faq-question {
    font-size: var(--question-font-size);
  }
  .blocky-faq-answer {
    font-size: var(--answer-font-size);
  }
  .blocky-faq-icon {
    font-size: calc(var(--question-font-size) * 1.2) !important;
    height: calc(var(--question-font-size) * 1.2);
    width: calc(var(--question-font-size) * 1.2);
  }
}
.blocky-accordion {
  height: fit-content;
}
.blocky-accordion-row .blocky-faq-item {
  margin-bottom: 1rem;  
}
.blocky-accordion-none .blocky-faq-question {
  background-color: unset;
}
.blocky-accordion-border .blocky-faq-question,
.blocky-accordion-none .blocky-faq-question {
  background-color: unset;
}
.blocky-accordion-border .blocky-accordion-btn,
.blocky-accordion-none .blocky-accordion-btn,
.blocky-accordion-border .blocky-faq-answer,
.blocky-accordion-none .blocky-faq-answer {
  padding-right: 0px !important;
  padding-left: 0px !important;
}
.blocky-accordion-border .blocky-faq-item {
  border-top: solid 1px var(--question-text-color);
}
.blocky-accordion-border .blocky-faq-item:first-of-type {
  border-top: none;
}
.blocky-accordion-border .blocky-faq-item:last-of-type {
  border-bottom: none;
}
.blocky-accordion-section,
.blocky-accordion-row .blocky-faq-item {
  border: 1px solid var(--faq-border-color);
}
#blocky-faq-{{ section.id }} .blocky-accordion-section,
#blocky-faq-{{ section.id }} .blocky-accordion-row .blocky-faq-item {
  box-shadow: {% if section.settings.show_container_shadow %}rgba(0, 0, 0, 0.24) 0px 1px 4px, rgba(0, 0, 0, 0.16) 0px 3px 8px{% else %}none{% endif %};
}
.blocky-accordion-row .blocky-faq-item,
.blocky-accordion-row .blocky-faq-question,
.blocky-accordion-section,
.blocky-accordion-section .blocky-faq-question {
  background-color: var(--faq-background);     
  border-radius: var(--faq-border-radius);
}

.blocky-faq .blocky-flex-container > .blocky-flex-child-small,
.blocky-faq .blocky-flex-child-large + .blocky-flex-child {
  width: 40%;
}
@media screen and (min-width: 750px) {
  .blocky-faq .blocky-flex-child-extra-large + .blocky-flex-child {
    width: 25%;
    flex-grow: 0;
  }
}
{% endstyle %}

<script src="{{ 'blocky-accordion.js' | asset_url }}" defer></script>

<div
  id="blocky-faq-{{ section.id }}"
  class="blocky blocky-padding background-wrapper blocky-faq"
  style="--padding-top: {{ section.settings.padding_top }}; --padding-bottom: {{ section.settings.padding_bottom }}; --background-color: {{ section.settings.background_color }}; --section-page-width: {{ section.settings.page_width | divided_by: 10 }}rem; --text-container-gap: {{ section.settings.text_container_gap }};
    --faq-background: {{ section.settings.faq_container_background }}; --question-padding: {{ section.settings.question_padding }}px; --faq-border-radius: {{ section.settings.faq_border_radius }}px;
    --question-font-size: {{ section.settings.question_font_size }}px; --answer-font-size: {{ section.settings.answer_font_size }}px; --question-text-color: {{ section.settings.question_text_color }};
    --answer-text-color: {{ section.settings.answer_text_color }};
    --faq-border-color: {{ section.settings.faq_container_border_color }};
  "
>
  <div class="blocky-page-width">
    {%- liquid
      assign is_product_page = false
      if request.page_type == 'product' or template.name == 'product'
        if product != blank
          assign is_product_page = true
        endif
      endif

      assign is_collection_page = false
      if collection != blank or template.name == 'collection'
        assign is_collection_page = true
      endif

      assign target_cat = ''
      assign target_label = ''

      if is_product_page and product
        assign cat_name = ''
        if product.category and product.category.name
          assign cat_name = product.category.name | downcase
        endif
        assign p_type = product.type | downcase
        assign p_handle = product.handle | downcase
        assign p_title = product.title | downcase
        
        assign tag_str = ''
        for t in product.tags
          assign t_down = t | downcase
          assign tag_str = tag_str | append: ' ' | append: t_down
        endfor

        assign coll_str = ''
        for c in product.collections
          assign c_h = c.handle | downcase
          assign c_t = c.title | downcase
          assign coll_str = coll_str | append: ' ' | append: c_h | append: ' ' | append: c_t
        endfor

        if p_type contains 'bag' or cat_name contains 'bag' or coll_str contains 'bag' or p_handle contains 'bag' or p_title contains 'bag' or tag_str contains 'bag' or p_type contains 'túi' or p_title contains 'túi' or coll_str contains 'tui'
          assign target_cat = 'bags'
          assign target_label = 'Tile Carrying Bags'
        elsif p_type contains 'mat' or cat_name contains 'mat' or coll_str contains 'mat' or p_handle contains 'mat' or p_title contains 'mat' or tag_str contains 'mat' or p_type contains 'thảm' or p_title contains 'thảm' or coll_str contains 'tham'
          assign target_cat = 'mats'
          assign target_label = 'Table Playing Mats'
        elsif p_type contains 'rack' or cat_name contains 'rack' or coll_str contains 'rack' or p_handle contains 'rack' or p_title contains 'rack' or tag_str contains 'rack' or p_type contains 'khay' or p_title contains 'khay'
          assign target_cat = 'racks'
          assign target_label = 'Mahjong Racks & Pushers'
        elsif p_type contains 'dice' or cat_name contains 'dice' or coll_str contains 'dice' or p_handle contains 'dice' or p_title contains 'dice' or tag_str contains 'dice' or p_type contains 'xúc xắc' or p_title contains 'xúc xắc' or coll_str contains 'xuc-xac'
          assign target_cat = 'dices'
          assign target_label = 'Artisanal Dice Sets'
        elsif p_type contains 'tile' or cat_name contains 'tile' or coll_str contains 'tile' or p_handle contains 'tile' or p_title contains 'tile' or tag_str contains 'tile' or p_type contains 'set' or coll_str contains 'set' or p_title contains 'set' or p_handle contains 'set' or p_type contains 'quân' or p_title contains 'quân'
          assign target_cat = 'tiles'
          assign target_label = 'American Mahjong Sets'
        else
          assign target_cat = ''
          assign target_label = ''
        endif
      endif
    -%}
        <div class="blocky-flex-container blocky-flex-{{ section.settings.layout }}{% if section.settings.layout == 'under-text' %} blocky-faq-table-under{% endif %} blocky-faq-flex">
      <div class="blocky-flex-child blocky-flex-child-{{ section.settings.desktop_faq_width }} blocky-justify-center">
        <blocky-accordion class="blocky-accordion blocky-w-full blocky-accordion-{{ section.settings.faq_layout }}">
          {% if section.settings.layout == 'under-text' and section.settings.columns > 1 %}
            <div class="blocky-faq-columns">
              {% assign questions = section.blocks | where: "type", "question" %}

              {% assign col_count = section.settings.columns | default: 1 %}
              {% assign total = questions.size %}

              {% assign base = total | divided_by: col_count %}
              {% assign extra = total | modulo: col_count %}

              {% assign current_index = 0 %}

              {% for col in (1..col_count) %}
                {% if col <= extra %}
                  {% assign items_in_col = base | plus: 1 %}
                {% else %}
                  {% assign items_in_col = base %}
                {% endif %}

                <div class="blocky-faq-column">
                  {% assign last_index_for_col = current_index | plus: items_in_col | minus: 1 %}

                  {% for i in (current_index..last_index_for_col) %}
                    {% assign block = questions[i] %}
                    {% if block %}
                      <div class="blocky-faq-item blocky-overflow-hidden" {{ block.shopify_attributes }} style="--icon-color: {{ block.settings.icon_color }};">
                        <button class="blocky-accordion-btn blocky-faq-question{% if block.settings.default_open %} active{% endif %}">
                          <div class="blocky-faq-question-text" {% if section.settings.chevron_position == 'end' %}style="justify-content: space-between;"{% endif %}>
                            {% if section.settings.chevron_position == 'front' %}
                              {% if section.settings.chevron_style == 'plusminus' %}
                                  <svg class="bky-accordion-carot" height="16" width="16" viewBox="0 0 16 16">
                                    <rect x="3" y="7" width="10" height="2" fill="currentColor"/>
                                    <rect class="bar-vertical" x="7" y="3" width="2" height="10" fill="currentColor"/>
                                  </svg>
                              {% else %}
                                <svg class="bky-accordion-carot" height="16" width="16" viewBox="0 0 10 6"><path fill="currentColor" fill-rule="evenodd" d="M9.354.646a.5.5 0 0 0-.708 0L5 4.293 1.354.646a.5.5 0 0 0-.708.708l4 4a.5.5 0 0 0 .708 0l4-4a.5.5 0 0 0 0-.708" clip-rule="evenodd"/></svg>
                              {% endif %}
                            {% endif %}
                            <div class="blocky-faq-question-text">
                              {% if block.settings.image != null %}
                                <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.question }}" class="blocky-faq-icon" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
                              {% elsif block.settings.icon_code != blank %}
                                <span class="material-icons material-symbols-outlined blocky-icon blocky-faq-icon"> {{ block.settings.icon_code }} </span>
                              {% endif %}
                              <span>{{ block.settings.question | replace: '<strong>', '' | replace: '</strong>', '' | replace: '<b>', '' | replace: '</b>', '' }}</span>
                            </div>
                            {% if section.settings.chevron_position != 'front' %}
                              {% if section.settings.chevron_style == 'plusminus' %}
                                  <svg class="bky-accordion-carot" height="16" width="16" viewBox="0 0 16 16">
                                    <rect x="3" y="7" width="10" height="2" fill="currentColor"/>
                                    <rect class="bar-vertical" x="7" y="3" width="2" height="10" fill="currentColor"/>
                                  </svg>
                              {% else %}
                                <svg class="bky-accordion-carot" height="16" width="16" viewBox="0 0 10 6"><path fill="currentColor" fill-rule="evenodd" d="M9.354.646a.5.5 0 0 0-.708 0L5 4.293 1.354.646a.5.5 0 0 0-.708.708l4 4a.5.5 0 0 0 .708 0l4-4a.5.5 0 0 0 0-.708" clip-rule="evenodd"/></svg>
                              {% endif %}
                            {% endif %}
                          </div>
                        </button>
                        <div class="blocky-faq-answer{% if block.settings.default_open %} active{% endif %}">
                          {{ block.settings.content }}
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}
                  {% assign current_index = last_index_for_col | plus: 1 %}
                </div>
              {% endfor %}
            </div>
          {% else %}
            {%- if target_cat != blank -%}
                          {%- case target_cat -%}
              {%- when 'tiles' -%}
                {%- assign faq_sec_title = "A FEW THINGS BEFORE YOU PURCHASE" -%}
                {%- assign q1 = "1. Are Mahjiva sets ready for American Mahjong?" -%}
                {%- assign a1 = "<p>Yes! Every Mahjiva tile set is NMJL-ready for American Mahjong. For the exact tile count and configuration, check the Details section of your chosen set.</p>" -%}
                {%- assign q2 = "2. What’s included with my set?" -%}
                {%- assign a2 = "<p>Each product page lists the tiles and accessories included with your purchase. Mats, racks, bags, and dice featured in lifestyle photos are included only when specifically listed.</p>" -%}
                {%- assign q3 = "3. Is the artwork engraved or printed?" -%}
                {%- assign a3 = "<p>Most Mahjiva sets feature hand-engraved artwork, while select designs use high-quality printing. We stand behind the colorfast finish of both—our tile artwork is guaranteed not to fade. Check your chosen set’s description for its specific finish.</p>" -%}
                {%- assign q4 = "4. Will the colors look exactly like the photos?" -%}
                {%- assign a4 = "<p>Colors may appear slightly lighter or darker in person due to lighting, photography, and screen settings. These subtle differences are normal and don’t indicate fading or a product defect.</p>" -%}
                {%- assign q5 = "5. When will my order arrive, and what if something isn’t right?" -%}
                {%- assign a5 = "<p>All orders arrive within 1–2 weeks. If your order arrives damaged, incorrect, or has another issue, please contact us with your order number and photos. We offer returns and exchanges within 30 days of delivery.</p>" -%}
              {%- when 'bags' -%}
                {%- assign faq_sec_title = "A FEW THINGS BEFORE YOU PURCHASE" -%}
                {%- assign q1 = "1. How do I know if my tiles will fit?" -%}
                {%- assign a1 = "<p>Compare your tile set’s measurements with the dimensions and capacity listed on the product page. If you’re unsure, send us your tile size and the bag you’re considering—we’re happy to help.</p>" -%}
                {%- assign q2 = "2. Are tiles or accessories included with the bag?" -%}
                {%- assign a2 = "<p>Check the product description for exactly what’s included. Tiles, racks, dice, and other accessories shown in styled photos are included only when specifically listed.</p>" -%}
                {%- assign q3 = "3. How should I clean my tile bag?" -%}
                {%- assign a3 = "<p>For light cleaning, gently wipe with a soft, slightly damp cloth and let it air-dry before storing. Avoid soaking or harsh cleaners, and follow any care instructions provided for your chosen style.</p>" -%}
                {%- assign q4 = "4. When will my order arrive?" -%}
                {%- assign a4 = "<p>Orders arrive within 1–2 weeks. If you’re shopping for a gift or an upcoming gathering, contact us before ordering if you need help with timing.</p>" -%}
                {%- assign q5 = "5. What if my bag arrives damaged or incorrect?" -%}
                {%- assign a5 = "<p>Contact us with your order number and clear photos so we can help resolve the issue. We offer returns and exchanges within 30 days of delivery.</p>" -%}
              {%- when 'mats' -%}
                {%- assign faq_sec_title = "A FEW THINGS BEFORE YOU PURCHASE" -%}
                {%- assign q1 = "1. Can I use a Mahjiva mat for American Mahjong?" -%}
                {%- assign a1 = "<p>Yes! Our mats are designed for your Mahjong table and can be paired with your American Mahjong tiles and racks. Check each design’s photos to see its layout and any printed playing guides.</p>" -%}
                {%- assign q2 = "2. How do I know if the mat will fit my table?" -%}
                {%- assign a2 = "<p>Our current mats measure approximately 31.5 × 31.5 inches (80 × 80 cm). Measure your tabletop before ordering to make sure the mat can lie flat, with room for your preferred playing setup.</p>" -%}
                {%- assign q3 = "3. How should I clean my mat?" -%}
                {%- assign a3 = "<p>For light cleaning, gently wipe the water-resistant surface with a soft, damp cloth. Let your mat air-dry completely before storing, and avoid harsh cleaners or abrasive scrubbing.</p>" -%}
                {%- assign q4 = "4. Can you help me coordinate a mat with my tiles?" -%}
                {%- assign a4 = "<p>Absolutely. Choose a design that complements your tiles’ colors, or mix patterns for a more personal look. If you’re deciding between styles, contact us—we’re happy to help you put your table together.</p>" -%}
                {%- assign q5 = "5. When will my mat arrive, and what if there’s an issue?" -%}
                {%- assign a5 = "<p>Orders arrive within 1–2 weeks. We offer returns and exchanges within 30 days of delivery. If your mat arrives damaged or incorrect, contact us with your order number and clear photos so we can help.</p>" -%}
              {%- when 'racks' -%}
                {%- assign faq_sec_title = "A FEW THINGS BEFORE YOU PURCHASE" -%}
                {%- assign q1 = "1. Will the racks fit my tiles?" -%}
                {%- assign a1 = "<p>Check the rack dimensions on the product page against your tiles and playing row. If you’re unsure, send us your tile measurements—we’re happy to help.</p>" -%}
                {%- assign q2 = "2. What does a pusher do?" -%}
                {%- assign a2 = "<p>A pusher helps move your tile wall into position in one smooth motion. Your chosen product’s description explains whether pushers are included and how they attach.</p>" -%}
                {%- assign q3 = "3. What’s included in the set?" -%}
                {%- assign a3 = "<p>Each product page lists the number of racks and any included accessories. Tiles, mats, and other items shown in styled photos are included only when specifically listed.</p>" -%}
                {%- assign q4 = "4. When will my order arrive?" -%}
                {%- assign a4 = "<p>Orders arrive within 1–2 weeks. Shopping for a gift or an upcoming game night? Contact us before ordering if you need help with timing.</p>" -%}
                {%- assign q5 = "5. What if something arrives damaged or incorrect?" -%}
                {%- assign a5 = "<p>Contact us with your order number and clear photos so we can help resolve the issue. We offer returns and exchanges within 30 days of delivery.</p>" -%}
