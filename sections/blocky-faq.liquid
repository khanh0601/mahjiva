{%- assign faq_schema_blocks = section.blocks | where: 'type', 'question' -%}
{%- if faq_schema_blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in faq_schema_blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | strip_newlines | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.content | strip_html | strip_newlines | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

