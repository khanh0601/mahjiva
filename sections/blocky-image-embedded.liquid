{%- comment -%}
  Copyright BlockyApps. Enhanced with Hero Banner Slideshow capability.
{% endcomment %}
{%- assign slide_blocks = section.blocks | where: 'type', 'slide' -%}
<div 
  class="blocky blocky-padding background-wrapper"
  style="--padding-top: {{ section.settings.padding_top }}; --padding-bottom: {{ section.settings.padding_bottom }}; --overlay_opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --section-page-width: {{ section.settings.page_width | divided_by: 10 }}rem; --border-radius: {{ section.settings.border_radius }}px; --background-color: {{ section.settings.background_color }};"
>
  <div {% if section.settings.full_screen == false %}class="blocky-page-width blocky-media-hero-window"{% endif %}>
    <div class="blocky-media-hero blocky-media-hero-{{ section.settings.section_height }} blocky-media-hero-mobile-{{ section.settings.mobile_height }}" >
      <div class="blocky-media-hero-container" style="{% if section.settings.show_border == true %}border: 1px solid {{ section.settings.border_color }};{% endif %}">
        {% if slide_blocks.size > 0 %}
          <div class="hero-slider-track" id="HeroSliderTrack-{{ section.id }}" data-autoplay="{{ section.settings.auto_rotate | default: true }}" data-speed="{{ section.settings.slide_duration | default: 5000 }}">
            {% for block in slide_blocks %}
              <div class="hero-slide-item{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" class="hero-slide-link" aria-label="Banner Link">
                {% endif %}

                {% if block.settings.image != blank or block.settings.image_mobile != blank %}
                  {% if block.settings.image_mobile != blank %}
                    <picture class="hero-slide-picture">
                      <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 1200 }}">
                      {% if block.settings.image != blank %}
                        <source media="(min-width: 750px)" srcset="{{ block.settings.image | image_url: width: 2560 }}">
                        <img
                          class="blocky-image-hero-img blocky-image-{{ section.settings.image_fit }}"
                          src="{{ block.settings.image | image_url: width: 2560 }}"
                          alt="{{ block.settings.image.alt | default: 'Banner' | escape }}"
                          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        />
                      {% else %}
                        <img
                          class="blocky-image-hero-img blocky-image-{{ section.settings.image_fit }}"
                          src="{{ block.settings.image_mobile | image_url: width: 1200 }}"
                          alt="{{ block.settings.image_mobile.alt | default: 'Banner' | escape }}"
                          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        />
                      {% endif %}
                    </picture>
                  {% elsif block.settings.image != blank %}
                    <img
                      class="blocky-image-hero-img blocky-image-{{ section.settings.image_fit }}"
                      src="{{ block.settings.image | image_url: width: 2560 }}"
                      alt="{{ block.settings.image.alt | default: 'Banner' | escape }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    />
                  {% endif %}
                {% else %}
                  <div class="hero-slide-placeholder">
                    <p class="hero-slide-placeholder-title">No Banner Artwork Selected</p>
                    <p class="hero-slide-placeholder-sub">Please upload real imagery in the Theme Customizer</p>
                  </div>
                {% endif %}

                {% if block.settings.link != blank %}
                  </a>
                {% endif %}
              </div>
            {% endfor %}
          </div>

          {% if slide_blocks.size > 1 %}
            <!-- Slide Navigation Controls -->
            <button class="hero-slider-btn hero-slider-prev" aria-label="Previous Slide" onclick="heroSlidePrev('{{ section.id }}')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button class="hero-slider-btn hero-slider-next" aria-label="Next Slide" onclick="heroSlideNext('{{ section.id }}')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>

            <!-- Slide Dots -->
            <div class="hero-slider-dots">
              {% for block in slide_blocks %}
                <button class="hero-slider-dot{% if forloop.first %} is-active{% endif %}" aria-label="Go to slide {{ forloop.index }}" onclick="heroSlideGoTo('{{ section.id }}', {{ forloop.index0 }})"></button>
              {% endfor %}
            </div>
          {% endif %}

        {% elsif section.settings.image %}
          <img
            class="blocky-image-hero-img blocky-image-{{ section.settings.image_fit }}"
            src="{{ section.settings.image | image_url: width: 2560 }}"
            alt="{{ section.settings.image.alt | default: 'Banner' | escape }}"
          />
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
        {% endif %}
      </div>
  
      <div class="blocky-media-hero-text-wrap{% if section.settings.overlay_opacity != 0 %} blocky-media-hero-text-wrap-opacity{% endif %}"> 
        <div class="blocky-page-width blocky-media-hero-text-content {{ section.settings.text_align }}">
          {%- for block in section.blocks -%}
            {% case block.type %}
              {%- when 'title' -%}
                {% render 'blocky-titlel', block: block %}
              {%- when 'body' -%}
                {% render 'blocky-bodyl', block: block %}
              {%- when 'button' -%}
                {%- if block.settings.button_label != blank -%}
                  <div>
                    {% render 'blocky-buttonl', block:block %}
                  </div>
                {%- endif -%}
              {%- when 'review-stars' -%}
                {% render 'blocky-review-starsl', block: block %}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const track = document.getElementById('HeroSliderTrack-' + sectionId);
    if (!track) return;

    let currentIndex = 0;
    const slides = track.querySelectorAll('.hero-slide-item');
    const dots = track.parentElement.querySelectorAll('.hero-slider-dot');
    const total = slides.length;
    if (total <= 1) return;

    let timer = null;
    const intervalTime = parseInt(track.getAttribute('data-speed'), 10) || 5000;
    const isAutoplay = track.getAttribute('data-autoplay') === 'true';

    window.heroSlideGoTo = function(id, index) {
      if (id !== sectionId) return;
      slides[currentIndex].classList.remove('is-active');
      if (dots[currentIndex]) dots[currentIndex].classList.remove('is-active');

      currentIndex = (index + total) % total;

      slides[currentIndex].classList.add('is-active');
      if (dots[currentIndex]) dots[currentIndex].classList.add('is-active');
      restartTimer();
    };

    window.heroSlideNext = function(id) {
      if (id !== sectionId) return;
      window.heroSlideGoTo(id, currentIndex + 1);
    };

    window.heroSlidePrev = function(id) {
      if (id !== sectionId) return;
      window.heroSlideGoTo(id, currentIndex - 1);
    };

    function startTimer() {
      if (!isAutoplay) return;
      stopTimer();
      timer = setInterval(() => {
        window.heroSlideNext(sectionId);
      }, intervalTime);
    }

    function stopTimer() {
      if (timer) clearInterval(timer);
    }

    function restartTimer() {
      stopTimer();
      startTimer();
    }

    track.parentElement.addEventListener('mouseenter', stopTimer);
    track.parentElement.addEventListener('mouseleave', startTimer);

    startTimer();
  })();
</script>

