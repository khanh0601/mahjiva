{%- assign is_about_path = false -%}
{%- assign check_url = canonical_url | downcase -%}
{%- assign check_path = request.path | downcase -%}
{%- if check_url contains 'about' or check_url contains 'story' or check_path contains 'about' or check_path contains 'story' -%}
  {%- assign is_about_path = true -%}
{%- endif -%}

{%- if is_about_path -%}
  {% render 'luxury-about-content' %}
{%- else -%}
  <div id="Mahjiva404ClientWrapper">
    <style type="text/css">
      .template-404 .title + * {
        margin-top: 1rem;
      }

      @media screen and (min-width: 750px) {
        .template-404 .title + * {
          margin-top: 2rem;
        }
      }
    </style>

    <div class="template-404 page-width page-margin center">
      <p>
        {{ 'templates.404.subtext' | t }}
      </p>
      <h1 class="title">
        {{ 'templates.404.title' | t }}
      </h1>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'general.continue_shopping' | t }}
      </a>
    </div>
  </div>

  <div id="Mahjiva404AboutFallback" style="display: none;">
    {% render 'luxury-about-content' %}
  </div>

  <script>
    (function() {
      if (window.location.pathname && (window.location.pathname.toLowerCase().includes('about') || window.location.pathname.toLowerCase().includes('story'))) {
        var default404 = document.getElementById('Mahjiva404ClientWrapper');
        var aboutFallback = document.getElementById('Mahjiva404AboutFallback');
        if (default404) default404.remove();
        if (aboutFallback) aboutFallback.style.display = 'block';
        document.title = 'About Us · A Place At The Table | Mahjiva';
      }
    })();
  </script>
{%- endif -%}
