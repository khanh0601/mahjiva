{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- if page.handle == 'refund-policy' or page.handle contains 'refund' or page.handle contains 'return' -%}
  <script>window.location.replace('/policies/refund-policy');</script>
  <meta http-equiv="refresh" content="0;url=/policies/refund-policy">
  <div style="padding: 60px 20px; text-align: center; font-family: sans-serif;">
    <p>Redirecting to <a href="/policies/refund-policy">Refund Policy</a>...</p>
  </div>
  {%- style -%}
    .page-width--narrow, .main-page-title, .page-title { display: none !important; }
  {%- endstyle -%}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if page.handle == 'about-us' or page.handle == 'about' or page.handle == 'our-story' -%}
  <div class="page-width page-width--about section-{{ section.id }}-padding">
    {%- if page.content != blank and page.content contains 'mj-about' -%}
      <div class="rte">
        {{ page.content }}
      </div>
    {%- else -%}
      {% render 'luxury-about-content' %}
    {%- endif -%}
  </div>
{%- else -%}
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ page.title | escape }}
    </h1>
    <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ page.content }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
