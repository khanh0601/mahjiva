{% stylesheet %}
  .blocky-multiimage-timeline {
    overflow: hidden;
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__inner {
    display: grid;
    grid-template-columns: minmax(0, var(--mit-media-width)) minmax(0, 1fr);
    gap: 42px;
    align-items: center;
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__media {
    min-width: 0;
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--mit-image-gap);
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: var(--mit-image-border-width) solid var(--mit-image-border-color);
    border-radius: var(--mit-image-radius);
    overflow: hidden;
    box-sizing: border-box;
    box-shadow: var(--mit-image-shadow);
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__image-wrap--1 {
    border-radius: var(--mit-image-radius) var(--mit-image-radius) 0 var(--mit-image-radius);
    width: 95%;
    justify-self: end;
    align-self: end;
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__image-wrap--2 {
    border-radius: var(--mit-image-radius) var(--mit-image-radius) var(--mit-image-radius) 0;
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__image-wrap--3 {
    border-radius: var(--mit-image-radius) 0 var(--mit-image-radius) var(--mit-image-radius);
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__image-wrap--4 {
    border-radius: 0 var(--mit-image-radius) var(--mit-image-radius) var(--mit-image-radius);
    width: 95%;
    justify-self: start;
    align-self: start;
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__image-inner {
    position: absolute;
    inset: 0;
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__image,
  .blocky-multiimage-timeline .blocky-multiimage-timeline__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: var(--mit-image-fit);
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__placeholder {
    background: #f2f2f2;
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__title {
    margin: 0 0 14px;
    color: var(--mit-title-color);
    font-size: var(--mit-title-size);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-align: var(--mit-text-align);
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__subtitle {
    margin: 0 0 24px;
    color: var(--mit-subtitle-color);
    font-size: var(--mit-subtitle-size);
    line-height: 1.4;
    font-weight: 400;
    text-align: var(--mit-text-align);
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__steps {
    display: grid;
    gap: 26px;
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__step-badge {
    width: var(--mit-step-circle-size);
    height: var(--mit-step-circle-size);
    border-radius: 999px;
    border: var(--mit-step-circle-border-width) solid var(--mit-step-circle-color);
    color: var(--mit-step-circle-color);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    margin-top: 1px;
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__step-number {
    font-size: var(--mit-step-number-size);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--mit-step-circle-color);
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__step-copy {
    min-width: 0;
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__step-title {
    margin: 0 0 4px;
    color: var(--mit-step-title-color);
    font-size: var(--mit-step-title-size);
    line-height: 1.22;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__step-title p {
    margin: 0;
  }

  .blocky-multiimage-timeline .blocky-multiimage-timeline__step-description {
    color: var(--mit-step-desc-color);
    font-size: var(--mit-step-desc-size);
    line-height: 1.42;
    font-weight: 400;
  }

  @media screen and (max-width: 989px) {
    .blocky-multiimage-timeline .blocky-multiimage-timeline__inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media screen and (max-width: 749px) {
    .blocky-multiimage-timeline .blocky-multiimage-timeline__title,
    .blocky-multiimage-timeline .blocky-multiimage-timeline__subtitle {
      text-align: var(--mit-text-align-mobile);
    }

    .blocky-multiimage-timeline .blocky-multiimage-timeline__step {
      gap: 12px;
    }

    .blocky-multiimage-timeline .blocky-multiimage-timeline__step-badge {
      width: calc(var(--mit-step-circle-size) * 0.8);
      height: calc(var(--mit-step-circle-size) * 0.8);
    }
  }
{% endstylesheet %}

<div
  class="blocky blocky-multiimage-timeline blocky-padding background-wrapper"
  style="
    --padding-top: {{ section.settings.padding_top }};
    --padding-bottom: {{ section.settings.padding_bottom }};
    --background-color: {{ section.settings.background_color }};
    --section-page-width: {{ section.settings.page_width | divided_by: 10 }}rem;
    --mit-title-color: {{ section.settings.title_color }};
    --mit-title-size: {{ section.settings.title_size }}px;
    --mit-subtitle-color: {{ section.settings.subtitle_color }};
    --mit-subtitle-size: {{ section.settings.subtitle_size }}px;
    --mit-text-align: {{ section.settings.content_alignment }};
    --mit-text-align-mobile: {{ section.settings.mobile_content_alignment }};
    --mit-image-border-width: {{ section.settings.image_border_width }}px;
    --mit-image-border-color: {{ section.settings.image_border_color }};
    --mit-image-radius: {{ section.settings.image_radius }}px;
    --mit-image-gap: {{ section.settings.image_gap }}px;
    --mit-image-fit: {{ section.settings.image_fit }};
    --mit-media-width: {{ section.settings.media_width }}px;
    --mit-image-shadow: {% if section.settings.image_shadow_enabled %}0 2px 4px grey, 0 12px 24px rgba(0,0,0,0.08){% else %}none{% endif %};
    --mit-step-circle-size: {{ section.settings.step_circle_size }}px;
    --mit-step-circle-border-width: {{ section.settings.step_circle_border_width }}px;
    --mit-step-circle-color: {{ section.settings.step_circle_color }};
    --mit-step-number-size: {{ section.settings.step_number_size }}px;
    --mit-step-title-size: {{ section.settings.step_title_size }}px;
    --mit-step-title-color: {{ section.settings.step_title_color }};
    --mit-step-desc-size: {{ section.settings.step_desc_size }}px;
    --mit-step-desc-color: {{ section.settings.step_description_color }};
  "
>
  <div class="blocky-page-width">
    <div class="blocky-multiimage-timeline__inner">
      <div class="blocky-multiimage-timeline__media">
        <div class="blocky-multiimage-timeline__columns">
          <div class="blocky-multiimage-timeline__image-wrap blocky-multiimage-timeline__image-wrap--1">
            {% if section.settings.image_1 != blank %}
              <div class="blocky-multiimage-timeline__image-inner">
                <img
                  class="blocky-multiimage-timeline__image"
                  src="{{ section.settings.image_1 | image_url: width: 1200 }}"
                  alt="{{ section.settings.image_1.alt | escape }}"
                  loading="lazy"
                  width="{{ section.settings.image_1.width }}"
                  height="{{ section.settings.image_1.height }}"
                >
              </div>
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'blocky-multiimage-timeline__placeholder' }}
            {% endif %}
          </div>

          <div class="blocky-multiimage-timeline__image-wrap blocky-multiimage-timeline__image-wrap--2">
            {% if section.settings.image_2 != blank %}
              <div class="blocky-multiimage-timeline__image-inner">
                <img
                  class="blocky-multiimage-timeline__image"
                  src="{{ section.settings.image_2 | image_url: width: 1200 }}"
                  alt="{{ section.settings.image_2.alt | escape }}"
                  loading="lazy"
                  width="{{ section.settings.image_2.width }}"
                  height="{{ section.settings.image_2.height }}"
                >
              </div>
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'blocky-multiimage-timeline__placeholder' }}
            {% endif %}
          </div>

          <div class="blocky-multiimage-timeline__image-wrap blocky-multiimage-timeline__image-wrap--3">
            {% if section.settings.image_3 != blank %}
              <div class="blocky-multiimage-timeline__image-inner">
                <img
                  class="blocky-multiimage-timeline__image"
                  src="{{ section.settings.image_3 | image_url: width: 1200 }}"
                  alt="{{ section.settings.image_3.alt | escape }}"
                  loading="lazy"
                  width="{{ section.settings.image_3.width }}"
                  height="{{ section.settings.image_3.height }}"
                >
              </div>
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'blocky-multiimage-timeline__placeholder' }}
            {% endif %}
          </div>

          <div class="blocky-multiimage-timeline__image-wrap blocky-multiimage-timeline__image-wrap--4">
            {% if section.settings.image_4 != blank %}
              <div class="blocky-multiimage-timeline__image-inner">
                <img
                  class="blocky-multiimage-timeline__image"
                  src="{{ section.settings.image_4 | image_url: width: 1200 }}"
                  alt="{{ section.settings.image_4.alt | escape }}"
                  loading="lazy"
                  width="{{ section.settings.image_4.width }}"
                  height="{{ section.settings.image_4.height }}"
                >
              </div>
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'blocky-multiimage-timeline__placeholder' }}
            {% endif %}
          </div>
        </div>
      </div>

      <div class="blocky-multiimage-timeline__content">
        {% if section.settings.title != blank %}
          <h2 class="blocky-multiimage-timeline__title">{{ section.settings.title }}</h2>
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <div class="blocky-multiimage-timeline__subtitle">{{ section.settings.subtitle }}</div>
        {% endif %}

        <div class="blocky-multiimage-timeline__steps">
          {% for block in section.blocks %}
            <div class="blocky-multiimage-timeline__step" {{ block.shopify_attributes }}>
              <div class="blocky-multiimage-timeline__step-badge" aria-hidden="true">
                <span class="blocky-multiimage-timeline__step-number">{{ block.settings.step_number }}</span>
              </div>
              <div class="blocky-multiimage-timeline__step-copy">
                {% if block.settings.title != blank %}
                  <div class="blocky-multiimage-timeline__step-title">{{ block.settings.title }}</div>
                {% endif %}
                {% if block.settings.description != blank %}
                  <div class="blocky-multiimage-timeline__step-description">{{ block.settings.description }}</div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

