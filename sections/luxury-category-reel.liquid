<section id="LuxuryCategoryReel-{{ section.id }}" class="lcr-section" aria-label="{{ section.settings.heading | escape }}">
  <div class="lcr-container">

    <!-- 1. Header Cluster -->
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank -%}
      <div class="lcr-header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="lcr-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="lcr-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="lcr-description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- 2. Single-line Ribbon of Category Tabs -->
    {%- if section.blocks.size > 0 -%}
      <div class="lcr-tabs-wrapper">
        <div class="lcr-tabs-nav" role="tablist" aria-label="Category Tabs">
          {%- for block in section.blocks -%}
            {%- assign coll = collections[block.settings.collection] -%}
            {%- assign tab_label = block.settings.tab_title | default: coll.title | default: block.settings.collection -%}
            {%- if tab_label == blank -%}
              {%- assign tab_label = 'Collection ' | append: forloop.index -%}
            {%- endif -%}
            <button 
              type="button" 
              role="tab" 
              class="lcr-tab-btn{% if forloop.first %} is-active{% endif %}"
              id="lcr-tab-{{ section.id }}-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="lcr-panel-{{ section.id }}-{{ block.id }}"
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              <span>{{ tab_label | escape }}</span>
              {%- if block.settings.tab_badge != blank -%}
                <span style="font-size: 8.5px; opacity: 0.8; margin-left: 2px;">{{ block.settings.tab_badge }}</span>
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      </div>

      <!-- 3. Tab Panels with Adaptive Dynamic Layout -->
      <div class="lcr-panels-wrapper">
        {%- for block in section.blocks -%}
          {%- assign coll = collections[block.settings.collection] -%}
          {%- assign product_limit = section.settings.products_to_show | default: 8 -%}
          {%- assign prod_count = 0 -%}
          {%- if coll != blank and coll.products_count > 0 -%}
            {%- assign prod_count = coll.products.size -%}
            {%- if prod_count > product_limit -%}
              {%- assign prod_count = product_limit -%}
            {%- endif -%}
          {%- endif -%}
          
          <div 
            class="lcr-tab-panel{% if forloop.first %} is-active{% endif %}"
            id="lcr-panel-{{ section.id }}-{{ block.id }}"
            role="tabpanel"
            aria-labelledby="lcr-tab-{{ section.id }}-{{ block.id }}"
            data-block-id="{{ block.id }}"
            data-prod-count="{{ prod_count }}"
          >
            {%- if prod_count == 0 -%}
              <!-- Elegant empty state (100% Policy Compliant) -->
              {%- if request.design_mode -%}
                <div class="lcr-empty-state">
                  <strong>Allocation Tab "{{ block.settings.tab_title | default: 'Tab ' | append: forloop.index }}" Unassigned</strong>
                  <p>Please assign a Shopify Collection with real products in Theme Customizer.</p>
                </div>
              {%- else -%}
                <div class="lcr-empty-state">
                  <p>No active allocations currently available in this repertoire.</p>
                </div>
              {%- endif -%}

            {%- elsif prod_count == 1 -%}
              <!-- =============================================================
                   ADAPTIVE SPOTLIGHT (prod_count == 1)
                   55% Hero showcase on left, 45% specification details on right.
                   Full 100% container fit, hidden progress bar and arrows.
                   ============================================================= -->
              {%- assign product = coll.products.first -%}
              <div class="lcr-spotlight-wrapper">
                <article class="lcr-spotlight-card">
                  <!-- Left column 55%: High-resolution gallery showcase -->
                  <div class="lcr-spotlight-media">
                    <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                      {%- if product.featured_image != blank -%}
                        <img 
                          src="{{ product.featured_image | image_url: width: 1400 }}" 
                          alt="{{ product.featured_image.alt | default: product.title | escape }}"
                          class="lcr-spotlight-img"
                          loading="lazy"
                          width="770"
                          height="520"
                        >
                      {%- else -%}
                        <div class="lcr-no-image">Imagery in archive</div>
                      {%- endif -%}
                    </a>
                  </div>

                  <!-- Right column 45%: Repertoire details + Inquire CTA -->
                  <div class="lcr-spotlight-body">
                    {%- assign tag_badge = block.settings.custom_card_tag -%}
                    {%- if tag_badge == blank -%}
                      {%- for tag in product.tags -%}
                        {%- assign tag_down = tag | downcase -%}
                        {%- if tag_down contains 'heirloom' or tag_down contains 'salon' or tag_down contains 'allocation' or tag_down contains 'piece' -%}
                          {%- assign tag_badge = tag -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                    {%- if tag_badge == blank -%}
                      {%- assign tag_badge = product.type | default: coll.title | default: 'HEIRLOOM PIECE' -%}
                    {%- endif -%}
                    <span class="lcr-spotlight-tag">
                      {{ tag_badge | upcase }}
                    </span>
                    <h3 class="lcr-spotlight-title">
                      <a href="{{ product.url }}">{{ product.title | escape }}</a>
                    </h3>
                    <span class="lcr-spotlight-price">{{ product.price | money }}</span>
                    {%- if product.description != blank -%}
                      <div class="lcr-spotlight-desc">
                        {{ product.description | strip_html | truncatewords: 34 }}
                      </div>
                    {%- endif -%}
                    <div class="lcr-spotlight-actions">
                      <a href="{{ product.url }}" class="lcr-spotlight-btn">
                        <span>{{ section.settings.btn_label | default: "INQUIRE" }}</span>
                        <span aria-hidden="true">→</span>
                      </a>
                      {%- if coll.url != blank -%}
                        <a href="{{ coll.url }}" class="lcr-spotlight-view-coll">
                          EXPLORE {{ coll.title | default: 'COLLECTION' | upcase }} <span aria-hidden="true">→</span>
                        </a>
                      {%- endif -%}
                    </div>
                  </div>
                </article>
              </div>

            {%- elsif prod_count == 2 or prod_count == 3 -%}
              <!-- =============================================================
                   ADAPTIVE CSS GRID (prod_count == 2 or 3)
                   Evenly spaced 2 or 3 columns, naturally expanding to 100% width
                   ============================================================= -->
              <div class="lcr-grid-layout lcr-grid-cols-{{ prod_count }}">
                {%- for product in coll.products limit: product_limit -%}
                  <article class="lcr-grid-card">
                    <div class="lcr-grid-card-media">
                      <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                        {%- if product.featured_image != blank -%}
                          <img 
                            src="{{ product.featured_image | image_url: width: 900 }}" 
                            alt="{{ product.featured_image.alt | default: product.title | escape }}"
                            class="lcr-grid-card-img"
                            loading="lazy"
                            width="500"
                            height="375"
                          >
                        {%- else -%}
                          <div class="lcr-no-image">Artwork Imagery in Archive</div>
                        {%- endif -%}
                      </a>
                    </div>

                    <div class="lcr-grid-card-body">
                      {%- assign grid_tag_badge = block.settings.custom_card_tag -%}
                      {%- if grid_tag_badge == blank -%}
                        {%- for tag in product.tags -%}
                          {%- assign tag_down = tag | downcase -%}
                          {%- if tag_down contains 'heirloom' or tag_down contains 'salon' or tag_down contains 'allocation' or tag_down contains 'piece' -%}
                            {%- assign grid_tag_badge = tag -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                      {%- if grid_tag_badge == blank -%}
                        {%- assign grid_tag_badge = product.type | default: coll.title | default: 'HEIRLOOM PIECE' -%}
                      {%- endif -%}
                      <span class="lcr-grid-card-cat">
                        {{ grid_tag_badge | upcase }}
                      </span>
                      <h3 class="lcr-grid-card-title">
                        <a href="{{ product.url }}">{{ product.title | escape }}</a>
                      </h3>
                      {%- if product.description != blank -%}
                        <p class="lcr-grid-card-desc">
                          {{ product.description | strip_html | truncatewords: 16 }}
                        </p>
                      {%- endif -%}

                      <div class="lcr-grid-card-bottom">
                        <span class="lcr-grid-card-price">{{ product.price | money }}</span>
                        <a href="{{ product.url }}" class="lcr-grid-card-btn">
                          {{ section.settings.btn_label | default: "INQUIRE" }} →
                        </a>
                      </div>
                    </div>
                  </article>
                {%- endfor -%}
              </div>

              <!-- Responsive Grid Footer -->
              <div class="lcr-grid-footer">
                <div class="lcr-counter">
                  <span class="lcr-counter-current">0{{ prod_count }}</span>
                  /
                  <span class="lcr-counter-total">0{{ prod_count }} ALLOCATIONS</span>
                </div>
                {%- if coll.url != blank -%}
                  <a href="{{ coll.url }}" class="lcr-view-all-link">
                    EXPLORE {{ coll.title | default: 'COLLECTION' | upcase }} <span aria-hidden="true">→</span>
                  </a>
                {%- endif -%}
              </div>

            {%- else -%}
              <!-- =============================================================
                   HORIZONTAL CAROUSEL REEL (prod_count >= 4)
                   Full horizontal carousel with gold progress bar & round controls
                   ============================================================= -->
              <div class="lcr-reel-viewport">
                <div class="lcr-reel-track" id="lcrTrack-{{ section.id }}-{{ block.id }}">
                  {%- for product in coll.products limit: product_limit -%}
                    <article class="lcr-card">
                      <div class="lcr-card-media">
                        <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                          {%- if product.featured_image != blank -%}
                            <img 
                              src="{{ product.featured_image | image_url: width: 900 }}" 
                              alt="{{ product.featured_image.alt | default: product.title | escape }}"
                              class="lcr-card-img"
                              loading="lazy"
                              width="450"
                              height="338"
                            >
                          {%- else -%}
                            <div class="lcr-no-image">Imagery in archive</div>
                          {%- endif -%}
                        </a>
                      </div>

                      <div class="lcr-card-body">
                        {%- assign reel_tag_badge = block.settings.custom_card_tag -%}
                        {%- if reel_tag_badge == blank -%}
                          {%- for tag in product.tags -%}
                            {%- assign tag_down = tag | downcase -%}
                            {%- if tag_down contains 'heirloom' or tag_down contains 'salon' or tag_down contains 'allocation' or tag_down contains 'piece' -%}
                              {%- assign reel_tag_badge = tag -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endif -%}
                        {%- if reel_tag_badge == blank -%}
                          {%- assign reel_tag_badge = product.type | default: coll.title | default: 'HEIRLOOM PIECE' -%}
                        {%- endif -%}
                        <span class="lcr-card-category">
                          {{ reel_tag_badge | upcase }}
                        </span>
                        <h3 class="lcr-card-title">
                          <a href="{{ product.url }}">{{ product.title | escape }}</a>
                        </h3>
                        {%- if product.description != blank -%}
                          <p class="lcr-card-desc">
                            {{ product.description | strip_html | truncatewords: 14 }}
                          </p>
                        {%- endif -%}

                        <div class="lcr-card-bottom">
                          <span class="lcr-card-price">{{ product.price | money }}</span>
                          <a href="{{ product.url }}" class="lcr-card-btn">
                            {{ section.settings.btn_label | default: "INQUIRE" }} →
                          </a>
                        </div>
                      </div>
                    </article>
                  {%- endfor -%}
                </div>
              </div>

              <!-- Carousel Reel Controls (Progress Bar + Counter + Circular Arrows) -->
              <div class="lcr-reel-footer">
                <div class="lcr-footer-left">
                  <div class="lcr-progress-track">
                    <div class="lcr-progress-fill" id="lcrProgress-{{ section.id }}-{{ block.id }}"></div>
                  </div>
                  <div class="lcr-counter">
                    <span class="lcr-counter-current" id="lcrCounterCurr-{{ section.id }}-{{ block.id }}">01</span>
                    /
                    <span class="lcr-counter-total">{% if prod_count < 10 %}0{% endif %}{{ prod_count }} ALLOCATIONS</span>
                  </div>
                </div>

                <div class="lcr-footer-right">
                  {%- if coll.url != blank -%}
                    <a href="{{ coll.url }}" class="lcr-view-all-link">
                      EXPLORE {{ coll.title | default: 'COLLECTION' | upcase }} <span aria-hidden="true">→</span>
                    </a>
                  {%- endif -%}

                  <div class="lcr-nav-arrows">
                    <button 
                      type="button" 
                      class="lcr-arrow-btn lcr-arrow-prev" 
                      id="lcrPrev-{{ section.id }}-{{ block.id }}" 
                      aria-label="Scroll left"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                      </svg>
                    </button>
                    <button 
                      type="button" 
                      class="lcr-arrow-btn lcr-arrow-next" 
                      id="lcrNext-{{ section.id }}-{{ block.id }}" 
                      aria-label="Scroll right"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>

            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

    {%- else -%}
      {%- if request.design_mode -%}
        <div class="lcr-empty-state">
          <strong>Category Reel Has No Active Tabs</strong>
          <p>Click "+ Add Block" in the sidebar to assign collections to display.</p>
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</section>

<script>
  (function() {
    const sectionEl = document.getElementById('LuxuryCategoryReel-{{ section.id }}');
    if (!sectionEl) return;

    // 1. Tab Switching Controller
    const tabBtns = sectionEl.querySelectorAll('.lcr-tab-btn');
    const tabPanels = sectionEl.querySelectorAll('.lcr-tab-panel');

    function switchTab(targetBlockId) {
      tabBtns.forEach(btn => {
        const isActive = btn.getAttribute('data-block-id') === targetBlockId;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      tabPanels.forEach(panel => {
        const isMatch = panel.getAttribute('data-block-id') === targetBlockId;
        panel.classList.toggle('is-active', isMatch);
        if (isMatch) {
          initReel(panel);
        }
      });
    }

    tabBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const blockId = this.getAttribute('data-block-id');
        switchTab(blockId);
      });
    });

    // 2. Carousel Reel Controller (Only for panels with .lcr-reel-track)
    function initReel(panel) {
      const track = panel.querySelector('.lcr-reel-track');
      if (!track) return; // Spotlight or Grid layout does not require carousel listeners

      const prevBtn = panel.querySelector('.lcr-arrow-prev');
      const nextBtn = panel.querySelector('.lcr-arrow-next');
      const progressBar = panel.querySelector('.lcr-progress-fill');
      const counterCurr = panel.querySelector('.lcr-counter-current');

      const cards = track.querySelectorAll('.lcr-card');
      const totalCards = cards.length;
      if (totalCards === 0) return;

      function updateControls() {
        const maxScroll = track.scrollWidth - track.clientWidth;
        const currentScroll = track.scrollLeft;

        // Progress bar width & position
        if (progressBar) {
          const ratio = maxScroll > 0 ? (currentScroll / maxScroll) : 0;
          const minWidth = Math.max(20, Math.round(100 / Math.max(1, totalCards)));
          progressBar.style.width = minWidth + '%';
          progressBar.style.transform = `translateX(${ratio * (100 - minWidth)}%)`;
        }

        // Current item counter
        if (counterCurr && cards[0]) {
          const cardWidth = cards[0].offsetWidth + 20; // 20px gap
          const activeIndex = Math.min(totalCards, Math.max(1, Math.round(currentScroll / cardWidth) + 1));
          counterCurr.textContent = activeIndex < 10 ? '0' + activeIndex : activeIndex;
        }

        // Arrow state
        if (prevBtn) {
          prevBtn.disabled = currentScroll <= 4;
        }
        if (nextBtn) {
          nextBtn.disabled = currentScroll >= (maxScroll - 4);
        }
      }

      function scrollByCard(direction) {
        if (!cards[0]) return;
        const cardWidth = cards[0].offsetWidth + 20; // 20px gap
        track.scrollBy({
          left: direction * cardWidth,
          behavior: 'smooth'
        });
      }

      if (prevBtn && !prevBtn._lcrBound) {
        prevBtn.addEventListener('click', () => scrollByCard(-1));
        prevBtn._lcrBound = true;
      }
      if (nextBtn && !nextBtn._lcrBound) {
        nextBtn.addEventListener('click', () => scrollByCard(1));
        nextBtn._lcrBound = true;
      }

      if (!track._lcrBound) {
        let scrollTimeout;
        track.addEventListener('scroll', () => {
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(updateControls, 25);
        }, { passive: true });
        track._lcrBound = true;
      }

      // Initial state sync
      updateControls();
    }

    // Initialize the active panel on page load
    const initialActivePanel = sectionEl.querySelector('.lcr-tab-panel.is-active');
    if (initialActivePanel) {
      initReel(initialActivePanel);
    }
  })();
</script>

{% schema %}
{
  "name": "Luxury Category Reel",
  "tag": "section",
  "class": "section-luxury-category-reel",
  "settings": [
    {
      "type": "header",
      "content": "Section Dossier & Typography"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "CURATED ALLOCATION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "The Atelier Repertoire"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "A singular repertoire of Hetian nephrite suites, hand-stitched leather trunks, and acoustic felt mats curated for private salons."
    },
    {
      "type": "header",
      "content": "Repertoire Carousel & Cards"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "Max Products Per Tab"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Action Button Label",
      "default": "INQUIRE"
    },
    {
      "type": "header",
      "content": "Layout & Container Spacing"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "default": 1360,
      "unit": "px",
      "label": "Container Max Width"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#FCFAF8"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px",
      "label": "Padding Top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px",
      "label": "Padding Bottom"
    }
  ],
  "blocks": [
    {
      "type": "category_tab",
      "name": "Category Tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Shopify Collection"
        },
        {
          "type": "text",
          "id": "tab_title",
          "label": "Custom Tab Title (Blank for Collection Title)"
        },
        {
          "type": "text",
          "id": "tab_badge",
          "label": "Tab Badge Chip (Optional)"
        },
        {
          "type": "text",
          "id": "custom_card_tag",
          "label": "Artwork Badge Tag (e.g., HEIRLOOM PIECE, SALON ALLOCATION)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Category Reel",
      "blocks": [
        {
          "type": "category_tab"
        },
        {
          "type": "category_tab"
        }
      ]
    }
  ]
}
{% endschema %}
