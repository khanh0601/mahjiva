    align-items: center;
    gap: 4px;
    transition: color 0.2s ease;
  }

  .lcr-spotlight-view-coll:hover {
    color: #141517;
  }

  /* =========================================================================
     2. ADAPTIVE CSS GRID LAYOUT (prod_count == 2 or 3)
     Expands evenly to 100% container width, leaving zero empty margin on right
     ========================================================================= */
  .lcr-grid-layout {
    display: grid;
    gap: 24px;
    width: 100%;
  }

  .lcr-grid-cols-2 {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .lcr-grid-cols-2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .lcr-grid-cols-3 {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .lcr-grid-cols-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .lcr-grid-cols-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .lcr-grid-card {
    background: #FFFFFF;
    border: 1px solid #EBE7DF;
    border-radius: 20px;
