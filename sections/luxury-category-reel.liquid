    font-weight: 700;
    color: #141517;
    letter-spacing: -0.01em;
    margin-bottom: 12px;
    display: block;
  }

  .lcr-spotlight-desc {
    font-size: 13px;
    line-height: 1.6;
    color: #555861;
    margin: 0 0 20px 0;
  }

  .lcr-spotlight-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .lcr-spotlight-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 26px;
    border-radius: 9999px;
    background: #141517;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
