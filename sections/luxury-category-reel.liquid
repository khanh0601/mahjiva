    font-weight: 700;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1.2 !important;
    display: inline-block;
  }

  .lcr-heading {
    font-family: "Cormorant Garamond", Garamond, Georgia, serif;
    font-size: 36px;
    font-weight: 500;
    color: #141517;
    line-height: 1.15;
    margin: 0 !important;
    padding: 0 !important;
  }

  @media (min-width: 768px) {
    .lcr-heading {
      font-size: 46px;
    }
  }

  .lcr-description {
    font-size: 13.5px;
    font-weight: 450;
    color: #3A3D45;
    line-height: 1.6;
    margin: 8px 0 0 !important;
    padding: 0 !important;
  }

  /* Single-line Ribbon of Pill Tabs */
  .lcr-tabs-wrapper {
    position: relative;
    margin-bottom: 38px;
    display: flex;
    justify-content: center;
  }

  .lcr-tabs-nav {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    overflow-x: auto;
    padding: 4px 8px 12px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    max-width: 100%;
    white-space: nowrap;
  }

  .lcr-tabs-nav::-webkit-scrollbar {
    display: none;
  }

  .lcr-tab-btn {
    appearance: none;
    background: #FFFFFF;
    border: 1px solid #EBE7DF;
    border-radius: 9999px;
    padding: 9px 20px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7A7571;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .lcr-tab-btn:hover {
    color: #141517;
    border-color: #D4CEBF;
    background: #F8F5F0;
  }

  .lcr-tab-btn.is-active {
    background: #163327 !important;
    color: #FFFFFF !important;
    border: 1px solid #D8B88C !important;
    box-shadow: 0 4px 16px rgba(22, 51, 39, 0.28);
  }

  /* Tab Panels */
  .lcr-tab-panel {
    display: none;
    animation: lcrFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .lcr-tab-panel.is-active {
    display: block;
  }

  @keyframes lcrFadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .lcr-no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #EDEAE4;
    color: #9E978E;
    font-size: 12px;
  }

  /* =========================================================================
     1. ADAPTIVE SPOTLIGHT LAYOUT (prod_count == 1)
     Refined compact max-width 980px, 46/54 ratio, height 380-420px
     ========================================================================= */
  .lcr-spotlight-wrapper {
    width: 100%;
  }

  .lcr-spotlight-card {
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
    border: 1px solid #EBE7DF;
    border-radius: 20px;
    overflow: hidden;
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
    box-shadow: 0 10px 32px rgba(20, 21, 23, 0.05);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease;
  }

  @media (min-width: 900px) {
    .lcr-spotlight-card {
      flex-direction: row;
      align-items: stretch;
      min-height: 380px;
      max-height: 420px;
    }
  }

  .lcr-spotlight-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 48px rgba(20, 21, 23, 0.09);
    border-color: #D8D2C4;
  }

  .lcr-spotlight-media {
    position: relative;
    width: 100%;
    background: #F4F1EA;
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .lcr-spotlight-media {
