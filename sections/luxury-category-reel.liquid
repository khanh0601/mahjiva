    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lcr-grid-card-btn:hover {
    background: #141517;
    color: #FFFFFF;
  }

  .lcr-grid-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 22px;
    margin-top: 8px;
    border-top: 1px solid #EBE7DF;
  }

  /* =========================================================================
     3. HORIZONTAL CAROUSEL REEL (prod_count >= 4)
     Enables smooth horizontal scroll with gold progress bar & circular nav buttons
     ========================================================================= */
  .lcr-reel-viewport {
    position: relative;
    width: 100%;
  }

  .lcr-reel-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 8px 4px 16px;
    margin: 0 -4px;
    -webkit-overflow-scrolling: touch;
  }

  .lcr-reel-track::-webkit-scrollbar {
    display: none;
  }

  .lcr-card {
    flex: 0 0 calc(84vw - 20px);
    max-width: 380px;
    scroll-snap-align: start;
    background: #FFFFFF;
    border: 1px solid #EBE7DF;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 640px) {
    .lcr-card {
      flex: 0 0 calc(50% - 15px);
      max-width: none;
    }
  }

  @media (min-width: 1024px) {
    .lcr-card {
      flex: 0 0 calc(25% - 15px);
      max-width: none;
    }
  }

  .lcr-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(20, 21, 23, 0.08), 0 2px 8px rgba(0, 0, 0, 0.04);
    border-color: #D8D2C4;
  }

  .lcr-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #F4F1EA;
    overflow: hidden;
  }

  .lcr-card-media a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .lcr-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lcr-card:hover .lcr-card-img {
    transform: scale(1.05);
  }

  .lcr-card-body {
    padding: 22px 20px 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .lcr-card-category {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3.5px 11px;
    border-radius: 9999px;
    background: #163327 !important;
    border: 1px solid rgba(216, 184, 140, 0.35) !important;
    color: #D8B88C !important;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 8px;
    width: fit-content;
    box-shadow: 0 2px 6px rgba(22, 51, 39, 0.12);
  }

  .lcr-card-title {
    font-family: "Cormorant Garamond", Garamond, Georgia, serif;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.4;
    color: #141517;
    margin: 0 0 8px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.8em;
  }

  .lcr-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .lcr-card-title a:hover {
    color: #B89768;
  }

  .lcr-card-desc {
    font-size: 12px;
    line-height: 1.55;
    color: #706C66;
    margin: 0 0 18px 0;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lcr-card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid #F2EEE7;
    margin-top: auto;
  }

  .lcr-card-price {
    font-size: 15px;
    font-weight: 700;
    color: #141517;
    letter-spacing: -0.01em;
  }

  .lcr-card-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 14px;
    border-radius: 9999px;
    border: 1px solid #141517;
    background: transparent;
    color: #141517;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lcr-card-btn:hover {
    background: #141517;
    color: #FFFFFF;
  }

  /* Carousel Reel Footer (Progress Bar + Counter + Arrows) */
  .lcr-reel-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 26px;
    margin-top: 12px;
    border-top: 1px solid #EBE7DF;
    flex-wrap: wrap;
    gap: 16px;
  }

  .lcr-footer-left {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: 1 1 240px;
  }

  .lcr-progress-track {
