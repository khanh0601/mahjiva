<style>
#shopify-section-{{ section.id }}:has(> .blocky-announcement-bar.blocky-announcement-bar-sticky) {
  position: sticky;
  top: calc({{ section.settings.sticky_offset }}px - 1px);
  z-index: 10;
  overflow: visible !important;
}
</style>

{% stylesheet %}
.blocky-announcement-bar {
  position: relative;
  width: 100%;
  z-index: 1;
  padding-top: calc(var(--padding-top) * 1px);
  padding-bottom: calc(var(--padding-bottom) * 1px);
  box-sizing: border-box;
  background-color: var(--background-color);
  max-width: var(--section-page-width);
  margin-left: auto;
  margin-right: auto;
}
.blocky-announcement-bar-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 4px 10px;
  padding: 7px 10px;
}
.blocky-announcement-bar-link {
  text-decoration: none;
  color: inherit;
}
.blocky-countdown-bar-group {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 4px 12px;
}
.blocky-countdown-bar-group.blocky-countdown-bar-group-2row {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px 12px;
}
.blocky-countdown-bar-group.blocky-countdown-bar-group-2row .blocky-countdown-bar-text {
  align-items: flex-start;
  text-align: left;
  gap: 0;
}
.blocky-countdown-bar-text {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.blocky-countdown-bar-text .blocky-title,
.blocky-countdown-bar-text .blocky-body-text {
  margin: 0 !important;
  line-height: 1.1 !important;
}
.blocky-countdown-bar-text .blocky-title {
  font-size: calc(var(--title-size) * 1px) !important;
}
.blocky-countdown-bar-text .blocky-body-text {
  font-size: var(--body-font-size) !important;
}
.blocky-timer {
  display: flex;
  gap: 6px;
  align-items: flex-start;
  direction: ltr;
}
.blocky-timer-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.blocky-timer-value {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--timer-background);
  border-radius: var(--border-radius);
  padding: 6px;
  min-width: 34px;
  box-sizing: border-box;
  transition: min-width 0.15s ease;
}
.blocky-timer-number {
  color: var(--timer-number-color);
  font-weight: var(--timer-number-weight);
  font-size: 17px;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  min-width: 2ch;
  white-space: nowrap;
  text-align: center;
}
.blocky-timer-legend {
  color: var(--timer-legend-color);
  font-size: 12px;
  font-weight: var(--timer-legend-weight);
  padding-top: 3px;
  text-align: center;
  line-height: 1;
}
@media (min-width: 431px) {
  .blocky-countdown-bar-group.blocky-countdown-bar-group-2row {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 4px;
  }
  .blocky-countdown-bar-text {
    gap: 4px;
  }
}
@media (min-width: 621px) {
  .blocky-announcement-bar-inner {
    padding: 10px 15px;
    gap: 4px 16px;
  }
  .blocky-timer-number {
    font-size: 22px;
  }
  .blocky-timer-value {
    min-width: 40px;
  }
}
{% endstylesheet %}

{% capture countdown_bar_content %}
  <div class="blocky-countdown-bar-group{% if section.settings.timer_layout == 'two_rows' %} blocky-countdown-bar-group-2row{% endif %}">
    <div class="blocky-countdown-bar-text">
      {% render 'blocky-title', title: section.settings.title, title_bold: false, title_color: section.settings.title_color, title_size: section.settings.title_size %}
      {% render 'blocky-body', body_text: section.settings.subheading, body_color: section.settings.subheading_color, body_size: section.settings.subheading_size %}
    </div>
    {% render 'blocky-timer', mode: section.settings.timer_mode, hours: section.settings.hours_duration, reset_scope: section.settings.reset_scope, fixed_end: section.settings.fixed_end, section_id: section.id, timer_background: section.settings.timer_background, timer_number_color: section.settings.timer_number_color, timer_legend_color: section.settings.timer_legend_color, timer_number_font_weight: section.settings.timer_number_font_weight, timer_legend_font_weight: section.settings.timer_legend_font_weight, border_radius: section.settings.border_radius, show_days: section.settings.show_days, show_hours: section.settings.show_hours, show_minutes: section.settings.show_minutes, show_seconds: section.settings.show_seconds %}
  </div>
{% endcapture %}

{% render 'blocky-announcement-bar-shell', content: countdown_bar_content, background_color: section.settings.background_color, padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom, page_width: section.settings.page_width, full_width: section.settings.full_width, link: section.settings.cta_link, sticky: section.settings.sticky %}

{% schema %}
{
  "name": "BKY - Countdown Bar",
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "<b>SPECIAL OFFER</b>",
      "info": "Leave blank to hide the title."
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "50% OFF + FREE SHIPPING",
      "info": "Leave blank to hide the subheading."
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Timer"
    },
    {
      "type": "select",
      "id": "timer_mode",
      "label": "Countdown type",
      "options": [
        {
          "value": "relative",
          "label": "Relative (X hours after each visitor arrives)"
        },
        {
          "value": "fixed",
          "label": "Fixed date (ends for everyone at the same time)"
        }
      ],
      "default": "relative"
    },
    {
      "type": "range",
      "id": "hours_duration",
      "label": "Countdown length",
      "min": 1,
      "max": 72,
      "step": 1,
      "unit": "hrs",
      "default": 4,
      "info": "Restarts for each visitor the first time they see the bar.",
      "visible_if": "{{ section.settings.timer_mode == 'relative' }}"
    },
    {
      "type": "select",
      "id": "reset_scope",
      "label": "Countdown resets",
      "options": [
        {
          "value": "visitor",
          "label": "Per visitor (persists across their visits)"
        },
        {
          "value": "session",
          "label": "Per session (resets each new browser session)"
        }
      ],
      "default": "visitor",
      "visible_if": "{{ section.settings.timer_mode == 'relative' }}"
    },
    {
      "type": "text",
      "id": "fixed_end",
      "label": "End date & time",
      "default": "2026-12-31 23:59",
      "info": "Format: YYYY-MM-DD HH:MM (24h), store's local time.",
      "visible_if": "{{ section.settings.timer_mode == 'fixed' }}"
    },
    {
      "type": "color",
      "id": "timer_background",
      "label": "Timer box background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "timer_number_color",
      "label": "Timer number color",
      "default": "#7AC2C9"
    },
    {
      "type": "color",
      "id": "timer_legend_color",
      "label": "Timer legend color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "timer_number_font_weight",
      "label": "Timer number font weight",
      "options": [
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "timer_legend_font_weight",
      "label": "Timer label font weight",
      "options": [
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Timer box border radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Timer units"
    },
    {
      "type": "checkbox",
      "id": "show_days",
      "label": "Show days",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Show hours",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_minutes",
      "label": "Show minutes",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_seconds",
      "label": "Show seconds",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick to top of page",
      "default": false
    },
    {
      "type": "range",
      "id": "sticky_offset",
      "label": "Sticky top offset",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "If your theme has its own sticky header, set this to its height so the two don't overlap.",
      "visible_if": "{{ section.settings.sticky == true }}"
    },
    {
      "type": "select",
      "id": "timer_layout",
      "label": "Timer layout",
      "options": [
        {
          "value": "one_row",
          "label": "1 Row"
        },
        {
          "value": "two_rows",
          "label": "2 Rows"
        }
      ],
      "default": "one_row"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#7AC2C9"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "range",
      "id": "page_width",
      "unit": "px",
      "step": 100,
      "min": 800,
      "max": 1600,
      "default": 1200,
      "label": "Section width",
      "visible_if": "{{ section.settings.full_width == false }}"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 8
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link",
      "info": "Optional. When set, clicking anywhere on the bar navigates here."
    }
  ],
  "presets": [
    {
      "name": "Blocky Countdown Bar"
    }
  ],
  "disabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}