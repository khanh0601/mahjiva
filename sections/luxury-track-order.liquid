</div>

<!-- 17Track External API Script deferred to prevent render blocking -->
<script type="text/javascript" src="//www.17track.net/externalcall.js" defer></script>

<script>
  function doTrack() {
    var inputEl = document.getElementById("YQNum");
    var errorEl = document.getElementById("ltoInputError");
    var resultWrap = document.getElementById("ltoResultWrapper");
    var num = inputEl ? inputEl.value.trim() : "";
    
    if (!num) {
      if (errorEl) {
        errorEl.style.display = "flex";
      }
      if (inputEl) {
        inputEl.focus();
      }
      return;
    }
    
    if (errorEl) {
      errorEl.style.display = "none";
    }

    if (resultWrap) {
      resultWrap.style.display = "block";
      resultWrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    if (typeof YQV5 !== 'undefined') {
      YQV5.trackSingle({
        YQ_ContainerId: "YQContainer",
        YQ_Height: 600,
        YQ_Fc: "0",
        YQ_Lang: "en",
        YQ_Num: num
      });
    }
  }

  // Allow pressing Enter key to track
  document.addEventListener("DOMContentLoaded", function() {
    var input = document.getElementById("YQNum");
    if (input) {
      input.addEventListener("keydown", function(e) {
        if (e.key === "Enter") {
          e.preventDefault();
          doTrack();
        }
      });
      input.addEventListener("input", function() {
        var errorEl = document.getElementById("ltoInputError");
        if (errorEl && errorEl.style.display !== "none") {
          errorEl.style.display = "none";
        }
      });
    }
  });
</script>

