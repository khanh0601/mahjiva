<style>
  .blocky-mi-{{ section.id }} .blocky-media-instructions-wrapper {
    --_spacing: var(--media-spacing, 1rem);
    grid-column: span 2;
  }

  .blocky-mi-{{ section.id }} .blocky-ivs-text-container {
    gap: var(--bky-mi-title-body-gap);
    margin-bottom: var(--bky-mi-content-below-spacing);
  }

  .blocky-mi-{{ section.id }} .blocky-media-instructions-media img {
    width: 100%;
    height: 100%;
    border-radius: var(--border-radius, 15px);
    border: calc(var(--show-border) * var(--bky-mi-border-width, 1px)) solid var(--border-color, #000000);
  }

  .blocky-mi-{{ section.id }} .blocky-media-instructions-media {
    background: #fff;
    height: 100%;
  }

  .blocky-mi-{{ section.id }} .blocky-media-instructions-grid {
    display: grid;
  }

  .blocky-mi-{{ section.id }}.blocky .blocky-media-instructions-title {
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 0;
    margin-bottom: var(--bky-mi-title-gap, 0.5em);
    line-height: 1.4;
  }

  .blocky-mi-{{ section.id }} .blocky-media-instructions-description {
    font-size: 1rem;
    line-height: 1.6;
  }

  .blocky-mi-{{ section.id }} .blocky-media-instructions-item {
    margin-bottom: var(--bky-mi-image-gap, 1rem);
    border-radius: var(--border-radius, 15px);
  }

  .blocky-mi-{{ section.id }} .blocky-media-instructions-media img.img-fit-fit {
    object-fit: fill;
  }

  .blocky-mi-{{ section.id }} .blocky-media-instructions-media img.img-fit-zoomed {
    object-fit: cover;
  }

  .blocky-mi-{{ section.id }} .blocky-media-instructions-media img.img-fit-contained {
    object-fit: contain;
  }

  .blocky-mi-{{ section.id }} .blocky-media-instructions-wrapper.card-style .blocky-media-instructions-title,
  .blocky-mi-{{ section.id }} .blocky-media-instructions-wrapper.card-style .blocky-media-instructions-description {
    padding: 0 1rem;
  }

  .blocky-mi-{{ section.id }} .blocky-media-instructions-wrapper.card-style .blocky-media-instructions-description {
    padding-bottom: 1rem;
  }

  .blocky-mi-{{ section.id }} .blocky-media-instructions-wrapper.card-style .blocky-media-instructions-item {
    margin-bottom: var(--bky-mi-image-gap, 0.5rem);
  }

  .blocky-mi-{{ section.id }} .blocky-media-instructions-wrapper.card-style {
    border-radius: var(--border-radius, 15px);
    border: calc(var(--show-border) * var(--bky-mi-border-width, 1px)) solid var(--border-color, #000000);
  }

  .blocky-mi-{{ section.id }} .blocky-media-instructions-wrapper.card-style img,
  .blocky-mi-{{ section.id }} .blocky-media-instructions-wrapper.card-style video,
  .blocky-mi-{{ section.id }} .blocky-media-instructions-wrapper.card-style .blocky-media-instructions-item {
    border-radius: var(--border-radius, 15px) var(--border-radius, 15px) 0 0;
  }

  .blocky-mi-{{ section.id }} .blocky-media-instructions-wrapper.card-style .blocky-media-instructions-media img {
    border: none;
  }

  @media (min-width: 750px) {
    .blocky-mi-{{ section.id }} .blocky-media-instructions-grid {
      grid-template-columns: repeat(var(--desktop-columns), 1fr);
    }
  }

  @media (max-width: 749px) {
    .blocky-mi-{{ section.id }} .blocky-media-instructions-grid {
      grid-template-columns: repeat(var(--mobile-columns), 1fr);
    }
  }

  @media (max-width: 749px) {
    .blocky-mi-{{ section.id }} .blocky-mi-{{ section.id }} .blocky-title { --title-size: {{ section.settings.mobile_title_size }} !important; }
    .blocky-mi-{{ section.id }} .blocky-mi-{{ section.id }} .blocky-body-text { --body-font-size: {{ section.settings.mobile_body_size }}px !important; }
    .blocky-mi-{{ section.id }} .blocky-mi-{{ section.id }} .blocky-media-instructions-title { font-size: {{ section.settings.mobile_instruction_title_size }}px !important; }
    .blocky-mi-{{ section.id }} .blocky-mi-{{ section.id }} .blocky-media-instructions-description { font-size: {{ section.settings.mobile_instruction_desc_size }}px !important; }
  }
</style>

<div class="blocky blocky-padding background-wrapper blocky-media-instructions blocky-mi-{{ section.id }} blocky-relative"
     style="--padding-top: {{ section.settings.padding_top }}; --padding-bottom: {{ section.settings.padding_bottom }}; --background-color: {{ section.settings.background_color }};
             --title-color: {{ section.settings.title_color }}; --description-color: {{ section.settings.body_color }}; --section-page-width: {{ section.settings.page_width | divided_by: 10 }}rem;
             --media-spacing: {{ section.settings.media_spacing }}px; --desktop-columns: {{ section.settings.desktop_steps_per_row | times: 2 }}; --mobile-columns: {{ section.settings.mobile_steps_per_row | times: 2 }};
             --show-border: {% if section.settings.show_border %}1{% else %}0{% endif %}; --border-color: {{ section.settings.border_color }}; --bky-mi-border-width: {{ section.settings.border_width }}px; --border-radius: {{ section.settings.border_radius }}px;
             --bky-mi-image-gap: {{ section.settings.image_title_gap }}px; --bky-mi-title-gap: {{ section.settings.title_desc_gap }}px;
             --bky-mi-title-body-gap: {{ section.settings.title_body_gap }}px; --bky-mi-content-below-spacing: {{ section.settings.content_below_spacing }}px;
             "
>
    <div class="blocky-ivs-text-container blocky-text-container-mobile-{{ section.settings.mobile_content_alignment }} blocky-text-container-desktop-{{ section.settings.desktop_content_alignment }} page-width{% if section.settings.show_shadow %} blocky-ivs-text-container-shadow{% endif %} blocky-page-width">
        {% render 'blocky-titlel', block: section %}
        {% render 'blocky-bodyl', block: section %}
    </div>
    <div class="blocky-media-instructions-container blocky-page-width">
        <blocky-media-instructions class="blocky-media-instructions-grid" data-id={{ section.id }} style="gap: var(--media-spacing);">
            {% capture other_classes %}blocky-desktop-{{ section.settings.media_size }} blocky-mobile-{{ section.settings.mobile_media_size }}{% endcapture %}
            {% for block in section.blocks %}
                <div class="blocky-media-instructions-wrapper blocky-flex blocky-flex-col{% if section.settings.card_style %} card-style{% endif %}{% if section.settings.card_style and section.settings.show_shadow %} blocky-shadow{% endif %}" style="background-color: {{ section.settings.instruction_background_color }};" {{ block.shopify_attributes }}>

                  {% if section.settings.card_style %}
                    <div class="blocky-media-instructions-item blocky-overflow-hidden{% if section.settings.show_shadow and section.settings.card_style == false %} blocky-shadow{% endif %}">
                        <div class="blocky-media-instructions-media">
                        {% if block.settings.link %}<a class="blocky-media-instructions-link" href={{ block.settings.link }}>{% endif %}
                                {% if block.type == "image" %}
                                    {% if block.settings.image %}
                                        <img
                                                class="img-fit-{{ block.settings.media_fit }} {{ other_classes }}"
                                                src="{{ block.settings.image | image_url: height: 750 }}"
                                                {% if block.settings.link %}class="blocky-media-instructions-img-link" data-url={{ block.settings.link }}{% endif %}
                                                alt="{{ block.settings.title | default: 'Media instruction image' }}"
                                        >
                                    {% else %}
                                        {{ 'image' | placeholder_svg_tag: other_classes }}
                                    {% endif %}
                                {% endif %}
                                {% if block.type == "video" %}
                                    {% render "blocky-video", video: block.settings.video, video_fit: block.settings.media_fit, placeholder: 1, autoplay: block.settings.autoplay, button_color: block.settings.play_button_color, background_button_color: block.settings.play_button_background_color, other_classes: other_classes %}
                                {% endif %}
                        {% if block.settings.link %}</a>{% endif %}
                        </div>
                    </div>

                    {% if block.settings.title != blank %}
                        <div class="blocky-media-instructions-title" style="color: {{ section.settings.instruction_title_color }}; font-size: {{ section.settings.instruction_title_size }}px; text-align: {{ section.settings.instruction_title_alignment }};">
                            {{ block.settings.title }}
                        </div>
                    {% endif %}

                    {% if block.settings.description != blank %}
                        <div class="blocky-media-instructions-description" style="color: {{ section.settings.instruction_description_color }}; font-size: {{ section.settings.instruction_description_size }}px; text-align: {{ section.settings.instruction_description_alignment }};">
                            {{ block.settings.description }}
                        </div>
                    {% endif %}

                  {% else %}
                    {%- capture title_html -%}
                      {% if block.settings.title != blank %}
                        <div class="blocky-media-instructions-title" style="color: {{ section.settings.instruction_title_color }}; font-size: {{ section.settings.instruction_title_size }}px; text-align: {{ section.settings.instruction_title_alignment }};">
                            {{ block.settings.title }}
                        </div>
                      {% endif %}
                    {%- endcapture -%}

                    {% unless section.settings.title_below_image %}{{ title_html }}{% endunless %}

                    <div class="blocky-media-instructions-item blocky-overflow-hidden{% if section.settings.show_shadow and section.settings.card_style == false %} blocky-shadow{% endif %}">
                        <div class="blocky-media-instructions-media">
                        {% if block.settings.link %}<a class="blocky-media-instructions-link" href={{ block.settings.link }}>{% endif %}
                                {% if block.type == "image" %}
                                    {% if block.settings.image %}
                                        <img
                                                class="img-fit-{{ block.settings.media_fit }} {{ other_classes }}"
                                                src="{{ block.settings.image | image_url: height: 750 }}"
                                                {% if block.settings.link %}class="blocky-media-instructions-img-link" data-url={{ block.settings.link }}{% endif %}
                                                alt="{{ block.settings.title | default: 'Media instruction image' }}"
                                        >
                                    {% else %}
                                        {{ 'image' | placeholder_svg_tag: other_classes }}
                                    {% endif %}
                                {% endif %}
                                {% if block.type == "video" %}
                                    {% render "blocky-video", video: block.settings.video, video_fit: block.settings.media_fit, placeholder: 1, autoplay: block.settings.autoplay, button_color: block.settings.play_button_color, background_button_color: block.settings.play_button_background_color, other_classes: other_classes %}
                                {% endif %}
                        {% if block.settings.link %}</a>{% endif %}
                        </div>
                    </div>

                    {% if section.settings.title_below_image %}{{ title_html }}{% endif %}

                    {% if block.settings.description != blank %}
                        <div class="blocky-media-instructions-description" style="color: {{ section.settings.instruction_description_color }}; font-size: {{ section.settings.instruction_description_size }}px; text-align: {{ section.settings.instruction_description_alignment }};">
                            {{ block.settings.description }}
                        </div>
                    {% endif %}
                  {% endif %}
                </div>
            {% endfor %}
        </blocky-media-instructions>
    </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (!customElements.get('blocky-media-instructions')) {
      customElements.define('blocky-media-instructions',
        class BlockyMediaInstructions extends HTMLElement {
          constructor() {
            super()

            this.sectionId = this.getAttribute("data-id")
            if (this.sectionId) {
              this.setup()
            }

            document.querySelectorAll(".blocky-slider-img-link").forEach(t => {
              const url = t.getAttribute("data-url")
              if (!url) return
              t.addEventListener("click", (event) => {
                window.location.href = url
              })
            })
          }

          setup() {
            this.centerWidows()
            window.addEventListener('resize', () => this.centerWidows())
          }

          centerWidows() {
            const wrappers = this.querySelectorAll('.blocky-media-instructions-wrapper')
            if (wrappers.length === 0) return

            const isDesktop = window.innerWidth >= 750
            const containerStyle = window.getComputedStyle(this)
            const stepsPerRow = isDesktop
              ? parseInt(containerStyle.getPropertyValue('--desktop-columns')) / 2
              : parseInt(containerStyle.getPropertyValue('--mobile-columns')) / 2

            const totalItems = wrappers.length

            wrappers.forEach(wrapper => {
              wrapper.style.gridColumnStart = ''
            })

            const completeRows = Math.floor(totalItems / stepsPerRow)
            const remainingItems = totalItems % stepsPerRow

            if (remainingItems > 0 && remainingItems < stepsPerRow) {
              const totalColumns = stepsPerRow * 2
              const firstItemOfLastRow = wrappers[completeRows * stepsPerRow]
              const totalColumnsUsed = remainingItems * 2
              const emptyColumns = totalColumns - totalColumnsUsed

              const start = emptyColumns / 2 + 1
              firstItemOfLastRow.style.gridColumnStart = start
              firstItemOfLastRow.style.gridColumnEnd = "span 2"
            }
          }
        }
      )
    }
  })
</script>

