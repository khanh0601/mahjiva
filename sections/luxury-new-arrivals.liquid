{% comment %}
  =============================================================================
  NEW ARRIVALS UPSELL GRID SECTION
  Designed for A+ Content & Cross-Sell Placement
  Features:
  - 100% Real Shopify Data (Single Source of Truth)
  - Date: New to Old sorting (Newest products first)
  - Configurable 4-column 1-row layout (default 4 products) for A+ content
  - Exact styling from approved design:
    * Dark rounded card borders (16px radius)
    * Purple pill SALE badge
    * Bold prices with compare-at strikethrough
    * Instant AJAX Add-To-Cart pill button
  =============================================================================
{% endcomment %}

<style>
  #NewArrivalsUpsell-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FCFAF8' }};
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .nau-container {
    max-width: {{ section.settings.container_max_width | default: 1300 }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (min-width: 1024px) {
    .nau-container {
      padding: 0 28px;
    }
  }

  /* Header Typography & Navigation */
  .nau-header-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 24px;
    gap: 16px;
  }

  .nau-header {
    margin-bottom: 0;
    flex: 1;
    text-align: left;
  }

  .nau-title {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 34px;
    font-weight: 600;
    color: #163327;
    margin: 0 0 10px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  @media (min-width: 768px) {
    .nau-title {
      font-size: 40px;
    }
  }

  .nau-subtitle {
    font-size: 15px;
    color: #5C554E;
    margin: 0;
    line-height: 1.5;
    max-width: 780px;
  }

  /* Slider Navigation Arrows */
  .nau-slider-nav {
    display: none;
    gap: 8px;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 4px;
  }

  .nau-slider-nav.is-visible {
    display: flex;
  }

  .nau-nav-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(22, 51, 39, 0.4);
    background: #ffffff;
    color: #163327;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
    box-shadow: 0 2px 6px rgba(22, 51, 39, 0.08);
  }

  .nau-nav-btn:hover {
    background: #163327;
    color: #FAF7F2;
    border-color: #163327;
    transform: translateY(-1px);
  }

  .nau-nav-btn:active {
    transform: scale(0.95);
  }

  /* Product Grid: Desktop & Tablet defaults */
  .nau-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  @media (min-width: 768px) {
    .nau-grid {
      display: grid !important;
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      grid-auto-flow: row !important;
      overflow-x: visible !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      padding: 0 !important;
      gap: 20px !important;
    }
    .nau-card {
      flex: unset !important;
      min-width: unset !important;
      max-width: unset !important;
      width: auto !important;
    }
    .nau-slider-nav {
      display: none !important;
    }
    .nau-slider-progress {
      display: none !important;
    }
  }

  @media (min-width: 1024px) {
    .nau-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, minmax(0, 1fr)) !important;
      gap: 24px !important;
    }
  }

  /* Mobile Layout Rules (< 768px) */
  @media (max-width: 767px) {
    /* 1. Slider: 1 Row */
    .nau-grid--mob-slider.nau-grid--mob-rows-1,
    .nau-grid--mob-slider.nau-grid--mob-rows-all {
      display: flex !important;
      flex-flow: row nowrap !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      scroll-snap-type: x proximity !important;
      scroll-behavior: smooth !important;
      -webkit-overflow-scrolling: touch !important;
      touch-action: pan-x pan-y !important;
      overscroll-behavior-x: contain !important;
      gap: 12px !important;
      padding: 4px 20px 14px 20px !important;
      margin-left: -20px !important;
      margin-right: -20px !important;
      scrollbar-width: none !important;
    }
    .nau-grid--mob-slider.nau-grid--mob-rows-1::-webkit-scrollbar,
    .nau-grid--mob-slider.nau-grid--mob-rows-all::-webkit-scrollbar {
      display: none !important;
    }
    .nau-grid--mob-slider.nau-grid--mob-rows-1.nau-grid--mob-size-compact .nau-card,
    .nau-grid--mob-slider.nau-grid--mob-rows-all.nau-grid--mob-size-compact .nau-card {
      flex: 0 0 calc(46% - 4px) !important;
      min-width: calc(46% - 4px) !important;
      max-width: calc(46% - 4px) !important;
      scroll-snap-align: start !important;
    }
    .nau-grid--mob-slider.nau-grid--mob-rows-1.nau-grid--mob-size-large .nau-card,
    .nau-grid--mob-slider.nau-grid--mob-rows-all.nau-grid--mob-size-large .nau-card {
      flex: 0 0 calc(72% - 6px) !important;
      min-width: calc(72% - 6px) !important;
      max-width: calc(72% - 6px) !important;
      scroll-snap-align: start !important;
    }

    /* 2. Slider: 2 Rows */
    .nau-grid--mob-slider.nau-grid--mob-rows-2 {
      display: grid !important;
      grid-template-rows: repeat(2, auto) !important;
      grid-auto-flow: column !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      scroll-snap-type: x proximity !important;
      scroll-behavior: smooth !important;
      -webkit-overflow-scrolling: touch !important;
      touch-action: pan-x pan-y !important;
      overscroll-behavior-x: contain !important;
      gap: 12px !important;
      padding: 4px 20px 14px 20px !important;
      margin-left: -20px !important;
      margin-right: -20px !important;
      scrollbar-width: none !important;
    }
    .nau-grid--mob-slider.nau-grid--mob-rows-2::-webkit-scrollbar {
      display: none !important;
    }
    .nau-grid--mob-slider.nau-grid--mob-rows-2.nau-grid--mob-size-compact {
      grid-auto-columns: calc(46% - 4px) !important;
    }
    .nau-grid--mob-slider.nau-grid--mob-rows-2.nau-grid--mob-size-large {
      grid-auto-columns: calc(72% - 6px) !important;
    }
    .nau-grid--mob-slider.nau-grid--mob-rows-2 .nau-card {
      width: 100% !important;
      scroll-snap-align: start !important;
    }

    /* 3. Grid: Standard */
    .nau-grid--mob-grid {
      display: grid !important;
      gap: 12px !important;
    }
    .nau-grid--mob-grid.nau-grid--mob-cols-1 {
      grid-template-columns: 1fr !important;
    }
    .nau-grid--mob-grid.nau-grid--mob-cols-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
    /* Grid 1 Row limits */
    .nau-grid--mob-grid.nau-grid--mob-cols-1.nau-grid--mob-rows-1 .nau-card:nth-child(n+2) {
      display: none !important;
    }
    .nau-grid--mob-grid.nau-grid--mob-cols-2.nau-grid--mob-rows-1 .nau-card:nth-child(n+3) {
      display: none !important;
    }
    /* Grid 2 Rows limits */
    .nau-grid--mob-grid.nau-grid--mob-cols-1.nau-grid--mob-rows-2 .nau-card:nth-child(n+3) {
      display: none !important;
    }
    .nau-grid--mob-grid.nau-grid--mob-cols-2.nau-grid--mob-rows-2 .nau-card:nth-child(n+5) {
      display: none !important;
    }
  }

  /* Progress indicator bar */
  .nau-slider-progress {
    display: none;
    width: 100%;
    max-width: 120px;
    height: 3px;
    background: rgba(22, 51, 39, 0.1);
    border-radius: 999px;
    margin: 14px auto 0 auto;
    overflow: hidden;
    position: relative;
  }
  @media (max-width: 767px) {
    .nau-slider-progress.is-visible {
      display: block !important;
    }
  }
  .nau-slider-progress-bar {
    height: 100%;
    width: 35%;
    background: #163327;
    border-radius: 999px;
    transition: transform 0.1s ease-out;
    transform-origin: left center;
  }

  /* Card Structure: Haute Horlogerie Luxury Card */
  .nau-card {
    background: #ffffff;
    border: 1px solid #EAE5DC;
    border-radius: 18px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease;
    position: relative;
    box-shadow: 0 4px 20px rgba(22, 51, 39, 0.04), 0 1px 3px rgba(0, 0, 0, 0.02);
  }

  @media (min-width: 768px) {
    .nau-card {
      padding: 16px;
    }
  }

  .nau-card:hover {
    transform: translateY(-5px);
    border-color: rgba(184, 151, 104, 0.55);
    box-shadow: 0 16px 36px rgba(22, 51, 39, 0.08), 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  /* Media & Badges */
  .nau-media-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    background: #FAF8F5;
    border: 1px solid rgba(22, 51, 39, 0.05);
  }

  .nau-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .nau-card:hover .nau-img {
    transform: scale(1.05);
  }

  /* Signature SALE Badge (Đồng bộ màu Imperial Jade & viền vàng hoàng gia) */
  .nau-badge-sale {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: {{ section.settings.badge_color | default: '#163327' }};
    color: #FAF7F2;
    border: 1px solid rgba(184, 151, 104, 0.45);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 999px;
    line-height: 1.1;
    z-index: 2;
    box-shadow: 0 3px 8px rgba(22, 51, 39, 0.25);
  }

  /* Details: Title & Price */
  .nau-info {
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .nau-prod-title {
    font-size: 16px;
    font-weight: 600;
    color: #163327;
    line-height: 1.35;
    margin: 0 0 8px;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 42px;
    transition: color 0.2s ease;
  }

  .nau-prod-title:hover {
    color: #B89768;
    text-decoration: none;
  }

  .nau-price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin-bottom: 14px;
  }

  .nau-price-regular {
    font-size: 16px;
    font-weight: 700;
    color: #163327;
    white-space: nowrap;
  }

  .nau-price-compare {
    font-size: 13.5px;
    font-weight: 400;
    color: #8C827A;
    text-decoration: line-through;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .nau-card {
      padding: 12px;
    }

    .nau-prod-title {
      font-size: 15px;
      min-height: 38px;
      margin-bottom: 6px;
    }

    .nau-price-row {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 1px;
      margin-bottom: 12px;
      min-height: 38px;
    }

    .nau-price-regular {
      font-size: 15px;
      line-height: 1.2;
    }

    .nau-price-compare {
      font-size: 12px;
      line-height: 1.2;
      color: #888888;
    }

    .nau-atc-btn {
      padding: 5px 8px !important;
      min-height: 32px !important;
      height: 32px !important;
      font-size: 10px !important;
      letter-spacing: 0.04em !important;
      white-space: nowrap !important;
      gap: 5px !important;
      line-height: 1 !important;
      border-width: 1px !important;
    }

    .nau-atc-btn span {
      white-space: nowrap !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
    }

    .nau-atc-btn svg {
      width: 11px !important;
      height: 11px !important;
      flex-shrink: 0 !important;
    }
  }

  /* Add To Cart Pill Button */
  .nau-atc-btn {
    width: 100%;
    margin-top: auto;
    padding: 10px 16px;
    background: #FAF8F5;
    color: #163327;
    border: 1px solid #163327;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 42px;
    text-decoration: none;
    outline: none;
  }

  .nau-atc-btn:hover:not(:disabled) {
    background: #163327 !important;
    border-color: #163327 !important;
    color: #FAF8F5 !important;
    box-shadow: 0 4px 16px rgba(22, 51, 39, 0.25) !important;
    transform: translateY(-1px);
  }

  .nau-atc-btn:disabled {
    background: #f3f4f6;
    border-color: #d1d5db;
    color: #9ca3af;
    cursor: not-allowed;
  }

  .nau-atc-btn.is-adding {
    background: linear-gradient(180deg, #1D4B37 0%, #143828 42%, #081610 100%) !important;
    border-color: #143828 !important;
    color: #FAF8F5 !important;
    opacity: 0.85;
  }

  .nau-atc-btn.is-added {
    background: #10b981;
    border-color: #10b981;
    color: #ffffff;
  }

  /* Footer View All Link */
  .nau-footer {
    margin-top: 32px;
    text-align: center;
  }

  .nau-view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    border: 1px solid #111111;
    border-radius: 9999px;
    background: transparent;
    color: #111111;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nau-view-all-link:hover {
    background: linear-gradient(180deg, #1D4B37 0%, #143828 42%, #081610 100%) !important;
    color: #FAF8F5 !important;
    border-color: #143828 !important;
    box-shadow: 0 4px 14px rgba(8, 22, 16, 0.35) !important;
  }
</style>

<div id="NewArrivalsUpsell-{{ section.id }}" class="section-new-arrivals-upsell">
  <div class="nau-container">

    {%- liquid
      assign mob_layout = section.settings.mobile_layout | default: 'slider'
      assign mob_rows = section.settings.mobile_rows | default: '1'
      assign mob_size = section.settings.mobile_card_size | default: 'compact'
      assign mob_cols = section.settings.columns_mobile | default: '2'
    -%}

    {%- comment -%} 1. Header Area with Slider Navigation {%- endcomment -%}
    <div class="nau-header-wrap">
      <div class="nau-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="nau-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="nau-subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_mobile_arrows and mob_layout == 'slider' -%}
        <div class="nau-slider-nav is-visible" aria-label="Slider navigation">
          <button 
            type="button" 
            class="nau-nav-btn nau-nav-prev" 
            onclick="nauSlide('{{ section.id }}', -1)" 
            aria-label="Previous products"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button 
            type="button" 
            class="nau-nav-btn nau-nav-next" 
            onclick="nauSlide('{{ section.id }}', 1)" 
            aria-label="Next products"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} 2. Product Query & Date Sorting {%- endcomment -%}
    {%- liquid
      # Select collection or fallback to 'all'
      assign target_coll = section.settings.collection
      if target_coll == blank
        assign target_coll = collections['all']
      endif

      # Sort products from newest to oldest
      assign raw_list = target_coll.products
      if section.settings.sort_newest
        assign sorted_list = raw_list | sort: 'published_at' | reverse
      else
        assign sorted_list = raw_list
      endif

      # Products limit: default 4
      assign limit_num = section.settings.products_to_show | default: 4
      assign rendered_count = 0
    -%}

    {%- comment -%} 3. Responsive 4-Column Product Grid / Mobile Slider {%- endcomment -%}
    <div 
      class="nau-grid nau-grid--mob-{{ mob_layout }} nau-grid--mob-rows-{{ mob_rows }} nau-grid--mob-size-{{ mob_size }} nau-grid--mob-cols-{{ mob_cols }}"
      id="NauGrid-{{ section.id }}"
    >
      {%- for prod in sorted_list -%}
        {%- comment -%} Skip the current product when placed on product page A+ content {%- endcomment -%}
        {%- if template.name == 'product' and product and prod.id == product.id -%}
          {%- continue -%}
        {%- endif -%}

        {%- assign rendered_count = rendered_count | plus: 1 -%}
        {%- if rendered_count > limit_num -%}
          {%- break -%}
        {%- endif -%}

        {%- assign current_var = prod.first_available_variant | default: prod.variants[0] -%}
        {%- assign is_on_sale = false -%}
        {%- if prod.compare_at_price > prod.price -%}
          {%- assign is_on_sale = true -%}
        {%- endif -%}

        <div class="nau-card" data-product-id="{{ prod.id }}">
          
          <!-- Image Container with SALE badge -->
          <a href="{{ prod.url }}" class="nau-media-wrap" aria-label="{{ prod.title | escape }}">
            {%- if is_on_sale and section.settings.show_sale_badge -%}
              <span class="nau-badge-sale">SALE</span>
            {%- endif -%}

            {%- if prod.featured_image != blank -%}
              {{ prod.featured_image | image_url: width: 800 | image_tag: class: 'nau-img', loading: 'lazy', alt: prod.title | escape }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'nau-img' }}
            {%- endif -%}
          </a>

          <!-- Product Information -->
          <div class="nau-info">
            <a href="{{ prod.url }}" class="nau-prod-title">
              {{ prod.title | escape }}
            </a>

            {% render 'luxury-card-rating', product: prod %}

            <div class="nau-price-row">
              <span class="nau-price-regular">{{ prod.price | money }}</span>
              {%- if is_on_sale -%}
                <span class="nau-price-compare">{{ prod.compare_at_price | money }}</span>
              {%- endif -%}
            </div>

            <!-- Instant AJAX Add To Cart -->
            {%- if prod.available -%}
              <button 
                type="button" 
                class="nau-atc-btn" 
                data-variant-id="{{ current_var.id }}"
                onclick="nauAddToCart(this, '{{ current_var.id }}')"
              >
                <span>Add to cart</span>
              </button>
            {%- else -%}
              <button type="button" class="nau-atc-btn" disabled>
                <span>Sold out</span>
              </button>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
    </div>

    {%- if mob_layout == 'slider' -%}
      <div class="nau-slider-progress is-visible" aria-hidden="true">
        <div class="nau-slider-progress-bar" id="NauProgress-{{ section.id }}"></div>
      </div>
    {%- endif -%}

    {%- comment -%} 4. View All Link (Optional) {%- endcomment -%}
    {%- if section.settings.show_view_all -%}
      <div class="nau-footer">
        <a 
          href="{{ section.settings.view_all_link | default: '/collections/all?sort_by=created-descending' }}" 
          class="nau-view-all-link"
        >
          <span>{{ section.settings.view_all_text | default: 'View All New Arrivals' }}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  function nauSlide(sectionId, direction) {
    const grid = document.getElementById('NauGrid-' + sectionId);
    if (!grid) return;
    const card = grid.querySelector('.nau-card');
    const scrollAmount = card ? (card.offsetWidth + 12) * direction : 240 * direction;
    grid.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  }

  function initNauSlider(sectionId) {
    const grid = document.getElementById('NauGrid-' + sectionId);
    const progressBar = document.getElementById('NauProgress-' + sectionId);
    if (!grid || !progressBar) return;

    function updateProgress() {
      const maxScroll = grid.scrollWidth - grid.clientWidth;
      if (maxScroll <= 0) {
        progressBar.style.transform = 'scaleX(1)';
        return;
      }
      const ratio = Math.max(0, Math.min(1, grid.scrollLeft / maxScroll));
      const minScale = 0.35;
      const translateX = ratio * (120 - (120 * minScale));
      progressBar.style.transform = `translateX(${translateX}px)`;
    }

    grid.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }

  document.addEventListener('DOMContentLoaded', function() {
    initNauSlider('{{ section.id }}');
  });
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initNauSlider('{{ section.id }}');
  }
  document.addEventListener('shopify:section:load', function(e) {
    if (e.detail && e.detail.sectionId === '{{ section.id }}') {
      initNauSlider('{{ section.id }}');
    }
  });

  function nauAddToCart(btn, variantId) {
    if (!variantId || btn.classList.contains('is-adding')) return;

    const originalText = btn.innerHTML;
    btn.classList.add('is-adding');
    btn.innerHTML = '<span>Adding...</span>';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        id: variantId,
        quantity: 1
      })
    })
    .then(response => {
      if (!response.ok) throw new Error('Network error');
      return response.json();
    })
    .then(item => {
      btn.classList.remove('is-adding');
      btn.classList.add('is-added');
      btn.innerHTML = '<span>Added ✓</span>';

      // Update cart bubble counter if present in theme
      fetch('/cart.js')
        .then(r => r.json())
        .then(cart => {
          const bubble = document.querySelector('.cart-count-bubble') || document.querySelector('[data-cart-count]');
          if (bubble) {
            bubble.textContent = cart.item_count;
            bubble.classList.remove('hidden');
          }
        })
        .catch(e => console.error(e));

      // Revert button text after 2.5 seconds
      setTimeout(() => {
        btn.classList.remove('is-added');
        btn.innerHTML = originalText;
      }, 2500);
    })
    .catch(error => {
      console.error('Error adding to cart:', error);
      btn.classList.remove('is-adding');
      btn.innerHTML = '<span>Added!</span>';
      setTimeout(() => {
        btn.innerHTML = originalText;
      }, 2000);
    });
  }
</script>

