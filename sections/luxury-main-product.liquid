    outline: none !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04) !important;
  }

  .lp-lb-ctrl-btn:hover {
    background: #163327 !important;
    color: #FAF8F5 !important;
    border-color: #163327 !important;
    transform: scale(1.1) !important;
    box-shadow: 0 4px 12px rgba(22, 51, 39, 0.25) !important;
  }

  .lp-lb-ctrl-btn:active {
    transform: scale(0.96) !important;
  }

  .lp-lb-ctrl-btn svg {
    pointer-events: none !important;
  }

  .lp-lb-counter {
    font-size: 12px !important;
    letter-spacing: 0.16em !important;
    color: #163327 !important;
    font-weight: 600 !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    text-transform: uppercase !important;
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    min-width: 58px !important;
    text-align: center !important;
    user-select: none !important;
  }

  /* -------------------------------------------------------------------------
     3. IN-PRODUCT ACCORDION & CATEGORY-SPECIFIC Q&A
     ------------------------------------------------------------------------- */
  .pdp-details-accordion {
    margin-top: 24px;
    border-top: 1px solid rgba(184, 151, 104, 0.3);
  }

  .pdp-acc-item {
    border-bottom: 1px solid rgba(184, 151, 104, 0.25);
  }

  .pdp-acc-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 0;
    background: transparent;
    border: none;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #141517;
    cursor: pointer;
    text-align: left;
    transition: color 0.2s ease;
  }

  .pdp-acc-trigger:hover,
  .pdp-acc-trigger[aria-expanded="true"] {
    color: #163327;
  }

  .pdp-acc-icon {
    width: 16px;
    height: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #B89768;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pdp-acc-trigger[aria-expanded="true"] .pdp-acc-icon {
    transform: rotate(180deg);
  }

  .pdp-acc-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1), padding 0.25s ease, opacity 0.25s ease;
    opacity: 0;
    padding: 0;
    color: #55524E;
    font-size: 13.5px;
    line-height: 1.6;
  }

  .pdp-acc-content.is-open {
    max-height: 1400px;
    opacity: 1;
    padding-bottom: 18px;
  }

  .pdp-sub-qa-item {
    padding: 10px 0;
    border-top: 1px dashed rgba(184, 151, 104, 0.2);
  }

  .pdp-sub-qa-item:first-child {
    border-top: none;
    padding-top: 0;
  }

  .pdp-sub-q {
    font-weight: 600;
    color: #163327;
    font-size: 13px;
    margin-bottom: 4px;
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .pdp-sub-q-badge {
    color: #B89768;
    font-weight: 700;
    font-size: 11px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .pdp-sub-a {
    font-size: 13px;
    color: #55524E;
    line-height: 1.55;
    margin: 0;
    padding-left: 17px;
  }

  /* Full Width In-Product Q&A Section (Below Stage & Info Grid) */
  .lp-pdp-faq-wrapper {
    margin-top: 56px;
    padding-top: 48px;
    border-top: 1px solid rgba(184, 151, 104, 0.3);
  }

  .lp-pdp-faq-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 36px;
  }

  .lp-pdp-faq-eyebrow {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #B89768;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .lp-pdp-faq-title {
    font-size: 32px;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 500;
    color: #141517;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .lp-pdp-faq-sub {
    font-size: 14px;
    color: #7A7571;
    line-height: 1.5;
    margin: 0;
  }

  .lp-pdp-faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    max-width: 880px;
    margin: 0 auto;
  }

  .lp-faq-card {
    background: #FFFFFF;
    border: 1px solid rgba(184, 151, 104, 0.28);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 3px 12px rgba(20, 21, 23, 0.03);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .lp-faq-card:hover {
    border-color: rgba(184, 151, 104, 0.6);
    box-shadow: 0 6px 18px rgba(20, 21, 23, 0.06);
  }

  .lp-faq-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    background: transparent;
    border: none;
    font-size: 14.5px;
    font-weight: 600;
    color: #141517;
    cursor: pointer;
    text-align: left;
    transition: color 0.2s ease;
  }

  .lp-faq-trigger:hover,
  .lp-faq-trigger[aria-expanded="true"] {
    color: #163327;
  }

  .lp-faq-trigger[aria-expanded="true"] .lp-faq-icon {
    transform: rotate(180deg);
    color: #163327;
  }

  .lp-faq-icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    color: #B89768;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }

  .lp-faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1), padding 0.25s ease, opacity 0.25s ease;
    opacity: 0;
    padding: 0 20px;
    font-size: 13.5px;
    line-height: 1.65;
    color: #55524E;
  }

  .lp-faq-answer.is-open {
    max-height: 600px;
    opacity: 1;
    padding: 0 20px 18px 20px;
  }

  .lp-pdp-faq-footer {
    text-align: center;
    margin-top: 32px;
  }

  .lp-faq-concierge-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #163327;
    text-decoration: none;
    padding: 10px 22px;
    border-radius: 999px;
    border: 1px solid rgba(22, 51, 39, 0.3);
    background: #FFFFFF;
    transition: all 0.25s ease;
  }

  .lp-faq-concierge-btn:hover {
    background: #163327;
    color: #FFFFFF;
    border-color: #163327;
  }
</style>

<section id="LuxuryProduct-{{ section.id }}" class="lp-section pdp-section" aria-label="{{ product.title | escape }}">
  <div class="lp-container pdp-container">

    <!-- 1. Breadcrumb Navigation (MAHJIVA > ALL PRODUCTS > TÊN COLLECTION > TÊN SP) -->
    {%- assign prod_collection = collection -%}
    {%- if prod_collection == blank or prod_collection.handle == 'all' or prod_collection.handle == 'frontpage' -%}
      {%- for c in product.collections -%}
        {%- unless c.handle == 'all' or c.handle == 'frontpage' or c.handle contains 'new' or c.handle contains 'best' -%}
          {%- assign prod_collection = c -%}
          {%- break -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- if prod_collection == blank and product.collections.size > 0 -%}
        {%- assign prod_collection = product.collections.first -%}
      {%- endif -%}
    {%- endif -%}

    {%- assign badge_label = prod_collection.title | default: product.type | default: 'MAHJIVA' | upcase -%}
    {%- if prod_collection.handle == 'mahjong-set' or badge_label == 'TILES' or badge_label == 'TILE' -%}
      {%- assign badge_label = 'MAHJONG SET' -%}
    {%- elsif prod_collection.handle == 'mats' or badge_label == 'MAT' -%}
      {%- assign badge_label = 'MATS' -%}
    {%- elsif prod_collection.handle == 'racks' or badge_label == 'RACK' -%}
      {%- assign badge_label = 'RACKS' -%}
    {%- elsif prod_collection.handle == 'dices' or badge_label == 'DICES' -%}
      {%- assign badge_label = 'DICE' -%}
    {%- elsif prod_collection.handle == 'tile-bag' or badge_label == 'TILE-BAG' or badge_label == 'BAG' -%}
      {%- assign badge_label = 'TILE BAG' -%}
    {%- endif -%}

    <nav class="lp-breadcrumb" aria-label="Breadcrumb">
      <a href="/">MAHJIVA</a>
      <span class="lp-sep">&gt;</span>
      <a href="/collections/all">ALL PRODUCTS</a>
      {%- if prod_collection != blank -%}
        <span class="lp-sep">&gt;</span>
        <a href="{{ prod_collection.url }}">{{ badge_label }}</a>
      {%- endif -%}
      <span class="lp-sep">&gt;</span>
      <span style="color:#163327;font-weight:600;">{{ product.title | upcase }}</span>
    </nav>

    <!-- 2. Grid Architecture: Left Column 54% / Right Column 46% -->
    <div class="lp-grid pdp-grid lp-layout">

      <!-- =====================================================================
           LEFT COLUMN (56%): GALLERY STAGE & FILMSTRIP TRACK
           ===================================================================== -->
      <div class="lp-gallery-col pdp-gallery-col">
        {%- assign current_variant = product.selected_or_first_available_variant -%}
        {%- assign initial_media = current_variant.featured_media | default: product.featured_media | default: product.media.first -%}

        <!-- Master Stage Frame: Ratio 4:3, max-height 520px, border-radius 20px, soft shadow -->
        <div 
          class="lp-stage-frame pdp-main-stage" 
          id="pdpMainStage-{{ section.id }}" 
          role="region" 
          aria-label="Master artwork stage - Click to inspect 2400px"
          title="Click to enter full-screen inspection archive (2400px)"
        >
          {%- if initial_media != blank -%}
            <div class="lp-stage-inner pdp-stage-inner">
              <img 
                id="pdpMainImage-{{ section.id }}"
                class="lp-main-img pdp-main-img"
                src="{{ initial_media | image_url: width: 1200 }}"
                srcset="{{ initial_media | image_url: width: 800 }} 800w, {{ initial_media | image_url: width: 1200 }} 1200w, {{ initial_media | image_url: width: 1600 }} 1600w, {{ initial_media | image_url: width: 2000 }} 2000w"
                sizes="(min-width: 1200px) 720px, (min-width: 992px) 56vw, 100vw"
                alt="{{ initial_media.alt | default: product.title | escape }}"
                loading="eager"
                fetchpriority="high"
                decoding="sync"
                width="1200"
                height="900"
                data-full-src="{{ initial_media | image_url: width: 2400 }}"
                data-media-id="{{ initial_media.id }}"
              >

            </div>
          {%- else -%}
            <div class="pdp-no-image">Artwork imagery in archive</div>
          {%- endif -%}
        </div>

        <!-- Filmstrip Thumbnails Track: Larger 82x82px with navigation buttons -->
        {%- if product.media.size > 1 -%}
          <div class="lp-thumbs-wrapper pdp-thumbs-wrapper">
            <button 
              type="button" 
              class="lp-thumb-nav-btn prev" 
              id="pdpThumbPrev-{{ section.id }}" 
              aria-label="Previous photo"
              title="Previous photo"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 19l-7-7 7-7"/></svg>
            </button>

            <div class="lp-thumbs-track pdp-thumbs-track" id="pdpThumbsTrack-{{ section.id }}" role="tablist" aria-label="Media archive filmstrip">
              {%- for media in product.media -%}
                {%- assign is_active = false -%}
                {%- if media.id == initial_media.id or forloop.first and initial_media == blank -%}
                  {%- assign is_active = true -%}
                {%- endif -%}
                <button
                  type="button"
                  role="tab"
                  class="lp-thumb-item pdp-thumb-item{% if is_active %} is-active{% endif %}"
                  data-media-id="{{ media.id }}"
                  data-index="{{ forloop.index0 }}"
                  data-src="{{ media | image_url: width: 1600 }}"
                  data-srcset="{{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w, {{ media | image_url: width: 2000 }} 2000w"
                  data-full-src="{{ media | image_url: width: 2400 }}"
                  data-alt="{{ media.alt | default: product.title | escape }}"
                  aria-selected="{% if is_active %}true{% else %}false{% endif %}"
                  aria-label="Plate {{ forloop.index }} of {{ product.title | escape }}"
                >
                  <img 
                    src="{{ media | image_url: width: 200, height: 200, crop: 'center' }}"
                    alt="{{ media.alt | default: product.title | escape }}"
                    loading="lazy"
                    decoding="async"
                    width="82"
                    height="82"
                    class="lp-thumb-img pdp-thumb-img"
                  >
                </button>
              {%- endfor -%}
            </div>

            <button 
              type="button" 
              class="lp-thumb-nav-btn next" 
              id="pdpThumbNext-{{ section.id }}" 
              aria-label="Next photo"
              title="Next photo"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>

      <!-- =====================================================================
           RIGHT COLUMN (44%): SUITE DOSSIER & COMMERCE (STICKY)
           ===================================================================== -->
      <div class="lp-info-col pdp-info-col">

        <!-- Eyebrow & Tag (Dynamic Collection Badge - 100% Real Shopify Data) -->
        <div class="pdp-tag-row">
          {%- if prod_collection != blank -%}
            <a href="{{ prod_collection.url }}" class="pdp-badge-tag" title="View {{ badge_label }} Collection">
              {{ badge_label }}
            </a>
          {%- else -%}
            <span class="pdp-badge-tag">
              {{ badge_label }}
            </span>
          {%- endif -%}
          {%- if product.vendor != blank -%}
            <span class="pdp-vendor-text">{{ product.vendor | escape }}</span>
          {%- endif -%}
        </div>

        <!-- Suite Title & Information Group -->
        <div class="pdp-title-desc-group">
          <!-- Judge.me Star Rating Badge directly above Product Title -->
          <div class="pdp-judgeme-rating" id="pdpJudgemeRating-{{ section.id }}" title="View customer reviews">
            <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
              {{ product.metafields.judgeme.badge }}
            </div>
          </div>

          <h1 class="pdp-title">{{ product.title | escape }}</h1>

          <!-- Delivery Estimation & Schedule Widget (Directly Below Product Title) -->
          <div class="pdp-delivery-estimator" id="pdpDeliveryEstimator-{{ section.id }}">
            <!-- Row 1: Deliver to Country -->
            <div class="pdp-delivery-row pdp-delivery-country-wrap">
              <span class="pdp-delivery-label">Deliver to:</span>
              <button 
                type="button" 
                class="pdp-delivery-trigger pdp-country-trigger" 
                id="pdpCountryTrigger-{{ section.id }}" 
                aria-expanded="false"
                aria-label="Change delivery country"
              >
                <span class="pdp-delivery-val" id="pdpCountryName-{{ section.id }}">{{ localization.country.name | default: 'United States' }}</span>
                <svg class="pdp-chevron-icon" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>

              <!-- Country Selection Popover -->
              <div class="pdp-country-popover" id="pdpCountryPopover-{{ section.id }}" hidden>
                <div class="pdp-popover-header">
                  <span class="pdp-popover-title">Select Delivery Destination</span>
                  <button type="button" class="pdp-popover-close" id="pdpCountryClose-{{ section.id }}" aria-label="Close">✕</button>
                </div>
                {%- form 'localization', id: 'PdpDeliveryCountryForm', class: 'pdp-delivery-form' -%}
                  <input type="hidden" name="country_code" id="PdpDeliveryCountryInput" value="{{ localization.country.iso_code }}">
                  <div class="pdp-country-search-wrap">
                    <input type="search" class="pdp-country-search-input" id="pdpCountrySearch-{{ section.id }}" placeholder="Search country or currency..." autocomplete="off">
                  </div>
                  <ul class="pdp-country-list" role="list">
                    {%- for country in localization.available_countries -%}
                      <li>
                        <button 
                          type="button" 
                          class="pdp-country-select-item{% if country.iso_code == localization.country.iso_code %} is-selected{% endif %}"
                          data-country-code="{{ country.iso_code }}"
                        >
                          <span class="pdp-country-flag">{% render 'country-flag', country: country, country_code: country.iso_code %}</span>
                          <span class="pdp-country-name-text">{{ country.name }}</span>
                          <span class="pdp-country-curr-tag">{{ country.currency.iso_code }}</span>
                        </button>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endform -%}
              </div>
            </div>

            <!-- Row 2: Order today, get it as early as -->
            <div class="pdp-delivery-row pdp-delivery-schedule-wrap">
              <span class="pdp-delivery-label">Order today, get it as early as:</span>
              <button 
                type="button" 
                class="pdp-delivery-trigger pdp-schedule-trigger" 
                id="pdpScheduleTrigger-{{ section.id }}" 
                aria-expanded="false"
                aria-label="View delivery schedule"
              >
                <span class="pdp-delivery-val pdp-delivery-date" id="pdpMainDeliveryDate-{{ section.id }}">
                  {{ 'now' | date: '%s' | plus: 604800 | date: '%B %d' }}-{{ 'now' | date: '%s' | plus: 864000 | date: '%d' }}
                </span>
                <svg class="pdp-chevron-icon pdp-schedule-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>

              <!-- Delivery Method Popover (Exact match to screenshot) -->
              <div class="pdp-delivery-popover" id="pdpDeliveryPopover-{{ section.id }}" hidden>
                <div class="pdp-popover-arrow"></div>
                <div class="pdp-delivery-card">
                  <!-- Header -->
                  <div class="pdp-delivery-card-header">
                    <div class="pdp-delivery-method-title">
                      <svg class="pdp-truck-icon" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M1 3h15v13H1zM16 8h4.5l3.5 4v4h-8zM5.5 18a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM18.5 18a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"/>
                      </svg>
                      <span>Delivery Method</span>
                    </div>
                    <button type="button" class="pdp-delivery-close-btn" id="pdpDeliveryClose-{{ section.id }}" aria-label="Close delivery method popup">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                      </svg>
                    </button>
                  </div>

                  <!-- Subtitle -->
                  <div class="pdp-delivery-subheading">Standard Shipping:</div>

                  <!-- 3 Milestone Rows -->
                  <div class="pdp-delivery-milestones">
                    <div class="pdp-milestone-row">
                      <span class="pdp-milestone-label">Order Placed:</span>
                      <span class="pdp-milestone-val" id="pdpPlacedDate-{{ section.id }}">
                        {{ 'now' | date: '%B %d' }}
                      </span>
                    </div>
                    <div class="pdp-milestone-row">
                      <span class="pdp-milestone-label">Order Ships:</span>
                      <span class="pdp-milestone-val" id="pdpShipsDate-{{ section.id }}">
                        {{ 'now' | date: '%s' | plus: 86400 | date: '%B %d' }}-{{ 'now' | date: '%s' | plus: 172800 | date: '%d' }}
                      </span>
                    </div>
                    <div class="pdp-milestone-row">
                      <span class="pdp-milestone-label">Delivered:</span>
                      <span class="pdp-milestone-val" id="pdpDeliveredDate-{{ section.id }}">
                        {{ 'now' | date: '%s' | plus: 604800 | date: '%B %d' }}-{{ 'now' | date: '%s' | plus: 864000 | date: '%d' }}
                      </span>
                    </div>
                  </div>

                  <!-- Notes -->
                  <div class="pdp-delivery-notes">
                    <div class="pdp-note-item">
                      <span class="pdp-bullet">&bull;</span>
                      <span>Orders can be cancelled or modified within 2 hours after being placed.</span>
                    </div>
                    <div class="pdp-note-item">
                      <span class="pdp-bullet">&bull;</span>
                      <span>Canvas/ Poster/ Metal Sign: These packages cannot be delivered to a PO box.</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Product Information / Description Directly Below Title -->
          {%- if product.description != blank -%}
            <div class="pdp-description rte">
              {{ product.description }}
            </div>
          {%- endif -%}
        </div>

        <!-- Tax & Diplomatic Transit Notice -->
        <div class="pdp-tax-notice">
          <span>Complimentary Insured Diplomatic Courier & Archival Certificate</span>
        </div>

        <!-- Bundle Deals Block (Buy More Save More) - Server-side 100% -->
        {%- assign has_bundle_deals = false -%}
        {%- if current_variant.price > 0 -%}
          {%- if product.metafields.custom.bundle_deals != blank or product.tags contains 'bundle' or section.settings.enable_bundle_deals -%}
            {%- assign has_bundle_deals = true -%}
          {%- endif -%}
        {%- endif -%}

        {%- if has_bundle_deals -%}
          <div class="pdp-bundle-container" id="pdpBundleContainer-{{ section.id }}">
            <div class="pdp-bundle-header">
              <span class="pdp-bundle-heading">CURATED ALLOCATIONS (BUY MORE SAVE MORE)</span>
            </div>
            <div class="pdp-bundle-grid">
              <!-- Tier 1 -->
              <div class="pdp-bundle-card is-selected" data-bundle-qty="1">
                <span class="pdp-bundle-badge">STANDARD</span>
                <div class="pdp-bundle-card-content">
                  <div class="pdp-bundle-card-info">
                    <span class="pdp-bundle-title">01 Allocation Suite</span>
                    <span class="pdp-bundle-sub">Standard allocation</span>
                  </div>
                  <div class="pdp-bundle-pricing">
                    <span class="pdp-bundle-price" data-bundle-base="{{ current_variant.price }}">{{ current_variant.price | money }}</span>
                  </div>
                </div>
              </div>

              <!-- Tier 2 -->
              <div class="pdp-bundle-card" data-bundle-qty="2">
                <span class="pdp-bundle-badge pdp-bundle-badge-save">SAVE 10%</span>
                <div class="pdp-bundle-card-content">
                  <div class="pdp-bundle-card-info">
                    <span class="pdp-bundle-title">02 Allocation Suites</span>
                    <span class="pdp-bundle-sub">Diplomatic pair</span>
                  </div>
                  <div class="pdp-bundle-pricing">
                    <span class="pdp-bundle-price" data-bundle-discount="0.9">{{ current_variant.price | times: 1.8 | money }}</span>
                    <s class="pdp-bundle-compare">{{ current_variant.price | times: 2 | money }}</s>
                  </div>
                </div>
              </div>

              <!-- Tier 3 -->
              <div class="pdp-bundle-card" data-bundle-qty="3">
                <span class="pdp-bundle-badge pdp-bundle-badge-vip">MAISON VIP (-20%)</span>
                <div class="pdp-bundle-card-content">
                  <div class="pdp-bundle-card-info">
                    <span class="pdp-bundle-title">03 Allocation Suites</span>
                    <span class="pdp-bundle-sub">Private salon heirloom</span>
                  </div>
                  <div class="pdp-bundle-pricing">
                    <span class="pdp-bundle-price" data-bundle-discount="0.8">{{ current_variant.price | times: 2.4 | money }}</span>
                    <s class="pdp-bundle-compare">{{ current_variant.price | times: 3 | money }}</s>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}

        <!-- Commerce & Variant Form -->
        {%- assign product_form_id = 'PdpForm-' | append: section.id -%}
        {%- form 'product', product, id: product_form_id, class: 'pdp-form' -%}
          <input type="hidden" name="id" id="PdpVariantId-{{ section.id }}" value="{{ current_variant.id }}">

          <!-- Variant Selectors (Swatch Card Grid & Pill Selector) -->
          {%- unless product.has_only_default_variant -%}
            <div class="pdp-variants-wrapper">
              {%- for option in product.options_with_values -%}
                {%- assign opt_idx = forloop.index0 -%}
                {%- assign opt_pos = option.position -%}

                {%- comment -%} Determine if this option has variant swatch images {%- endcomment -%}
                {%- assign has_swatch_images = false -%}
                {%- for val in option.values -%}
                  {%- for variant in product.variants -%}
                    {%- case opt_pos -%}
                      {%- when 1 -%}
                        {%- if variant.option1 == val and variant.featured_image != blank -%}
                          {%- assign has_swatch_images = true -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- when 2 -%}
                        {%- if variant.option2 == val and variant.featured_image != blank -%}
                          {%- assign has_swatch_images = true -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- when 3 -%}
                        {%- if variant.option3 == val and variant.featured_image != blank -%}
                          {%- assign has_swatch_images = true -%}
                          {%- break -%}
                        {%- endif -%}
                    {%- endcase -%}
                  {%- endfor -%}
                  {%- if has_swatch_images -%}{%- break -%}{%- endif -%}
                {%- endfor -%}

                <div class="pdp-option-group">
                  <div class="pdp-option-label">
                    <span class="pdp-option-name">{{ option.name | upcase }}:</span>
                    <span class="pdp-option-value-selected" id="pdpSelectedValue-{{ section.id }}-{{ opt_idx }}">
                      {{ option.selected_value }}
                    </span>
                  </div>

                  {%- if has_swatch_images -%}
                    <!-- 4-Column Specimen Swatch Card Grid (As requested) -->
                    <div class="pdp-swatch-grid">
                      {%- for value in option.values -%}
                        {%- assign swatch_img = nil -%}
                        {%- for variant in product.variants -%}
                          {%- case opt_pos -%}
                            {%- when 1 -%}
                              {%- if variant.option1 == value and variant.featured_image != blank -%}
                                {%- assign swatch_img = variant.featured_image -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- when 2 -%}
                              {%- if variant.option2 == value and variant.featured_image != blank -%}
                                {%- assign swatch_img = variant.featured_image -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- when 3 -%}
                              {%- if variant.option3 == value and variant.featured_image != blank -%}
                                {%- assign swatch_img = variant.featured_image -%}
                                {%- break -%}
                              {%- endif -%}
                          {%- endcase -%}
                        {%- endfor -%}

                        {%- if swatch_img == blank -%}
                          {%- for img in product.images -%}
                            {%- assign alt_down = img.alt | downcase -%}
                            {%- assign val_down = value | downcase -%}
                            {%- if alt_down contains val_down or img.src contains val_down -%}
                              {%- assign swatch_img = img -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endif -%}

                        <button
                          type="button"
                          class="pdp-opt-btn pdp-opt-card{% if option.selected_value == value %} is-selected{% endif %}"
                          data-option-index="{{ opt_idx }}"
                          data-value="{{ value | escape }}"
                          aria-label="{{ value | escape }}"
                          title="{{ value | escape }}"
                        >
                          <div class="pdp-card-img-wrap">
                            {%- if swatch_img != blank -%}
                              <img
                                src="{{ swatch_img | image_url: width: 240 }}"
                                alt="{{ value | escape }}"
                                class="pdp-card-img"
                                width="70"
                                height="70"
                                loading="lazy"
                              >
                            {%- else -%}
                              <div class="pdp-card-img-fallback">
                                <span>{{ value | slice: 0, 2 | upcase }}</span>
                              </div>
                            {%- endif -%}
                          </div>
                          <span class="pdp-card-label">{{ value }}</span>
                        </button>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <!-- Standard Pill Selectors -->
                    <div class="pdp-option-values">
                      {%- for value in option.values -%}
                        <button
                          type="button"
                          class="pdp-opt-btn pdp-opt-pill{% if option.selected_value == value %} is-selected{% endif %}"
                          data-option-index="{{ opt_idx }}"
                          data-value="{{ value | escape }}"
                        >
                          {{ value }}
                        </button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <!-- Price Display Directly Above ATC Button -->
          <div class="pdp-price-row maison-cls-price-slot">
            <span class="pdp-current-price{% if current_variant.price == 0 %} is-inquiry-price{% endif %}" id="pdpPrice-{{ section.id }}">
              {%- if current_variant.price > 0 -%}
                {{ current_variant.price | money }}
              {%- else -%}
                PRICE UPON INQUIRY
              {%- endif -%}
            </span>
            <span class="pdp-compare-price" id="pdpComparePrice-{{ section.id }}" style="{% unless current_variant.compare_at_price > current_variant.price and current_variant.price > 0 %}display: none;{% endunless %}">
              {%- if current_variant.compare_at_price > current_variant.price and current_variant.price > 0 -%}
                {{ current_variant.compare_at_price | money }}
              {%- endif -%}
            </span>
          </div>

          <!-- Suite Acquisition Action Buttons -->
          <div class="lp-actions-wrapper pdp-actions-wrapper">
            <button 
              type="submit" 
              name="add" 
              id="pdpAddBtn-{{ section.id }}" 
              class="lp-add-btn pdp-add-btn lp-primary-btn"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span id="pdpAddBtnText-{{ section.id }}">
                {%- if current_variant.available -%}
                  ADD TO CART
                {%- else -%}
                  SOLD OUT
                {%- endif -%}
              </span>
            </button>
          </div>
        {%- endform -%}

        <!-- App Blocks / Upsell Slot (Placed between Action Buttons and Payment & Guarantees) -->
        {%- assign has_app_blocks = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' or block.type == 'custom_liquid' -%}
            {%- assign has_app_blocks = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_app_blocks -%}
          <div class="pdp-app-blocks-slot" id="pdpAppBlocksSlot-{{ section.id }}">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  <div class="pdp-app-block-item" {{ block.shopify_attributes }}>
                    {% render block %}
                  </div>
                {%- when 'custom_liquid' -%}
                  <div class="pdp-custom-liquid-block" {{ block.shopify_attributes }}>
                    {{ block.settings.custom_liquid }}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%}
          =======================================================================
          DYNAMIC CATEGORY DETECTION FOR PRODUCT GUARANTEES & Q&A ARCHIVE
          - Sets: 'tiles' (American Mahjong Sets), 'bags', 'mats', 'racks', 'dices'
          =======================================================================
        {%- endcomment -%}
        {%- assign product_category = 'tiles' -%}
        {%- assign category_label = 'American Mahjong Sets' -%}

        {%- assign cat_name = '' -%}
        {%- if product.category and product.category.name -%}
          {%- assign cat_name = product.category.name | downcase -%}
        {%- endif -%}
        {%- assign p_type = product.type | downcase -%}
        {%- assign p_handle = product.handle | downcase -%}
        {%- assign p_title = product.title | downcase -%}

        {%- assign tag_str = '' -%}
        {%- for t in product.tags -%}
          {%- assign t_down = t | downcase -%}
          {%- assign tag_str = tag_str | append: ' ' | append: t_down -%}
        {%- endfor -%}

        {%- assign coll_str = '' -%}
        {%- for c in product.collections -%}
          {%- assign c_h = c.handle | downcase -%}
          {%- assign c_t = c.title | downcase -%}
          {%- assign coll_str = coll_str | append: ' ' | append: c_h | append: ' ' | append: c_t -%}
        {%- endfor -%}

        {%- if p_type contains 'bag' or cat_name contains 'bag' or coll_str contains 'bag' or p_handle contains 'bag' or p_title contains 'bag' or tag_str contains 'bag' or p_type contains 'túi' or p_title contains 'túi' or coll_str contains 'tui' -%}
          {%- assign product_category = 'bags' -%}
          {%- assign category_label = 'Tile Carrying Bags' -%}
        {%- elsif p_type contains 'mat' or cat_name contains 'mat' or coll_str contains 'mat' or p_handle contains 'mat' or p_title contains 'mat' or tag_str contains 'mat' or p_type contains 'thảm' or p_title contains 'thảm' or coll_str contains 'tham' -%}
          {%- assign product_category = 'mats' -%}
          {%- assign category_label = 'Table Playing Mats' -%}
        {%- elsif p_type contains 'rack' or cat_name contains 'rack' or coll_str contains 'rack' or p_handle contains 'rack' or p_title contains 'rack' or tag_str contains 'rack' or p_type contains 'khay' or p_title contains 'khay' -%}
          {%- assign product_category = 'racks' -%}
          {%- assign category_label = 'Mahjong Racks & Pushers' -%}
        {%- elsif p_type contains 'dice' or cat_name contains 'dice' or coll_str contains 'dice' or p_handle contains 'dice' or p_title contains 'dice' or tag_str contains 'dice' or p_type contains 'xúc xắc' or p_title contains 'xúc xắc' or coll_str contains 'xuc-xac' -%}
          {%- assign product_category = 'dices' -%}
          {%- assign category_label = 'Artisanal Dice Sets' -%}
        {%- else -%}
          {%- assign product_category = 'tiles' -%}
          {%- assign category_label = 'American Mahjong Sets' -%}
        {%- endif -%}

        <!-- Payment & Guarantee Bar -->
        {%- if section.settings.show_payment_guarantee != false -%}
          {%- assign g1_text = 'Easy Returns' -%}
          {%- case product_category -%}
            {%- when 'tiles' -%}
              {%- assign g2_text = 'NMJL-Ready Tile Sets' -%}
            {%- when 'mats' -%}
              {%- assign g2_text = 'Designed for Mahjong' -%}
            {%- when 'racks' -%}
              {%- assign g2_text = 'Keep Your Tiles Organized' -%}
            {%- when 'dices' -%}
              {%- assign g2_text = 'Made for Mahjong' -%}
            {%- when 'bags' -%}
              {%- assign g2_text = 'Carry Your Tiles in Style' -%}
            {%- else -%}
              {%- assign g2_text = 'NMJL-Ready Tile Sets' -%}
          {%- endcase -%}
          {%- assign g3_text = 'U.S. Shipping' -%}

          <div class="pdp-guarantee-bar">
            <!-- 3 Category-Specific Guarantee Features Above Logos -->
            <div class="pdp-guarantee-features">
              <div class="pdp-guarantee-feature-item">
                <span class="pdp-guarantee-feature-icon">
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="10" cy="10" r="10" fill="#163327"/>
                    <path d="M6 10.2L8.7 13L14.2 7.5" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="pdp-guarantee-feature-text">{{ g1_text }}</span>
              </div>

              <div class="pdp-guarantee-feature-item">
                <span class="pdp-guarantee-feature-icon">
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="10" cy="10" r="10" fill="#163327"/>
                    <path d="M6 10.2L8.7 13L14.2 7.5" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="pdp-guarantee-feature-text">{{ g2_text }}</span>
              </div>

              <div class="pdp-guarantee-feature-item">
                <span class="pdp-guarantee-feature-icon">
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="10" cy="10" r="10" fill="#163327"/>
                    <path d="M6 10.2L8.7 13L14.2 7.5" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="pdp-guarantee-feature-text">{{ g3_text }}</span>
              </div>
            </div>

            <!-- Payment Icons (100% Dynamic from Shopify Server shop.enabled_payment_types) -->
            {%- unless shop.enabled_payment_types == empty -%}
              <div class="pdp-payment-icons-wrapper">
                <div class="pdp-payment-icons-list" id="pdpPaymentIcons-{{ section.id }}" aria-label="Accepted Payment Methods">
                  {%- for type in shop.enabled_payment_types -%}
                    {%- liquid
                      assign type_title = type | replace: '_', ' ' | capitalize
                      if type == 'american_express'
                        assign type_title = 'American Express'
                      elsif type == 'apple_pay'
                        assign type_title = 'Apple Pay'
                      elsif type == 'google_pay'
                        assign type_title = 'Google Pay'
                      elsif type == 'shopify_pay'
                        assign type_title = 'Shop Pay'
                      elsif type == 'master'
                        assign type_title = 'Mastercard'
                      elsif type == 'diners_club'
                        assign type_title = 'Diners Club'
                      elsif type == 'unionpay'
                        assign type_title = 'UnionPay'
                      elsif type == 'ideal'
                        assign type_title = 'iDEAL'
                      elsif type == 'jcb'
                        assign type_title = 'JCB'
                      elsif type == 'blik'
                        assign type_title = 'BLIK'
                      elsif type == 'mbway'
                        assign type_title = 'MB WAY'
                      elsif type == 'bancontact'
                        assign type_title = 'Bancontact'
                      endif
                    -%}
                    <span class="pdp-payment-badge" title="{{ type_title }}">
                      {{ type | payment_type_svg_tag: class: 'pdp-payment-svg' }}
                    </span>
                  {%- endfor -%}
                </div>
              </div>
            {%- endunless -%}
          </div>
        {%- endif -%}



      </div>

    </div>

    <!-- =========================================================================
         DEDICATED IN-PRODUCT Q&A SECTION (CATEGORY-TAILORED & ADMIN CUSTOMIZABLE)
         ========================================================================= -->
    {%- if section.settings.show_pdp_faq_section -%}
    <div class="lp-pdp-faq-wrapper" id="pdpFaqArchive-{{ section.id }}">
      <div class="lp-pdp-faq-header">
        <span class="lp-pdp-faq-eyebrow">CLIENT CARE • Q&A ARCHIVE</span>
        <h2 class="lp-pdp-faq-title" style="text-transform: uppercase; letter-spacing: 0.05em;">A FEW THINGS BEFORE YOU PURCHASE</h2>
        <p class="lp-pdp-faq-sub">Everything you need to know about our handcrafted {{ category_label | downcase }} and concierge care.</p>
      </div>

      <div class="lp-pdp-faq-grid">
        {%- comment -%} 1. Render Admin Custom FAQ Blocks if configured {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq_item' -%}
            <div class="lp-faq-card" {{ block.shopify_attributes }}>
              <button 
                type="button" 
                class="lp-faq-trigger" 
                aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="lpFaqCard-{{ block.id }}"
              >
                <span>{{ block.settings.question | escape }}</span>
                <span class="lp-faq-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                </span>
              </button>
              <div class="lp-faq-answer{% if forloop.first %} is-open{% endif %}" id="lpFaqCard-{{ block.id }}">
                {{ block.settings.answer }}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} 2. Category-Specific Default Q&A Cards {%- endcomment -%}
        {%- case product_category -%}
          {%- when 'tiles' -%}
            <div class="lp-faq-card">
              <button type="button" class="lp-faq-trigger" aria-expanded="true" aria-controls="lpFaq-t1-{{ section.id }}">
                <span>1. Are Mahjiva sets ready for American Mahjong?</span>
                <span class="lp-faq-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
              </button>
              <div class="lp-faq-answer is-open" id="lpFaq-t1-{{ section.id }}">
                <p>Yes! Every Mahjiva tile set is NMJL-ready for American Mahjong. For the exact tile count and configuration, check the Details section of your chosen set.</p>
              </div>
            </div>

            <div class="lp-faq-card">
              <button type="button" class="lp-faq-trigger" aria-expanded="false" aria-controls="lpFaq-t2-{{ section.id }}">
                <span>2. What’s included with my set?</span>
                <span class="lp-faq-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
              </button>
              <div class="lp-faq-answer" id="lpFaq-t2-{{ section.id }}">
                <p>Each product page lists the tiles and accessories included with your purchase. Mats, racks, bags, and dice featured in lifestyle photos are included only when specifically listed.</p>
              </div>
            </div>

            <div class="lp-faq-card">
              <button type="button" class="lp-faq-trigger" aria-expanded="false" aria-controls="lpFaq-t3-{{ section.id }}">
                <span>3. Is the artwork engraved or printed?</span>
                <span class="lp-faq-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
              </button>
              <div class="lp-faq-answer" id="lpFaq-t3-{{ section.id }}">
                <p>Most Mahjiva sets feature hand-engraved artwork, while select designs use high-quality printing. We stand behind the colorfast finish of both—our tile artwork is guaranteed not to fade. Check your chosen set’s description for its specific finish.</p>
              </div>
            </div>

            <div class="lp-faq-card">
              <button type="button" class="lp-faq-trigger" aria-expanded="false" aria-controls="lpFaq-t4-{{ section.id }}">
                <span>4. Will the colors look exactly like the photos?</span>
                <span class="lp-faq-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
              </button>
              <div class="lp-faq-answer" id="lpFaq-t4-{{ section.id }}">
                <p>Colors may appear slightly lighter or darker in person due to lighting, photography, and screen settings. These subtle differences are normal and don’t indicate fading or a product defect.</p>
              </div>
            </div>

            <div class="lp-faq-card">
              <button type="button" class="lp-faq-trigger" aria-expanded="false" aria-controls="lpFaq-t5-{{ section.id }}">
                <span>5. When will my order arrive, and what if something isn’t right?</span>
                <span class="lp-faq-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
              </button>
              <div class="lp-faq-answer" id="lpFaq-t5-{{ section.id }}">
                <p>All orders arrive within 1–2 weeks. If your order arrives damaged, incorrect, or has another issue, please contact us with your order number and photos. We offer returns and exchanges within 30 days of delivery.</p>
              </div>
            </div>

          {%- when 'bags' -%}
            <div class="lp-faq-card">
              <button type="button" class="lp-faq-trigger" aria-expanded="true" aria-controls="lpFaq-b1-{{ section.id }}">
                <span>1. How do I know if my tiles will fit?</span>
                <span class="lp-faq-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
              </button>
              <div class="lp-faq-answer is-open" id="lpFaq-b1-{{ section.id }}">
                <p>Compare your tile set’s measurements with the dimensions and capacity listed on the product page. If you’re unsure, send us your tile size and the bag you’re considering—we’re happy to help.</p>
              </div>
            </div>

            <div class="lp-faq-card">
              <button type="button" class="lp-faq-trigger" aria-expanded="false" aria-controls="lpFaq-b2-{{ section.id }}">
                <span>2. Are tiles or accessories included with the bag?</span>
                <span class="lp-faq-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
              </button>
              <div class="lp-faq-answer" id="lpFaq-b2-{{ section.id }}">
                <p>Check the product description for exactly what’s included. Tiles, racks, dice, and other accessories shown in styled photos are included only when specifically listed.</p>
              </div>
            </div>

            <div class="lp-faq-card">
              <button type="button" class="lp-faq-trigger" aria-expanded="false" aria-controls="lpFaq-b3-{{ section.id }}">
                <span>3. How should I clean my tile bag?</span>
                <span class="lp-faq-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
              </button>
              <div class="lp-faq-answer" id="lpFaq-b3-{{ section.id }}">
                <p>For light cleaning, gently wipe with a soft, slightly damp cloth and let it air-dry before storing. Avoid soaking or harsh cleaners, and follow any care instructions provided for your chosen style.</p>
              </div>
