    border-color: #B89768;
    transform: translateY(-2px);
  }

  .pdp-bundle-card.is-selected {
    border-color: #163327;
    background: #F4F8F5;
    box-shadow: 0 4px 14px rgba(22, 51, 39, 0.12);
  }

  .pdp-bundle-badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 4px 10px;
    border-radius: 9999px;
    background: #163327;
    color: #FAF8F5;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    border: 1px solid rgba(216, 184, 140, 0.4);
  }

  .pdp-bundle-badge-save {
    background: #B89768;
    color: #FFFFFF;
  }

  .pdp-bundle-badge-vip {
    background: #163327;
    color: #D8B88C;
  }

  .pdp-bundle-card-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  .pdp-bundle-title {
    font-size: 13px;
    font-weight: 700;
    color: #141517;
  }

  .pdp-bundle-sub {
    font-size: 11px;
    color: #7A7571;
  }

  .pdp-bundle-pricing {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
    margin-top: 4px;
    flex-wrap: wrap;
  }

  .pdp-bundle-price {
    font-size: 14px;
    font-weight: 700;
    color: #163327;
  }

  .pdp-bundle-compare {
    font-size: 12px;
    color: #9E978E;
    text-decoration: line-through;
  }

  /* MOBILE BUNDLE REDESIGN: Viewport < 768px (Single column card stack) */
  @media (max-width: 767px) {
    .pdp-bundle-grid {
      grid-template-columns: 1fr;
      gap: 12px;
