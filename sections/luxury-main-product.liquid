<!-- =========================================================================
     VANILLA JAVASCRIPT: STAGE, FILMSTRIP & LIGHTBOX CONTROLLER
     ========================================================================= -->
<script>
  (function() {
    const sectionEl = document.getElementById('LuxuryProduct-{{ section.id }}') || document.getElementById('LuxuryMainProduct-{{ section.id }}');
    if (!sectionEl) return;

    // Elements
    const mainStage = document.getElementById('pdpMainStage-{{ section.id }}');
    const mainImg = document.getElementById('pdpMainImage-{{ section.id }}');
    const zoomTrigger = document.getElementById('pdpZoomTrigger-{{ section.id }}');
    const thumbsTrack = document.getElementById('pdpThumbsTrack-{{ section.id }}');
    const thumbItems = Array.from(sectionEl.querySelectorAll('.lp-thumb-item, .pdp-thumb-item'));

    // Lightbox Elements
    const lbModal = document.getElementById('AtelierLightbox');
    const lightboxImg = document.getElementById('lbMainImg');
    const lightboxPlate = document.getElementById('lbPlateTitle');
    const lightboxCounter = document.getElementById('lbCounterBadge');

    // Automatically teleport #AtelierLightbox to document.body
    function ensureLightboxInBody() {
      const modal = document.getElementById('AtelierLightbox');
      if (modal && modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }
    }
    ensureLightboxInBody();
    document.addEventListener('DOMContentLoaded', ensureLightboxInBody);

    let activeIdx = thumbItems.findIndex(t => t.classList.contains('is-active'));
    let currentIndex = activeIdx >= 0 ? activeIdx : 0;
    const totalMedia = thumbItems.length > 0 ? thumbItems.length : 1;
    let switchTimeout = null;

    // Helper: format 2-digit numbers
    const formatNumber = num => (num < 10 ? '0' + num : num);

    // 1. Switch Stage Image with Silky Crossfade (0.25s)
    function switchMainImage(index) {
      if (!mainImg || !thumbItems[index]) return;
      currentIndex = index;

      const targetThumb = thumbItems[index];
      const newSrc = targetThumb.getAttribute('data-src');
      const newSrcset = targetThumb.getAttribute('data-srcset');
      const fullSrc = targetThumb.getAttribute('data-full-src');
      const altText = targetThumb.getAttribute('data-alt') || '';

      // Update thumb active state
      thumbItems.forEach(t => {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      targetThumb.classList.add('is-active');
      targetThumb.setAttribute('aria-selected', 'true');

      // Scroll thumbnail into view smoothly
      if (thumbsTrack) {
        targetThumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }

      // Silky Crossfade Transition on Main Stage (0.25s)
      if (switchTimeout) clearTimeout(switchTimeout);
      mainImg.classList.add('is-switching');
      mainImg.classList.add('is-transitioning');

      switchTimeout = setTimeout(() => {
        if (newSrcset) {
          mainImg.setAttribute('srcset', newSrcset);
        } else {
          mainImg.removeAttribute('srcset');
        }
        mainImg.src = newSrc;
        mainImg.alt = altText;
        mainImg.setAttribute('data-full-src', fullSrc);
        mainImg.classList.remove('is-switching');
        mainImg.classList.remove('is-transitioning');
      }, 120);

      // Preload & Sync Lightbox Image & Text
      const lbImg = document.getElementById('lbMainImg');
      if (lbImg) {
        lbImg.src = fullSrc;
        lbImg.alt = altText;
        lbImg.classList.remove('is-zoomed');
      }
      const lbPlate = document.getElementById('lbPlateTitle');
      if (lbPlate) {
        lbPlate.textContent = `PLATE ${formatNumber(currentIndex + 1)} • ATELIER ARCHIVE`;
      }
      const lbCounter = document.getElementById('lbCounterBadge');
      if (lbCounter) {
        lbCounter.textContent = `${formatNumber(currentIndex + 1)} / ${formatNumber(totalMedia)}`;
      }
    }

    // Attach click events to thumbnails
    thumbItems.forEach((thumb, idx) => {
      thumb.addEventListener('click', (e) => {
        e.preventDefault();
        switchMainImage(idx);
      });
    });

    // Thumbnail Navigation Buttons (Prev / Next) & Mouse Wheel Horizontal Scroll
    const thumbPrevBtn = document.getElementById('pdpThumbPrev-{{ section.id }}');
    const thumbNextBtn = document.getElementById('pdpThumbNext-{{ section.id }}');

    if (thumbPrevBtn) {
      thumbPrevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        let prevIdx = (currentIndex - 1 + totalMedia) % totalMedia;
        switchMainImage(prevIdx);
      });
    }

    if (thumbNextBtn) {
      thumbNextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        let nextIdx = (currentIndex + 1) % totalMedia;
        switchMainImage(nextIdx);
      });
    }

    // Horizontal mouse wheel scrolling over thumbnail track
    if (thumbsTrack) {
      thumbsTrack.addEventListener('wheel', (e) => {
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          e.preventDefault();
          thumbsTrack.scrollBy({ left: e.deltaY * 1.5, behavior: 'smooth' });
        }
      }, { passive: false });
    }

    // 2. Inspection Lightbox Operations
    function openLightbox() {
      const modal = document.getElementById('AtelierLightbox');
      if (!modal) return;
      ensureLightboxInBody();

      const targetThumb = thumbItems[currentIndex];
      const currentFullSrc = targetThumb ? targetThumb.getAttribute('data-full-src') : (mainImg ? (mainImg.getAttribute('data-full-src') || mainImg.src) : '');
      const currentAlt = targetThumb ? targetThumb.getAttribute('data-alt') : (mainImg ? mainImg.alt : '');

      const lbImg = document.getElementById('lbMainImg');
      if (lbImg && currentFullSrc) {
        lbImg.src = currentFullSrc;
        lbImg.alt = currentAlt || '';
        lbImg.classList.remove('is-zoomed');
      }
      const lbPlate = document.getElementById('lbPlateTitle');
      if (lbPlate) {
        lbPlate.textContent = `PLATE ${formatNumber(currentIndex + 1)} • ATELIER ARCHIVE`;
      }
      const lbCounter = document.getElementById('lbCounterBadge');
      if (lbCounter) {
        lbCounter.textContent = `${formatNumber(currentIndex + 1)} / ${formatNumber(totalMedia)}`;
      }

      modal.classList.add('active');
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      document.addEventListener('keydown', handleKeyDown);
    }

    function closeLightbox() {
      const modal = document.getElementById('AtelierLightbox');
      if (!modal) return;
      modal.classList.remove('active');
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      const lbImg = document.getElementById('lbMainImg');
      if (lbImg) lbImg.classList.remove('is-zoomed');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', handleKeyDown);
    }

    function toggleLightboxZoom() {
      const lbImg = document.getElementById('lbMainImg');
      if (lbImg) {
        lbImg.classList.toggle('is-zoomed');
      }
    }

    function changeLightboxImage(direction) {
      if (totalMedia <= 1) return;
      let nextIdx = (currentIndex + direction + totalMedia) % totalMedia;
      switchMainImage(nextIdx);
    }

    // Expose functions globally for inline onclick handlers
    window.closeLightbox = closeLightbox;
    window.closeAtelierLightbox = closeLightbox;
    window.openLightbox = openLightbox;
    window.openAtelierLightbox = openLightbox;
    window.toggleLightboxZoom = toggleLightboxZoom;
    window.changeLightboxImage = changeLightboxImage;

    function handleKeyDown(e) {
      const modal = document.getElementById('AtelierLightbox');
      if (!modal || (!modal.classList.contains('active') && !modal.classList.contains('is-open'))) return;
      if (e.key === 'Escape' || e.keyCode === 27) {
        closeLightbox();
      } else if (e.key === 'ArrowRight' || e.keyCode === 39) {
        changeLightboxImage(1);
      } else if (e.key === 'ArrowLeft' || e.keyCode === 37) {
        changeLightboxImage(-1);
      }
    }

    if (mainStage) {
      mainStage.addEventListener('click', (e) => {
        openLightbox();
      });
    }

    if (zoomTrigger) {
      zoomTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        openLightbox();
      });
    }

    // 3. Variant Switching Logic & Product Form
    const productData = {{ product | json }};
    const optionBtns = Array.from(sectionEl.querySelectorAll('.pdp-opt-btn'));
    const variantIdInput = document.getElementById('PdpVariantId-{{ section.id }}');
    const priceEl = document.getElementById('pdpPrice-{{ section.id }}');
    const comparePriceEl = document.getElementById('pdpComparePrice-{{ section.id }}');
    const addBtn = document.getElementById('pdpAddBtn-{{ section.id }}');
    const addBtnText = document.getElementById('pdpAddBtnText-{{ section.id }}');

    // Helper: format money text without innerHTML re-render (Prevents layout shift and font flicker)
    const moneyFormatString = {{ shop.money_format | json }};
    function formatMoneyText(cents) {
      if (!cents || cents <= 0) {
        return 'PRICE UPON INQUIRY';
      }
      if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
        const dummy = document.createElement('div');
        dummy.innerHTML = Shopify.formatMoney(cents, moneyFormatString);
        return dummy.textContent || dummy.innerText || '';
      }
      return (cents / 100).toLocaleString('{{ request.locale.iso_code | default: "en-US" }}') + ' {{ cart.currency.symbol | default: localization.country.currency.symbol | default: "$" }}';
    }

    function getSelectedOptions() {
      const selected = [];
      const groups = sectionEl.querySelectorAll('.pdp-option-group');
      groups.forEach((group, gIdx) => {
        const activeBtn = group.querySelector('.pdp-opt-btn.is-selected');
        if (activeBtn) {
          selected.push(activeBtn.getAttribute('data-value'));
        }
      });
      return selected;
    }

    function onOptionClick(clickedBtn) {
      const group = clickedBtn.closest('.pdp-option-group');
      if (!group) return;

      group.querySelectorAll('.pdp-opt-btn').forEach(btn => btn.classList.remove('is-selected'));
      clickedBtn.classList.add('is-selected');

      const optIdx = clickedBtn.getAttribute('data-option-index');
      const labelValEl = document.getElementById(`pdpSelectedValue-{{ section.id }}-${optIdx}`);
      if (labelValEl) {
        labelValEl.textContent = clickedBtn.getAttribute('data-value');
      }

      const selectedOptions = getSelectedOptions();

      // Find matched variant
      if (productData && productData.variants) {
        const matchedVariant = productData.variants.find(variant => {
          return variant.options.every((optVal, idx) => optVal === selectedOptions[idx]);
        });

        if (matchedVariant) {
          if (variantIdInput) variantIdInput.value = matchedVariant.id;

          // Refactor variant change: Pure DOM textContent mutation (Zero innerHTML / Zero layout flicker)
          if (priceEl && matchedVariant.price !== undefined) {
            priceEl.textContent = formatMoneyText(matchedVariant.price);
            if (matchedVariant.price <= 0) {
              priceEl.classList.add('is-inquiry-price');
            } else {
              priceEl.classList.remove('is-inquiry-price');
            }
          }

          if (comparePriceEl) {
            if (matchedVariant.compare_at_price && matchedVariant.compare_at_price > matchedVariant.price && matchedVariant.price > 0) {
              comparePriceEl.textContent = formatMoneyText(matchedVariant.compare_at_price);
              comparePriceEl.style.display = 'inline';
            } else {
              comparePriceEl.textContent = '';
              comparePriceEl.style.display = 'none';
            }
          }

          // Update bundle card prices if bundle exists
          const bundleCards = sectionEl.querySelectorAll('.pdp-bundle-card');
          if (bundleCards.length > 0 && matchedVariant.price > 0) {
            bundleCards.forEach(bCard => {
              const qty = parseInt(bCard.getAttribute('data-bundle-qty') || '1', 10);
              const bPriceEl = bCard.querySelector('.pdp-bundle-price');
              const bCompEl = bCard.querySelector('.pdp-bundle-compare');
              if (qty === 1 && bPriceEl) {
                bPriceEl.textContent = formatMoneyText(matchedVariant.price);
              } else if (qty === 2 && bPriceEl) {
                bPriceEl.textContent = formatMoneyText(Math.round(matchedVariant.price * 1.8));
                if (bCompEl) bCompEl.textContent = formatMoneyText(matchedVariant.price * 2);
              } else if (qty === 3 && bPriceEl) {
                bPriceEl.textContent = formatMoneyText(Math.round(matchedVariant.price * 2.4));
                if (bCompEl) bCompEl.textContent = formatMoneyText(matchedVariant.price * 3);
              }
            });
          }

          // Stock button state
          if (addBtn && addBtnText) {
            if (!matchedVariant.available) {
              addBtn.disabled = true;
              addBtnText.textContent = 'SOLD OUT';
            } else {
              addBtn.disabled = false;
              addBtnText.textContent = 'ADD TO CART';
            }
          }

          // Switch image if variant has featured image
          if (matchedVariant.featured_image) {
            const featId = matchedVariant.featured_image.id;
            const featSrc = matchedVariant.featured_image.src;
            let mediaIdx = -1;
            if (featId) {
              mediaIdx = thumbItems.findIndex(t => t.getAttribute('data-media-id') == featId);
            }
            if (mediaIdx === -1 && featSrc) {
              const filename = featSrc.split('?')[0].split('/').pop();
              mediaIdx = thumbItems.findIndex(t => {
                const s = t.getAttribute('data-src') || '';
                return s.includes(filename);
              });
            }
            if (mediaIdx !== -1) {
              switchMainImage(mediaIdx);
            } else if (featSrc) {
              mainImg.removeAttribute('srcset');
              mainImg.src = featSrc;
            }
          }
        }
      }
    }

    optionBtns.forEach(btn => {
      btn.addEventListener('click', () => onOptionClick(btn));
    });

    // Bundle Card selection interaction
    // Bundle Card selection interaction
    const bundleCardList = sectionEl.querySelectorAll('.pdp-bundle-card');
    bundleCardList.forEach(bCard => {
      bCard.addEventListener('click', () => {
        bundleCardList.forEach(c => c.classList.remove('is-selected'));
        bCard.classList.add('is-selected');
      });
    });

    // Accordion toggle handlers (Right Column & Full Q&A)
    const accTriggers = sectionEl.querySelectorAll('.pdp-acc-trigger, .lp-faq-trigger');
    accTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
        trigger.setAttribute('aria-expanded', !isExpanded);
        const content = trigger.nextElementSibling;
        if (content) {
          content.classList.toggle('is-open', !isExpanded);
        }
      });
    });

    // Judge.me rating click handler -> smooth scroll down to reviews widget
    const judgemeRating = document.getElementById('pdpJudgemeRating-{{ section.id }}');
    if (judgemeRating) {
      judgemeRating.addEventListener('click', () => {
        const reviewWidget = document.querySelector('.jdgm-review-widget, #judgeme_product_reviews, [data-from-snippet="true"]');
        if (reviewWidget) {
          reviewWidget.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }

    // Delivery Estimator & Shipping Schedule Popover Handler
    (function initDeliveryEstimator() {
      const now = new Date();
      function formatRange(d1, d2) {
        const m1 = d1.toLocaleString('en-US', { month: 'long' });
        const day1 = d1.getDate();
        const m2 = d2.toLocaleString('en-US', { month: 'long' });
        const day2 = d2.getDate();
        return (m1 === m2) ? `${m1} ${day1}-${day2}` : `${m1} ${day1} - ${m2} ${day2}`;
      }
      function formatSingle(d) {
        return `${d.toLocaleString('en-US', { month: 'long' })} ${d.getDate()}`;
      }

      const ship1 = new Date(now); ship1.setDate(now.getDate() + 1);
      const ship2 = new Date(now); ship2.setDate(now.getDate() + 2);
      const del1 = new Date(now); del1.setDate(now.getDate() + 7);
      const del2 = new Date(now); del2.setDate(now.getDate() + 10);

      const placedStr = formatSingle(now);
      const shipsStr = formatRange(ship1, ship2);
      const delStr = formatRange(del1, del2);

      const mainDelDate = document.getElementById('pdpMainDeliveryDate-{{ section.id }}');
      const placedDateEl = document.getElementById('pdpPlacedDate-{{ section.id }}');
      const shipsDateEl = document.getElementById('pdpShipsDate-{{ section.id }}');
      const delDateEl = document.getElementById('pdpDeliveredDate-{{ section.id }}');

      if (mainDelDate) mainDelDate.textContent = delStr;
      if (placedDateEl) placedDateEl.textContent = placedStr;
      if (shipsDateEl) shipsDateEl.textContent = shipsStr;
      if (delDateEl) delDateEl.textContent = delStr;

      // Delivery Method Popover Toggle
      const scheduleTrigger = document.getElementById('pdpScheduleTrigger-{{ section.id }}');
      const deliveryPopover = document.getElementById('pdpDeliveryPopover-{{ section.id }}');
      const deliveryCloseBtn = document.getElementById('pdpDeliveryClose-{{ section.id }}');

      function toggleDeliveryPopover(show) {
        if (!deliveryPopover || !scheduleTrigger) return;
        const isHidden = deliveryPopover.hasAttribute('hidden');
        const willShow = show !== undefined ? show : isHidden;
        if (willShow) {
          deliveryPopover.removeAttribute('hidden');
          scheduleTrigger.setAttribute('aria-expanded', 'true');
          toggleCountryPopover(false);
        } else {
          deliveryPopover.setAttribute('hidden', 'true');
          scheduleTrigger.setAttribute('aria-expanded', 'false');
        }
      }

      if (scheduleTrigger) {
        scheduleTrigger.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleDeliveryPopover();
        });
      }

      if (deliveryCloseBtn) {
        deliveryCloseBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleDeliveryPopover(false);
        });
      }

      // Country Selection Popover Toggle
      const countryTrigger = document.getElementById('pdpCountryTrigger-{{ section.id }}');
      const countryPopover = document.getElementById('pdpCountryPopover-{{ section.id }}');
      const countryCloseBtn = document.getElementById('pdpCountryClose-{{ section.id }}');
      const countrySearch = document.getElementById('pdpCountrySearch-{{ section.id }}');
      const countryForm = document.getElementById('PdpDeliveryCountryForm');
      const countryInput = document.getElementById('PdpDeliveryCountryInput');

      function toggleCountryPopover(show) {
        if (!countryPopover || !countryTrigger) return;
        const isHidden = countryPopover.hasAttribute('hidden');
        const willShow = show !== undefined ? show : isHidden;
        if (willShow) {
          countryPopover.removeAttribute('hidden');
          countryTrigger.setAttribute('aria-expanded', 'true');
          toggleDeliveryPopover(false);
          if (countrySearch) {
            setTimeout(() => countrySearch.focus(), 60);
          }
        } else {
          countryPopover.setAttribute('hidden', 'true');
          countryTrigger.setAttribute('aria-expanded', 'false');
        }
      }

      if (countryTrigger) {
        countryTrigger.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleCountryPopover();
        });
      }

      if (countryCloseBtn) {
        countryCloseBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleCountryPopover(false);
        });
      }

      if (countrySearch) {
        countrySearch.addEventListener('input', () => {
          const q = countrySearch.value.toLowerCase().trim();
          const items = countryPopover.querySelectorAll('.pdp-country-select-item');
          items.forEach(item => {
            const txt = item.textContent.toLowerCase();
            const li = item.closest('li');
            if (li) li.style.display = txt.includes(q) ? '' : 'none';
          });
        });
      }

      if (countryPopover) {
        const countryItems = countryPopover.querySelectorAll('.pdp-country-select-item');
        countryItems.forEach(item => {
          item.addEventListener('click', (e) => {
            e.preventDefault();
            const code = item.getAttribute('data-country-code');
            if (code && countryInput && countryForm) {
              countryInput.value = code;
              countryForm.submit();
            }
          });
        });
      }

      // Close popovers when clicking outside
      document.addEventListener('click', (e) => {
        const estimator = document.getElementById('pdpDeliveryEstimator-{{ section.id }}');
        if (estimator && !estimator.contains(e.target)) {
          toggleDeliveryPopover(false);
          toggleCountryPopover(false);
        }
      });
    })();

  })();
</script>

