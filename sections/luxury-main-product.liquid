  <div id="AtelierLightbox" role="dialog" aria-modal="true" onclick="if(!event.target.closest('#lbMainImg') && !event.target.closest('.lp-lb-controls-bar')) closeLightbox()">
    <!-- SÂN KHẤU TRUNG TÂM -->
    <div class="lp-lb-stage">
      <img id="lbMainImg" src="{{ initial_media | image_url: width: 2400 }}" alt="{{ initial_media.alt | default: product.title | escape }}" class="lp-lb-img" onclick="event.stopPropagation();" ondblclick="toggleLightboxZoom()">
    </div>

    <!-- COMPACT LUXURY BOTTOM CONTROLLER (Buttons next to counter) -->
    <div class="lp-lb-footer" onclick="event.stopPropagation();">
      <div class="lp-lb-controls-bar">
        <button 
          type="button" 
          class="lp-lb-ctrl-btn prev" 
          onclick="event.stopPropagation(); changeLightboxImage(-1);" 
          aria-label="Previous image"
          title="Previous image"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 19l-7-7 7-7"/></svg>
        </button>

        <span class="lp-lb-counter" id="lbCounterBadge">01 / {{ product.media.size | default: 1 | prepend: '0' | slice: -2, 2 }}</span>

        <button 
          type="button" 
          class="lp-lb-ctrl-btn next" 
          onclick="event.stopPropagation(); changeLightboxImage(1);" 
          aria-label="Next image"
          title="Next image"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
