        <img 
          id="lbMainImg" 
          src="{{ initial_media | image_url: width: 2400 }}" 
          alt="{% render 'luxury-image-alt', image: initial_media, product: product, index: 1 %}" 
          class="lp-lb-img" 
          width="{{ initial_media.width }}" 
          height="{{ initial_media.height }}" 
          loading="eager" 
          decoding="sync"
          onclick="event.stopPropagation();" 
          ondblclick="toggleLightboxZoom()"
        >
      </div>

      <!-- THANH ĐIỀU HƯỚNG GẮN LIỀN NGAY DƯỚI ẢNH -->
      <div class="lp-lb-footer">
        <div class="lp-lb-controls-bar">
          <button 
            type="button" 
            class="lp-lb-ctrl-btn prev" 
            onclick="event.stopPropagation(); changeLightboxImage(-1);" 
            aria-label="Previous image"
            title="Previous image"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 19l-7-7 7-7"/></svg>
          </button>

          <span class="lp-lb-counter" id="lbCounterBadge">01 / {{ product.media.size | default: 1 | prepend: '0' | slice: -2, 2 }}</span>

          <button 
            type="button" 
            class="lp-lb-ctrl-btn next" 
            onclick="event.stopPropagation(); changeLightboxImage(1);" 
            aria-label="Next image"
            title="Next image"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Luxury Sticky Product Bar -->
  <div class="lp-mobile-sticky-bar" id="pdpMobileStickyBar-{{ section.id }}" aria-hidden="true">
    <div class="lp-msb-inner">
      <div class="lp-msb-left">
        {%- if initial_media != blank -%}
          <img 
            id="pdpMsbThumb-{{ section.id }}"
            src="{{ initial_media | image_url: width: 120 }}" 
            alt="{{ product.title | escape }}"
            class="lp-msb-thumb"
            width="44"
            height="44"
            loading="lazy"
          >
        {%- endif -%}
        <div class="lp-msb-info">
          <div class="lp-msb-title">{{ product.title }}</div>
          <div class="lp-msb-price" id="pdpMsbPrice-{{ section.id }}">{{ current_variant.price | money }}</div>
        </div>
      </div>
      <div class="lp-msb-right">
        <button 
          type="button" 
          class="lp-msb-btn" 
          id="pdpMsbBtn-{{ section.id }}"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <span id="pdpMsbBtnText-{{ section.id }}">
            {%- if current_variant.available -%}
              ADD TO CART
            {%- else -%}
              SOLD OUT
            {%- endif -%}
          </span>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================================
     VANILLA JAVASCRIPT: STAGE, FILMSTRIP & LIGHTBOX CONTROLLER
     ========================================================================= -->
<script>
  window.handlePdpCustomPhotoSelect = function(input, sectionId) {
    const content = document.getElementById('pdpPhotosContent-' + sectionId);
    const selected = document.getElementById('pdpPhotosSelected-' + sectionId);
    const filename = document.getElementById('pdpPhotosFilename-' + sectionId);
    if (input.files && input.files[0]) {
      if (content) content.style.display = 'none';
      if (selected) selected.style.display = 'inline-flex';
      if (filename) filename.textContent = '✓ ' + input.files[0].name;
    }
  };

  window.removePdpCustomPhoto = function(sectionId) {
    const input = document.getElementById('PdpCustomPhotos-' + sectionId);
    const content = document.getElementById('pdpPhotosContent-' + sectionId);
    const selected = document.getElementById('pdpPhotosSelected-' + sectionId);
    const filename = document.getElementById('pdpPhotosFilename-' + sectionId);
    if (input) input.value = '';
    if (content) content.style.display = 'block';
    if (selected) selected.style.display = 'none';
    if (filename) filename.textContent = '';
  };

  (function() {
    const sectionEl = document.getElementById('LuxuryProduct-{{ section.id }}') || document.getElementById('LuxuryMainProduct-{{ section.id }}');
    if (!sectionEl) return;

    // Elements
    const mainStage = document.getElementById('pdpMainStage-{{ section.id }}');
    const mainImg = document.getElementById('pdpMainImage-{{ section.id }}');
    const zoomTrigger = document.getElementById('pdpZoomTrigger-{{ section.id }}');
    const thumbsTrack = document.getElementById('pdpThumbsTrack-{{ section.id }}');
    const thumbItems = Array.from(sectionEl.querySelectorAll('.lp-thumb-item, .pdp-thumb-item'));

    // Lightbox Elements
    const lbModal = document.getElementById('AtelierLightbox');
    const lightboxImg = document.getElementById('lbMainImg');
    const lightboxPlate = document.getElementById('lbPlateTitle');
    const lightboxCounter = document.getElementById('lbCounterBadge');

    // Automatically teleport #AtelierLightbox to document.body
    function ensureLightboxInBody() {
      const modal = document.getElementById('AtelierLightbox');
      if (modal && modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }
    }
    ensureLightboxInBody();
    document.addEventListener('DOMContentLoaded', ensureLightboxInBody);

    let activeIdx = thumbItems.findIndex(t => t.classList.contains('is-active'));
    let currentIndex = activeIdx >= 0 ? activeIdx : 0;
    const totalMedia = thumbItems.length > 0 ? thumbItems.length : 1;
    let switchTimeout = null;

    // Helper: format 2-digit numbers
    const formatNumber = num => (num < 10 ? '0' + num : num);

    // Helper: mathematically center thumbnail in track without causing vertical page jump
    function scrollThumbIntoView(index) {
      if (!thumbsTrack || !thumbItems[index]) return;
      const targetThumb = thumbItems[index];
      const trackRect = thumbsTrack.getBoundingClientRect();
      const thumbRect = targetThumb.getBoundingClientRect();
      
      const currentScroll = thumbsTrack.scrollLeft;
      const relativeOffset = thumbRect.left - trackRect.left;
      const targetScroll = currentScroll + relativeOffset - (trackRect.width / 2) + (thumbRect.width / 2);
      const maxScroll = Math.max(0, thumbsTrack.scrollWidth - thumbsTrack.clientWidth);
      const clampedScroll = Math.max(0, Math.min(maxScroll, targetScroll));
      
      thumbsTrack.scrollTo({
        left: clampedScroll,
        behavior: 'smooth'
      });
    }

    // 1. Switch Stage Image with Silky Crossfade (0.2s)
    function switchMainImage(index) {
      if (!mainImg || !thumbItems[index]) return;
      currentIndex = index;

      const targetThumb = thumbItems[index];
      const newSrc = targetThumb.getAttribute('data-src');
      const newSrcset = targetThumb.getAttribute('data-srcset');
      const fullSrc = targetThumb.getAttribute('data-full-src');
      const altText = targetThumb.getAttribute('data-alt') || '';

      // Update thumb active state
      thumbItems.forEach(t => {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      targetThumb.classList.add('is-active');
      targetThumb.setAttribute('aria-selected', 'true');

      // Scroll thumbnail into view smoothly
      scrollThumbIntoView(index);

      // Silky Crossfade Transition on Main Stage
      if (switchTimeout) clearTimeout(switchTimeout);
      mainImg.classList.add('is-switching');
      mainImg.classList.add('is-transitioning');

      switchTimeout = setTimeout(() => {
        if (newSrcset) {
          mainImg.setAttribute('srcset', newSrcset);
        } else {
          mainImg.removeAttribute('srcset');
        }
        mainImg.src = newSrc;
        mainImg.alt = altText;
        mainImg.setAttribute('data-full-src', fullSrc);
        mainImg.classList.remove('is-switching');
        mainImg.classList.remove('is-transitioning');
      }, 90);

      // Preload & Sync Lightbox Image & Text
      const lbImg = document.getElementById('lbMainImg');
      if (lbImg) {
        lbImg.src = fullSrc;
        lbImg.alt = altText;
        lbImg.classList.remove('is-zoomed');
      }
      const lbPlate = document.getElementById('lbPlateTitle');
      if (lbPlate) {
        lbPlate.textContent = `PLATE ${formatNumber(currentIndex + 1)} • ATELIER ARCHIVE`;
      }
      const lbCounter = document.getElementById('lbCounterBadge');
      if (lbCounter) {
        lbCounter.textContent = `${formatNumber(currentIndex + 1)} / ${formatNumber(totalMedia)}`;
      }
    }

    let isTrackDown = false;
    let trackStartX = 0;
    let trackScrollLeft = 0;
    let hasDraggedTrack = false;

    // Attach click events to thumbnails
    thumbItems.forEach((thumb, idx) => {
      thumb.addEventListener('click', (e) => {
        e.preventDefault();
        if (hasDraggedTrack) return;
        switchMainImage(idx);
      });
    });

    // Thumbnail Navigation Buttons (Prev / Next) & Mouse Wheel Horizontal Scroll
    const thumbPrevBtn = document.getElementById('pdpThumbPrev-{{ section.id }}');
    const thumbNextBtn = document.getElementById('pdpThumbNext-{{ section.id }}');

    if (thumbPrevBtn) {
      thumbPrevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        let prevIdx = (currentIndex - 1 + totalMedia) % totalMedia;
        switchMainImage(prevIdx);
      });
    }

    if (thumbNextBtn) {
      thumbNextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        let nextIdx = (currentIndex + 1) % totalMedia;
        switchMainImage(nextIdx);
      });
    }

    // Horizontal mouse wheel & drag-to-scroll on thumbnail track
    let dragRaf = 0, momentumRaf = 0, pendingLeft = 0, lastX = 0, lastT = 0, velocity = 0;
    const stopMomentum = () => { cancelAnimationFrame(momentumRaf); momentumRaf = 0; };
    if (thumbsTrack) thumbsTrack.addEventListener('wheel', (e) => { stopMomentum(); if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return; const max = Math.max(0, thumbsTrack.scrollWidth - thumbsTrack.clientWidth); const cur = thumbsTrack.scrollLeft; if (max <= 0 || (e.deltaY < 0 && cur <= 0) || (e.deltaY > 0 && cur >= max)) return; e.preventDefault(); thumbsTrack.scrollLeft = Math.max(0, Math.min(max, cur + e.deltaY * 1.5)); }, { passive: false });
  if (thumbsTrack) thumbsTrack.addEventListener('dragstart', (e) => e.preventDefault());
if (thumbsTrack) thumbsTrack.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse' || e.button !== 0) return; stopMomentum(); thumbsTrack.scrollTo({ left: thumbsTrack.scrollLeft, behavior: 'auto' }); isTrackDown = true; hasDraggedTrack = false; trackStartX = e.clientX; trackScrollLeft = thumbsTrack.scrollLeft; lastX = e.clientX; lastT = performance.now(); velocity = 0; });
window.addEventListener('pointermove', (e) => { if (!isTrackDown || e.pointerType !== 'mouse') return; const walk = e.clientX - trackStartX; if (!hasDraggedTrack) { if (Math.abs(walk) < 6) return; hasDraggedTrack = true; trackStartX = e.clientX; trackScrollLeft = thumbsTrack.scrollLeft; thumbsTrack.classList.add('is-dragging'); try { thumbsTrack.setPointerCapture(e.pointerId); } catch (err) {} return; } e.preventDefault(); const now = performance.now(); const dt = now - lastT; if (dt > 0) velocity = 0.75 * velocity + 0.25 * ((lastX - e.clientX) / dt); lastX = e.clientX; lastT = now; pendingLeft = trackScrollLeft - (e.clientX - trackStartX); if (!dragRaf) dragRaf = requestAnimationFrame(() => { dragRaf = 0; thumbsTrack.scrollLeft = pendingLeft; }); });
const endTrackDrag = (e) => { if (!isTrackDown) return; isTrackDown = false; thumbsTrack.classList.remove('is-dragging'); try { thumbsTrack.releasePointerCapture(e.pointerId); } catch (err) {} if (!hasDraggedTrack) return; cancelAnimationFrame(dragRaf); dragRaf = 0; let v = (performance.now() - lastT < 80) ? velocity * 16 : 0; const max = Math.max(0, thumbsTrack.scrollWidth - thumbsTrack.clientWidth); if (Math.abs(v) > 0.6) { const step = () => { v *= 0.94; const next = thumbsTrack.scrollLeft + v; thumbsTrack.scrollLeft = Math.max(0, Math.min(max, next)); if (Math.abs(v) > 0.4 && next > 0 && next < max) momentumRaf = requestAnimationFrame(step); }; momentumRaf = requestAnimationFrame(step); } setTimeout(() => { hasDraggedTrack = false; }, 60); };
window.addEventListener('pointerup', endTrackDrag);
window.addEventListener('pointercancel', endTrackDrag);

// 2. Inspection Lightbox Operations
    function openLightbox() {
      const modal = document.getElementById('AtelierLightbox');
      if (!modal) return;
      ensureLightboxInBody();

      const targetThumb = thumbItems[currentIndex];
      const currentFullSrc = targetThumb ? targetThumb.getAttribute('data-full-src') : (mainImg ? (mainImg.getAttribute('data-full-src') || mainImg.src) : '');
      const currentAlt = targetThumb ? targetThumb.getAttribute('data-alt') : (mainImg ? mainImg.alt : '');

      const lbImg = document.getElementById('lbMainImg');
      if (lbImg && currentFullSrc) {
        lbImg.src = currentFullSrc;
        lbImg.alt = currentAlt || '';
        lbImg.classList.remove('is-zoomed');
      }
      const lbPlate = document.getElementById('lbPlateTitle');
      if (lbPlate) {
        lbPlate.textContent = `PLATE ${formatNumber(currentIndex + 1)} • ATELIER ARCHIVE`;
      }
      const lbCounter = document.getElementById('lbCounterBadge');
      if (lbCounter) {
        lbCounter.textContent = `${formatNumber(currentIndex + 1)} / ${formatNumber(totalMedia)}`;
      }

      modal.classList.add('active');
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      document.addEventListener('keydown', handleKeyDown);
    }

    function closeLightbox() {
      const modal = document.getElementById('AtelierLightbox');
      if (!modal) return;
      modal.classList.remove('active');
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      const lbImg = document.getElementById('lbMainImg');
      if (lbImg) lbImg.classList.remove('is-zoomed');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', handleKeyDown);
    }

    function toggleLightboxZoom() {
      const lbImg = document.getElementById('lbMainImg');
      if (lbImg) {
        lbImg.classList.toggle('is-zoomed');
      }
    }

    function changeLightboxImage(direction) {
      if (totalMedia <= 1) return;
      let nextIdx = (currentIndex + direction + totalMedia) % totalMedia;
      switchMainImage(nextIdx);
    }

    // Expose functions globally for inline onclick handlers
    window.closeLightbox = closeLightbox;
    window.closeAtelierLightbox = closeLightbox;
    window.openLightbox = openLightbox;
    window.openAtelierLightbox = openLightbox;
    window.toggleLightboxZoom = toggleLightboxZoom;
    window.changeLightboxImage = changeLightboxImage;

    function handleKeyDown(e) {
      const modal = document.getElementById('AtelierLightbox');
      if (!modal || (!modal.classList.contains('active') && !modal.classList.contains('is-open'))) return;
      if (e.key === 'Escape' || e.keyCode === 27) {
        closeLightbox();
      } else if (e.key === 'ArrowRight' || e.keyCode === 39) {
        changeLightboxImage(1);
      } else if (e.key === 'ArrowLeft' || e.keyCode === 37) {
        changeLightboxImage(-1);
      }
    }

    // Touch & Swipe gesture on Master Main Stage (Image 2 - Mobile & iPad)
    let stageTouchStartX = 0;
    let stageTouchStartY = 0;
    let stageTouchEndX = 0;
    let stageTouchEndY = 0;
    let isStageTouching = false;
    let stageSwipeOccurred = false;

    if (mainStage) {
      mainStage.addEventListener('touchstart', (e) => {
        if (!e.touches || e.touches.length === 0) return;
        isStageTouching = true;
        stageSwipeOccurred = false;
        stageTouchStartX = e.touches[0].clientX;
        stageTouchStartY = e.touches[0].clientY;
        stageTouchEndX = stageTouchStartX;
        stageTouchEndY = stageTouchStartY;
      }, { passive: true });

      mainStage.addEventListener('touchmove', (e) => {
        if (!isStageTouching || !e.touches || e.touches.length === 0) return;
        stageTouchEndX = e.touches[0].clientX;
        stageTouchEndY = e.touches[0].clientY;
        const diffX = stageTouchStartX - stageTouchEndX;
        const diffY = stageTouchStartY - stageTouchEndY;
        if (Math.abs(diffX) > 12 && Math.abs(diffX) > Math.abs(diffY)) {
          stageSwipeOccurred = true;
        }
      }, { passive: true });

      const handleStageSwipeEnd = () => {
        if (!isStageTouching) return;
        isStageTouching = false;
        const diffX = stageTouchStartX - stageTouchEndX;
        const diffY = stageTouchStartY - stageTouchEndY;
        if (Math.abs(diffX) > 35 && Math.abs(diffX) > Math.abs(diffY)) {
          stageSwipeOccurred = true;
          if (diffX > 0) {
            let nextIdx = (currentIndex + 1) % totalMedia;
            switchMainImage(nextIdx);
          } else {
            let prevIdx = (currentIndex - 1 + totalMedia) % totalMedia;
            switchMainImage(prevIdx);
          }
        }
        setTimeout(() => { stageSwipeOccurred = false; }, 80);
      };

      mainStage.addEventListener('touchend', (e) => {
        if (e.changedTouches && e.changedTouches.length > 0) {
          stageTouchEndX = e.changedTouches[0].clientX;
          stageTouchEndY = e.changedTouches[0].clientY;
        }
        handleStageSwipeEnd();
      }, { passive: true });

      mainStage.addEventListener('touchcancel', handleStageSwipeEnd, { passive: true });

      // Mouse drag-to-swipe on Desktop & iPad trackpad
      let stageMouseDown = false;
      let stageMouseStartX = 0;
      let stageMouseStartY = 0;

      mainStage.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        stageMouseDown = true;
        stageSwipeOccurred = false;
        stageMouseStartX = e.clientX;
        stageMouseStartY = e.clientY;
      });

      window.addEventListener('mouseup', (e) => {
        if (!stageMouseDown) return;
        stageMouseDown = false;
        const diffX = stageMouseStartX - e.clientX;
        const diffY = stageMouseStartY - e.clientY;
        if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
          stageSwipeOccurred = true;
          if (diffX > 0) {
            let nextIdx = (currentIndex + 1) % totalMedia;
            switchMainImage(nextIdx);
          } else {
            let prevIdx = (currentIndex - 1 + totalMedia) % totalMedia;
            switchMainImage(prevIdx);
          }
        }
        setTimeout(() => { stageSwipeOccurred = false; }, 80);
      });

      // Click handler: only open lightbox if user did NOT swipe/drag
      mainStage.addEventListener('click', (e) => {
        if (stageSwipeOccurred) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        openLightbox();
      });
    }

    // Touch swipe support in full-screen Lightbox modal
    const lightboxModalEl = document.getElementById('AtelierLightbox') || lbModal;
    if (lightboxModalEl) {
      let lbTouchStartX = 0;
      let lbTouchStartY = 0;
      let lbTouchEndX = 0;
      let lbTouchEndY = 0;

      lightboxModalEl.addEventListener('touchstart', (e) => {
        if (!e.touches || e.touches.length === 0) return;
        lbTouchStartX = e.touches[0].clientX;
        lbTouchStartY = e.touches[0].clientY;
        lbTouchEndX = lbTouchStartX;
        lbTouchEndY = lbTouchStartY;
      }, { passive: true });

      lightboxModalEl.addEventListener('touchmove', (e) => {
        if (!e.touches || e.touches.length === 0) return;
        lbTouchEndX = e.touches[0].clientX;
        lbTouchEndY = e.touches[0].clientY;
      }, { passive: true });

      lightboxModalEl.addEventListener('touchend', () => {
        const diffX = lbTouchStartX - lbTouchEndX;
        const diffY = lbTouchStartY - lbTouchEndY;
        if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
          if (diffX > 0) {
            changeLightboxImage(1);
          } else {
            changeLightboxImage(-1);
          }
        }
      }, { passive: true });
    }

    if (zoomTrigger) {
      zoomTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        openLightbox();
      });
    }

    // 3. Variant Switching Logic & Product Form
    const productData = {{ product | json }};
    const optionBtns = Array.from(sectionEl.querySelectorAll('.pdp-opt-btn'));
    const variantIdInput = document.getElementById('PdpVariantId-{{ section.id }}');
    const priceEl = document.getElementById('pdpPrice-{{ section.id }}');
    const comparePriceEl = document.getElementById('pdpComparePrice-{{ section.id }}');
    const addBtn = document.getElementById('pdpAddBtn-{{ section.id }}');
    const addBtnText = document.getElementById('pdpAddBtnText-{{ section.id }}');
    const pdpForm = document.getElementById('PdpForm-{{ section.id }}');
    const qtyWrapper = sectionEl.querySelector('.pdp-qty-wrapper');
    const qtyInput = document.getElementById('pdpQtyInput-{{ section.id }}');
    const minusBtn = document.getElementById('pdpQtyMinus-{{ section.id }}');
    const plusBtn = document.getElementById('pdpQtyPlus-{{ section.id }}');

    function isCurrentVariantAvailable() {
      if (qtyWrapper && qtyWrapper.classList.contains('is-disabled')) return false;
      if (addBtn && addBtn.disabled && addBtnText && addBtnText.textContent.trim() === 'SOLD OUT') return false;
      return true;
    }

    function updatePdpQty(newVal) {
      if (!qtyInput) return;
      const isAvailable = isCurrentVariantAvailable();
      let val = parseInt(newVal, 10);
      if (isNaN(val) || val < 1) val = 1;
      if (val > 99) val = 99;
      qtyInput.value = val;
      qtyInput.setAttribute('value', val);

      if (minusBtn) {
        const isMin = (!isAvailable) || (val <= 1);
        minusBtn.disabled = isMin;
        minusBtn.classList.toggle('is-disabled', isMin);
        if (isMin) {
          minusBtn.setAttribute('aria-disabled', 'true');
        } else {
          minusBtn.removeAttribute('aria-disabled');
        }
      }

      if (plusBtn) {
        const isMax = (!isAvailable) || (val >= 99);
        plusBtn.disabled = isMax;
        plusBtn.classList.toggle('is-disabled', isMax);
        if (isMax) {
          plusBtn.setAttribute('aria-disabled', 'true');
        } else {
          plusBtn.removeAttribute('aria-disabled');
        }
      }

      // Sync bundle selection if active
      const bundleCardList = sectionEl.querySelectorAll('.pdp-bundle-card');
      bundleCardList.forEach(c => {
        const bQty = parseInt(c.getAttribute('data-bundle-qty') || '1', 10);
        c.classList.toggle('is-selected', bQty === val);
      });
    }

    // Helper: format money text without innerHTML re-render (Prevents layout shift and font flicker)
    const moneyFormatString = {{ shop.money_format | json }};
    function formatMoneyText(cents) {
      if (!cents || cents <= 0) {
        return 'PRICE UPON INQUIRY';
      }
      if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
        const dummy = document.createElement('div');
        dummy.innerHTML = Shopify.formatMoney(cents, moneyFormatString);
        return dummy.textContent || dummy.innerText || '';
      }
      return (cents / 100).toLocaleString('{{ request.locale.iso_code | default: "en-US" }}') + ' {{ cart.currency.symbol | default: localization.country.currency.symbol | default: "$" }}';
    }

    function getSelectedOptions() {
      const selected = [];
      const groups = sectionEl.querySelectorAll('.pdp-option-group');
      groups.forEach((group, gIdx) => {
        const activeBtn = group.querySelector('.pdp-opt-btn.is-selected');
        if (activeBtn) {
          selected.push(activeBtn.getAttribute('data-value'));
        }
      });
      return selected;
    }

    function onOptionClick(clickedBtn) {
      const group = clickedBtn.closest('.pdp-option-group');
      if (!group) return;

      group.querySelectorAll('.pdp-opt-btn').forEach(btn => btn.classList.remove('is-selected'));
      clickedBtn.classList.add('is-selected');

      const optIdx = clickedBtn.getAttribute('data-option-index');
      const labelValEl = document.getElementById(`pdpSelectedValue-{{ section.id }}-${optIdx}`);
      if (labelValEl) {
        labelValEl.textContent = clickedBtn.getAttribute('data-value');
      }

      const selectedOptions = getSelectedOptions();

      // Find matched variant
      if (productData && productData.variants) {
        const matchedVariant = productData.variants.find(variant => {
          return variant.options.every((optVal, idx) => optVal === selectedOptions[idx]);
        });

        if (matchedVariant) {
          if (variantIdInput) variantIdInput.value = matchedVariant.id;

          // Refactor variant change: Pure DOM textContent mutation (Zero innerHTML / Zero layout flicker)
          if (priceEl && matchedVariant.price !== undefined) {
            priceEl.textContent = formatMoneyText(matchedVariant.price);
        var msbPrice = document.getElementById('pdpMsbPrice-{{ section.id }}');
        if (msbPrice) msbPrice.textContent = formatMoneyText(matchedVariant.price);
        var msbBtn = document.getElementById('pdpMsbBtn-{{ section.id }}');
        var msbBtnText = document.getElementById('pdpMsbBtnText-{{ section.id }}');
        if (msbBtn) {
          msbBtn.disabled = !matchedVariant.available;
          if (msbBtnText) msbBtnText.textContent = matchedVariant.available ? 'ADD TO CART' : 'SOLD OUT';
        }
            if (matchedVariant.price <= 0) {
              priceEl.classList.add('is-inquiry-price');
            } else {
              priceEl.classList.remove('is-inquiry-price');
            }
          }

          if (comparePriceEl) {
            if (matchedVariant.compare_at_price && matchedVariant.compare_at_price > matchedVariant.price && matchedVariant.price > 0) {
              comparePriceEl.textContent = formatMoneyText(matchedVariant.compare_at_price);
              comparePriceEl.style.display = 'inline';
            } else {
              comparePriceEl.textContent = '';
              comparePriceEl.style.display = 'none';
            }
          }



          // Update bundle card prices if bundle exists
          const bundleCards = sectionEl.querySelectorAll('.pdp-bundle-card');
          if (bundleCards.length > 0 && matchedVariant.price > 0) {
            bundleCards.forEach(bCard => {
              const qty = parseInt(bCard.getAttribute('data-bundle-qty') || '1', 10);
              const bPriceEl = bCard.querySelector('.pdp-bundle-price');
              const bCompEl = bCard.querySelector('.pdp-bundle-compare');
              if (qty === 1 && bPriceEl) {
                bPriceEl.textContent = formatMoneyText(matchedVariant.price);
              } else if (qty === 2 && bPriceEl) {
                bPriceEl.textContent = formatMoneyText(Math.round(matchedVariant.price * 1.8));
                if (bCompEl) bCompEl.textContent = formatMoneyText(matchedVariant.price * 2);
              } else if (qty === 3 && bPriceEl) {
                bPriceEl.textContent = formatMoneyText(Math.round(matchedVariant.price * 2.4));
                if (bCompEl) bCompEl.textContent = formatMoneyText(matchedVariant.price * 3);
              }
            });
          }

          // Stock button & quantity stepper state
          const qtyWrapper = sectionEl.querySelector('.pdp-qty-wrapper');
          if (addBtn && addBtnText) {
            if (!matchedVariant.available) {
              addBtn.disabled = true;
              addBtnText.textContent = 'SOLD OUT';
              if (qtyWrapper) qtyWrapper.classList.add('is-disabled');
              if (qtyInput) qtyInput.disabled = true;
              if (minusBtn) { minusBtn.disabled = true; minusBtn.classList.add('is-disabled'); }
              if (plusBtn) { plusBtn.disabled = true; plusBtn.classList.add('is-disabled'); }
            } else {
              addBtn.disabled = false;
              addBtnText.textContent = 'ADD TO CART';
              if (qtyWrapper) qtyWrapper.classList.remove('is-disabled');
              if (qtyInput) qtyInput.disabled = false;
              if (typeof updatePdpQty === 'function') {
                updatePdpQty(qtyInput ? qtyInput.value : 1);
              }
            }
          }

          // Switch image if variant has featured image
          if (matchedVariant.featured_image) {
            const featId = matchedVariant.featured_image.id;
            const featSrc = matchedVariant.featured_image.src;
            let mediaIdx = -1;
            if (featId) {
              mediaIdx = thumbItems.findIndex(t => t.getAttribute('data-media-id') == featId);
            }
            if (mediaIdx === -1 && featSrc) {
              const filename = featSrc.split('?')[0].split('/').pop();
              mediaIdx = thumbItems.findIndex(t => {
                const s = t.getAttribute('data-src') || '';
                return s.includes(filename);
              });
            }
            if (mediaIdx !== -1) {
              switchMainImage(mediaIdx);
            } else if (featSrc) {
              mainImg.removeAttribute('srcset');
              mainImg.src = featSrc;
            }
          }
        }
      }
    }

    optionBtns.forEach(btn => {
      btn.addEventListener('click', () => onOptionClick(btn));
    });

    // Quantity Stepper Event Listeners & Keyboard Controls
    if (minusBtn && qtyInput) {
      minusBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        if (minusBtn.disabled || minusBtn.classList.contains('is-disabled') || !isCurrentVariantAvailable()) return;
        const current = parseInt(qtyInput.value, 10) || 1;
        if (current > 1) {
          updatePdpQty(current - 1);
        }
      });
    }

    if (plusBtn && qtyInput) {
      plusBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        if (plusBtn.disabled || plusBtn.classList.contains('is-disabled') || !isCurrentVariantAvailable()) return;
        const current = parseInt(qtyInput.value, 10) || 1;
        if (current < 99) {
          updatePdpQty(current + 1);
        }
      });
    }

    if (qtyInput) {
      qtyInput.addEventListener('input', function() {
        this.value = this.value.replace(/[^0-9]/g, '');
        if (this.value !== '') {
          let raw = parseInt(this.value, 10);
          if (!isNaN(raw)) {
            if (raw > 99) {
              raw = 99;
              this.value = '99';
            }
            if (minusBtn) {
              const isMin = (!isCurrentVariantAvailable()) || (raw <= 1);
              minusBtn.disabled = isMin;
              minusBtn.classList.toggle('is-disabled', isMin);
            }
            if (plusBtn) {
              const isMax = (!isCurrentVariantAvailable()) || (raw >= 99);
              plusBtn.disabled = isMax;
              plusBtn.classList.toggle('is-disabled', isMax);
            }
            // Sync bundle selection
            const bundleCardList = sectionEl.querySelectorAll('.pdp-bundle-card');
            bundleCardList.forEach(c => {
              const bQty = parseInt(c.getAttribute('data-bundle-qty') || '1', 10);
              c.classList.toggle('is-selected', bQty === raw);
            });
          }
        }
      });

      qtyInput.addEventListener('change', function() {
        updatePdpQty(this.value);
      });

      qtyInput.addEventListener('blur', function() {
        updatePdpQty(this.value);
      });

      qtyInput.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowUp') {
          e.preventDefault();
          updatePdpQty((parseInt(qtyInput.value, 10) || 1) + 1);
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          updatePdpQty((parseInt(qtyInput.value, 10) || 1) - 1);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          updatePdpQty(this.value);
          if (pdpForm) {
            if (typeof pdpForm.requestSubmit === 'function') {
              pdpForm.requestSubmit();
            } else {
              pdpForm.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
            }
          }
        }
      });
    }

    // Initialize stepper button states
    updatePdpQty(qtyInput ? qtyInput.value : 1);

    // Bundle Card selection interaction (sync with quantity)
    const bundleCardList = sectionEl.querySelectorAll('.pdp-bundle-card');
    bundleCardList.forEach(bCard => {
      bCard.addEventListener('click', () => {
        bundleCardList.forEach(c => c.classList.remove('is-selected'));
        bCard.classList.add('is-selected');
        const bQty = parseInt(bCard.getAttribute('data-bundle-qty') || '1', 10);
        updatePdpQty(bQty);
      });
    });

    // Seamless AJAX Add to Cart & Cart Drawer Sync
    if (pdpForm) {
      pdpForm.addEventListener('submit', function(e) {
        e.preventDefault();
        if (addBtn.disabled || addBtn.classList.contains('is-adding') || !isCurrentVariantAvailable()) return;
        if (typeof pdpForm.reportValidity === 'function' && !pdpForm.reportValidity()) return;

        const cartDrawer = document.querySelector('cart-drawer');
        const selectedQty = Math.max(1, Math.min(99, parseInt(qtyInput ? qtyInput.value : '1', 10) || 1));
        const originalText = addBtnText ? addBtnText.textContent : 'ADD TO CART';

        addBtn.disabled = true;
        addBtn.classList.add('is-adding');
        if (addBtnText) addBtnText.textContent = 'ADDING...';

        const formData = new FormData(pdpForm);
        formData.set('quantity', selectedQty);

        // Prune empty properties to avoid blank line item properties in cart
        pdpForm.querySelectorAll('[name^="properties"]').forEach(function(propInput) {
          if (propInput.type === 'file') {
            if (!propInput.files || propInput.files.length === 0 || (propInput.files[0] && propInput.files[0].size === 0)) {
              formData.delete(propInput.name);
            }
          } else if (!propInput.value || !propInput.value.trim()) {
            formData.delete(propInput.name);
          }
        });

        if (cartDrawer) {
          const sectionsToRender = typeof cartDrawer.getSectionsToRender === 'function'
            ? cartDrawer.getSectionsToRender().map(s => s.id)
            : ['cart-drawer', 'cart-icon-bubble'];

          formData.append('sections', sectionsToRender.join(','));
          formData.append('sections_url', window.location.pathname);
          if (typeof cartDrawer.setActiveElement === 'function') {
            cartDrawer.setActiveElement(document.activeElement || addBtn);
          }
        }

        const addUrl = (window.routes && window.routes.cart_add_url)
          ? (window.routes.cart_add_url.endsWith('.js') ? window.routes.cart_add_url : window.routes.cart_add_url + '.js')
          : '/cart/add.js';

        fetch(addUrl, {
          method: 'POST',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body: formData
        })
        .then(function(res) {
          return res.json().then(function(data) {
            if (!res.ok || data.status) {
              throw data;
            }
            return data;
          });
        })
        .then(function(data) {
          if (addBtnText) {
            addBtnText.textContent = selectedQty > 1 ? `ADDED (${selectedQty}) ✓` : 'ADDED ✓';
          }

          // Reset quantity stepper back to 1 for clean subsequent additions
          updatePdpQty(1);

          // Update cart drawer contents & open drawer
          if (cartDrawer) {
            cartDrawer.classList.remove('is-empty');
            const drawerInner = cartDrawer.querySelector('.drawer__inner');
            if (drawerInner) drawerInner.classList.remove('is-empty');
            const drawerItems = cartDrawer.querySelector('cart-drawer-items');
            if (drawerItems) drawerItems.classList.remove('is-empty');

            if (typeof cartDrawer.renderContents === 'function' && data.sections) {
              cartDrawer.renderContents(data);
              cartDrawer.classList.remove('is-empty');
            } else if (typeof cartDrawer.open === 'function') {
              cartDrawer.open();
            }
          }

          // Publish standard Dawn cart events
          if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined' && PUB_SUB_EVENTS.cartUpdate) {
            publish(PUB_SUB_EVENTS.cartUpdate, {
              source: 'luxury-product-form',
              productVariantId: formData.get('id'),
              cartData: data
            });
          }

          // Refresh header cart count bubble
          fetch('/cart.js')
            .then(function(r) { return r.json(); })
            .then(function(cart) {
              const bubbles = document.querySelectorAll('.cart-count-bubble, [data-cart-count], .header__cart-count, #cart-icon-bubble .cart-count-bubble');
              bubbles.forEach(function(b) {
                const countSpan = b.querySelector('[aria-hidden="true"]') || b;
                if (countSpan) countSpan.textContent = cart.item_count;
                b.classList.remove('hidden');
                b.style.display = cart.item_count > 0 ? '' : 'none';
              });
            })
            .catch(function(e) { console.warn('Cart bubble update error:', e); });

          // Dispatch standard Shopify cart events
          document.documentElement.dispatchEvent(new CustomEvent('cart:item-added', { detail: data }));
          document.body.dispatchEvent(new CustomEvent('cart:refresh'));
        })
        .catch(function(err) {
          console.error('Pdp Add to Cart error:', err);
          const errorMsg = (err && (err.description || err.message)) ? (err.description || err.message) : null;
          if (addBtnText) addBtnText.textContent = 'TRY AGAIN';
          if (errorMsg && !errorMsg.includes('Unexpected token') && !errorMsg.includes('JSON')) {
            alert(errorMsg);
          }
        })
        .finally(function() {
          setTimeout(function() {
            addBtn.disabled = !isCurrentVariantAvailable();
            addBtn.classList.remove('is-adding');
            if (addBtnText) {
              addBtnText.textContent = isCurrentVariantAvailable() ? originalText : 'SOLD OUT';
            }
          }, 1800);
        });
      });
    }

    // Accordion toggle handlers (Right Column & Full Q&A)
    const accTriggers = sectionEl.querySelectorAll('.pdp-acc-trigger, .lp-faq-trigger');
    accTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
        trigger.setAttribute('aria-expanded', !isExpanded);
        const content = trigger.nextElementSibling;
        if (content) {
          content.classList.toggle('is-open', !isExpanded);
        }
      });
    });

    // Judge.me rating click handler & dynamic 0-review hiding
    const judgemeRating = document.getElementById('pdpJudgemeRating-{{ section.id }}');
    if (judgemeRating) {
      function checkReviewCount() {
        const badge = judgemeRating.querySelector('.jdgm-prev-badge, .jdgm-preview-badge');
        const badgeText = judgemeRating.querySelector('.jdgm-prev-badge__text');
        const numReviews = badge ? badge.getAttribute('data-number-of-reviews') : null;
        const textContent = badgeText ? badgeText.textContent.trim().toLowerCase() : '';

        // If explicitly 0 reviews, or contains 'no review' / '0 review', hide badge
        if (
          numReviews === '0' ||
          textContent.includes('no review') ||
          textContent.startsWith('0 review') ||
          textContent === '0'
        ) {
          judgemeRating.style.setProperty('display', 'none', 'important');
        } else if (numReviews && parseInt(numReviews, 10) > 0) {
          judgemeRating.style.removeProperty('display');
        }
      }

      checkReviewCount();
      // Observe Judge.me async loading/hydration
      const observer = new MutationObserver(() => {
        checkReviewCount();
      });
      observer.observe(judgemeRating, { childList: true, subtree: true, attributes: true, characterData: true });

      judgemeRating.addEventListener('click', () => {
        const reviewWidget = document.querySelector('.jdgm-review-widget, #judgeme_product_reviews, [data-from-snippet="true"]');
        if (reviewWidget) {
          reviewWidget.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }

    // Delivery Estimator & Shipping Schedule Popover Handler (Accurate calendar logic based on Today)
    (function initDeliveryEstimator() {
      const today = new Date();

      function addDays(base, days) {
        const d = new Date(base.getFullYear(), base.getMonth(), base.getDate() + days);
        return d;
      }

      function formatSingle(d, showFullMonth) {
        const month = d.toLocaleString('en-US', { month: showFullMonth ? 'long' : 'short' });
        return `${month} ${d.getDate()}`;
      }

      function formatRange(d1, d2) {
        const m1 = d1.toLocaleString('en-US', { month: 'short' });
        const m2 = d2.toLocaleString('en-US', { month: 'short' });
        const day1 = d1.getDate();
        const day2 = d2.getDate();
        if (m1 === m2) {
          return `${m1} ${day1}–${day2}`;
        } else {
          return `${m1} ${day1} – ${m2} ${day2}`;
        }
      }

      // Base Date: Today (Day 0)
      const placedDate = today;
      // Ships: Day 0 + 1 to Day 0 + 2 (1–2 days processing)
      const ship1 = addDays(today, 1);
      const ship2 = addDays(today, 2);
      // Delivered: Day 0 + 10 to Day 0 + 15 (1–3 weeks delivery window)
      const del1 = addDays(today, 10);
      const del2 = addDays(today, 15);

      const placedStr = `Today, ${formatSingle(placedDate, false)}`;
      const shipsStr = formatRange(ship1, ship2);
      const delStr = formatRange(del1, del2);

      const mainDelDate = document.getElementById('pdpMainDeliveryDate-{{ section.id }}');
      const placedDateEl = document.getElementById('pdpPlacedDate-{{ section.id }}');
      const shipsDateEl = document.getElementById('pdpShipsDate-{{ section.id }}');
      const delDateEl = document.getElementById('pdpDeliveredDate-{{ section.id }}');

      function refreshDates() {
        const liveNow = new Date();
        const liveShip1 = addDays(liveNow, 1);
        const liveShip2 = addDays(liveNow, 2);
        const liveDel1 = addDays(liveNow, 10);
        const liveDel2 = addDays(liveNow, 15);

        const livePlaced = `Today, ${formatSingle(liveNow, false)}`;
        const liveShips = formatRange(liveShip1, liveShip2);
        const liveDel = formatRange(liveDel1, liveDel2);

        if (mainDelDate) mainDelDate.textContent = liveDel;
        if (placedDateEl) placedDateEl.textContent = livePlaced;
        if (shipsDateEl) shipsDateEl.textContent = liveShips;
        if (delDateEl) delDateEl.textContent = liveDel;
      }

      refreshDates();

      // Delivery Method Popover Toggle
      const scheduleTrigger = document.getElementById('pdpScheduleTrigger-{{ section.id }}');
      const deliveryPopover = document.getElementById('pdpDeliveryPopover-{{ section.id }}');
      const deliveryCloseBtn = document.getElementById('pdpDeliveryClose-{{ section.id }}');

      function clampDeliveryPopoverPosition() {
        if (!deliveryPopover || deliveryPopover.hasAttribute('hidden')) return;
        deliveryPopover.style.right = '0px';
        deliveryPopover.style.left = 'auto';

        const rect = deliveryPopover.getBoundingClientRect();
        const padding = 12;

        if (rect.right > window.innerWidth - padding) {
          const shift = rect.right - (window.innerWidth - padding);
          deliveryPopover.style.right = `${shift}px`;
        }

        const newRect = deliveryPopover.getBoundingClientRect();
        if (newRect.left < padding) {
          const shiftLeft = padding - newRect.left;
          deliveryPopover.style.right = `-${shiftLeft}px`;
        }
      }

      function toggleDeliveryPopover(show) {
        if (!deliveryPopover || !scheduleTrigger) return;
        const isHidden = deliveryPopover.hasAttribute('hidden');
        const willShow = show !== undefined ? show : isHidden;
        if (willShow) {
          refreshDates();
          deliveryPopover.removeAttribute('hidden');
          scheduleTrigger.setAttribute('aria-expanded', 'true');
          toggleCountryPopover(false);
          clampDeliveryPopoverPosition();
        } else {
          deliveryPopover.setAttribute('hidden', 'true');
          scheduleTrigger.setAttribute('aria-expanded', 'false');
        }
      }

      if (scheduleTrigger) {
        scheduleTrigger.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleDeliveryPopover();
        });
      }

      if (deliveryCloseBtn) {
        deliveryCloseBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleDeliveryPopover(false);
        });
      }

      // Country Selection Popover Toggle (Synchronized with Header Luxury Dropdown)
      const countryTrigger = document.getElementById('pdpCountryTrigger-{{ section.id }}');
      const countryPopover = document.getElementById('pdpCountryPopover-{{ section.id }}');
      const countryCloseBtn = document.getElementById('pdpCountryClose-{{ section.id }}');
      const countrySearch = document.getElementById('pdpCountrySearch-{{ section.id }}');
      const countryForm = document.getElementById('PdpDeliveryCountryForm');
      const countryInput = document.getElementById('PdpDeliveryCountryInput-{{ section.id }}') || document.getElementById('PdpDeliveryCountryInput');

      function clampCountryPopoverPosition() {
        if (!countryPopover || countryPopover.hasAttribute('hidden')) return;
        countryPopover.style.right = '0px';
        countryPopover.style.left = 'auto';

        const rect = countryPopover.getBoundingClientRect();
        const padding = 12;

        if (rect.right > window.innerWidth - padding) {
          const shift = rect.right - (window.innerWidth - padding);
          countryPopover.style.right = `${shift}px`;
        }

        const newRect = countryPopover.getBoundingClientRect();
        if (newRect.left < padding) {
          const shiftLeft = padding - newRect.left;
          countryPopover.style.right = `-${shiftLeft}px`;
        }
      }

      function toggleCountryPopover(show) {
        if (!countryPopover || !countryTrigger) return;
        const isHidden = countryPopover.hasAttribute('hidden');
        const willShow = show !== undefined ? show : isHidden;
        if (willShow) {
          countryPopover.removeAttribute('hidden');
          countryTrigger.setAttribute('aria-expanded', 'true');
          toggleDeliveryPopover(false);
          clampCountryPopoverPosition();
          if (countrySearch) {
            setTimeout(() => {
              countrySearch.focus();
              clampCountryPopoverPosition();
            }, 60);
          }
        } else {
          countryPopover.setAttribute('hidden', 'true');
          countryTrigger.setAttribute('aria-expanded', 'false');
        }
      }

      window.addEventListener('resize', () => {
        clampCountryPopoverPosition();
        clampDeliveryPopoverPosition();
      });

      if (countryTrigger) {
        countryTrigger.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleCountryPopover();
        });
      }

      if (countryCloseBtn) {
        countryCloseBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleCountryPopover(false);
        });
      }

      if (countrySearch) {
        countrySearch.addEventListener('input', () => {
          const q = countrySearch.value.toLowerCase().trim();
          const items = countryPopover.querySelectorAll('.pdp-curr-option-item, li');
          items.forEach(li => {
            const txt = li.textContent.toLowerCase();
            li.style.display = txt.includes(q) ? '' : 'none';
          });
        });
        countrySearch.addEventListener('click', (e) => {
          e.stopPropagation();
        });
      }

      if (countryPopover) {
        countryPopover.addEventListener('click', (e) => {
          e.stopPropagation();
        });
        const countryItems = countryPopover.querySelectorAll('.pdp-country-select-item, .pdp-curr-select-btn');
        countryItems.forEach(item => {
          item.addEventListener('click', (e) => {
            e.preventDefault();
            const code = item.getAttribute('data-country-code');
            if (code && countryInput && countryForm) {
              countryInput.value = code;
              countryForm.submit();
            }
          });
        });
      }

      // Close popovers when clicking outside
      document.addEventListener('click', (e) => {
        const estimator = document.getElementById('pdpDeliveryEstimator-{{ section.id }}');
        if (estimator && !estimator.contains(e.target)) {
          toggleDeliveryPopover(false);
          toggleCountryPopover(false);
        }
      });
    })();


    // =========================================================================
    // MOBILE STICKY BAR OBSERVER & DELEGATION
    // =========================================================================
    (function initMobileStickyBar() {
      var bar = document.getElementById('pdpMobileStickyBar-{{ section.id }}');
      var addBtn = document.getElementById('pdpAddBtn-{{ section.id }}');
      var msbBtn = document.getElementById('pdpMsbBtn-{{ section.id }}');
      if (!bar || !addBtn) return;

      if (msbBtn) {
        msbBtn.addEventListener('click', function(e) {
          e.preventDefault();
          if (addBtn.disabled) return;
          addBtn.click();
        });
      }

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
              bar.classList.add('is-visible');
              bar.setAttribute('aria-hidden', 'false');
            } else {
              bar.classList.remove('is-visible');
              bar.setAttribute('aria-hidden', 'true');
            }
          });
        }, { threshold: 0 });
        observer.observe(addBtn);
      } else {
        window.addEventListener('scroll', function() {
          var rect = addBtn.getBoundingClientRect();
          if (rect.bottom < 0) {
            bar.classList.add('is-visible');
            bar.setAttribute('aria-hidden', 'false');
          } else {
            bar.classList.remove('is-visible');
            bar.setAttribute('aria-hidden', 'true');
          }
        }, { passive: true });
      }
    })();

  })();
</script>

