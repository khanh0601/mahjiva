                  </div>
                </div>
                <!-- Real-time Immediate Date Hydration Script (Runs synchronously to defeat CDN edge cache) -->
                <script>
                  (function() {
                    try {
                      var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
                      var now = new Date();
                      function addD(b, d) {
                        var r = new Date(b.getTime());
                        r.setDate(r.getDate() + d);
                        return r;
                      }
                      function fmtRange(d1, d2) {
                        var m1 = months[d1.getMonth()];
                        var m2 = months[d2.getMonth()];
                        var n1 = d1.getDate();
                        var n2 = d2.getDate();
                        if (m1 === m2) return m1 + ' ' + n1 + '\u2013' + n2;
                        return m1 + ' ' + n1 + ' \u2013 ' + m2 + ' ' + n2;
                      }
                      var ship1 = addD(now, 1);
                      var ship2 = addD(now, 2);
                      var del1 = addD(now, 10);
                      var del2 = addD(now, 15);

                      var placedStr = 'Today, ' + months[now.getMonth()] + ' ' + now.getDate();
                      var shipsStr = fmtRange(ship1, ship2);
                      var delStr = fmtRange(del1, del2);

                      var mEl = document.getElementById('pdpMainDeliveryDate-{{ section.id }}');
                      var pEl = document.getElementById('pdpPlacedDate-{{ section.id }}');
                      var sEl = document.getElementById('pdpShipsDate-{{ section.id }}');
                      var dEl = document.getElementById('pdpDeliveredDate-{{ section.id }}');

                      if (mEl) mEl.textContent = delStr;
                      if (pEl) pEl.textContent = placedStr;
                      if (sEl) sEl.textContent = shipsStr;
                      if (dEl) dEl.textContent = delStr;
                    } catch(e) {}
                  })();
                </script>
              </div>
