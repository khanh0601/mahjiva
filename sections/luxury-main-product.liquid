  #AtelierLightbox {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background-color: rgba(250, 248, 245, 0.88) !important; /* Elegant semi-translucent backdrop */
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    z-index: 2147483647 !important;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px !important;
    box-sizing: border-box !important;
    user-select: none;
    cursor: zoom-out !important;
  }

  #AtelierLightbox.active,
  #AtelierLightbox.is-open {
    display: flex !important;
    animation: lbPureFadeIn 0.22s ease-out forwards;
  }

  @keyframes lbPureFadeIn {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Compact cohesive modal card wrapping image, close button and controls together */
  .lp-lb-card {
    position: relative !important;
    display: inline-flex !important;
    flex-direction: column !important;
    align-items: center !important;
    max-width: 92vw !important;
    max-height: 86vh !important;
    cursor: default !important;
  }

  /* Close Button directly hugging top-right corner of image */
  .lp-lb-close-btn {
    position: absolute !important;
    top: -12px !important;
    right: -12px !important;
    width: 38px !important;
    height: 38px !important;
    border-radius: 50% !important;
    background: #FFFFFF !important;
    border: 1px solid rgba(184, 151, 104, 0.45) !important;
    color: #163327 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    z-index: 100 !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.16) !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    padding: 0 !important;
    outline: none !important;
  }

  .lp-lb-close-btn:hover {
    background: #143828 !important;
    color: #FAF8F5 !important;
    border-color: #143828 !important;
    transform: scale(1.1) !important;
    box-shadow: 0 6px 20px rgba(20, 56, 40, 0.35) !important;
  }

  .lp-lb-close-btn:active {
    transform: scale(0.94) !important;
  }

  .lp-lb-close-btn svg {
    pointer-events: none !important;
  }

  /* Center Stage */
  #AtelierLightbox .lp-lb-stage {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    position: relative !important;
    cursor: zoom-in !important;
  }

  /* Ultra-Crisp Artwork Image: High-res rendering with clean edge */
  #AtelierLightbox .lp-lb-img {
    max-height: 66vh !important;
    max-width: 88vw !important;
    width: auto !important;
    height: auto !important;
    object-fit: contain !important;
    border-radius: 16px !important;
    background: #FFFFFF !important;
    box-shadow: 0 16px 48px rgba(22, 51, 39, 0.12), 0 2px 10px rgba(0, 0, 0, 0.04) !important;
    border: 1px solid rgba(184, 151, 104, 0.32) !important;
    image-rendering: -webkit-optimize-contrast !important;
    image-rendering: crisp-edges !important;
    transition: transform 0.25s ease-out !important;
    cursor: zoom-in !important;
    display: block !important;
  }

  #AtelierLightbox .lp-lb-img.is-zoomed {
    transform: scale(1.85) !important;
    cursor: grab !important;
  }

  /* Integrated Luxury Bottom Controller - Hugging closely right beneath image */
  #AtelierLightbox .lp-lb-footer {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding-top: 14px !important;
    padding-bottom: 0 !important;
    width: 100% !important;
  }

  .lp-lb-controls-bar {
    display: inline-flex !important;
    align-items: center !important;
    gap: 16px !important;
    background: rgba(255, 255, 255, 0.92) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    padding: 6px 14px !important;
    border-radius: 9999px !important;
    border: 1px solid rgba(184, 151, 104, 0.35) !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08) !important;
  }

  .lp-lb-ctrl-btn {
    width: 34px !important;
    height: 34px !important;
    border-radius: 50% !important;
    border: 1px solid rgba(184, 151, 104, 0.4) !important;
    background: #FFFFFF !important;
    color: #163327 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    padding: 0 !important;
    outline: none !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04) !important;
  }

  .lp-lb-ctrl-btn:hover {
    background: linear-gradient(180deg, #1D4B37 0%, #143828 42%, #081610 100%) !important;
    color: #FAF8F5 !important;
    border-color: #143828 !important;
    transform: scale(1.1) !important;
    box-shadow: 0 4px 12px rgba(8, 22, 16, 0.35) !important;
  }

  .lp-lb-ctrl-btn:active {
    transform: scale(0.96) !important;
  }

  .lp-lb-ctrl-btn svg {
    pointer-events: none !important;
  }

  .lp-lb-counter {
    font-size: 12px !important;
    letter-spacing: 0.16em !important;
    color: #163327 !important;
    font-weight: 600 !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    text-transform: uppercase !important;
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    min-width: 58px !important;
    text-align: center !important;
    user-select: none !important;
  }

  /* -------------------------------------------------------------------------
     3. IN-PRODUCT ACCORDION & CATEGORY-SPECIFIC Q&A
     ------------------------------------------------------------------------- */
  .pdp-details-accordion {
    margin-top: 24px;
    border-top: 1px solid rgba(184, 151, 104, 0.3);
  }

  .pdp-acc-item {
    border-bottom: 1px solid rgba(184, 151, 104, 0.25);
  }

  .pdp-acc-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 0;
    background: transparent;
    border: none;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #141517;
    cursor: pointer;
    text-align: left;
    transition: color 0.2s ease;
  }

  .pdp-acc-trigger:hover,
  .pdp-acc-trigger[aria-expanded="true"] {
    color: #163327;
  }

  .pdp-acc-icon {
    width: 16px;
    height: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #B89768;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pdp-acc-trigger[aria-expanded="true"] .pdp-acc-icon {
    transform: rotate(180deg);
  }

  .pdp-acc-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1), padding 0.25s ease, opacity 0.25s ease;
    opacity: 0;
    padding: 0;
    color: #55524E;
    font-size: 13.5px;
    line-height: 1.6;
  }

  .pdp-acc-content.is-open {
    max-height: 1400px;
    opacity: 1;
    padding-bottom: 18px;
  }

  .pdp-sub-qa-item {
    padding: 10px 0;
    border-top: 1px dashed rgba(184, 151, 104, 0.2);
  }

  .pdp-sub-qa-item:first-child {
    border-top: none;
    padding-top: 0;
  }

  .pdp-sub-q {
    font-weight: 600;
    color: #163327;
    font-size: 13px;
    margin-bottom: 4px;
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .pdp-sub-q-badge {
    color: #B89768;
    font-weight: 700;
    font-size: 11px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .pdp-sub-a {
    font-size: 13px;
    color: #55524E;
    line-height: 1.55;
    margin: 0;
    padding-left: 17px;
  }

  /* Full Width In-Product Q&A Section (Below Stage & Info Grid) */
  .lp-pdp-faq-wrapper {
    margin-top: 56px;
    padding-top: 48px;
    border-top: 1px solid rgba(184, 151, 104, 0.3);
  }

  .lp-pdp-faq-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 36px;
  }

  .lp-pdp-faq-eyebrow {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #B89768;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .lp-pdp-faq-title {
    font-size: 32px;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 700;
    color: #0D1110;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .lp-pdp-faq-sub {
    font-size: 14px;
    color: #7A7571;
    line-height: 1.5;
    margin: 0;
  }

  .lp-pdp-faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    max-width: 880px;
    margin: 0 auto;
  }

  .lp-faq-card {
    background: #FFFFFF;
    border: 1px solid rgba(184, 151, 104, 0.28);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 3px 12px rgba(20, 21, 23, 0.03);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .lp-faq-card:hover {
    border-color: rgba(184, 151, 104, 0.6);
    box-shadow: 0 6px 18px rgba(20, 21, 23, 0.06);
  }

  .lp-faq-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    background: transparent;
    border: none;
    font-size: 14.5px;
    font-weight: 600;
    color: #141517;
    cursor: pointer;
    text-align: left;
    transition: color 0.2s ease;
  }

  .lp-faq-trigger:hover,
  .lp-faq-trigger[aria-expanded="true"] {
    color: #163327;
  }

  .lp-faq-trigger[aria-expanded="true"] .lp-faq-icon {
    transform: rotate(180deg);
    color: #163327;
  }

  .lp-faq-icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    color: #B89768;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }

  .lp-faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1), padding 0.25s ease, opacity 0.25s ease;
    opacity: 0;
    padding: 0 20px;
    font-size: 13.5px;
    line-height: 1.65;
    color: #55524E;
  }

  .lp-faq-answer.is-open {
    max-height: 600px;
    opacity: 1;
    padding: 0 20px 18px 20px;
  }

  .lp-pdp-faq-footer {
    text-align: center;
    margin-top: 32px;
  }

  .lp-faq-concierge-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #163327;
    text-decoration: none;
    padding: 10px 22px;
    border-radius: 999px;
    border: 1px solid rgba(22, 51, 39, 0.3);
    background: #FFFFFF;
    transition: all 0.25s ease;
  }

  .lp-faq-concierge-btn:hover {
    background: linear-gradient(180deg, #1D4B37 0%, #143828 42%, #081610 100%) !important;
    color: #FFFFFF !important;
    border-color: #143828 !important;
    box-shadow: 0 4px 12px rgba(8, 22, 16, 0.3) !important;
  }
</style>

<section id="LuxuryProduct-{{ section.id }}" class="lp-section pdp-section" aria-label="{{ product.title | escape }}">
  <div class="lp-container pdp-container">

    <!-- 1. Breadcrumb Navigation (MAHJIVA > ALL PRODUCTS > TÊN COLLECTION > TÊN SP) -->
    {%- assign prod_collection = collection -%}
    {%- if prod_collection == blank or prod_collection.handle == 'all' or prod_collection.handle == 'frontpage' -%}
      {%- for c in product.collections -%}
        {%- unless c.handle == 'all' or c.handle == 'frontpage' or c.handle contains 'new' or c.handle contains 'best' -%}
          {%- assign prod_collection = c -%}
          {%- break -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- if prod_collection == blank and product.collections.size > 0 -%}
        {%- assign prod_collection = product.collections.first -%}
      {%- endif -%}
    {%- endif -%}

    {%- assign badge_label = prod_collection.title | default: product.type | default: 'MAHJIVA' | upcase -%}
    {%- if prod_collection.handle == 'mahjong-set' or badge_label == 'TILES' or badge_label == 'TILE' -%}
      {%- assign badge_label = 'MAHJONG SET' -%}
    {%- elsif prod_collection.handle == 'mats' or badge_label == 'MAT' -%}
      {%- assign badge_label = 'MATS' -%}
    {%- elsif prod_collection.handle == 'racks' or badge_label == 'RACK' -%}
      {%- assign badge_label = 'RACKS' -%}
    {%- elsif prod_collection.handle == 'dices' or badge_label == 'DICES' -%}
      {%- assign badge_label = 'DICE' -%}
    {%- elsif prod_collection.handle == 'tile-bag' or badge_label == 'TILE-BAG' or badge_label == 'TILE BAG' or badge_label == 'BAG' -%}
      {%- assign badge_label = 'BAG' -%}
    {%- endif -%}

    <nav class="lp-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">MAHJIVA</a>
      <span class="lp-sep">&gt;</span>
      <a href="{{ routes.all_products_collection_url }}">ALL PRODUCTS</a>
      {%- if prod_collection != blank -%}
        <span class="lp-sep">&gt;</span>
        <a href="{{ prod_collection.url }}">{{ badge_label }}</a>
      {%- endif -%}
      <span class="lp-sep">&gt;</span>
      <span style="color:#163327;font-weight:600;">{{ product.title | upcase }}</span>
    </nav>

    <!-- 2. Grid Architecture: Left Column 54% / Right Column 46% -->
    <div class="lp-grid pdp-grid lp-layout" data-pz-scope>

      <!-- =====================================================================
           LEFT COLUMN (56%): GALLERY STAGE & FILMSTRIP TRACK
           ===================================================================== -->
      <div class="lp-gallery-col pdp-gallery-col{% if product.metafields.custom.personalization_options.value != blank %} lp-gallery-col--pz{% endif %}">
        {%- assign current_variant = product.selected_or_first_available_variant -%}
        {%- assign initial_media = current_variant.featured_media | default: product.featured_media | default: product.media.first -%}

        <div class="lp-pin-wrap" data-lp-pin>
        {%- if product.metafields.custom.personalization_options.value != blank -%}
          {%- assign pz_photos_selector = '#pdpMainStage-' | append: section.id -%}
          {%- assign pz_triggers_selector = '#pdpThumbsTrack-' | append: section.id -%}
          {%- render 'mahjiva-personalizer-preview', product: product, photos_selector: pz_photos_selector, triggers_selector: pz_triggers_selector -%}
        {%- endif -%}

        <!-- Master Stage Frame: Ratio 4:3, max-height 520px, border-radius 20px, soft shadow -->
        <div 
          class="lp-stage-frame pdp-main-stage" 
          id="pdpMainStage-{{ section.id }}" 
          role="region" 
          aria-label="Master artwork stage - Click to inspect 2400px"
          title="Click to enter full-screen inspection archive (2400px)"
        >
          {%- if initial_media != blank -%}
            <div class="lp-stage-inner pdp-stage-inner">
              <img 
                id="pdpMainImage-{{ section.id }}"
                class="lp-main-img pdp-main-img"
                src="{{ initial_media | image_url: width: 1200 }}"
                srcset="{{ initial_media | image_url: width: 800 }} 800w, {{ initial_media | image_url: width: 1200 }} 1200w, {{ initial_media | image_url: width: 1600 }} 1600w, {{ initial_media | image_url: width: 2000 }} 2000w"
                sizes="(min-width: 1200px) 720px, (min-width: 992px) 56vw, 100vw"
                alt="{% render 'luxury-image-alt', image: initial_media, product: product, index: 1 %}"
                loading="eager"
                fetchpriority="high"
                decoding="sync"
                width="1200"
                height="1200"
                data-full-src="{{ initial_media | image_url: width: 2400 }}"
                data-media-id="{{ initial_media.id }}"
              >

            </div>
          {%- else -%}
            <div class="pdp-no-image">Artwork imagery in archive</div>
          {%- endif -%}
        </div>
        </div>

        <!-- Filmstrip Thumbnails Track: Larger 82x82px with navigation buttons -->
        {%- if product.media.size > 1 -%}
          <div class="lp-thumbs-wrapper pdp-thumbs-wrapper">
            <button 
              type="button" 
              class="lp-thumb-nav-btn prev" 
              id="pdpThumbPrev-{{ section.id }}" 
              aria-label="Previous photo"
              title="Previous photo"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 19l-7-7 7-7"/></svg>
            </button>

            <div class="lp-thumbs-track pdp-thumbs-track" id="pdpThumbsTrack-{{ section.id }}" role="tablist" aria-label="Media archive filmstrip">
              {%- assign seen_media_ids = '' -%}
              {%- assign thumb_counter = 0 -%}
              {%- for media in product.media -%}
                {%- assign media_id_str = media.id | append: ',' -%}
                {%- if seen_media_ids contains media_id_str -%}
                  {%- continue -%}
                {%- endif -%}
                {%- assign seen_media_ids = seen_media_ids | append: media_id_str -%}
                {%- assign is_active = false -%}
                {%- if media.id == initial_media.id or forloop.first and initial_media == blank -%}
                  {%- assign is_active = true -%}
                {%- endif -%}
                <button
                  type="button"
                  role="tab"
                  class="lp-thumb-item pdp-thumb-item{% if is_active %} is-active{% endif %}"
                  data-media-id="{{ media.id }}"
                  data-index="{{ thumb_counter }}"
                  data-src="{{ media | image_url: width: 1600 }}"
                  data-srcset="{{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w, {{ media | image_url: width: 2000 }} 2000w"
                  data-full-src="{{ media | image_url: width: 2400 }}"
                  data-alt="{% render 'luxury-image-alt', image: media, product: product, index: forloop.index %}"
                  aria-selected="{% if is_active %}true{% else %}false{% endif %}"
                  aria-label="Plate {{ forloop.index }} of {{ product.title | escape }}"
                >
                  <img 
                    src="{{ media | image_url: width: 200, height: 200, crop: 'center' }}"
                    alt="{% render 'luxury-image-alt', image: media, product: product, index: forloop.index %}"
                    loading="lazy"
                    decoding="async"
                    width="82"
                    height="82"
                    class="lp-thumb-img pdp-thumb-img"
                  >
                </button>
                {%- assign thumb_counter = thumb_counter | plus: 1 -%}
              {%- endfor -%}
            </div>

            <button 
              type="button" 
              class="lp-thumb-nav-btn next" 
              id="pdpThumbNext-{{ section.id }}" 
              aria-label="Next photo"
              title="Next photo"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>

      <!-- =====================================================================
           RIGHT COLUMN (44%): SUITE DOSSIER & COMMERCE (STICKY)
           ===================================================================== -->
      <div class="lp-info-col pdp-info-col">

        <!-- Eyebrow & Tag (Dynamic Collection Badge - 100% Real Shopify Data) -->
        <div class="pdp-tag-row">
          {%- if prod_collection != blank -%}
            <a href="{{ prod_collection.url }}" class="pdp-badge-tag" title="View {{ badge_label }} Collection">
              {{ badge_label }}
            </a>
          {%- else -%}
            <span class="pdp-badge-tag">
              {{ badge_label }}
            </span>
          {%- endif -%}
        </div>

        <!-- Suite Title & Information Group -->
        <div class="pdp-title-desc-group">
          <!-- Judge.me Star Rating Badge directly above Product Title -->
          <div class="pdp-judgeme-rating" id="pdpJudgemeRating-{{ section.id }}" title="View customer reviews">
            <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
              {{ product.metafields.judgeme.badge }}
            </div>
          </div>

          <h1 class="pdp-title">{{ product.title | escape }}</h1>

          <!-- Product Information / Description Directly Below Title -->
          {%- if product.description != blank -%}
            <div class="pdp-description rte">
              {{ product.description }}
            </div>
          {%- endif -%}
        </div>

        <!-- Tax & Insured Transit Notice -->
        <div class="pdp-tax-notice">
          <span>Complimentary Worldwide Shipping &amp; Tracked Delivery</span>
        </div>

        <!-- Bundle Deals Block (Buy More Save More) - Server-side 100% -->
        {%- assign has_bundle_deals = false -%}
        {%- if current_variant.price > 0 -%}
          {%- if product.metafields.custom.bundle_deals != blank or product.tags contains 'bundle' or section.settings.enable_bundle_deals -%}
            {%- assign has_bundle_deals = true -%}
          {%- endif -%}
        {%- endif -%}

        {%- if has_bundle_deals -%}
          <div class="pdp-bundle-container" id="pdpBundleContainer-{{ section.id }}">
            <div class="pdp-bundle-header">
              <span class="pdp-bundle-heading">CURATED ALLOCATIONS (BUY MORE SAVE MORE)</span>
            </div>
            <div class="pdp-bundle-grid">
              <!-- Tier 1 -->
              <div class="pdp-bundle-card is-selected" data-bundle-qty="1">
                <span class="pdp-bundle-badge">STANDARD</span>
                <div class="pdp-bundle-card-content">
                  <div class="pdp-bundle-card-info">
                    <span class="pdp-bundle-title">01 Allocation Suite</span>
                    <span class="pdp-bundle-sub">Standard allocation</span>
                  </div>
                  <div class="pdp-bundle-pricing">
                    <span class="pdp-bundle-price" data-bundle-base="{{ current_variant.price }}">{{ current_variant.price | money }}</span>
                  </div>
                </div>
              </div>

              <!-- Tier 2 -->
              <div class="pdp-bundle-card" data-bundle-qty="2">
                <span class="pdp-bundle-badge pdp-bundle-badge-save">SAVE 10%</span>
                <div class="pdp-bundle-card-content">
                  <div class="pdp-bundle-card-info">
                    <span class="pdp-bundle-title">02 Allocation Suites</span>
                    <span class="pdp-bundle-sub">Curated duo</span>
                  </div>
                  <div class="pdp-bundle-pricing">
                    <span class="pdp-bundle-price" data-bundle-discount="0.9">{{ current_variant.price | times: 1.8 | money }}</span>
                    <s class="pdp-bundle-compare">{{ current_variant.price | times: 2 | money }}</s>
                  </div>
                </div>
              </div>

              <!-- Tier 3 -->
              <div class="pdp-bundle-card" data-bundle-qty="3">
                <span class="pdp-bundle-badge pdp-bundle-badge-vip">MAHJIVA VIP (-20%)</span>
                <div class="pdp-bundle-card-content">
                  <div class="pdp-bundle-card-info">
                    <span class="pdp-bundle-title">03 Allocation Suites</span>
                    <span class="pdp-bundle-sub">Private salon heirloom</span>
                  </div>
                  <div class="pdp-bundle-pricing">
                    <span class="pdp-bundle-price" data-bundle-discount="0.8">{{ current_variant.price | times: 2.4 | money }}</span>
                    <s class="pdp-bundle-compare">{{ current_variant.price | times: 3 | money }}</s>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}

        <!-- Commerce & Variant Form -->
        {%- assign show_custom_set_request = false -%}
        {%- assign cur_handle = product.handle | downcase -%}
        {%- assign cur_title = product.title | downcase -%}
        {%- if cur_handle contains 'cocktail-social-clubs-mahjong-set' or cur_handle contains 'crimson-leopard-mahjong-set' or cur_handle contains 'lotus-dynasty-mahjong-set' -%}
          {%- assign show_custom_set_request = true -%}
        {%- elsif cur_title contains 'cocktail social clubs mahjong set' or cur_title contains 'crimson leopard mahjong set' or cur_title contains 'lotus dynasty mahjong set' -%}
          {%- assign show_custom_set_request = true -%}
        {%- elsif section.settings.enable_custom_set_request -%}
          {%- assign show_custom_set_request = true -%}
        {%- endif -%}
        {%- assign product_form_id = 'PdpForm-' | append: section.id -%}
        {%- form 'product', product, id: product_form_id, class: 'pdp-form', enctype: 'multipart/form-data' -%}
          <input type="hidden" name="id" id="PdpVariantId-{{ section.id }}" value="{{ current_variant.id }}">

          <!-- Variant Selectors (Swatch Card Grid & Pill Selector) -->
          {%- unless product.has_only_default_variant -%}
            <div class="pdp-variants-wrapper">
              {%- for option in product.options_with_values -%}
                {%- assign opt_idx = forloop.index0 -%}
                {%- assign opt_pos = option.position -%}

                {%- comment -%} Determine if this option has variant swatch images {%- endcomment -%}
                {%- assign has_swatch_images = false -%}
                {%- for val in option.values -%}
                  {%- for variant in product.variants -%}
                    {%- case opt_pos -%}
                      {%- when 1 -%}
                        {%- if variant.option1 == val and variant.featured_image != blank -%}
                          {%- assign has_swatch_images = true -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- when 2 -%}
                        {%- if variant.option2 == val and variant.featured_image != blank -%}
                          {%- assign has_swatch_images = true -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- when 3 -%}
                        {%- if variant.option3 == val and variant.featured_image != blank -%}
                          {%- assign has_swatch_images = true -%}
                          {%- break -%}
                        {%- endif -%}
                    {%- endcase -%}
                  {%- endfor -%}
                  {%- if has_swatch_images -%}{%- break -%}{%- endif -%}
                {%- endfor -%}

                <div class="pdp-option-group">
                  <div class="pdp-option-label">
                    <span class="pdp-option-name">{{ option.name | upcase }}:</span>
                    <span class="pdp-option-value-selected" id="pdpSelectedValue-{{ section.id }}-{{ opt_idx }}">
                      {{ option.selected_value }}
                    </span>
                  </div>

                  {%- if has_swatch_images -%}
                    <!-- 4-Column Specimen Swatch Card Grid (As requested) -->
                    <div class="pdp-swatch-grid">
                      {%- for value in option.values -%}
                        {%- assign swatch_img = nil -%}
                        {%- for variant in product.variants -%}
                          {%- case opt_pos -%}
                            {%- when 1 -%}
                              {%- if variant.option1 == value and variant.featured_image != blank -%}
                                {%- assign swatch_img = variant.featured_image -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- when 2 -%}
                              {%- if variant.option2 == value and variant.featured_image != blank -%}
                                {%- assign swatch_img = variant.featured_image -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- when 3 -%}
                              {%- if variant.option3 == value and variant.featured_image != blank -%}
                                {%- assign swatch_img = variant.featured_image -%}
                                {%- break -%}
                              {%- endif -%}
                          {%- endcase -%}
                        {%- endfor -%}

                        {%- if swatch_img == blank -%}
                          {%- for img in product.images -%}
                            {%- assign alt_down = img.alt | downcase -%}
                            {%- assign val_down = value | downcase -%}
                            {%- if alt_down contains val_down or img.src contains val_down -%}
                              {%- assign swatch_img = img -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endif -%}

                        <button
                          type="button"
                          class="pdp-opt-btn pdp-opt-card{% if option.selected_value == value %} is-selected{% endif %}"
                          data-option-index="{{ opt_idx }}"
                          data-value="{{ value | escape }}"
                          aria-label="{{ value | escape }}"
                          title="{{ value | escape }}"
                        >
                          <div class="pdp-card-img-wrap">
                            {%- if swatch_img != blank -%}
                              <img
                                src="{{ swatch_img | image_url: width: 240 }}"
                                alt="{{ value | escape }}"
                                class="pdp-card-img"
                                width="70"
                                height="70"
                                loading="lazy"
                              >
                            {%- else -%}
                              <div class="pdp-card-img-fallback">
                                <span>{{ value | slice: 0, 2 | upcase }}</span>
                              </div>
                            {%- endif -%}
                          </div>
                          <span class="pdp-card-label">{{ value }}</span>
                        </button>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <!-- Standard Pill Selectors -->
                    <div class="pdp-option-values">
                      {%- for value in option.values -%}
                        <button
                          type="button"
                          class="pdp-opt-btn pdp-opt-pill{% if option.selected_value == value %} is-selected{% endif %}"
                          data-option-index="{{ opt_idx }}"
                          data-value="{{ value | escape }}"
                        >
                          {{ value }}
                        </button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          {%- assign pz_options = product.metafields.custom.personalization_options.value -%}
          {%- if pz_options != blank -%}
            <!-- Data-driven personalizer: steps from product.metafields.custom.personalization_options -->
            <div class="pdp-personalizer">
              {%- render 'mahjiva-personalizer', product: product, section_id: section.id -%}
            </div>
          {%- elsif template.suffix == 'custom-2' or section.settings.enable_custom_idea_fields -%}
            <!-- Customizer Idea & Reference Photos Block (custom-2 template) -->
            <div class="pdp-custom-idea-block" id="PdpCustomIdeaBlock">
              <div class="pdp-custom-idea-group">
                <label for="PdpCustomIdea-{{ section.id }}" class="pdp-custom-idea-label">
                  {{ section.settings.custom_idea_heading | default: "Tell us your idea" }}
                </label>
                <textarea
                  id="PdpCustomIdea-{{ section.id }}"
                  name="properties[Tell us your idea]"
                  class="pdp-custom-idea-textarea"
                  rows="3"
                  placeholder="{{ section.settings.custom_idea_placeholder | default: 'The Thursday Girls, est. 2005 — soft greens and gold, with peonies' }}"
                ></textarea>
                <p class="pdp-custom-idea-subtext">
                  {{ section.settings.custom_idea_subtext | default: "A name, a year, colours you love, a motif, a pet. A few words are enough. Not ready yet? Order now and reply to your confirmation email — we will not start drawing until we hear from you." }}
                </p>
              </div>

              <div class="pdp-custom-idea-group">
                <label class="pdp-custom-idea-label">
                  {{ section.settings.custom_photos_heading | default: "Reference photos" }}
                </label>
                <div class="pdp-custom-photos-dropzone" id="pdpPhotosDropzone-{{ section.id }}">
                  <input
                    type="file"
                    id="PdpCustomPhotos-{{ section.id }}"
                    name="properties[Reference photos]"
                    class="pdp-custom-photos-input"
                    accept="image/*,.pdf"
                    style="display: none;"
                    onchange="handlePdpCustomPhotoSelect(this, '{{ section.id }}')"
                  >
                  <div class="pdp-custom-photos-content" id="pdpPhotosContent-{{ section.id }}">
                    <button
                      type="button"
                      class="pdp-custom-photos-btn"
                      onclick="document.getElementById('PdpCustomPhotos-{{ section.id }}').click()"
                    >
                      {{ section.settings.custom_photos_button_text | default: "Add photos" }}
                    </button>
                  </div>
                  <div class="pdp-custom-photos-selected" id="pdpPhotosSelected-{{ section.id }}" style="display: none;">
                    <span class="pdp-custom-photos-filename" id="pdpPhotosFilename-{{ section.id }}"></span>
                    <button
                      type="button"
                      class="pdp-custom-photos-remove"
                      onclick="removePdpCustomPhoto('{{ section.id }}')"
                      title="Remove photo"
                      aria-label="Remove photo"
                    >✕</button>
                  </div>
                </div>
                <p class="pdp-custom-idea-subtext">
                  {{ section.settings.custom_photos_subtext | default: "A pet, a room, a fabric, a style you love. Optional — you can also send these later by replying to your order confirmation." }}
                </p>
              </div>
            </div>
          {%- elsif show_custom_set_request -%}
            <!-- Optional Bespoke Set Personalization Request -->
            <div class="pdp-custom-request-wrap">
              <div class="pdp-custom-request-header">
                <label for="PdpCustomRequest-{{ section.id }}" class="pdp-custom-request-title">
                  {{ section.settings.custom_set_request_heading | default: "Complimentary Gift Note or Order Instructions (Optional)" }}
                </label>
                <span class="pdp-custom-request-optional">
                  {{ section.settings.custom_set_request_badge | default: "Optional" }}
                </span>
              </div>
              <textarea
                id="PdpCustomRequest-{{ section.id }}"
                name="properties[Complimentary Gift Note or Order Instructions (Optional)]"
                class="pdp-custom-request-input"
                rows="3"
                placeholder="I’d like a different mat with my tiles…&#10;I’d like a custom mat with my name…&#10;I'd like to choose different racks..."
              ></textarea>
            </div>
          {%- endif -%}

          <!-- Price Display Directly Above ATC Button -->
          <div class="pdp-price-row maison-cls-price-slot">
            <span class="pdp-current-price{% if current_variant.price == 0 %} is-inquiry-price{% endif %}" id="pdpPrice-{{ section.id }}">
              {%- if current_variant.price > 0 -%}
                {{ current_variant.price | money }}
              {%- else -%}
                PRICE UPON INQUIRY
              {%- endif -%}
            </span>
            <span class="pdp-compare-price" id="pdpComparePrice-{{ section.id }}" style="{% unless current_variant.compare_at_price > current_variant.price and current_variant.price > 0 %}display: none;{% endunless %}">
              {%- if current_variant.compare_at_price > current_variant.price and current_variant.price > 0 -%}
                {{ current_variant.compare_at_price | money }}
              {%- endif -%}
            </span>
          </div>



          <!-- Suite Acquisition Action Buttons -->
          <div class="lp-actions-wrapper pdp-actions-wrapper">
            <div class="pdp-actions-row">
              <!-- Quantity Stepper Selector -->
              <div class="pdp-qty-wrapper{% unless current_variant.available %} is-disabled{% endunless %}" role="group" aria-label="Quantity selector">
                <button 
                  type="button" 
                  class="pdp-qty-btn pdp-qty-btn--minus is-disabled" 
                  id="pdpQtyMinus-{{ section.id }}" 
                  aria-label="Decrease quantity"
                  title="Decrease quantity"
                  disabled
                  aria-disabled="true"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
                <input 
                  type="number" 
                  name="quantity" 
                  id="pdpQtyInput-{{ section.id }}" 
                  class="pdp-qty-input" 
                  value="1" 
                  min="1" 
                  max="99" 
                  step="1"
                  inputmode="numeric"
                  aria-label="Product quantity"
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                <button 
                  type="button" 
                  class="pdp-qty-btn pdp-qty-btn--plus" 
                  id="pdpQtyPlus-{{ section.id }}" 
                  aria-label="Increase quantity"
                  title="Increase quantity"
                  {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
              </div>

              <!-- Main Add to Cart Button -->
              <button 
                type="submit" 
                name="add" 
                id="pdpAddBtn-{{ section.id }}" 
                class="lp-add-btn pdp-add-btn lp-primary-btn"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span id="pdpAddBtnText-{{ section.id }}">
                  {%- if current_variant.available -%}
                    ADD TO CART
                  {%- else -%}
                    SOLD OUT
                  {%- endif -%}
                </span>
              </button>
            </div>
          </div>
        {%- endform -%}

        <!-- Maison Atelier Luxury Delivery & Schedule Concierge Card -->
          <div class="pdp-delivery-estimator" id="pdpDeliveryEstimator-{{ section.id }}">
            <!-- Row 1: Deliver to Destination -->
            <div class="pdp-delivery-row pdp-delivery-row--country">
              <div class="pdp-delivery-left">
                <span class="pdp-delivery-icon-badge" aria-hidden="true">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </span>
                <span class="pdp-delivery-label">Deliver to</span>
              </div>
              
              <div class="pdp-delivery-right pdp-delivery-country-wrap">
                {%- form 'localization', id: 'PdpDeliveryCountryForm', class: 'pdp-country-form' -%}
                  <input type="hidden" name="country_code" id="PdpDeliveryCountryInput-{{ section.id }}" value="{{ localization.country.iso_code }}">
                  <div class="pdp-country-dropdown-wrapper">
                    <button 
                      type="button" 
                      class="pdp-delivery-trigger pdp-country-trigger" 
                      id="pdpCountryTrigger-{{ section.id }}" 
                      aria-expanded="false" 
                      aria-label="Select delivery destination (Currently {{ localization.country.name }} - {{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})"
                    >
                      <span class="pdp-curr-flag" aria-hidden="true">
                        {% render 'country-flag', country: localization.country, country_code: localization.country.iso_code %}
                      </span>
                      <span class="pdp-country-current-text">{{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})</span>
                      {%- if localization.available_countries.size > 1 -%}
                        <svg class="pdp-chevron-icon" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                      {%- endif -%}
                    </button>

                    {%- if localization.available_countries.size > 1 -%}
                      <div class="pdp-country-popover" id="pdpCountryPopover-{{ section.id }}" hidden>
                        <div class="pdp-curr-header">
                          <span>Shipping Destination &amp; Currency</span>
                          <button type="button" class="pdp-curr-close" id="pdpCountryClose-{{ section.id }}" aria-label="Close country selection">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                              <line x1="18" y1="6" x2="6" y2="18"></line>
                              <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                          </button>
                        </div>
                        
                        <div class="pdp-curr-search-box">
                          <input 
                            type="search" 
                            class="pdp-curr-search-input" 
                            id="pdpCountrySearch-{{ section.id }}" 
                            placeholder="Search region or currency..." 
                            aria-label="Search region or currency"
                            autocomplete="off"
                          >
                        </div>

                        <ul class="pdp-curr-options" role="list">
                          {%- for country in localization.available_countries -%}
                            <li class="pdp-curr-option-item">
                              <button 
                                type="button" 
                                class="pdp-country-select-item pdp-curr-select-btn{% if country.iso_code == localization.country.iso_code %} is-active is-selected{% endif %}"
                                data-country-code="{{ country.iso_code }}"
                                data-currency="{{ country.currency.iso_code }}"
                              >
                                <div class="pdp-curr-btn-left">
                                  {% render 'country-flag', country: country, country_code: country.iso_code %}
                                  <span class="pdp-curr-country-name">{{ country.name }}</span>
                                </div>
                                <span class="pdp-curr-currency-tag">
                                  {{ country.currency.iso_code }} {{ country.currency.symbol }}
                                </span>
                              </button>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    {%- endif -%}
                  </div>
                {%- endform -%}
              </div>
            </div>

            <!-- Subtle Hairline Luxury Divider -->
            <div class="pdp-delivery-divider" aria-hidden="true"></div>

            <!-- Row 2: Estimated Arrival Date -->
            <div class="pdp-delivery-row pdp-delivery-row--schedule">
              <div class="pdp-delivery-left">
                <span class="pdp-delivery-icon-badge pdp-delivery-icon-badge--truck" aria-hidden="true">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                </span>
                <span class="pdp-delivery-label">Estimated arrival</span>
              </div>

              <div class="pdp-delivery-right pdp-delivery-schedule-wrap">
                <button 
                  type="button" 
                  class="pdp-delivery-trigger pdp-schedule-trigger" 
                  id="pdpScheduleTrigger-{{ section.id }}" 
                  aria-expanded="false"
                  aria-label="View delivery schedule"
                >
                {%- liquid
                  assign sec_now = 'now' | date: '%s'
                  assign sec_ship_1 = sec_now | plus: 86400
                  assign sec_ship_2 = sec_now | plus: 172800
                  assign sec_del_1 = sec_now | plus: 864000
                  assign sec_del_2 = sec_now | plus: 1296000

                  assign m_ship_1 = sec_ship_1 | date: '%b'
                  assign m_ship_2 = sec_ship_2 | date: '%b'
                  assign m_del_1 = sec_del_1 | date: '%b'
                  assign m_del_2 = sec_del_2 | date: '%b'

                  assign day_ship_2 = sec_ship_2 | date: '%d'
                  assign day_del_2 = sec_del_2 | date: '%d'
                  assign date_ship_2 = sec_ship_2 | date: '%b %d'
                  assign date_del_2 = sec_del_2 | date: '%b %d'

                  if m_ship_1 == m_ship_2
                    assign ships_liquid = sec_ship_1 | date: '%b %d' | append: '–' | append: day_ship_2
                  else
                    assign ships_liquid = sec_ship_1 | date: '%b %d' | append: ' – ' | append: date_ship_2
                  endif

                  if m_del_1 == m_del_2
                    assign del_liquid = sec_del_1 | date: '%b %d' | append: '–' | append: day_del_2
                  else
                    assign del_liquid = sec_del_1 | date: '%b %d' | append: ' – ' | append: date_del_2
                  endif
                -%}
                  <span class="pdp-delivery-val pdp-delivery-date" id="pdpMainDeliveryDate-{{ section.id }}">
                    {{ del_liquid }}
                  </span>
                  <svg class="pdp-chevron-icon pdp-schedule-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>

                <!-- Delivery Method Popover (Luxury Atelier Delivery Schedule) -->
                <div class="pdp-delivery-popover" id="pdpDeliveryPopover-{{ section.id }}" hidden>
                  <div class="pdp-popover-arrow"></div>
                  <div class="pdp-delivery-card">
                    <!-- Header -->
                    <div class="pdp-delivery-card-header">
                      <div class="pdp-delivery-method-title">
                        <svg class="pdp-truck-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="1" y="3" width="15" height="13"></rect>
                          <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                          <circle cx="5.5" cy="18.5" r="2.5"></circle>
                          <circle cx="18.5" cy="18.5" r="2.5"></circle>
                        </svg>
                        <span>Estimated Delivery Schedule</span>
                      </div>
                      <button type="button" class="pdp-delivery-close-btn" id="pdpDeliveryClose-{{ section.id }}" aria-label="Close delivery schedule popup">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <line x1="18" y1="6" x2="6" y2="18"></line>
                          <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                      </button>
                    </div>

                    <!-- Shipping Badge -->
                    <div class="pdp-delivery-service-badge">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      </svg>
                      <span>Complimentary Insured Courier • Tracking Included</span>
                    </div>

                    <!-- Visual Timeline (Step by Step) -->
                    <div class="pdp-timeline">
                      <!-- Step 1: Placed -->
                      <div class="pdp-timeline-step">
                        <div class="pdp-timeline-dot is-active"></div>
                        <div class="pdp-timeline-content">
                          <div>
                            <div class="pdp-timeline-label">Order Placed</div>
                            <div class="pdp-timeline-sub">Verified &amp; sent to atelier</div>
                          </div>
                          <div class="pdp-timeline-date" id="pdpPlacedDate-{{ section.id }}">
                            Today, {{ 'now' | date: '%b %d' }}
                          </div>
                        </div>
                      </div>

                      <!-- Step 2: Ships -->
                      <div class="pdp-timeline-step">
                        <div class="pdp-timeline-dot"></div>
                        <div class="pdp-timeline-content">
                          <div>
                            <div class="pdp-timeline-label">Order Ships</div>
                            <div class="pdp-timeline-sub">Hand-inspected &amp; dispatched</div>
                          </div>
                          <div class="pdp-timeline-date" id="pdpShipsDate-{{ section.id }}">
                            {{ ships_liquid }}
                          </div>
                        </div>
                      </div>

