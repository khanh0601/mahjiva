    min-height: 54px;
    border-radius: 10px;
    background-color: #163327;
    border: 1px solid #163327;
    color: #FAF8F5;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 6px 18px rgba(22, 51, 39, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    position: relative !important;
    overflow: hidden !important;
  }

  /* Emerald Gleam Shimmer Effect */
  .lp-add-btn::after,
  .pdp-add-btn::after,
  .lp-primary-btn::after {
    content: '' !important;
    position: absolute !important;
    top: -50% !important;
    left: -130% !important;
    width: 80% !important;
    height: 200% !important;
    background: linear-gradient(
      105deg,
      transparent 20%,
      rgba(216, 184, 140, 0.3) 42%,
      rgba(255, 255, 255, 0.55) 50%,
      rgba(216, 184, 140, 0.3) 58%,
      transparent 80%
    ) !important;
    transform: rotate(25deg) !important;
    pointer-events: none !important;
    transition: none !important;
  }

  .lp-add-btn:hover::after,
  .pdp-add-btn:hover::after,
  .lp-primary-btn:hover::after {
    left: 140% !important;
    transition: left 0.85s cubic-bezier(0.19, 1, 0.22, 1) !important;
  }

  .lp-add-btn:hover,
  .pdp-add-btn:hover,
  .lp-primary-btn:hover {
    background-color: #1a3d2f;
    border-color: #D8B88C;
    color: #FAF8F5;
    transform: translateY(-1px);
    box-shadow: 0 10px 28px rgba(22, 51, 39, 0.35);
