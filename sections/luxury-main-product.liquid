  .pdp-bundle-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pdp-bundle-heading {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #163327;
  }

  .pdp-bundle-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    width: 100%;
  }

  .pdp-bundle-card {
    position: relative;
    padding: 24px 12px 14px;
    border-radius: 12px;
    border: 1.5px solid #E2DCD1;
    background: #FFFFFF;
    cursor: pointer;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
