{%- comment -%}
  -----------------------------------------------------------------------------
  SECTION: LUXURY MAIN PRODUCT (STAGE & FILMSTRIP ARCHITECTURE)
  - 100% Real Shopify Data (Zero Mock)
  - Fixed Header Buffer: padding-top: 128px !important; padding-bottom: 110px;
  - Breadcrumb Navigation: The Maison • Collections • [Product Title]
  - Left Column (56%):
      * .lp-stage-frame: Aspect Ratio 4:3, max-height 520px, border-radius 20px, shadow 0 12px 32px rgba(20,21,23,0.06)
      * .lp-thumbs-track: Loop product.media, 72x72px thumbnails with border-radius 10px
      * Active thumbnail: Imperial Jade border #163327 and soft box-shadow
      * Smooth horizontal scroll: overflow-x: auto, padding: 14px 2px 8px, scrollbar hidden
  - Right Column (44%):
      * Sticky on scroll: position: sticky; top: 110px;
      * Clean price & tax notice (11px unstyled)
      * Dynamic Variant Picker
      * Full-width Primary CTA: ACQUIRE THIS ALLOCATION → (padding 17px, border-radius 10px, #163327)
      * Single-line Secondary CTA: SPEAK WITH MAISON CONCIERGE
      * .lp-trust-grid: 3-col grid, #FAF8F5 background, 16px 12px padding, 18px jade icons, 9.5px uppercase titles
      * Clean Description Accordion (all cheap emojis stripped, classic serif typography)
  - Vanilla JS Interactions:
      * Click thumbnail -> updates 'is-active' class, transitions main image src with smooth fade
      * Click main stage -> Full-screen Inspection Lightbox with ultra-crisp 2400px image
      * Close button, click outside, and ESC key listener
      * Left / Right arrow navigation in Lightbox
  -----------------------------------------------------------------------------
{%- endcomment -%}

<style>
  #LuxuryProduct-{{ section.id }},
  #LuxuryMainProduct-{{ section.id }},
  #LuxuryProduct-{{ section.id }} *,
  #LuxuryMainProduct-{{ section.id }} * {
    box-sizing: border-box !important;
  }

  /* 1. COMPACT ATELIER PADDING & RESPONSIVE CONTAINER (1360px) */
  #LuxuryProduct-{{ section.id }},
  #LuxuryMainProduct-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FCFAF8' }};
    padding-top: {{ section.settings.padding_top | default: 24 }}px !important;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #141517;
    position: relative;
    overflow-x: clip !important;
    overflow-y: visible !important;
    max-width: 100vw !important;
  }

  @media (max-width: 767px) {
    #LuxuryProduct-{{ section.id }},
    #LuxuryMainProduct-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 24 | times: 0.7 | round | at_least: 16 }}px !important;
      padding-bottom: 40px !important;
    }
  }

  .lp-container,
  .pdp-container {
    max-width: 1200px !important;
    margin: 0 auto !important;
    padding: 0 24px !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  @media (max-width: 767px) {
    .lp-container,
    .pdp-container {
      padding: 0 16px !important;
    }
  }

  @media (min-width: 1024px) {
    .lp-container,
    .pdp-container {
      max-width: 1200px !important;
      padding: 0 24px !important;
    }
  }

  /* Breadcrumb Navigation */
  .lp-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #7A7571;
    margin-bottom: 16px;
    flex-wrap: wrap;
    line-height: 1.4;
  }

  @media (max-width: 767px) {
    .lp-breadcrumb {
      font-size: 10.5px !important;
      gap: 6px !important;
      margin-bottom: 12px !important;
      line-height: 1.4 !important;
    }
  }

  .lp-breadcrumb a {
    color: #7A7571;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .lp-breadcrumb a:hover {
    color: #163327;
  }

  .lp-breadcrumb .lp-sep,
  .lp-breadcrumb span:not([style]) {
    color: #B89768;
    font-size: 10px;
  }

  /* Grid Layout: Left Column 54% / Right Column 46%, 40px gap on Desktop */
  .lp-grid,
  .pdp-grid,
  .lp-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) !important;
    gap: 28px;
    width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
  }

  @media (max-width: 767px) {
    .lp-grid,
    .pdp-grid,
    .lp-layout {
      gap: 20px !important;
    }
  }

  @media (min-width: 992px) {
    .lp-grid,
    .pdp-grid,
    .lp-layout {
      grid-template-columns: 54% 46% !important;
      gap: 40px !important;
      align-items: start;
    }
  }

  @media (min-width: 1200px) {
    .lp-grid,
    .pdp-grid,
    .lp-layout {
      grid-template-columns: 54% 46% !important;
      gap: 40px !important;
    }
  }

  /* =========================================================================
     2. LEFT COLUMN (54%): GALLERY STAGE & FILMSTRIP
     ========================================================================= */
  .lp-gallery-col,
  .pdp-gallery-col {
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
  }

  /* Desktop Sticky Gallery Pinning */
  @media (min-width: 992px) {
    .lp-gallery-col,
    .pdp-gallery-col {
      position: sticky !important;
      top: 88px !important;
      align-self: start !important;
      z-index: 5;
    }
  }

  /* Master Stage Frame: 1:1 ratio, max-height 480px, border-radius 18px, champagne gold border #B89768 */
  .lp-stage-frame,
  .pdp-main-stage {
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    aspect-ratio: 1 / 1 !important;
    max-height: 480px !important;
    border-radius: 18px !important;
    overflow: hidden;
    background-color: #F5F2EB !important;
    border: 1px solid rgba(184, 151, 104, 0.45) !important;
    box-shadow: 0 12px 32px rgba(20, 21, 23, 0.06);
    cursor: zoom-in;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.3s ease;
    box-sizing: border-box !important;
  }

  @media (max-width: 767px) {
    .lp-stage-frame,
    .pdp-main-stage {
      border-radius: 14px !important;
      max-height: 420px !important;
    }
  }

  .lp-stage-frame:hover,
  .pdp-main-stage:hover {
    box-shadow: 0 16px 44px rgba(20, 21, 23, 0.1);
    border-color: rgba(184, 151, 104, 0.7) !important;
  }

  .lp-stage-inner,
  .pdp-stage-inner {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .lp-main-img,
  .pdp-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 1;
    transform: scale(1);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  .lp-main-img.is-switching,
  .lp-main-img.is-transitioning,
  .pdp-main-img.is-switching,
  .pdp-main-img.is-transitioning {
    opacity: 0 !important;
    transform: scale(0.98) !important;
  }

  /* Micro-interaction: Hover Zoom 1.04x */
  .lp-stage-frame:hover .lp-main-img,
  .pdp-main-stage:hover .pdp-main-img {
    transform: scale(1.04) !important;
  }

  /* Zoom badge removed to preserve unobstructed view of master artwork */

  .pdp-no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9E978E;
    font-size: 13px;
    background: #F4F0E8;
  }

  /* Filmstrip thumbnails track: larger 82x82px thumbnails with integrated navigation */
  .lp-thumbs-wrapper,
  .pdp-thumbs-wrapper {
    margin-top: 16px;
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    display: flex;
    align-items: center;
    gap: 8px;
    box-sizing: border-box !important;
  }

  @media (max-width: 767px) {
    .lp-thumbs-wrapper,
    .pdp-thumbs-wrapper {
      margin-top: 12px !important;
      gap: 6px !important;
    }
  }

  /* Thumbnail Navigation Buttons */
  .lp-thumb-nav-btn {
    flex: 0 0 34px !important;
    width: 34px !important;
    height: 34px !important;
    border-radius: 50% !important;
    background: #FFFFFF !important;
    border: 1px solid rgba(184, 151, 104, 0.4) !important;
    color: #163327 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08) !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    z-index: 5 !important;
    padding: 0 !important;
    outline: none !important;
  }

  @media (max-width: 767px) {
    .lp-thumb-nav-btn {
      flex: 0 0 30px !important;
      width: 30px !important;
      height: 30px !important;
    }
  }

  .lp-thumb-nav-btn:hover {
    background: #163327 !important;
    color: #FAF8F5 !important;
    border-color: #163327 !important;
    transform: scale(1.08) !important;
    box-shadow: 0 4px 12px rgba(22, 51, 39, 0.2) !important;
  }

  .lp-thumb-nav-btn:active {
    transform: scale(0.96) !important;
  }

  .lp-thumb-nav-btn svg {
    pointer-events: none !important;
  }

  .lp-thumbs-track,
  .pdp-thumbs-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 6px 2px 10px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    flex: 1 1 0% !important;
    width: 0 !important;
    min-width: 0 !important;
    align-items: center;
  }

  @media (max-width: 767px) {
    .lp-thumbs-track,
    .pdp-thumbs-track {
      gap: 8px !important;
      padding: 4px 2px 8px !important;
    }
  }

  .lp-thumbs-track::-webkit-scrollbar,
  .pdp-thumbs-track::-webkit-scrollbar {
    display: none;
  }

  /* Enlarged Thumbnail dimensions: 82x82px, border-radius: 12px */
  .lp-thumb-item,
  .pdp-thumb-item {
    width: 82px !important;
    height: 82px !important;
    flex: 0 0 82px !important;
    border-radius: 12px !important;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    padding: 0;
    margin: 0;
    background: #F4F1EA;
    border: 1.5px solid rgba(22, 51, 39, 0.08);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
    scroll-snap-align: start;
    opacity: 0.72;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
  }

  @media (max-width: 767px) {
    .lp-thumb-item,
    .pdp-thumb-item {
      width: 68px !important;
      height: 68px !important;
      flex: 0 0 68px !important;
      border-radius: 8px !important;
    }
  }

  .lp-thumb-item:hover,
  .pdp-thumb-item:hover {
    opacity: 1;
    border-color: #B89768;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  }

  /* Active thumbnail: Imperial Jade border #163327 and soft elevation */
  .lp-thumb-item.is-active,
  .pdp-thumb-item.is-active {
    opacity: 1 !important;
    border: 2px solid #163327 !important;
    box-shadow: 0 4px 14px rgba(22, 51, 39, 0.24) !important;
    transform: translateY(-2px);
  }

  .lp-thumb-img,
  .pdp-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  /* =========================================================================
     3. RIGHT COLUMN (44%): SUITE DOSSIER & COMMERCE (STICKY)
     ========================================================================= */
  .lp-info-col,
  .pdp-info-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    align-self: start;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
  }

  /* Eyebrow & Category Tag */
  .pdp-tag-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 0;
  }

  .pdp-badge-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: 9999px;
    background: #163327;
    border: 1px solid rgba(216, 184, 140, 0.45);
    color: #D8B88C;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  a.pdp-badge-tag:hover {
    background: #234d3c;
    border-color: #D8B88C;
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .pdp-vendor-text {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #7A7571;
    font-weight: 600;
  }

  /* Judge.me Star Rating Badge (Above Product Title) */
  .pdp-judgeme-rating {
    display: flex;
    align-items: center;
    min-height: 18px;
    margin-top: 2px;
    margin-bottom: 2px;
    cursor: pointer;
  }

  .pdp-judgeme-rating .jdgm-widget,
  .pdp-judgeme-rating .jdgm-preview-badge,
  .pdp-judgeme-rating .jdgm-preview-badge[data-template="product"],
  .pdp-judgeme-rating .jdgm-prev-badge {
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  .pdp-judgeme-rating .jdgm-star {
    color: #E3D10D !important;
    font-size: 15px !important;
  }

  .pdp-judgeme-rating .jdgm-prev-badge__text {
    font-size: 12.5px !important;
    color: #55524E !important;
    font-weight: 500 !important;
    visibility: visible !important;
    display: inline !important;
    margin-left: 4px !important;
  }

  /* Product Title & Description Group */
  .pdp-title-desc-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pdp-title {
    font-family: "Cormorant Garamond", Garamond, Georgia, serif;
    font-size: 27px;
    font-weight: 500;
    line-height: 1.2;
    color: #141517;
    margin: 0 !important;
    letter-spacing: -0.01em;
  }

  @media (min-width: 768px) {
    .pdp-title {
      font-size: 38px;
      line-height: 1.15;
    }
  }

  .pdp-description {
    font-size: 14px;
    line-height: 1.55;
    color: #4A4642;
    margin-top: 4px;
    margin-bottom: 0;
  }

  .pdp-description p {
    margin: 0 0 6px 0 !important;
  }

  .pdp-description p:last-child {
    margin-bottom: 0 !important;
  }

  /* Delivery & Shipping Estimator Widget (Amazon/Etsy Style) */
  .pdp-delivery-estimator {
    margin: 8px 0 14px 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    position: relative;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .pdp-delivery-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 13.5px;
    line-height: 1.45;
    color: #4B5563;
    position: relative;
  }

  .pdp-delivery-label {
    color: #4B5563;
    font-weight: 400;
  }

  .pdp-delivery-trigger {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    font-family: inherit;
    font-size: 13.5px;
    color: #111827;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.15s ease;
    line-height: inherit;
  }

  .pdp-delivery-trigger:hover {
    color: #163327;
  }

  .pdp-chevron-icon {
    color: #4B5563;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .pdp-delivery-trigger[aria-expanded="true"] .pdp-chevron-icon {
    transform: rotate(180deg);
  }

  /* Delivery Method Popover (Exact match to screenshot) */
  .pdp-delivery-popover {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    z-index: 1000;
    width: 100%;
    max-width: 385px;
    animation: pdpFadeInUp 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes pdpFadeInUp {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pdp-popover-arrow {
    position: absolute;
    top: -6px;
    left: 48px;
    width: 12px;
    height: 12px;
    background: #FFFFFF;
    border-left: 1px solid #E5E7EB;
    border-top: 1px solid #E5E7EB;
    transform: rotate(45deg);
    z-index: 1001;
  }

  .pdp-delivery-card {
    position: relative;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.04);
    padding: 18px 20px 20px;
    color: #111827;
    box-sizing: border-box;
  }

  .pdp-delivery-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .pdp-delivery-method-title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
    color: #111827;
  }

  .pdp-truck-icon {
    color: #111827;
    flex-shrink: 0;
  }

  .pdp-delivery-close-btn {
    background: #F3F4F6;
    border: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #4B5563;
    transition: all 0.15s ease;
    padding: 0;
  }

  .pdp-delivery-close-btn:hover {
    background: #E5E7EB;
    color: #111827;
  }

  .pdp-delivery-subheading {
    font-size: 14px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 12px;
  }

  .pdp-delivery-milestones {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 16px;
  }

  .pdp-milestone-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13.5px;
    line-height: 1.4;
  }

  .pdp-milestone-label {
    font-weight: 700;
    color: #111827;
  }

  .pdp-milestone-val {
    font-weight: 700;
    color: #111827;
    text-align: right;
  }

  .pdp-delivery-notes {
    border-top: 1px solid #F0ECE4;
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pdp-note-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12px;
    line-height: 1.5;
    color: #4B5563;
  }

  .pdp-bullet {
    font-size: 14px;
    line-height: 1;
    color: #111827;
    flex-shrink: 0;
  }

  /* Country Selection Popover */
  .pdp-country-popover {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 1002;
    width: 320px;
    max-width: 90vw;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    padding: 14px;
    animation: pdpFadeInUp 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }

  .pdp-popover-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .pdp-popover-title {
    font-size: 13px;
    font-weight: 700;
    color: #111827;
    letter-spacing: 0.02em;
  }

  .pdp-popover-close {
    background: transparent;
    border: none;
    font-size: 14px;
    color: #6B7280;
    cursor: pointer;
    padding: 2px 6px;
  }

  .pdp-country-search-wrap {
    margin-bottom: 8px;
  }

  .pdp-country-search-input {
    width: 100%;
    padding: 7px 10px;
    font-size: 12.5px;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    outline: none;
    box-sizing: border-box;
  }

  .pdp-country-search-input:focus {
    border-color: #163327;
  }

  .pdp-country-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 200px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pdp-country-select-item {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 8px;
    border-radius: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 12.5px;
    color: #374151;
    text-align: left;
    transition: background 0.15s ease;
  }

  .pdp-country-select-item:hover,
  .pdp-country-select-item.is-selected {
    background: #F3F4F6;
    color: #111827;
    font-weight: 600;
  }

  .pdp-country-flag {
    margin-right: 8px;
    display: inline-flex;
  }

  .pdp-country-curr-tag {
    font-size: 11px;
