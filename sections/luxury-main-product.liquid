    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 8px 24px rgba(8, 22, 16, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2) !important;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    position: relative !important;
    overflow: hidden !important;
  }

  /* Emerald Gleam Shimmer Effect */
  .lp-add-btn::after,
  .pdp-add-btn::after,
  .lp-primary-btn::after {
    content: '' !important;
    position: absolute !important;
    top: -50% !important;
    left: -130% !important;
    width: 80% !important;
    height: 200% !important;
    background: linear-gradient(
      105deg,
      transparent 20%,
      rgba(216, 184, 140, 0.3) 42%,
      rgba(255, 255, 255, 0.55) 50%,
      rgba(216, 184, 140, 0.3) 58%,
      transparent 80%
    ) !important;
    transform: rotate(25deg) !important;
    pointer-events: none !important;
    transition: none !important;
  }

  .lp-add-btn:hover::after,
  .pdp-add-btn:hover::after,
  .lp-primary-btn:hover::after {
    left: 140% !important;
    transition: left 0.85s cubic-bezier(0.19, 1, 0.22, 1) !important;
  }

  .lp-add-btn:hover,
  .pdp-add-btn:hover,
  .lp-primary-btn:hover {
    background: linear-gradient(180deg, #245E45 0%, #18422F 42%, #0C1E15 100%) !important;
    border-color: #D8B88C !important;
    color: #FFFFFF !important;
    transform: translateY(-1px);
    box-shadow: 0 10px 28px rgba(8, 22, 16, 0.45), 0 0 18px rgba(36, 94, 69, 0.25) !important;
  }

  .lp-add-btn:disabled,
  .pdp-add-btn:disabled,
  .lp-primary-btn:disabled {
    background-color: #EDEAE4;
    border-color: #EDEAE4;
    color: #A39D94;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
  }

  .lp-add-btn:disabled::after,
  .pdp-add-btn:disabled::after,
  .lp-primary-btn:disabled::after {
    display: none !important;
  }

