{%- comment -%}
  -----------------------------------------------------------------------------
  SECTION: LUXURY MAIN PRODUCT (STAGE & FILMSTRIP ARCHITECTURE)
  - 100% Real Shopify Data (Zero Mock)
  - Fixed Header Buffer: padding-top: 128px !important; padding-bottom: 110px;
  - Breadcrumb Navigation: The Maison • Collections • [Product Title]
  - Left Column (56%):
      * .lp-stage-frame: Aspect Ratio 4:3, max-height 520px, border-radius 20px, shadow 0 12px 32px rgba(20,21,23,0.06)
      * .lp-thumbs-track: Loop product.media, 72x72px thumbnails with border-radius 10px
      * Active thumbnail: Imperial Jade border #163327 and soft box-shadow
      * Smooth horizontal scroll: overflow-x: auto, padding: 14px 2px 8px, scrollbar hidden
  - Right Column (44%):
      * Sticky on scroll: position: sticky; top: 110px;
      * Clean price & tax notice (11px unstyled)
      * Dynamic Variant Picker
      * Full-width Primary CTA: ACQUIRE THIS ALLOCATION → (padding 17px, border-radius 10px, #163327)
      * Single-line Secondary CTA: SPEAK WITH MAISON CONCIERGE
      * .lp-trust-grid: 3-col grid, #FAF8F5 background, 16px 12px padding, 18px jade icons, 9.5px uppercase titles
      * Clean Description Accordion (all cheap emojis stripped, classic serif typography)
  - Vanilla JS Interactions:
      * Click thumbnail -> updates 'is-active' class, transitions main image src with smooth fade
      * Click main stage -> Full-screen Inspection Lightbox with ultra-crisp 2400px image
      * Close button, click outside, and ESC key listener
      * Left / Right arrow navigation in Lightbox
  -----------------------------------------------------------------------------
{%- endcomment -%}

<style>
  #LuxuryProduct-{{ section.id }},
  #LuxuryMainProduct-{{ section.id }},
  #LuxuryProduct-{{ section.id }} *,
  #LuxuryMainProduct-{{ section.id }} * {
    box-sizing: border-box !important;
  }

  /* 1. COMPACT ATELIER PADDING & RESPONSIVE CONTAINER (1360px) */
  #LuxuryProduct-{{ section.id }},
  #LuxuryMainProduct-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FCFAF8' }};
    padding-top: {{ section.settings.padding_top | default: 24 }}px !important;
    padding-bottom: 8px !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #141517;
    position: relative;
    overflow: visible !important;
    overflow-x: visible !important;
    overflow-y: visible !important;
    max-width: 100vw !important;
  }

  @media (max-width: 767px) {
    #LuxuryProduct-{{ section.id }},
    #LuxuryMainProduct-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 24 | times: 0.7 | round | at_least: 16 }}px !important;
      padding-bottom: 8px !important;
    }
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    #LuxuryProduct-{{ section.id }},
    #LuxuryMainProduct-{{ section.id }} {
      padding-top: 18px !important;
      padding-bottom: 24px !important;
    }
  }

  .lp-container,
  .pdp-container {
    max-width: 1200px !important;
    margin: 0 auto !important;
    padding: 0 24px !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  @media (max-width: 767px) {
    .lp-container,
    .pdp-container {
      padding: 0 16px !important;
    }
  }

  @media (min-width: 740px) and (max-width: 1199px) {
    .lp-container,
    .pdp-container {
      padding: 0 20px !important;
      max-width: 100% !important;
    }
  }

  @media (min-width: 1200px) {
    .lp-container,
    .pdp-container {
      max-width: 1200px !important;
      padding: 0 24px !important;
    }
  }

  /* Breadcrumb Navigation */
  .lp-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #7A7571;
    margin-bottom: 16px;
    flex-wrap: wrap;
    line-height: 1.4;
  }

  @media (max-width: 739px) {
    .lp-breadcrumb {
      font-size: 10.5px !important;
      gap: 6px !important;
      margin-bottom: 12px !important;
      line-height: 1.4 !important;
    }
  }

  .lp-breadcrumb a {
    color: #7A7571;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .lp-breadcrumb a:hover {
    color: #163327;
  }

  .lp-breadcrumb .lp-sep,
  .lp-breadcrumb span:not([style]) {
    color: #B89768;
    font-size: 10px;
  }

  /* Grid Layout: Left Column / Right Column */
  .lp-grid,
  .pdp-grid,
  .lp-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) !important;
    gap: 28px;
    width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
  }

  @media (max-width: 739px) {
    .lp-grid,
    .pdp-grid,
    .lp-layout {
      gap: 20px !important;
    }
  }

  /* iPad Portrait & Tablets (740px - 991px): 2 columns, exactly 100% width, zero overflow */
  @media (min-width: 740px) and (max-width: 991px) {
    .lp-grid,
    .pdp-grid,
    .lp-layout {
      grid-template-columns: minmax(0, 0.96fr) minmax(0, 1.04fr) !important;
      gap: 20px !important;
      align-items: start !important;
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }
  }

  /* iPad Landscape & Large Tablets (992px - 1199px): 50/50 columns, exactly 100% width, zero overflow */
  @media (min-width: 992px) and (max-width: 1199px) {
    .lp-grid,
    .pdp-grid,
    .lp-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
      gap: 24px !important;
      align-items: start !important;
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }
  }

  /* Large Desktop & iPad Pro 12.9" Landscape (>= 1200px): 54/46 columns, zero overflow */
  @media (min-width: 1200px) {
    .lp-grid,
    .pdp-grid,
    .lp-layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr) !important;
      gap: 32px !important;
      align-items: start !important;
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }
  }

    /* =========================================================================
     MOBILE LUXURY STICKY PRODUCT BAR (Slides up when scrolling past Add to Cart)
     ========================================================================= */
  .lp-mobile-sticky-bar {
    display: none !important;
  }

  @media (max-width: 739px) {
    .lp-mobile-sticky-bar {
      display: block !important;
      position: fixed !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      width: 100% !important;
      background: #FAF8F5 !important;
      border-top: 1px solid rgba(184, 151, 104, 0.4) !important;
      box-shadow: 0 -6px 22px rgba(10, 22, 17, 0.12) !important;
      z-index: 998 !important;
      transform: translateY(115%) !important;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease !important;
      opacity: 0 !important;
      pointer-events: none !important;
      padding: 10px 16px !important;
      padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px)) !important;
      box-sizing: border-box !important;
    }

    .lp-mobile-sticky-bar.is-visible {
      transform: translateY(0) !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }

    .lp-msb-inner {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 12px !important;
      max-width: 600px !important;
      margin: 0 auto !important;
    }

    .lp-msb-left {
      display: flex !important;
      align-items: center !important;
      gap: 10px !important;
      min-width: 0 !important;
      flex: 1 !important;
    }

    .lp-msb-thumb {
      width: 44px !important;
      height: 44px !important;
      border-radius: 8px !important;
      object-fit: cover !important;
      border: 1px solid rgba(22, 51, 39, 0.15) !important;
      flex-shrink: 0 !important;
      background: #FFFFFF !important;
      box-shadow: 0 1px 4px rgba(0,0,0,0.06) !important;
    }

    .lp-msb-info {
      min-width: 0 !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 2px !important;
    }

    .lp-msb-title {
      font-size: 13px !important;
      font-weight: 600 !important;
      color: #163327 !important;
      white-space: nowrap !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      line-height: 1.25 !important;
    }

    .lp-msb-price {
      font-size: 13px !important;
      font-weight: 700 !important;
      color: #B89768 !important;
      line-height: 1 !important;
    }

    .lp-msb-right {
      flex-shrink: 0 !important;
    }

    .lp-msb-btn {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      background: linear-gradient(180deg, #1D4B37 0%, #163327 100%) !important;
      color: #FAF8F5 !important;
      border: 1px solid rgba(184, 151, 104, 0.45) !important;
      border-radius: 8px !important;
      padding: 10px 18px !important;
      font-size: 12.5px !important;
      font-weight: 700 !important;
      letter-spacing: 0.04em !important;
      cursor: pointer !important;
      white-space: nowrap !important;
      box-shadow: 0 3px 10px rgba(22, 51, 39, 0.25) !important;
      transition: all 0.2s ease !important;
      min-height: 42px !important;
    }

    .lp-msb-btn:active {
      transform: scale(0.97) !important;
    }

    .lp-msb-btn[disabled] {
      background: #A3A09B !important;
      border-color: #A3A09B !important;
      cursor: not-allowed !important;
      box-shadow: none !important;
    }
  }

  /* =========================================================================
     2. LEFT COLUMN: GALLERY STAGE & FILMSTRIP - STICKY ACROSS ALL DEVICES
     ========================================================================= */
  .lp-gallery-col,
  .pdp-gallery-col {
    position: -webkit-sticky !important;
    position: sticky !important;
    top: var(--lh-header-h, 68.5px) !important;
    align-self: start !important;
    height: fit-content !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
    z-index: 15 !important;
    transition: top 0.25s ease !important;
  }

  /* Sticky Gallery Pinning on Tablet (iPad) & Desktop */
  @media (min-width: 740px) {
    .lp-grid,
    .pdp-grid,
    .lp-layout {
      align-items: start !important;
    }

    .lp-gallery-col,
    .pdp-gallery-col {
      top: var(--lh-header-h, 68.5px) !important;
      z-index: 15 !important;
    }

    body.header-is-revealed .lp-gallery-col,
    body.header-is-revealed .pdp-gallery-col,
    body.is-scrolled-past-top .lp-gallery-col,
    body.is-scrolled-past-top .pdp-gallery-col {
      top: var(--lh-header-h, 68.5px) !important;
    }
  }

  /* Mobile Gallery Sticky Experience */
  @media (max-width: 739px) {
    .lp-gallery-col,
    .pdp-gallery-col {
      position: -webkit-sticky !important;
      position: sticky !important;
      top: var(--lh-header-h, 60px) !important;
      z-index: 5 !important;
    }

    .lp-info-col,
    .pdp-info-col {
      position: relative !important;
      z-index: 10 !important;
      background: #FAF8F5 !important;
      border-radius: 20px 20px 0 0 !important;
      box-shadow: 0 -8px 24px rgba(22, 51, 39, 0.08) !important;
      padding-top: 18px !important;
      margin-top: 8px !important;
    }
  }

  /* Master Stage Frame: Exact 1:1 square ratio, border-radius 18px, champagne gold border #B89768 */
  .lp-stage-frame,
  .pdp-main-stage {
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    aspect-ratio: 1 / 1 !important;
    height: auto !important;
    max-height: none !important;
    border-radius: 18px !important;
    overflow: hidden;
    background-color: #FFFFFF !important;
    border: 1px solid rgba(184, 151, 104, 0.45) !important;
    box-shadow: 0 12px 32px rgba(20, 21, 23, 0.06);
    cursor: zoom-in;
    touch-action: pan-y !important;
    user-select: none !important;
    -webkit-user-select: none !important;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.3s ease;
    box-sizing: border-box !important;
  }

  .lp-stage-frame img,
  .pdp-main-stage img,
  .lp-main-img,
  .pdp-main-img {
    -webkit-user-drag: none !important;
    user-drag: none !important;
    pointer-events: auto !important;
  }

  @media (max-width: 767px) {
    .lp-stage-frame,
    .pdp-main-stage {
      border-radius: 14px !important;
      height: auto !important;
      max-height: none !important;
    }
  }

  .lp-stage-frame:hover,
  .pdp-main-stage:hover {
    box-shadow: 0 16px 44px rgba(20, 21, 23, 0.1);
    border-color: rgba(184, 151, 104, 0.7) !important;
  }

  .lp-stage-inner,
  .pdp-stage-inner {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lp-main-img,
  .pdp-main-img {
    width: 100%;
    height: 100%;
    object-fit: contain !important;
    object-position: center !important;
    display: block;
    opacity: 1;
    transform: scale(1);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  .lp-main-img.is-switching,
  .lp-main-img.is-transitioning,
  .pdp-main-img.is-switching,
  .pdp-main-img.is-transitioning {
    opacity: 0 !important;
    transform: scale(0.98) !important;
  }

  /* Micro-interaction: Keep crisp 1:1 image without cropping edges on hover */
  .lp-stage-frame:hover .lp-main-img,
  .pdp-main-stage:hover .pdp-main-img {
    transform: scale(1) !important;
  }

  /* Zoom badge removed to preserve unobstructed view of master artwork */

  .pdp-no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9E978E;
    font-size: 13px;
    background: #F4F0E8;
  }

  /* Filmstrip thumbnails track: larger 82x82px thumbnails with integrated navigation */
  .lp-thumbs-wrapper,
  .pdp-thumbs-wrapper {
    margin-top: 16px;
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    display: flex;
    align-items: center;
    gap: 8px;
    box-sizing: border-box !important;
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    .lp-thumbs-wrapper,
    .pdp-thumbs-wrapper {
      margin-top: 10px !important;
      gap: 6px !important;
    }
  }

  @media (max-width: 767px) {
    .lp-thumbs-wrapper,
    .pdp-thumbs-wrapper {
      margin-top: 12px !important;
      gap: 6px !important;
    }
  }

  /* Thumbnail Navigation Buttons */
  .lp-thumb-nav-btn {
    flex: 0 0 34px !important;
    width: 34px !important;
    height: 34px !important;
    border-radius: 50% !important;
    background: #FFFFFF !important;
    border: 1px solid rgba(184, 151, 104, 0.4) !important;
    color: #163327 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08) !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    z-index: 5 !important;
    padding: 0 !important;
    outline: none !important;
  }

  @media (max-width: 767px) {
    .lp-thumb-nav-btn {
      flex: 0 0 30px !important;
      width: 30px !important;
      height: 30px !important;
    }
  }

  .lp-thumb-nav-btn:hover {
    background: linear-gradient(180deg, #1D4B37 0%, #143828 42%, #081610 100%) !important;
    color: #FAF8F5 !important;
    border-color: #143828 !important;
    transform: scale(1.08) !important;
    box-shadow: 0 4px 12px rgba(8, 22, 16, 0.35) !important;
  }

  .lp-thumb-nav-btn:active {
    transform: scale(0.96) !important;
  }

  .lp-thumb-nav-btn svg {
    pointer-events: none !important;
  }

  .lp-thumbs-track,
  .pdp-thumbs-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: none !important;
    scroll-behavior: auto;
        touch-action: pan-x pan-y !important;
    overscroll-behavior-x: contain !important;
    padding: 6px 2px 10px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    flex: 1 1 auto !important;
    min-width: 0 !important;
    width: auto !important;
    align-items: center;
  }

  @media (max-width: 767px) {
    .lp-thumbs-track,
    .pdp-thumbs-track {
      gap: 8px !important;
      padding: 4px 2px 8px !important;
    }
  }

  .lp-thumbs-track::-webkit-scrollbar,
  .pdp-thumbs-track::-webkit-scrollbar {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) { .lp-thumbs-track, .pdp-thumbs-track { cursor: grab; } }
  .lp-thumbs-track.is-dragging, .pdp-thumbs-track.is-dragging { cursor: grabbing; user-select: none; }
  .lp-thumbs-track.is-dragging .lp-thumb-item, .pdp-thumbs-track.is-dragging .pdp-thumb-item { transition: none !important; }

  /* Enlarged Thumbnail dimensions: 82x82px, border-radius: 12px */
  .lp-thumb-item,
  .pdp-thumb-item {
    width: 82px !important;
    height: 82px !important;
    flex: 0 0 82px !important;
    aspect-ratio: 1 / 1 !important;
    border-radius: 12px !important;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    padding: 0;
    margin: 0;
    background: #F4F1EA;
    border: 1.5px solid rgba(22, 51, 39, 0.08);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
    scroll-snap-align: start;
    opacity: 0.72;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    .lp-thumb-item,
    .pdp-thumb-item {
      width: 72px !important;
      height: 72px !important;
      flex: 0 0 72px !important;
      border-radius: 10px !important;
    }
  }

  @media (max-width: 767px) {
    .lp-thumb-item,
    .pdp-thumb-item {
      width: 68px !important;
      height: 68px !important;
      flex: 0 0 68px !important;
      border-radius: 8px !important;
    }
  }

  .lp-thumb-item:hover,
  .pdp-thumb-item:hover {
    opacity: 1;
    border-color: #B89768;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  }

  /* Active thumbnail: Imperial Jade border #163327 and soft elevation */
  .lp-thumb-item.is-active,
  .pdp-thumb-item.is-active {
    opacity: 1 !important;
    border: 2px solid #163327 !important;
    box-shadow: 0 4px 14px rgba(22, 51, 39, 0.24) !important;
    transform: translateY(-2px);
  }

  .lp-thumb-img,
  .pdp-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  /* =========================================================================
     3. RIGHT COLUMN (44%): SUITE DOSSIER & COMMERCE (STICKY)
     ========================================================================= */
  .lp-info-col,
  .pdp-info-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    align-self: start;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
  }

  /* Eyebrow & Category Tag */
  .pdp-tag-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 0;
  }

  .pdp-badge-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: 9999px;
    background: #163327;
    border: 1px solid rgba(216, 184, 140, 0.45);
    color: #D8B88C;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  a.pdp-badge-tag:hover {
    background: #234d3c;
    border-color: #D8B88C;
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .pdp-vendor-text {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #7A7571;
    font-weight: 600;
  }

  /* Judge.me Star Rating Badge (Above Product Title) - Sleek, clean and hide empty reviews */
  .pdp-judgeme-rating {
    display: flex;
    align-items: center;
    min-height: 18px;
    margin-top: 2px;
    margin-bottom: 2px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .pdp-judgeme-rating:hover {
    opacity: 0.85;
  }

  /* Automatically hide if Judge.me has 0 reviews / no reviews */
  .pdp-judgeme-rating.is-empty-review,
  .pdp-judgeme-rating .jdgm-prev-badge[data-number-of-reviews="0"],
  .pdp-judgeme-rating .jdgm-preview-badge[data-number-of-reviews="0"] {
    display: none !important;
  }

  .pdp-judgeme-rating .jdgm-widget,
  .pdp-judgeme-rating .jdgm-preview-badge,
  .pdp-judgeme-rating .jdgm-preview-badge[data-template="product"],
  .pdp-judgeme-rating .jdgm-prev-badge {
    display: inline-flex !important;
    align-items: center !important;
    gap: 5px !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  .pdp-judgeme-rating .jdgm-star {
    color: #E5A93C !important;
    font-size: 14px !important;
