       distinct discount badge & strikethrough price without overlapping
     ========================================================================= */
  .pdp-bundle-container {
    margin-top: 18px;
    padding: 16px 14px;
    background: #FAF8F5;
    border: 1px solid #ECE7DE;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
