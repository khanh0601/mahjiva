{% style %}
@media screen and (max-width: 749px) {
  .blocky-faq-flex {
    row-gap: 3rem !important;
  }
  .blocky-faq-flex > * {
    width: 100% !important;
    flex-grow: 1 !important;
  }
}
.blocky-faq-question {
  border: none;
  width: 100%;
  padding: var(--question-padding);
  font-size: 16px;
  text-align: left;
  cursor: pointer;
  border-radius: 5px;
  transition: all .125s ease-in-out;
  font-size: calc(var(--question-font-size) * .85);
  color: var(--question-text-color);
}
.blocky-faq-question.active {
  border-radius: 5px 5px 0px 0px;
}
.blocky-faq-question.active .bky-accordion-carot {
  transform: rotate(180deg);
}
.bky-accordion-carot {
  transition: transform .25s;
}
.blocky-faq-question.active .bky-accordion-minus,
.blocky-faq-question:not(.active) .bky-accordion-plus {
  display: block;
}
.blocky-faq-question:not(.active) .bky-accordion-minus,
.blocky-faq-question.active .bky-accordion-plus {
  display: none;
}
.blocky-faq-question:hover {
  opacity: 0.65;
}
.blocky-faq-answer {
  overflow: hidden;
  border-radius: 0px 0px 5px 5px;
  transition: all 0.125s ease-in-out;
  padding: 0px var(--question-padding) 0px var(--question-padding);
  max-height: 0;
  font-size: calc(var(--answer-font-size) * .85);
  color: var(--answer-text-color);
}
.blocky-faq-answer.active {
  max-height: 1000px;
  padding: var(--question-padding);
  padding-top: 0px;
}
.blocky-faq-icon {
  font-size: var(--bky-faq-icon-size, var(--question-font-size)) !important;
  height: var(--bky-faq-icon-size, var(--question-font-size));
  width: var(--bky-faq-icon-size, var(--question-font-size));
}
@media screen and (min-width: 750px) {
  .blocky-faq-question {
    font-size: var(--question-font-size);
  }
  .blocky-faq-answer {
    font-size: var(--answer-font-size);
  }
  .blocky-faq-icon {
    font-size: var(--bky-faq-icon-size, calc(var(--question-font-size) * 1.2)) !important;
    height: var(--bky-faq-icon-size, calc(var(--question-font-size) * 1.2));
    width: var(--bky-faq-icon-size, calc(var(--question-font-size) * 1.2));
  }
}
.blocky-accordion {
  height: fit-content;
}
.blocky-accordion-row .blocky-faq-item {
  margin-bottom: 1rem;
}
.blocky-accordion-border .blocky-faq-question,
.blocky-accordion-none .blocky-faq-question {
  background-color: unset;
}
.blocky-accordion-border .blocky-accordion-btn,
.blocky-accordion-none .blocky-accordion-btn,
.blocky-accordion-border .blocky-faq-answer,
.blocky-accordion-none .blocky-faq-answer {
  padding-right: 0px !important;
  padding-left: 0px !important;
}
.blocky-accordion-border .blocky-faq-item {
  border-top: solid 1px var(--question-text-color);
}
.blocky-accordion-border .blocky-faq-item:last-of-type {
  border-bottom: solid 1px var(--question-text-color);
}
.blocky-accordion-section,
.blocky-accordion-row .blocky-faq-item {
  box-shadow: var(--bky-faq-shadow);
}
.bky-accordion-google {
  transition: transform .25s;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: {{ section.settings.toggle_icon_bg_color }};
  width: calc(var(--question-font-size) * 1.6);
  height: calc(var(--question-font-size) * 1.6);
}
.blocky-faq-question.active .bky-accordion-google {
  transform: rotate(45deg);
}
.bky-accordion-google .material-icons,
.bky-accordion-google .material-symbols-outlined {
  font-size: var(--question-font-size) !important;
  color: {{ section.settings.toggle_icon_color }};
}
.blocky-accordion-row .blocky-faq-item,
.blocky-accordion-row .blocky-faq-question,
.blocky-accordion-section,
.blocky-accordion-section .blocky-faq-question {
  background-color: var(--faq-background);
  border-radius: var(--faq-border-radius);
}
.blocky-faq .blocky-flex-container > .blocky-flex-child-small,
.blocky-faq .blocky-flex-child-large + .blocky-flex-child {
  width: 40%;
}
.blocky-faq-media-has-text {
  position: absolute;
  z-index: 1;
  padding: 2.5rem;
  display: flex;
  flex-direction: column;
  gap: var(--text-container-gap, 2rem)!important;
}
@media screen and (max-width: 750px) {
  .blocky-faq-media-has-text {
    padding: 1.5rem;
  }
}
.blocky-faq .blocky-media-hero-container img,
.blocky-faq .blocky-media-hero-container video,
.blocky-faq .blocky-media-hero-text-wrap-opacity::before {
  border-radius: var(--border-radius);
}
.blocky-faq .blocky-media-hero-container .blocky-video,
.blocky-faq .blocky-media-hero-container {
  position: unset;
}
.blocky-faqm-{{ section.id }} .blocky-accordion-row .blocky-faq-item {
  margin-bottom: {{ section.settings.faq_items_gap }}px;
}
@media screen and (max-width: 749px) {
  .blocky-faqm-{{ section.id }} .blocky-title { --title-size: {{ section.settings.faq_title_mobile_size }} !important; }
  .blocky-faqm-{{ section.id }} .bky-faq-subtitle { font-size: {{ section.settings.faq_subtitle_mobile_size }}px !important; }
}
.blocky-faqm-{{ section.id }} .bky-faq-video-inplace {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: {{ section.settings.faq_media_radius }}px;
}
.blocky-faqm-{{ section.id }} .bky-faq-play-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: transparent;
  border: 2px solid {{ section.settings.video_play_button_color }};
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 5;
  transition: opacity 0.2s;
}
.blocky-faqm-{{ section.id }} .bky-faq-play-overlay:hover { opacity: 0.75; }
.blocky-faqm-{{ section.id }} .bky-faq-play-overlay.bky-hidden { display: none; }
{% endstyle %}

<script src="{{ 'blocky-accordion.js' | asset_url }}" defer></script>
<script src="{{ 'blocky-video.js' | asset_url }}" defer></script>

<div
  class="blocky blocky-padding background-wrapper blocky-faqm-{{ section.id }}"
  style="--padding-top: {{ section.settings.padding_top }}; --padding-bottom: {{ section.settings.padding_bottom }}; --background-color: {{ section.settings.background_color }}; --section-page-width: {{ section.settings.page_width | divided_by: 10 }}rem; --text-container-gap: {{ section.settings.text_container_gap }};
    --faq-background: {{ section.settings.faq_container_background }}; --question-padding: {{ section.settings.question_padding }}px; --faq-border-radius: {{ section.settings.faq_border_radius }}px;
    --question-font-size: {{ section.settings.question_font_size }}px; --answer-font-size: {{ section.settings.answer_font_size }}px; --question-text-color: {{ section.settings.question_text_color }};
    --answer-text-color: {{ section.settings.answer_text_color }}; --overlay_opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --bky-faq-shadow: {% if section.settings.show_shadow %}rgba(0, 0, 0, 0.24) 0px 1px 4px, rgba(0, 0, 0, 0.16) 0px 3px 8px{% else %}none{% endif %};
  "
>
  <div class="blocky-page-width blocky-faq">
    <div class="blocky-flex-container blocky-des-flex-{{ section.settings.layout }} blocky-mob-flex-{{ section.settings.mobile_layout }} blocky-faq-flex" style="align-items: center;">
      <div class="blocky-flex-child blocky-flex-child-{{ section.settings.desktop_faq_width }} blocky-justify-center blocky-align-center blocky-flex-col">
        {% unless section.settings.faq_title == blank %}
          <h2
            class="blocky-title"
            style="--title-color: {{ section.settings.faq_title_color }}; --title-size: {{ section.settings.faq_title_size }}; margin-bottom: {% if section.settings.faq_subtitle != blank %}{{ section.settings.faq_title_subtitle_gap }}px{% else %}40px{% endif %};"
          >
            {{ section.settings.faq_title }}
          </h2>
        {% endunless %}
        {% unless section.settings.faq_subtitle == blank %}
          <div class="bky-faq-subtitle" style="font-size: {{ section.settings.faq_subtitle_size }}px; color: {{ section.settings.faq_subtitle_color }}; margin-bottom: 40px; line-height: 1.5;">
            {{ section.settings.faq_subtitle }}
          </div>
        {% endunless %}
        <blocky-accordion class="blocky-accordion blocky-w-full blocky-accordion-{{ section.settings.faq_layout }}">
          {% for block in section.blocks %}
            <div class="blocky-faq-item blocky-overflow-hidden" {{ block.shopify_attributes }} style="--icon-color: {{ block.settings.icon_color }}; --bky-faq-icon-size: {{ block.settings.icon_size }}px;">
              <button class="blocky-accordion-btn blocky-faq-question{% if block.settings.default_open %} active{% endif %}">
                <div style="display: flex; justify-content: space-between; align-items: center; gap: .7rem;">
                  <div style="display: flex; align-items: center; gap: inherit;">
                   {% if block.settings.image != null %}
                      <img
                        src="{{ block.settings.image | image_url }}"
                        alt="{{ block.settings.question }}"
                        class="blocky-faq-icon"
                        style="border-radius: 50%;"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        loading="lazy"
                      />
                    {% elsif block.settings.icon_code != blank %}
                        <span class="material-icons material-symbols-outlined blocky-icon blocky-faq-icon"> {{ block.settings.icon_code }} </span>
                    {% endif %}
                    <span>
                      {{ block.settings.question }}
                    </span>
                  </div>
                  {% if section.settings.faq_toggle_icon == "caret" %}
                    <svg class="bky-accordion-carot" height="16" width="16" viewBox="0 0 10 6"><path fill="currentColor" fill-rule="evenodd" d="M9.354.646a.5.5 0 0 0-.708 0L5 4.293 1.354.646a.5.5 0 0 0-.708.708l4 4a.5.5 0 0 0 .708 0l4-4a.5.5 0 0 0 0-.708" clip-rule="evenodd"/></svg>
                  {% elsif section.settings.faq_toggle_icon == "google" %}
                    <span class="bky-accordion-google">
                      <span class="material-icons material-symbols-outlined">{{ section.settings.toggle_icon_code | default: 'add' }}</span>
                    </span>
                  {% else %}
                    <svg class="bky-accordion-plus" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <line x1="8" y1="1.5" x2="8" y2="14.5" stroke="currentColor" stroke-width="2"/>
                      <line x1="1.5" y1="8" x2="14.5" y2="8" stroke="currentColor" stroke-width="2"/>
                    </svg>
                    <svg class="bky-accordion-minus" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  {% endif %}
                </div>
              </button>
              <div class="blocky-faq-answer{% if block.settings.default_open %} active{% endif %}"> {{ block.settings.content }} </div>
            </div>
          {% endfor %}
        </blocky-accordion>
      </div>
        <div class="blocky-flex-child blocky-relative" style="--border-radius: {{ section.settings.faq_media_radius }}px">
          <div class="blocky-media-{{ section.settings.height }} blocky-w-full{% if section.settings.overlay_opacity != 0 %} blocky-media-hero-text-wrap-opacity{% endif %}">
            <div class="blocky-media-hero-container">
              {% if section.settings.video != blank %}
                {%- if section.settings.video_display_mode == 'play_button' -%}
                  <video
                    id="bky-faq-video-{{ section.id }}"
                    class="bky-faq-video-inplace"
                    playsinline
                    preload="none"
                    poster="{{ section.settings.video.preview_image | image_url: width: 1200 }}"
                  >
                    {%- for source in section.settings.video.sources -%}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endfor -%}
                  </video>
                {%- else -%}
                  {% render "blocky-video", video: section.settings.video, video_fit: "zoomed", fill: "#DCDCDC" %}
                {%- endif -%}
              {% elsif section.settings.image != blank %}
                <img
                  class="blocky-image-cover"
                  src="{{ section.settings.image | image_url: height: 750 }}"
                  height="100%"
                  width="100%"
                >
              {% else %}
               {{ 'image' | placeholder_svg_tag: "blocky-full" }}
              {% endif %}
            </div>
          </div>
          {%- if section.settings.video != blank and section.settings.video_display_mode == 'play_button' -%}
            <button class="bky-faq-play-overlay" id="bky-faq-playbtn-{{ section.id }}" aria-label="Play video">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="{{ section.settings.video_play_button_color }}" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </button>
            <script>
              ;(function () {
                var btn   = document.getElementById('bky-faq-playbtn-{{ section.id }}');
                var video = document.getElementById('bky-faq-video-{{ section.id }}');
                btn.addEventListener('click', function () {
                  video.controls = true;
                  video.play();
                  btn.classList.add('bky-hidden');
                });
              })();
            </script>
          {%- endif -%}
          {% unless section.settings.title == blank and section.settings.body_text == blank and section.settings.button_label == blank %}
            <div class="blocky-media-hero-text-content blocky-faq-media-has-text {{ section.settings.text_align }} ">
              {% render 'blocky-titlel', block: section %}
              {% render 'blocky-bodyl', block: section %}
              {% unless section.settings.button_label == blank %}
                <div>
                  {% render 'blocky-buttonl', block: section %}
                </div>
              {% endunless %}
            </div>
          {% endunless %}
        </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BKY - FAQ with Media 2",
  "settings": [
    {
      "type": "header",
      "content": "Background media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background Video"
    },
    {
      "type": "select",
      "id": "video_display_mode",
      "label": "Video display mode",
      "default": "autoplay",
      "options": [
        {
          "value": "autoplay",
          "label": "Autoplay (decoration)"
        },
        {
          "value": "play_button",
          "label": "Play on click"
        }
      ]
    },
    {
      "type": "color",
      "id": "video_play_button_color",
      "label": "Play button color",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.video_display_mode == 'play_button' }}"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to media"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "adapt",
      "label": "Media height"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background video darkness",
      "info": "Lower the brightness of your video to make your text easier to read",
      "default": 10,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "faq_media_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Media border radius",
      "default": 15
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "<b>FAQS</b>",
      "label": "Title",
      "info": "Leave the text blank to hide the title."
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "default": 16,
      "min": 15,
      "max": 80,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#2D2B6B"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "default": "<p>Still have questions?</p>",
      "label": "Body",
      "info": "Leave the text blank to hide the body."
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "default": 32,
      "min": 10,
      "max": 40,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#000000"
    },
    {
      "type": "richtext",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave the text blank to hide the button.",
      "default": "<p>Ask our Team</p>"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_border_radius",
      "label": "Button border radius",
      "default": "extra-round",
      "options": [
        {
          "value": "flat",
          "label": "Flat"
        },
        {
          "value": "curved",
          "label": "Curved"
        },
        {
          "value": "round",
          "label": "Round"
        },
        {
          "value": "extra-round",
          "label": "Extra Round"
        }
      ]
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background color",
      "default": "#2D2B6B"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "FAQ Layout"
    },
    {
      "type": "inline_richtext",
      "id": "faq_title",
      "default": "<b>Frequently Asked Questions</b>",
      "label": "Faq Title",
      "info": "Leave the text blank to hide the title."
    },
    {
      "type": "range",
      "id": "faq_title_size",
      "label": "Title size desktop (px)",
      "default": 40,
      "min": 15,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "faq_title_mobile_size",
      "label": "Title size mobile (px)",
      "default": 32,
      "min": 15,
      "max": 56,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "faq_title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "richtext",
      "id": "faq_subtitle",
      "label": "Subtitle",
      "info": "Optional subtitle shown below the FAQ title.",
      "default": "<p>Optional subtitle shown below the FAQ title.</p>"
    },
    {
      "type": "range",
      "id": "faq_subtitle_size",
      "label": "Subtitle font size desktop (px)",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "faq_subtitle_mobile_size",
      "label": "Subtitle font size mobile (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "faq_subtitle_color",
      "label": "Subtitle color",
      "default": "#606367"
    },
    {
      "type": "range",
      "id": "faq_title_subtitle_gap",
      "label": "Title to subtitle spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "faq_items_gap",
      "label": "Space between FAQ items",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "faq_layout",
      "label": "FAQ Layout",
      "options": [
        {
          "value": "none",
          "label": "No container"
        },
        {
          "value": "border",
          "label": "No container with borders"
        },
        {
          "value": "row",
          "label": "Row container"
        },
        {
          "value": "section",
          "label": "Section container"
        }
      ],
      "default": "row"
    },
    {
      "type": "range",
      "id": "question_padding",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Container padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "faq_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Container border radius",
      "default": 15
    },
    {
      "type": "color",
      "id": "faq_container_background",
      "label": "Container background",
      "default": "#E7E4F8",
      "info": "If 'no container' is selected for layout, this is color is ignored"
    },
    {
      "type": "range",
      "id": "question_font_size",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Question font size",
      "default": 18
    },
    {
      "type": "range",
      "id": "answer_font_size",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Answer font size",
      "default": 18
    },
    {
      "type": "color",
      "id": "question_text_color",
      "label": "Question text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "answer_text_color",
      "label": "Answer text color",
      "default": "#606367"
    },
    {
      "type": "select",
      "id": "faq_toggle_icon",
      "label": "FAQ toggle icon",
      "default": "google",
