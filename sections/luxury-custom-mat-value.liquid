{%- comment -%}
  -----------------------------------------------------------------------------
  SECTION: LUXURY CUSTOM MAT VALUE ("What Your Bespoke Mat Actually Buys")
  - Value Breakdown Cards & Side-by-Side Comparison Table
  - Fully responsive, luxury serif typography & subtle borders
  -----------------------------------------------------------------------------
{%- endcomment -%}

<style>
  #CustomMatValue-{{ section.id }},
  #CustomMatValue-{{ section.id }} * {
    box-sizing: border-box !important;
  }

  #CustomMatValue-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FCFAF8' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 88 }}px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #141517;
  }

  .cmv-container {
    max-width: {{ section.settings.container_max_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0 24px;
    width: 100%;
  }

  .cmv-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 52px auto;
  }

  .cmv-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #7F5260;
    margin-bottom: 12px;
  }

  .cmv-title {
    font-family: var(--font-heading-family, serif);
    font-size: 36px;
    font-weight: 700;
    line-height: 1.25;
    color: #141517;
    margin: 0 0 16px 0;
  }

  @media (min-width: 768px) {
    .cmv-title {
      font-size: 44px;
    }
  }

  .cmv-subtitle {
    font-size: 16px;
    line-height: 1.6;
    color: #55504C;
    margin: 0;
  }

  /* 5 Pillars Bento Grid */
  .cmv-bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 56px;
  }

  @media (min-width: 640px) {
    .cmv-bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .cmv-bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .cmv-bento-card:nth-child(1) {
      grid-column: span 2;
    }
  }

  .cmv-bento-card {
    background: #FFFFFF;
    border: 1px solid #ECE7E1;
    border-radius: 18px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s ease;
  }

  .cmv-bento-card:hover {
    border-color: #D5CEC7;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.04);
  }

  .cmv-bento-card.is-featured {
    background: #163327;
    color: #FFFFFF;
    border-color: #163327;
  }

  .cmv-bento-badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 14px;
    display: inline-block;
  }
  .cmv-bento-card:not(.is-featured) .cmv-bento-badge {
    color: #7F5260;
  }
  .cmv-bento-card.is-featured .cmv-bento-badge {
    color: #E2B96F;
  }

  .cmv-bento-heading {
    font-family: var(--font-heading-family, serif);
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 10px 0;
    line-height: 1.3;
  }
  .cmv-bento-card:not(.is-featured) .cmv-bento-heading {
    color: #141517;
  }
  .cmv-bento-card.is-featured .cmv-bento-heading {
    color: #FFFFFF;
  }

  .cmv-bento-desc {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }
  .cmv-bento-card:not(.is-featured) .cmv-bento-desc {
    color: #55504C;
  }
  .cmv-bento-card.is-featured .cmv-bento-desc {
    color: #E6E1DC;
  }

  /* Comparison Table Section */
  .cmv-table-wrapper {
    background: #FFFFFF;
    border: 1px solid #ECE7E1;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.03);
  }

  .cmv-table-title-row {
    padding: 24px 28px;
    background: #FAF8F5;
    border-bottom: 1px solid #ECE7E1;
  }

  .cmv-table-title {
    font-family: var(--font-heading-family, serif);
    font-size: 22px;
    font-weight: 700;
    color: #141517;
    margin: 0;
  }

  .cmv-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .cmv-table th,
  .cmv-table td {
    padding: 18px 24px;
    font-size: 14px;
    border-bottom: 1px solid #ECE7E1;
  }

  .cmv-table tr:last-child td {
    border-bottom: none;
  }

  .cmv-table th {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7A7571;
    background: #FFFFFF;
  }

  .cmv-col-criteria {
    width: 32%;
    font-weight: 600;
    color: #141517;
  }

  .cmv-col-store {
    width: 34%;
    color: #7A7571;
    background: #FAF8F5;
  }

  .cmv-col-bespoke {
    width: 34%;
    font-weight: 600;
    color: #163327;
    background: #F4F8F5;
  }

  @media (max-width: 640px) {
    .cmv-table th,
    .cmv-table td {
      padding: 12px 14px;
      font-size: 12.5px;
    }
  }
</style>

<section id="CustomMatValue-{{ section.id }}">
  <div class="cmv-container">
    
    <div class="cmv-header">
      <span class="cmv-eyebrow">{{ section.settings.eyebrow | default: 'TRANSPARENT VALUE BREAKDOWN' }}</span>
      <h2 class="cmv-title">{{ section.settings.heading | default: 'What Your Bespoke Mat Actually Buys' }}</h2>
      <p class="cmv-subtitle">
        {{ section.settings.subtitle | default: 'Everything else on the table can be replaced. This is the one piece that could never be.' }}
      </p>
    </div>

    <!-- 5 Bento Cards -->
    <div class="cmv-bento-grid">
      
      <!-- Card 1 (Wide): Hand-drawn from zero -->
      <div class="cmv-bento-card is-featured">
        <div>
          <span class="cmv-bento-badge">Hand-Drawn · Never Templates</span>
          <h3 class="cmv-bento-heading">Three Original Designs from a Blank Canvas</h3>
          <p class="cmv-bento-desc">
            Not one option. Not a pre-made template with your name slotted in. Our in-house artist sketches three distinct compositions around your idea, your group name, and your aesthetic.
          </p>
        </div>
      </div>

      <!-- Card 2: 3 Revision Rounds -->
      <div class="cmv-bento-card">
        <div>
          <span class="cmv-bento-badge">Refine Until It’s Right</span>
          <h3 class="cmv-bento-heading">Three Rounds of Changes</h3>
          <p class="cmv-bento-desc">
            After choosing your concept, you have three complete rounds of adjustments. Shift the lettering, swap background hues, resize crests until it feels flawless.
          </p>
        </div>
      </div>

      <!-- Card 3: 1-of-1 Artwork -->
      <div class="cmv-bento-card">
        <div>
          <span class="cmv-bento-badge">One of One</span>
          <h3 class="cmv-bento-heading">Artwork Nobody Else Owns</h3>
          <p class="cmv-bento-desc">
            Your final artwork belongs exclusively to your circle. It will never be re-used, mass-printed, or sold to any other group in the world.
          </p>
        </div>
      </div>

      <!-- Card 4: 31.5" Rubber -->
      <div class="cmv-bento-card">
        <div>
          <span class="cmv-bento-badge">Atelier Materials</span>
          <h3 class="cmv-bento-heading">31.5″ Silken Neoprene &amp; Non-Slip Base</h3>
          <p class="cmv-bento-desc">
            Water-resistant silken neoprene surface with heavy 3mm non-slip rubber base, engineered for smooth tile gliding and acoustic sound dampening.
          </p>
        </div>
      </div>

      <!-- Card 5: Free Shipping & Humans -->
      <div class="cmv-bento-card">
        <div>
          <span class="cmv-bento-badge">Concierge Service</span>
          <h3 class="cmv-bento-heading">Free Worldwide Shipping &amp; Real Humans</h3>
          <p class="cmv-bento-desc">
            You talk directly with real people in our atelier, not an AI ticket queue. Every question is answered by the team crafting your piece.
          </p>
        </div>
      </div>

    </div>

    <!-- Comparison Table -->
    <div class="cmv-table-wrapper">
      <div class="cmv-table-title-row">
        <h3 class="cmv-table-title">Mahjiva Bespoke vs. Store-Bought Mats</h3>
      </div>
      <table class="cmv-table">
        <thead>
          <tr>
            <th class="cmv-col-criteria">Feature</th>
            <th class="cmv-col-store">Store-Bought Mat</th>
            <th class="cmv-col-bespoke">Mahjiva Bespoke Mat</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="cmv-col-criteria">Design Origin</td>
            <td class="cmv-col-store">Mass-market print from a catalog</td>
            <td class="cmv-col-bespoke">✓ Hand-drawn by artist from scratch</td>
          </tr>
          <tr>
            <td class="cmv-col-criteria">Design Proofs</td>
            <td class="cmv-col-store">None (you get what is in the box)</td>
            <td class="cmv-col-bespoke">✓ 3 original proof concepts in 24 hours</td>
          </tr>
          <tr>
            <td class="cmv-col-criteria">Revision Policy</td>
            <td class="cmv-col-store">No changes possible</td>
            <td class="cmv-col-bespoke">✓ Up to 3 revision rounds included</td>
          </tr>
          <tr>
            <td class="cmv-col-criteria">Approval Step</td>
            <td class="cmv-col-store">Never approved by you</td>
            <td class="cmv-col-bespoke">✓ Printed ONLY after you say "Approved"</td>
          </tr>
          <tr>
            <td class="cmv-col-criteria">Exclusivity</td>
            <td class="cmv-col-store">Thousands of identical copies exist</td>
            <td class="cmv-col-bespoke">✓ 1-of-1 exclusive to your table</td>
          </tr>
          <tr>
            <td class="cmv-col-criteria">Acoustic Dampening</td>
            <td class="cmv-col-store">Thin synthetic foam or felt</td>
            <td class="cmv-col-bespoke">✓ Heavy 3mm non-slip rubber with neoprene top</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Custom Mat Value",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FCFAF8"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "TRANSPARENT VALUE BREAKDOWN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Your Bespoke Mat Actually Buys"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything else on the table can be replaced. This is the one piece that could never be."
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 1000,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "Custom Mat Value"
    }
  ]
}
{% endschema %}
