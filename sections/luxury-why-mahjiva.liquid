{%- comment -%}
  -----------------------------------------------------------------------------
  SECTION: LUXURY WHY MAHJIVA ("More Than a Mahjong Set")
  - 3 Value Proposition Cards (Made to Be Played, For the Women Who Play, A Real Brand Behind Every Order)
  - Elegant luxury Atelier aesthetic harmonized with website colors
  - Fully customizable via Shopify Theme Editor
  -----------------------------------------------------------------------------
{%- endcomment -%}

<style>
  #LuxuryWhyMahjiva-{{ section.id }},
  #LuxuryWhyMahjiva-{{ section.id }} * {
    box-sizing: border-box !important;
  }

  #LuxuryWhyMahjiva-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FCFAF8' }};
    padding-top: {{ section.settings.padding_top | default: 72 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    position: relative;
    overflow: hidden;
  }

  .lwm-container {
    max-width: {{ section.settings.container_max_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .lwm-container {
      padding: 0 32px;
    }
  }

  /* Header */
  .lwm-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 52px auto;
  }

  .lwm-eyebrow {
    display: inline-block;
    font-family: var(--font-body-family, sans-serif);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color | default: '#7F5260' }};
    margin-bottom: 12px;
  }

  .lwm-heading {
    font-family: var(--font-heading-family, serif);
    font-size: {{ section.settings.heading_size | default: 40 }}px;
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: 0.01em;
    color: {{ section.settings.heading_color | default: '#163327' }};
    margin: 0 0 14px 0;
  }

  @media (min-width: 768px) {
    .lwm-heading {
      font-size: {{ section.settings.heading_size | default: 48 }}px;
    }
  }

  .lwm-subheading {
    font-family: var(--font-body-family, sans-serif);
    font-size: 15px;
    line-height: 1.55;
    color: {{ section.settings.subheading_color | default: '#5A5550' }};
    margin: 0;
    font-weight: 400;
  }

  /* 3 Cards Grid */
  .lwm-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    align-items: stretch;
    margin-bottom: 48px;
  }

  @media (max-width: 959px) {
    .lwm-grid {
      grid-template-columns: 1fr;
      gap: 20px;
      max-width: 540px;
      margin-left: auto;
      margin-right: auto;
    }
    .lwm-header {
      margin-bottom: 36px;
    }
    .lwm-heading {
      font-size: calc({{ section.settings.heading_size | default: 38 }}px * 0.8);
    }
  }

  /* Card Item */
  .lwm-card {
    background: {{ section.settings.card_bg_color | default: '#FFFFFF' }};
    border: 1px solid {{ section.settings.card_border_color | default: '#EAE5DC' }};
    border-radius: 18px;
    padding: 38px 28px 34px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    position: relative;
  }

  .lwm-card:hover {
    transform: translateY(-4px);
    border-color: #D8D0C5;
    box-shadow: 0 12px 30px rgba(22, 51, 39, 0.08);
  }

  /* Icon Badge */
  .lwm-card-icon {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background-color: {{ section.settings.icon_bg_color | default: '#F4F8F5' }};
    color: {{ section.settings.icon_color | default: '#163327' }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .lwm-card:hover .lwm-card-icon {
    transform: scale(1.08);
  }

  .lwm-card-icon svg {
    display: block;
    width: 26px;
    height: 26px;
  }

  .lwm-card-title {
    font-family: var(--font-heading-family, serif);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    color: {{ section.settings.card_title_color | default: '#163327' }};
    margin: 0 0 12px 0;
  }

  .lwm-card-desc {
    font-family: var(--font-body-family, sans-serif);
    font-size: 14px;
    line-height: 1.65;
    color: {{ section.settings.card_text_color | default: '#5A5550' }};
    margin: 0;
    font-weight: 400;
  }

  /* Action CTA */
  .lwm-action {
    text-align: center;
    margin-top: 10px;
  }

  .lwm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 42px;
    border-radius: 9999px;
    background-color: {{ section.settings.btn_bg_color | default: '#163327' }};
    color: {{ section.settings.btn_text_color | default: '#FFFFFF' }};
    font-family: var(--font-body-family, sans-serif);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid {{ section.settings.btn_bg_color | default: '#163327' }};
    box-shadow: 0 6px 20px rgba(22, 51, 39, 0.2);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .lwm-btn:hover {
    background-color: #1a3d2f;
    border-color: #D8B88C;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(22, 51, 39, 0.32);
  }
</style>

<div id="LuxuryWhyMahjiva-{{ section.id }}" class="luxury-why-mahjiva-section">
  <div class="lwm-container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="lwm-header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="lwm-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="lwm-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="lwm-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="lwm-grid">
      {%- for block in section.blocks -%}
        <div class="lwm-card" {{ block.shopify_attributes }}>
          <div class="lwm-card-icon">
            {%- case block.settings.icon_type -%}
              {%- when 'tile' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="5" y="3" width="14" height="18" rx="3"></rect>
                  <circle cx="12" cy="8.5" r="1.5" fill="currentColor"></circle>
                  <circle cx="12" cy="15.5" r="1.5" fill="currentColor"></circle>
                  <line x1="9" y1="12" x2="15" y2="12"></line>
                </svg>
              {%- when 'flower' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M12 2a4 4 0 0 0-4 4c0 2 2 3.5 4 5 2-1.5 4-3 4-5a4 4 0 0 0-4-4z"></path>
                  <path d="M12 22a4 4 0 0 0 4-4c0-2-2-3.5-4-5-2 1.5-4 3-4 5a4 4 0 0 0 4 4z"></path>
                  <path d="M2 12a4 4 0 0 0 4 4c2 0 3.5-2 5-4-1.5-2-3-4-5-4a4 4 0 0 0-4 4z"></path>
                  <path d="M22 12a4 4 0 0 0-4-4c-2 0-3.5 2-5 4 1.5 2 3 4 5 4a4 4 0 0 0 4-4z"></path>
                </svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
              {%- when 'heart' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              {%- when 'star' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
            {%- endcase -%}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="lwm-card-title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="lwm-card-desc">{{ block.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="lwm-action">
        <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="lwm-btn">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Luxury - Why MAHJIVA",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHY MAHJIVA"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#7F5260"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More Than a Mahjong Set"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#163327"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Crafted for the women who take the game — and the table — seriously."
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#5A5550"
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border",
      "default": "#EAE5DC"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon Badge Background",
      "default": "#F4F8F5"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#163327"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#163327"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Text Color",
      "default": "#5A5550"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "BROWSE EVERY SET"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background",
      "default": "#163327"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FCFAF8"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Container Max Width",
      "min": 900,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature Card",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            { "value": "tile", "label": "Mahjong Tile" },
            { "value": "flower", "label": "Flower / Blossom" },
            { "value": "shield", "label": "Shield / Guarantee" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" }
          ],
          "default": "tile"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Card Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Card description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury - Why MAHJIVA",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon_type": "tile",
            "title": "Made to Be Played",
            "description": "Weighted 160-piece, NMJL-ready sets, with each design engraved into the acrylic and color-filled by hand to last for years."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon_type": "flower",
            "title": "For the Women Who Play",
            "description": "Custom floral artwork and mother-of-pearl backs, made for players who love a beautiful table as much as a good game."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon_type": "shield",
            "title": "A Real Brand Behind Every Order",
            "description": "A registered US company with real people and real support by email, phone, and WhatsApp"
          }
        }
      ]
    }
  ]
}
{% endschema %}
