{%- comment -%}
  -----------------------------------------------------------------------------
  SECTION: LUXURY CRAFTSMANSHIP ("The Anatomy of Perfection")
  - Multi-layout Savoir-Faire Presentation:
      * layout_style: "grid_2x2" (2 Columns x 2 Rows Balanced Grid) OR "stacked" (Vertical 1-Column Sequential Stack)
      * image_position: "left" (Left aligned) OR "right" (Right aligned)
      * bg_color: Fully customizable background palette
  - Haute Atelier Photograph:
      * Connected with image_picker "craftsman_image"
      * Stretches 100% height to match the narrative column perfectly
      * Fallback elegant dashed placeholder when unassigned
  - 4 Master Craftsmanship Specs in Presets (Material Provenance, Tolerance 0.02mm, 24K Gold Inlay, Californian Burl Walnut)
  - 100% Zero Mock / Fully configurable via Shopify Customizer
  -----------------------------------------------------------------------------
{%- endcomment -%}

{%- assign layout_style = section.settings.layout_style | default: 'grid_2x2' -%}
{%- assign image_position = section.settings.image_position | default: 'left' -%}

<style>
  #LuxuryCraftsmanship-{{ section.id }},
  #LuxuryCraftsmanship-{{ section.id }} * {
    box-sizing: border-box !important;
  }

  #LuxuryCraftsmanship-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FDFBF8' }};
    padding: {{ section.settings.padding_top | default: 80 }}px 0 {{ section.settings.padding_bottom | default: 88 }}px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    position: relative;
    overflow: hidden;
  }

  .lc-container {
    max-width: {{ section.settings.container_max_width | default: 1360 }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (min-width: 1024px) {
    .lc-container {
      padding: 0 32px;
    }
  }

  /* Two Column Grid with Perfect Height Alignment */
  .lc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: stretch;
  }

  @media (min-width: 960px) {
    .lc-grid {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }

    .lc-grid.lc-image-left .lc-media-col {
      order: 1;
    }
    .lc-grid.lc-image-left .lc-content-col {
      order: 2;
    }

    .lc-grid.lc-image-right .lc-media-col {
      order: 2;
    }
    .lc-grid.lc-image-right .lc-content-col {
      order: 1;
    }
  }

  @media (min-width: 1200px) {
    .lc-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 72px;
    }
    .lc-grid.lc-image-right {
      grid-template-columns: 1fr 1.05fr;
    }
  }

  /* Craftsmanship Media Column - Stretches 100% Height */
  .lc-media-col {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .lc-media-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 420px;
    border-radius: 24px;
    overflow: hidden;
    border: 0.5px solid #ECE8E1;
    box-shadow: 0 14px 34px -10px rgba(20, 21, 23, 0.08);
    background: #FAF8F5;
    display: flex;
  }

  @media (max-width: 959px) {
    .lc-media-wrapper {
      aspect-ratio: 4 / 5;
      min-height: 360px;
    }
  }

  .lc-craft-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 24px;
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lc-media-wrapper:hover .lc-craft-img {
    transform: scale(1.03);
  }

  .lc-craft-placeholder {
    width: 100%;
    height: 100%;
    background: #FAF8F5;
    border: 0.5px dashed #D6D2CA;
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #8C8F96;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 24px;
    text-align: center;
  }

  /* Right / Content Column */
  .lc-content-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
  }

  .lc-eyebrow {
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #B89768;
    font-weight: 700;
    margin-bottom: 12px;
    display: inline-block;
  }

  .lc-heading {
    font-family: "Cormorant Garamond", Garamond, Georgia, serif;
    font-size: 36px;
    font-weight: 500;
    line-height: 1.15;
    color: {{ section.settings.text_color | default: '#141517' }};
    margin: 0 0 18px 0;
  }

  @media (min-width: 768px) {
    .lc-heading {
      font-size: 44px;
    }
  }

  .lc-description {
    font-size: 14.5px;
    font-weight: 450;
    line-height: 1.7;
    color: #3A3D45;
    margin: 0 0 32px 0;
  }

  /* Common Spec Card Styles */
  .lc-spec-card {
    background: {{ section.settings.card_bg_color | default: '#FFFFFF' }};
    border: 1px solid {{ section.settings.card_border_color | default: '#EBE7DF' }};
    border-radius: 16px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .lc-spec-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(20, 21, 23, 0.05);
    border-color: #D8D2C4;
  }

  .lc-spec-num {
    font-family: "Cormorant Garamond", Garamond, Georgia, serif;
    font-weight: 600;
    color: #B89768;
    line-height: 1;
  }

  .lc-spec-title {
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ section.settings.text_color | default: '#141517' }};
    margin: 0 0 6px 0;
    line-height: 1.3;
  }

  .lc-spec-desc {
    font-size: 12px;
    line-height: 1.6;
    color: #706C66;
    margin: 0;
  }

  /* =========================================================================
     LAYOUT STYLE 1: GRID 2x2 (2 Columns x 2 Rows Balanced Grid)
     ========================================================================= */
  .lc-specs-grid_2x2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 34px;
  }

  @media (min-width: 600px) {
    .lc-specs-grid_2x2 {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  .lc-specs-grid_2x2 .lc-spec-card {
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
  }

  .lc-specs-grid_2x2 .lc-spec-num {
    font-size: 18px;
    margin-bottom: 8px;
    display: block;
  }

  /* =========================================================================
     LAYOUT STYLE 2: STACKED (Vertical 1-Column Sequential Stack)
     ========================================================================= */
  .lc-specs-stacked {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 34px;
  }

  .lc-specs-stacked .lc-spec-card {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 18px 22px;
  }

  .lc-specs-stacked .lc-spec-num {
    font-size: 24px;
    min-width: 34px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .lc-specs-stacked .lc-spec-info {
    flex-grow: 1;
  }

  /* Bottom Action CTA */
  .lc-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .lc-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 30px;
    border-radius: 9999px;
    background: #141517;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(20, 21, 23, 0.15);
  }

  .lc-cta-btn:hover {
    background: #B89768;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(184, 151, 104, 0.35);
  }
</style>

<section id="LuxuryCraftsmanship-{{ section.id }}" class="lc-section" aria-label="{{ section.settings.heading | default: 'The Anatomy of Perfection' | escape }}">
  <div class="lc-container">
    <div class="lc-grid lc-image-{{ image_position }}">

      <!-- CRAFTSMANSHIP MEDIA COLUMN -->
      <div class="lc-media-col">
        <div class="lc-media-wrapper">
          {%- if section.settings.craftsman_image != blank -%}
            {{ section.settings.craftsman_image | image_url: width: 1400 | image_tag: class: 'lc-craft-img', loading: 'lazy', widths: '480, 720, 960, 1200, 1400', sizes: '(max-width: 749px) 100vw, 50vw', alt: section.settings.heading | escape }}
          {%- else -%}
            <div class="lc-craft-placeholder">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 12px; opacity: 0.6;">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
              <span>Please assign atelier craftsmanship photography in Theme Customizer</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- CRAFTSMANSHIP CONTENT & SPECS COLUMN -->
      <div class="lc-content-col">
        {%- if section.settings.eyebrow != blank -%}
          <span class="lc-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        
        {%- if section.settings.heading != blank -%}
          <h2 class="lc-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="lc-description">{{ section.settings.description | escape }}</p>
        {%- endif -%}

        <!-- Master Craftsmanship Specs Container -->
        <div class="lc-specs-{{ layout_style }}">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div class="lc-spec-card" {{ block.shopify_attributes }}>
                <span class="lc-spec-num">{{ block.settings.number | default: forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <div class="lc-spec-info">
                  <h3 class="lc-spec-title">{{ block.settings.title | escape }}</h3>
                  <p class="lc-spec-desc">{{ block.settings.description | escape }}</p>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback 4 Default Pillars of Craftsmanship -->
            <div class="lc-spec-card">
              <span class="lc-spec-num">01</span>
              <div class="lc-spec-info">
                <h3 class="lc-spec-title">Hetian River Nephrite Jade (Xinjiang Grade A)</h3>
                <p class="lc-spec-desc">Directly sourced from high-altitude glacial deposits. Each boulder is hand-selected for fibrous tremolite density and characteristic warm, oily luster.</p>
              </div>
            </div>
            <div class="lc-spec-card">
              <span class="lc-spec-num">02</span>
              <div class="lc-spec-info">
                <h3 class="lc-spec-title">0.02mm CNC Diamond-Milled & Hand-Trued</h3>
                <p class="lc-spec-desc">Sub-millimeter CNC diamond mills true each tile face. Master lapidaries execute 12 stages of diamond-paste polish to ensure seamless wall stacking without slippage.</p>
              </div>
            </div>
            <div class="lc-spec-card">
              <span class="lc-spec-num">03</span>
              <div class="lc-spec-info">
                <h3 class="lc-spec-title">24K Triple-Leaf Gold Inlay</h3>
                <p class="lc-spec-desc">Each glyph is hand-engraved with diamond burrs, gilded with three layers of genuine 24-karat gold leaf, and sealed with archival natural lacquer.</p>
              </div>
            </div>
            <div class="lc-spec-card">
              <span class="lc-spec-num">04</span>
              <div class="lc-spec-info">
                <h3 class="lc-spec-title">Californian Burl Walnut & French Bridle Leather</h3>
                <p class="lc-spec-desc">Hand-dovetailed solid Californian walnut chassis lined in acoustic micro-suede, framed by hand-stitched saddle leather and solid brushed brass fittings.</p>
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.button_label != blank -%}
          <div class="lc-actions">
            <a href="{{ section.settings.button_link | default: routes.collections_url }}" class="lc-cta-btn">
              <span>{{ section.settings.button_label | replace: '→', '' | strip | escape }}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxury Craftsmanship",
  "tag": "section",
  "class": "section-luxury-craftsmanship",
  "settings": [
    {
      "type": "header",
      "content": "Layout Architecture & Positioning"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Craftsmanship Specification Layout",
      "options": [
        {
          "value": "grid_2x2",
          "label": "Balanced 2x2 Grid"
        },
        {
          "value": "stacked",
          "label": "Vertical Stack (4 Cards)"
        }
      ],
      "default": "grid_2x2"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Atelier Imagery Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left (Default)"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Atelier Workshop Photography"
    },
    {
      "type": "image_picker",
      "id": "craftsman_image",
      "label": "Craftsmanship Portrait Imagery"
    },
    {
      "type": "header",
      "content": "Craftsmanship Dossier Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "SAVOIR-FAIRE & METROLOGY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "The Anatomy of Perfection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Every Mahjong & Co. suite represents the seamless convergence of millenary lapidary heritage and sub-millimeter contemporary metrology."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "DISCOVER THE ATELIER →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Destination Link"
    },
    {
      "type": "header",
      "content": "Color Scheme & Dimensions"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#FDFBF8"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Specification Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Specification Card Border",
      "default": "#EBE7DF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Primary Text Color",
      "default": "#141517"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 1100,
      "max": 1600,
      "step": 20,
      "default": 1360,
      "unit": "px",
      "label": "Container Max Width"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 140,
      "step": 4,
      "default": 80,
      "unit": "px",
      "label": "Padding Top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 140,
      "step": 4,
      "default": 88,
      "unit": "px",
      "label": "Padding Bottom"
    }
  ],
  "blocks": [
    {
      "type": "spec_item",
      "name": "Craft Specification",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Specification Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Specification Title",
          "default": "Material Provenance"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Specification Description",
          "default": "Directly sourced from high-altitude glacial deposits. Each boulder is hand-selected for fibrous tremolite density and characteristic warm, oily luster."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Craftsmanship",
      "settings": {
        "layout_style": "grid_2x2",
        "image_position": "left",
        "bg_color": "#FDFBF8"
      },
      "blocks": [
        {
          "type": "spec_item",
          "settings": {
            "number": "01",
            "title": "Hetian River Nephrite Jade (Xinjiang Grade A)",
            "description": "Directly sourced from high-altitude glacial deposits. Each boulder is hand-selected for fibrous tremolite density and characteristic warm, oily luster."
          }
        },
        {
          "type": "spec_item",
          "settings": {
            "number": "02",
            "title": "0.02mm CNC Diamond-Milled & Hand-Trued",
            "description": "Sub-millimeter CNC diamond mills true each tile face. Master lapidaries execute 12 stages of diamond-paste polish to ensure seamless wall stacking without slippage."
          }
        },
        {
          "type": "spec_item",
          "settings": {
            "number": "03",
            "title": "24K Triple-Leaf Gold Inlay",
            "description": "Each glyph is hand-engraved with diamond burrs, gilded with three layers of genuine 24-karat gold leaf, and sealed with archival natural lacquer."
          }
        },
        {
          "type": "spec_item",
          "settings": {
            "number": "04",
            "title": "Californian Burl Walnut & French Bridle Leather",
            "description": "Hand-dovetailed solid Californian walnut chassis lined in acoustic micro-suede, framed by hand-stitched saddle leather and solid brushed brass fittings."
          }
        }
      ]
    }
  ]
}
{% endschema %}
