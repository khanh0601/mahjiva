                      </div>
                      <div class="cmh-trust-item">
                        <span class="cmh-trust-icon">{{ block.settings.badge_2_icon | default: '✍️' }}</span>
                        <span class="cmh-trust-text">{{ block.settings.badge_2_text | default: '3 Revisions' }}</span>
                      </div>
                      <div class="cmh-trust-item">
                        <span class="cmh-trust-icon">{{ block.settings.badge_3_icon | default: '🛡️' }}</span>
                        <span class="cmh-trust-text">{{ block.settings.badge_3_text | default: 'Approval First' }}</span>
                      </div>
                      <div class="cmh-trust-item">
                        <span class="cmh-trust-icon">{{ block.settings.badge_4_icon | default: '✈️' }}</span>
                        <span class="cmh-trust-text">{{ block.settings.badge_4_text | default: 'Free Shipping' }}</span>
                      </div>
                    </div>

                  {%- when 'collapsible_tab' -%}
