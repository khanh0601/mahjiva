                      {{ block.settings.text }}
                    </div>

                  {%- when 'custom_liquid' -%}
                    <div class="cmh-custom-liquid-block" {{ block.shopify_attributes }}>
                      {{ block.settings.custom_liquid }}
                    </div>

                {%- endcase -%}
              {%- endfor -%}

            {%- endif -%}

          </div>
        {%- endform -%}

      </div>

    </div>

  </div>
</section>

<script>
  function switchCmhMode(mode, sectionId) {
    const btnPreview = document.getElementById('btnModePreview-' + sectionId);
    const btnPhotos = document.getElementById('btnModePhotos-' + sectionId);
    const previewBox = document.getElementById('cmhPreviewBox-' + sectionId);
    const photoStage = document.getElementById('cmhPhotoStage-' + sectionId);

    if (mode === 'preview') {
      if (btnPreview) btnPreview.classList.add('is-active');
      if (btnPhotos) btnPhotos.classList.remove('is-active');
      if (previewBox) previewBox.style.display = 'flex';
      if (photoStage) photoStage.classList.remove('is-active');
    } else {
      if (btnPhotos) btnPhotos.classList.add('is-active');
      if (btnPreview) btnPreview.classList.remove('is-active');
      if (previewBox) previewBox.style.display = 'none';
      if (photoStage) photoStage.classList.add('is-active');
    }
  }

  function selectCmhPhoto(imgSrc, thumbEl, sectionId) {
    switchCmhMode('photos', sectionId);
    const activePhoto = document.getElementById('cmhPhotoActive-' + sectionId);
    if (activePhoto) activePhoto.src = imgSrc;
    
    if (thumbEl && thumbEl.parentElement) {
      const track = thumbEl.parentElement;
      track.querySelectorAll('.cmh-thumb-item').forEach(el => el.classList.remove('is-active'));
      thumbEl.classList.add('is-active');
    }
  }

  function updateCmhText(sectionId) {
    const mainInput = document.getElementById('cmhInputMainText-' + sectionId);
    const subInput = document.getElementById('cmhInputSubText-' + sectionId);
    const previewTitle = document.getElementById('cmhPreviewTitle-' + sectionId);
    const previewSub = document.getElementById('cmhPreviewSub-' + sectionId);

    const mainVal = (mainInput && mainInput.value ? mainInput.value : '').trim() || 'YOUR NAME / CLUB';
    const subVal = (subInput && subInput.value ? subInput.value : '').trim() || 'EST. 2026';

    if (previewTitle) previewTitle.textContent = mainVal;
    if (previewSub) previewSub.textContent = subVal;

    const propMonogram = document.getElementById('propMonogramText');
    const propSubtitle = document.getElementById('propSubtitleYear');
    if (propMonogram) propMonogram.value = mainVal;
    if (propSubtitle) propSubtitle.value = subVal;
  }

  function selectCmhFont(fontName, fontFamilyCss, pillEl, sectionId) {
    const previewTitle = document.getElementById('cmhPreviewTitle-' + sectionId);
    if (previewTitle) previewTitle.style.fontFamily = fontFamilyCss;

    if (pillEl && pillEl.parentElement) {
      const parent = pillEl.parentElement;
      parent.querySelectorAll('.cmh-pill-label').forEach(el => el.classList.remove('is-selected'));
      pillEl.classList.add('is-selected');
    }

    const propFont = document.getElementById('propLetteringStyle');
    if (propFont) propFont.value = fontName;
  }

  function selectCmhColor(hex, colorName, btnEl, sectionId) {
    const previewBox = document.getElementById('cmhPreviewBox-' + sectionId);
    const colorLabel = document.getElementById('cmhColorName-' + sectionId);

    if (previewBox) previewBox.style.backgroundColor = hex;
    if (colorLabel) colorLabel.textContent = colorName;

    if (btnEl && btnEl.parentElement) {
      const parent = btnEl.parentElement;
      parent.querySelectorAll('.cmh-color-btn').forEach(el => el.classList.remove('is-active'));
      btnEl.classList.add('is-active');
    }

    const propColor = document.getElementById('propBaseColor');
    if (propColor) propColor.value = colorName + ' (' + hex + ')';
  }

  function selectCmhMotif(motifName, emoji, cardEl, sectionId) {
    const iconWrap = document.getElementById('cmhPreviewIconWrap-' + sectionId);
    if (iconWrap) {
      iconWrap.innerHTML = '<span style="font-size: 38px; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.3));">' + emoji + '</span>';
    }

    if (cardEl && cardEl.parentElement) {
      const parent = cardEl.parentElement;
      parent.querySelectorAll('.cmh-motif-card').forEach(el => el.classList.remove('is-active'));
      cardEl.classList.add('is-active');
    }

    const propMotif = document.getElementById('propDesignDirection');
    if (propMotif) propMotif.value = motifName;
  }

  function handleCmhFileUpload(inputEl, sectionId) {
    const nameLabel = document.getElementById('cmhFileName-' + sectionId);
    if (inputEl && inputEl.files && inputEl.files[0] && nameLabel) {
      nameLabel.textContent = '✓ Selected: ' + inputEl.files[0].name;
      nameLabel.style.display = 'block';
    }
  }

  function changeCmhQty(delta, sectionId) {
    const qtyInput = document.getElementById('Quantity-' + sectionId);
    if (!qtyInput) return;
    let current = parseInt(qtyInput.value, 10) || 1;
    current = Math.max(1, Math.min(99, current + delta));
    qtyInput.value = current;
  }

  async function handleCmhAddToCart(mode, sectionId) {
    const form = document.getElementById('CustomMatForm');
    if (!form) return;
    if (typeof form.reportValidity === 'function' && !form.reportValidity()) return;

    const atcBtn = document.getElementById('cmhAddToCartBtn-' + sectionId);
    const buyBtn = document.getElementById('cmhBuyNowBtn-' + sectionId);
    const btnText = atcBtn ? atcBtn.querySelector('.cmh-btn-text') : null;
    const btnSpinner = atcBtn ? atcBtn.querySelector('.cmh-btn-spinner') : null;

    if (btnText && btnSpinner) {
      btnText.style.display = 'none';
      btnSpinner.style.display = 'inline-flex';
    }
    if (atcBtn) atcBtn.disabled = true;
    if (buyBtn) buyBtn.disabled = true;

    try {
      const formData = new FormData(form);
      formData.set('sections', 'cart-drawer,cart-icon-bubble');
      formData.set('sections_url', window.location.pathname);

      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: formData
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.description || data.message || 'Error adding item to cart');
      }

      if (mode === 'checkout') {
        window.location.href = '/checkout';
        return;
      }

      // Success visual feedback
      if (btnText && btnSpinner) {
        btnSpinner.style.display = 'none';
        btnText.innerHTML = '✓ Added to Cart!';
        btnText.style.display = 'inline-block';
      }

      // Update and open cart drawer if available
      const cartDrawer = document.querySelector('cart-drawer');
      if (cartDrawer && typeof cartDrawer.renderContents === 'function' && data.sections) {
        cartDrawer.renderContents(data);
      } else {
        // Fallback: update header bubble count if present
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            const bubbles = document.querySelectorAll('.cart-count-bubble, [id^="cart-icon-bubble"]');
            bubbles.forEach(b => {
              b.textContent = cart.item_count;
              b.classList.remove('is-empty');
            });
          })
          .catch(() => {});
      }

      setTimeout(() => {
        if (btnText) {
          btnText.innerHTML = 'ADD TO CART — {{ current_variant.price | money }}';
        }
        if (atcBtn) atcBtn.disabled = false;
        if (buyBtn) buyBtn.disabled = false;
      }, 2500);

    } catch (err) {
      console.error('Cart add error:', err);
      alert('Could not add item to cart: ' + err.message);
      if (btnText && btnSpinner) {
        btnSpinner.style.display = 'none';
        btnText.style.display = 'inline-block';
      }
      if (atcBtn) atcBtn.disabled = false;
      if (buyBtn) buyBtn.disabled = false;
    }
  }
</script>

