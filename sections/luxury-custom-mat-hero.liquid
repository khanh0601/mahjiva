                      <details class="cmh-accordion-item" {% if block.settings.open_by_default %}open{% endif %}>
                        <summary class="cmh-accordion-summary">
                          <span>{{ block.settings.heading | default: 'Product Specifications' }}</span>
                          <span class="cmh-accordion-icon">+</span>
                        </summary>
                        <div class="cmh-accordion-body">
