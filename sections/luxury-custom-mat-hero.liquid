                              name="quantity" 
                              id="Quantity-{{ section.id }}" 
                              class="cmh-qty-input" 
                              value="1" 
                              min="1" 
                              max="99" 
                              aria-label="Quantity"
                            >
                            <button type="button" class="cmh-qty-btn" onclick="changeCmhQty(1, '{{ section.id }}')" aria-label="Increase quantity">+</button>
                          </div>
                        </div>
