                        <div class="cmh-motif-card" onclick="selectCmhMotif('{{ block.settings.motif_6_title | default: 'Asian Dragons & Clouds' }}', '{{ block.settings.motif_6_icon | default: '🐉' }}', this, '{{ section.id }}')">
