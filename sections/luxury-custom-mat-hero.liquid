                          <span class="cmh-step-num">{{ block.settings.step_num | default: '6' }}</span>
                          {{ block.settings.heading | default: 'Special Requests for Artist' }}
                        </span>
                        <span class="cmh-step-help">{{ block.settings.help_text | default: 'Optional' }}</span>
                      </div>
                      <textarea 
                        class="cmh-textarea" 
                        name="properties[Artist Notes]" 
                        placeholder="{{ block.settings.placeholder | default: 'Tell us any special wishes, e.g., Please include our dog Daisy on the bottom-right corner and use soft gold accents.' }}"
