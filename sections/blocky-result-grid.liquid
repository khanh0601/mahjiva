{% stylesheet %}
  .blocky-rg .blocky-rg-inner {
    max-width: calc(var(--columns-desktop) * 330px);
    margin-inline: auto;
  }

  .blocky-rg .blocky-rg-header {
    text-align: center;
    margin-bottom: var(--header-gap);
  }

  .blocky-rg .blocky-rg-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-desktop), minmax(0, 1fr));
    gap: var(--card-gap);
    margin-bottom: var(--cards-gap);
  }

  .blocky-rg .blocky-rg-card {
    background: var(--card-bg);
    border-radius: var(--corner-radius);
    border: var(--border-width) solid var(--border-color);
    box-shadow: var(--card-shadow);
    padding: 35px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--inner-gap);
    aspect-ratio: 1 / 1;
  }

  .blocky-rg .blocky-rg-circle-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
  }

  .blocky-rg .blocky-rg-circle-wrap svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
    display: block;
  }

  .blocky-rg .blocky-rg-circle-bg {
    fill: transparent;
  }

  .blocky-rg .blocky-rg-circle-fg {
    fill: transparent;
  }

  .blocky-rg .blocky-rg-circle-value {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-weight: 700;
    line-height: 1;
    pointer-events: none;
  }

  .blocky-rg .blocky-rg-card-text {
    line-height: 1.5;
    margin: 0;
  }

  .blocky-rg .blocky-rg-cta {
    text-align: center;
  }

  .blocky-rg .blocky-rg-cta .blocky-button {
    width: min(100%, var(--button-width));
  }

  .blocky-rg .blocky-rg-cta .blocky-button:not(.blocky-button-regular) {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 0 3rem;
    min-width: 128px;
    min-height: 50px;
    background: transparent;
    border: 1px solid var(--button-text-color);
    color: var(--button-text-color);
  }

  @media screen and (max-width: 749px) {
    .blocky-rg .blocky-rg-grid {
      grid-template-columns: repeat(var(--columns-mobile), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

<div
  class="blocky blocky-rg blocky-padding background-wrapper"
  style="
    --padding-top: {{ section.settings.padding_top }};
    --padding-bottom: {{ section.settings.padding_bottom }};
    --background-color: {{ section.settings.background_color }};
    --section-page-width: {{ section.settings.page_width | divided_by: 10 }}rem;
    --header-gap: {{ section.settings.header_gap }}px;
    --columns-desktop: {{ section.settings.columns_desktop }};
    --columns-mobile: {{ section.settings.columns_mobile }};
    --card-gap: {{ section.settings.card_gap }}px;
    --cards-gap: {{ section.settings.cards_gap }}px;
    --card-bg: {{ section.settings.card_bg }};
    --corner-radius: {{ section.settings.corner_radius }}px;
    --border-width: {{ section.settings.border_width }}px;
    --border-color: {{ section.settings.border_color }};
    --inner-gap: {{ section.settings.inner_gap }}px;
    --button-width: {{ section.settings.button_width }}px;
    --card-shadow: {% if section.settings.show_card_shadow %}0 4px 16px rgba(0, 0, 0, 0.08){% else %}none{% endif %};
  "
>
  <div class="blocky-page-width">
    <div class="blocky-rg-inner">

    <div class="blocky-rg-header blocky-media-text-container blocky-text-container-desktop-center blocky-text-container-mobile-center">
      {%- if section.settings.show_title -%}
        {% render 'blocky-titlel', block: section %}
      {%- endif -%}
      {%- if section.settings.show_body -%}
        {% render 'blocky-bodyl', block: section %}
      {%- endif -%}
    </div>

    <div class="blocky-rg-grid" id="blocky-rg-grid-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- assign circle_size = block.settings.size -%}
        {%- assign stroke_w = block.settings.ring_width -%}
        {%- assign radius = circle_size | divided_by: 2 | minus: stroke_w -%}
        <div
          class="blocky-rg-card"
          data-pcs-card
          data-percent="{{ block.settings.percentage }}"
          data-duration="{{ block.settings.duration }}"
          {{ block.shopify_attributes }}
        >
          <div class="blocky-rg-circle-wrap" style="max-width:{{ circle_size }}px;">
            <svg
              viewBox="0 0 {{ circle_size }} {{ circle_size }}"
            >
              <circle
                class="blocky-rg-circle-bg"
                cx="{{ circle_size | divided_by: 2 }}"
                cy="{{ circle_size | divided_by: 2 }}"
                r="{{ radius }}"
                stroke="{{ block.settings.track_color }}"
                stroke-width="{{ stroke_w }}"
              />
              <circle
                class="blocky-rg-circle-fg"
                data-pcs-fg
                cx="{{ circle_size | divided_by: 2 }}"
                cy="{{ circle_size | divided_by: 2 }}"
                r="{{ radius }}"
                stroke="{{ block.settings.ring_color }}"
                stroke-width="{{ stroke_w }}"
                stroke-linecap="{{ block.settings.ring_cap }}"
              />
            </svg>
            <div
              class="blocky-rg-circle-value"
              data-pcs-label
              style="font-size: {{ block.settings.pct_size }}px; color: {{ block.settings.pct_color }};"
            >0%</div>
          </div>

          {%- if block.settings.card_text != blank -%}
            <div
              class="blocky-rg-card-text"
              style="font-size: {{ block.settings.text_size }}px; color: {{ block.settings.text_color }};"
            >{{ block.settings.card_text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_button -%}
      <div class="blocky-rg-cta">
        {% render 'blocky-buttonl', block: section %}
      </div>
    {%- endif -%}

    </div>
  </div>
</div>

<script>
(function() {
  var grid = document.getElementById('blocky-rg-grid-{{ section.id }}');
  if (!grid) return;

  var cards = Array.from(grid.querySelectorAll('[data-pcs-card]'));

  function easeInOutQuad(t) {
    return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
  }

  var animators = cards.map(function(card) {
    var target = parseFloat(card.dataset.percent) || 0;
    var dur    = parseInt(card.dataset.duration) || 1000;
    var fg     = card.querySelector('[data-pcs-fg]');
    var label  = card.querySelector('[data-pcs-label]');
    var r      = parseFloat(fg.getAttribute('r'));
    var C      = 2 * Math.PI * r;

    fg.style.strokeDasharray  = C + ' ' + C;
    fg.style.strokeDashoffset = C;

    function setProgress(pct) {
      fg.style.strokeDashoffset = C - (pct / 100) * C;
      label.textContent = Math.round(pct) + '%';
    }

    return { run: function() {
      var start = null;
      function frame(ts) {
        if (!start) start = ts;
        var elapsed = ts - start;
        var t = Math.min(elapsed / dur, 1);
        setProgress(easeInOutQuad(t) * target);
        if (t < 1) requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }};
  });

  var stagger   = {{ section.settings.stagger }};
  var triggered = false;

  var observer = new IntersectionObserver(function(entries) {
    if (entries[0].isIntersecting && !triggered) {
      triggered = true;
      animators.forEach(function(a, i) {
        setTimeout(function() { a.run(); }, i * stagger);
      });
      observer.disconnect();
    }
  }, { threshold: {{ section.settings.threshold }} });

  if (cards[0]) observer.observe(cards[0]);
})();
</script>

