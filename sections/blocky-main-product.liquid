    #blocky-featured-product-{{ section.id }} .blocky-review-modal__stage,
    #blocky-featured-product-{{ section.id }} .blocky-review-modal__video-panel {
      width: 100%;
      height: calc(100vh - 1.5rem);
      height: calc(100dvh - 1.5rem);
    }

    #blocky-featured-product-{{ section.id }} .blocky-review-modal__video-panel video,
    #blocky-featured-product-{{ section.id }} .blocky-review-modal__video-panel img,
    #blocky-featured-product-{{ section.id }} .blocky-review-modal__video-panel svg {
      width: 100%;
      height: 100%;
      max-height: none;
      object-fit: cover;
    }

    #blocky-featured-product-{{ section.id }} .blocky-review-modal__bottom-products {
      right: 1.5rem;
      bottom: 1.35rem;
      left: 1.5rem;
      z-index: 2;
    }

    #blocky-featured-product-{{ section.id }} .blocky-review-modal__bottom-panel {
      gap: 0.45rem;
      padding-top: 2.2rem;
      padding-bottom: 0;
      scroll-snap-type: x mandatory;
    }

    #blocky-featured-product-{{ section.id }} .blocky-review-modal__view-all {
      position: absolute;
      top: 0;
      bottom: auto;
      left: 0;
    }

    #blocky-featured-product-{{ section.id }} .blocky-review-modal__bottom-card {
      flex-basis: min(265px, 76vw);
      grid-template-columns: 56px minmax(0, 1fr) 30px;
      min-height: 74px;
      scroll-snap-align: start;
      background: rgba(0, 0, 0, 0.58);
      backdrop-filter: blur(6px);
    }

    #blocky-featured-product-{{ section.id }} .blocky-review-modal__bottom-card img,
    #blocky-featured-product-{{ section.id }} .blocky-review-modal__bottom-card svg {
      width: 56px;
      height: 56px;
    }

    #blocky-featured-product-{{ section.id }} .blocky-review-modal__bottom-title,
    #blocky-featured-product-{{ section.id }} .blocky-review-modal__bottom-price {
      font-size: 0.9rem;
    }
  }

  #blocky-featured-product-{{ section.id }} .blocky-rti {
    display: flex;
    align-items: flex-start;
    gap: 24px;
    width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rti-avatars-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rti-avatars {
    display: flex;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rti-avatar {
    width: var(--rti-avatar-size);
    height: var(--rti-avatar-size);
    border-radius: 50%;
    border: var(--rti-avatar-border-width) solid var(--rti-avatar-border-color);
    overflow: hidden;
    margin-left: calc(var(--rti-avatar-size) * -0.3);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  #blocky-featured-product-{{ section.id }} .blocky-rti-avatar:first-child {
    margin-left: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rti-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rti-stars-container {
    display: flex;
    gap: 0.125em;
    color: var(--rti-star-color);
  }

  #blocky-featured-product-{{ section.id }} .blocky-rti-stars-container svg {
    display: block;
    flex-shrink: 0;
    width: var(--rti-star-size);
    height: var(--rti-star-size);
  }

  #blocky-featured-product-{{ section.id }} .blocky-rti-stars-underlay {
    position: relative;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rti-stars-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% / 5 * var(--rti-rating));
    overflow: hidden;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rti-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
