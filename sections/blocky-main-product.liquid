  @media screen and (min-width: 750px) {
    #blocky-featured-product-{{ section.id }} .blocky-featured-product__media-col {
      flex: 0 0 {{ section.settings.media_size }}%;
      position: sticky;
      top: 30px;
      align-self: flex-start;
    }

    /* Top-align the content column instead of vertically centering it, so the
       product text starts at the top of the row rather than floating in the
       middle when the media column is taller. */
    #blocky-featured-product-{{ section.id }} .blocky-featured-product__content-col {
      align-self: flex-start;
    }

    /* Review carousel: fallback to a 4-up width on desktop so it stays proportional
       even if the slider JS hasn't sized the slides yet (matches Horizon's layout).
       Glide's inline per-slide width overrides this when it mounts, so Horizon is unchanged. */
    #blocky-featured-product-{{ section.id }} .blocky-review-carousel .glide__slide {
      width: calc((100% - 36px) / 4);
      flex-shrink: 0;
