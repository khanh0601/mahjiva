  }

  #blocky-featured-product-{{ section.id }} .blocky-review-modal__product-price {
    margin: 0.15rem 0 0.7rem;
  }

  #blocky-featured-product-{{ section.id }} .blocky-review-modal__product-button {
    display: inline-flex;
    justify-content: center;
    width: 100%;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: black;
    color: #ffffff;
