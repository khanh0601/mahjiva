  #blocky-featured-product-{{ section.id }} .blocky-review-modal__products-panel[hidden],
  #blocky-featured-product-{{ section.id }} .blocky-review-modal__bottom-panel[hidden] {
    display: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-review-modal__products-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.8rem 0.8rem;
  }

  #blocky-featured-product-{{ section.id }} .blocky-review-modal__product-card {
    display: block;
    min-width: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-review-modal__product-card img,
  #blocky-featured-product-{{ section.id }} .blocky-review-modal__product-card svg {
    display: block;
    width: 100%;
    height: 136px;
    object-fit: contain;
    background: linear-gradient(#ffffff, #f4f4f4);
  }

  #blocky-featured-product-{{ section.id }} .blocky-review-modal__product-title {
    overflow: hidden;
    margin: 0.65rem 0 0;
    font-weight: 700;
    line-height: 1.2;
    text-overflow: ellipsis;
