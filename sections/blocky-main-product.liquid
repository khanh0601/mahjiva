    #blocky-featured-product-{{ section.id }} .blocky-review-modal__media {
      display: block;
      min-height: 100vh;
      min-height: 100dvh;
      padding: 0.75rem 1.25rem;
    }

    #blocky-featured-product-{{ section.id }} .blocky-review-modal__thumbs {
      display: none;
    }

    #blocky-featured-product-{{ section.id }} .blocky-review-modal__products {
      display: none;
    }

    #blocky-featured-product-{{ section.id }} .blocky-review-modal__close {
      top: 1.5rem;
      left: 1.75rem;
      z-index: 3;
      width: 2rem;
      height: 2rem;
      font-size: 2.4rem;
      text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
