                                <div class="blocky-product-review__reviewer">{{ reviewer }}</div>
                                {%- if block.settings.display_stars -%}
                                  <div class="blocky-product-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                                {%- endif -%}
                              </div>
                            </div>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                  {%- if rendered_review_count > 1 -%}
                    <div class="glide__arrows" data-glide-el="controls">
                      <button type="button" class="glide__arrow glide__arrow--prev blocky-product-review__nav blocky-product-review__nav--prev" data-glide-dir="<" aria-label="Previous review">&#8249;</button>
                      <button type="button" class="glide__arrow glide__arrow--next blocky-product-review__nav blocky-product-review__nav--next" data-glide-dir=">" aria-label="Next review">&#8250;</button>
                    </div>
                  {%- endif -%}
                </blocky-media-slider>
                </div>
                {%- endunless -%}
              {%- when 'product_reviews_2' -%}
                {%- unless block.settings.show_on_left -%}
                {%- assign rendered_review_count = 0 -%}
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign reviewer_key = 'reviewer_' | append: i
                    assign text_key = 'text_' | append: i
                    assign reviewer = block.settings[reviewer_key]
                    assign review_text = block.settings[text_key]
                  -%}
                  {%- if reviewer != blank or review_text != blank -%}
                    {%- assign rendered_review_count = rendered_review_count | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- capture pr2_star_filled -%}<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 1.5L14.41 8.68L21.99 8.76L15.9 13.27L18.17 20.49L12 16.1L5.83 20.49L8.1 13.27L2.01 8.76L9.59 8.68Z"></path></svg>{%- endcapture -%}
                {%- capture pr2_style -%}--pr2-bg-color: {{ block.settings.card_bg_color }}; --pr2-border-color: {{ block.settings.card_border_color }}; --pr2-radius: {{ block.settings.card_border_radius }}px; --pr2-accent-color: {{ block.settings.accent_color }}; --pr2-bar-color: {{ block.settings.bar_color }}; --pr2-star-color: {{ block.settings.star_color }}; --pr2-star-size: {{ block.settings.star_size }}px; --pr2-heading-color: {{ block.settings.heading_color }}; --pr2-heading-size: {{ block.settings.heading_size }}px; --pr2-text-color: {{ block.settings.text_color }}; --pr2-text-size: {{ block.settings.text_size }}px; --pr2-reviewer-color: {{ block.settings.reviewer_color }}; --pr2-reviewer-size: {{ block.settings.reviewer_text_size }}px; --pr2-avatar-size: {{ block.settings.avatar_size }}px; --pr2-avatar-border-width: {{ block.settings.avatar_border_width }}px; --pr2-verified-size: {{ block.settings.verified_text_size }}px;{%- endcapture -%}
                <div class="blocky-product-reviews-outer blocky-pr2-outer{% if block.settings.hide_on_mobile %} blocky-pr2-hide-mobile{% endif %}">
                {%- if rendered_review_count > 1 -%}
                <blocky-media-slider
                  class="blocky-product-reviews blocky-pr2 glide ivs-{{ section.id }}-{{ block.id }}"
                  data-id="{{ section.id }}-{{ block.id }}"
                  data-size="{{ rendered_review_count }}"
                  slide-size="1"
                  mobile-slide-size="1"
                  media-spacing="0"
                  data-anim-duration="350"
                  style="{{ pr2_style }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="glide__track" data-glide-el="track">
                    <ul class="glide__slides">
                      {%- for i in (1..3) -%}
                        {%- liquid
                          assign reviewer_key = 'reviewer_' | append: i
                          assign text_key = 'text_' | append: i
                          assign image_key = 'image_' | append: i
                          assign heading_key = 'heading_' | append: i
                          assign reviewer = block.settings[reviewer_key]
                          assign review_text = block.settings[text_key]
                          assign review_image = block.settings[image_key]
                          assign review_heading = block.settings[heading_key]
                        -%}
                        {%- if reviewer != blank or review_text != blank -%}
                          <li class="glide__slide">
                            <div class="blocky-pr2-card">
                              {%- if block.settings.display_stars -%}
                                <div class="blocky-pr2-stars" aria-hidden="true">
                                  {{ pr2_star_filled }}{{ pr2_star_filled }}{{ pr2_star_filled }}{{ pr2_star_filled }}{{ pr2_star_filled }}
                                </div>
                              {%- endif -%}
                              {%- if review_heading != blank -%}
                                <p class="blocky-pr2-heading">{{ review_heading }}</p>
                              {%- endif -%}
                              {%- if review_text != blank -%}
                                <div class="blocky-pr2-text">{{ review_text }}</div>
                              {%- endif -%}
                              <div class="blocky-pr2-footer">
                                {%- if review_image != blank or block.settings.show_placeholder_image -%}
                                  <div class="blocky-pr2-avatar">
                                    {%- if review_image != blank -%}
                                      <img src="{{ review_image | image_url: width: 200 }}" alt="{{ reviewer | strip_html | escape }}" loading="lazy" width="200" height="200">
                                    {%- else -%}
                                      {{ 'image' | placeholder_svg_tag }}
                                    {%- endif -%}
                                  </div>
                                {%- endif -%}
                                <div class="blocky-pr2-meta">
                                  {%- if reviewer != blank -%}<div class="blocky-pr2-reviewer">{{ reviewer }}</div>{%- endif -%}
                                  {%- if block.settings.show_verified -%}
                                    <div class="blocky-pr2-verified">
                                      <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2l2.39 2.39 3.3-.6.6 3.3L20.68 9l-1.79 2.7L20.68 15l-2.39 1.91-.6 3.3-3.3-.6L12 22l-2.39-2.39-3.3.6-.6-3.3L3.32 15l1.79-2.7L3.32 9l2.39-1.91.6-3.3 3.3.6L12 2z"></path><path d="M9.5 12.5l1.8 1.8 3.2-3.6" stroke="#fff" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                      <span>{{ block.settings.verified_text }}</span>
                                    </div>
                                  {%- endif -%}
                                </div>
                              </div>
                            </div>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                  {%- unless block.settings.hide_arrows -%}
                    <div class="glide__arrows" data-glide-el="controls">
                      <button type="button" class="glide__arrow glide__arrow--prev blocky-product-review__nav blocky-product-review__nav--prev" data-glide-dir="<" aria-label="Previous review">&#8249;</button>
                      <button type="button" class="glide__arrow glide__arrow--next blocky-product-review__nav blocky-product-review__nav--next" data-glide-dir=">" aria-label="Next review">&#8250;</button>
                    </div>
                  {%- endunless -%}
                </blocky-media-slider>
                {%- else -%}
                  <div class="blocky-pr2-single" style="{{ pr2_style }}" {{ block.shopify_attributes }}>
                    {%- for i in (1..3) -%}
                      {%- liquid
                        assign reviewer_key = 'reviewer_' | append: i
                        assign text_key = 'text_' | append: i
                        assign image_key = 'image_' | append: i
                        assign heading_key = 'heading_' | append: i
                        assign reviewer = block.settings[reviewer_key]
                        assign review_text = block.settings[text_key]
                        assign review_image = block.settings[image_key]
                        assign review_heading = block.settings[heading_key]
                      -%}
                      {%- if reviewer != blank or review_text != blank -%}
                        <div class="blocky-pr2-card">
                          {%- if block.settings.display_stars -%}
                            <div class="blocky-pr2-stars" aria-hidden="true">
                              {{ pr2_star_filled }}{{ pr2_star_filled }}{{ pr2_star_filled }}{{ pr2_star_filled }}{{ pr2_star_filled }}
                            </div>
                          {%- endif -%}
                          {%- if review_heading != blank -%}
                            <p class="blocky-pr2-heading">{{ review_heading }}</p>
                          {%- endif -%}
                          {%- if review_text != blank -%}
                            <div class="blocky-pr2-text">{{ review_text }}</div>
                          {%- endif -%}
                          <div class="blocky-pr2-footer">
                            {%- if review_image != blank or block.settings.show_placeholder_image -%}
                              <div class="blocky-pr2-avatar">
                                {%- if review_image != blank -%}
                                  <img src="{{ review_image | image_url: width: 200 }}" alt="{{ reviewer | strip_html | escape }}" loading="lazy" width="200" height="200">
                                {%- else -%}
                                  {{ 'image' | placeholder_svg_tag }}
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                            <div class="blocky-pr2-meta">
                              {%- if reviewer != blank -%}<div class="blocky-pr2-reviewer">{{ reviewer }}</div>{%- endif -%}
                              {%- if block.settings.show_verified -%}
                                <div class="blocky-pr2-verified">
                                  <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2l2.39 2.39 3.3-.6.6 3.3L20.68 9l-1.79 2.7L20.68 15l-2.39 1.91-.6 3.3-3.3-.6L12 22l-2.39-2.39-3.3.6-.6-3.3L3.32 15l1.79-2.7L3.32 9l2.39-1.91.6-3.3 3.3.6L12 2z"></path><path d="M9.5 12.5l1.8 1.8 3.2-3.6" stroke="#fff" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                  <span>{{ block.settings.verified_text }}</span>
                                </div>
                              {%- endif -%}
                            </div>
                          </div>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                </div>
                {%- endunless -%}
              {%- when 'scroll_to' -%}
                <blocky-scroll-to
                  class="blocky blocky-scroll-to"
                  {{ block.shopify_attributes }}
                  style="--heading-text-color: {{ block.settings.heading_text_color }}; --btn-background-color: {{ block.settings.btn_background_color }}; --btn-text-color: {{ block.settings.btn_text_color }}; --btn-border-radius: {{ block.settings.btn_border_radius }}px; --btn-font-size: {{ block.settings.btn_font_size }}px; --heading-font-size: {{ block.settings.heading_font_size }}px; --btn-border: {% if block.settings.show_border %}1px solid var(--btn-text-color){% else %}none{% endif %}; --btn-shadow: {% if block.settings.show_shadow %}#0000001f 0 2px 4px{% else %}none{% endif %};"
                >
                  <div class="blocky-scroll-to-heading">{{ block.settings.heading }}</div>
                  <div class="blocky-scroll-to-btns">
                    {% unless block.settings.button_1 == blank %}<button class="blocky-scroll-to-btn" type="button" data-btn="1">{{ block.settings.button_1 }}</button>{% endunless %}
                    {% unless block.settings.button_2 == blank %}<button class="blocky-scroll-to-btn" type="button" data-btn="2">{{ block.settings.button_2 }}</button>{% endunless %}
                    {% unless block.settings.button_3 == blank %}<button class="blocky-scroll-to-btn" type="button" data-btn="3">{{ block.settings.button_3 }}</button>{% endunless %}
                    {% unless block.settings.button_4 == blank %}<button class="blocky-scroll-to-btn" type="button" data-btn="4">{{ block.settings.button_4 }}</button>{% endunless %}
                  </div>
                </blocky-scroll-to>
              {%- when 'payment_badges' -%}
                <div class="list-payment" style="--bky-pay-size: {{ block.settings.icon_size }}px; justify-content: {{ block.settings.alignment }};" {{ block.shopify_attributes }}>
                  {%- for type in shop.enabled_payment_types -%}
                    {%- assign payment_type = type | strip -%}
                    <div class="list-payment__item">
                      {{ payment_type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                    </div>
                  {%- endfor -%}
                </div>
              {%- when 'delivery_deadline' -%}
                <div
                  class="blocky-delivery-deadline blocky-delivery-deadline--{{ block.settings.text_layout }} blocky-delivery-deadline--{{ block.settings.text_alignment }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.date_text != blank -%}
                    {%- capture dd_format -%}{{ block.settings.date_format | replace: 'day', block.settings.day_label | replace: 'month', block.settings.month_label }}{%- endcapture -%}
                    {%- assign dd_seconds = block.settings.days | times: 86400 -%}
                    {%- assign dd_date = 'now' | date: '%s' | plus: dd_seconds | date: dd_format | strip -%}
                    <p style="color: {{ block.settings.date_color }}; line-height: {% if block.settings.line_height > 0 %}{{ block.settings.line_height }}{% else %}1.2{% endif %}; font-size: {{ block.settings.date_size }}px;{% if block.settings.letter_spacing != 0 %} letter-spacing: {{ block.settings.letter_spacing }}px;{% endif %}">
                      {{ block.settings.date_text | replace: '[DATE]', dd_date }}
                    </p>
                  {%- endif -%}
                  {%- if block.settings.timer_text != blank -%}
                    <blocky-timer
                      data-text="{{ block.settings.timer_text | escape }}"
                      data-hours="{{ block.settings.hours }}"
                      data-minutes="{{ block.settings.minutes }}"
                    >
                      <span
                        class="blocky-timer-text"
                        style="color: {{ block.settings.timer_color }}; line-height: {% if block.settings.line_height > 0 %}{{ block.settings.line_height }}{% else %}1.2{% endif %}; font-size: {{ block.settings.timer_size }}px;{% if block.settings.letter_spacing != 0 %} letter-spacing: {{ block.settings.letter_spacing }}px;{% endif %}"
                      >
                        {{ block.settings.timer_text | replace: '[HOURS]', block.settings.hours | replace: '[MINUTES]', block.settings.minutes }}
                      </span>
                    </blocky-timer>
                  {%- endif -%}
                </div>
              {%- when 'alert_text' -%}
                <div
                  class="blocky-alert-text"
                  style="justify-content: {{ block.settings.text_alignment }}; --bky-alert-dot-color: {{ block.settings.dot_color }}; --bky-alert-dot-size: {{ block.settings.dot_size }}px; --bky-alert-text-color: {{ block.settings.text_color }}; --bky-alert-text-size: {{ block.settings.font_size }}px;{% if block.settings.line_height > 0 %} --bky-lh: {{ block.settings.line_height }};{% endif %}{% if block.settings.letter_spacing != 0 %} --bky-ls: {{ block.settings.letter_spacing }}px;{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.show_dot -%}
                    <span class="blocky-alert-text__dot blocky-alert-text__dot--{{ block.settings.animation }}"></span>
                  {%- endif -%}
                  <span class="blocky-alert-text__text" style="font-weight: {% if block.settings.is_bold %}700{% else %}400{% endif %};{% if block.settings.in_stock_uppercase %} text-transform: uppercase;{% endif %}">{{ block.settings.text }}</span>
                </div>
              {%- when 'urgency_progress' -%}
                {%- liquid
                  assign primary_color = block.settings.primary_color
                  assign third_color = block.settings.third_color
                  assign sold_percent = block.settings.sold_percent | plus: 0
                  if sold_percent < 0
                    assign sold_percent = 0
                  endif
                  if sold_percent > 100
                    assign sold_percent = 100
                  endif
                  assign remaining_percent = 100 | minus: sold_percent
                  assign icon_size = block.settings.icon_size
                -%}

                <div class="urgency-block" style="background-color: {{ third_color }}; border: 1px solid {{ primary_color }}; border-radius: {{ block.settings.section_radius }}px; --bky-progress-text-size: {{ block.settings.progress_text_size }}px;{% if block.settings.show_shadow %} box-shadow: 0 4px 14px rgba(0,0,0,0.12);{% endif %}{% if block.settings.line_height > 0 %} --bky-lh: {{ block.settings.line_height }};{% endif %}{% if block.settings.letter_spacing != 0 %} --bky-ls: {{ block.settings.letter_spacing }}px;{% endif %}" {{ block.shopify_attributes }}>
                  <div class="urgency-features" style="border-bottom: 1px solid {{ primary_color }};">
                    {%- for i in (1..3) -%}
                      {%- liquid
                        assign feature_key = 'feature_' | append: i
                        assign feature_text = block.settings[feature_key]
                        assign icon_key = 'feature_' | append: i | append: '_icon'
                        assign icon_img = block.settings[icon_key]
                      -%}
                      {%- if feature_text != blank -%}
                        <div class="urgency-feature urgency-feature-{{ i }}">
                          {%- if icon_img != blank -%}
                            <img class="urgency-icon-img" src="{{ icon_img | image_url: width: 100 }}" width="{{ icon_size }}" height="{{ icon_size }}" alt="" loading="lazy">
                          {%- else -%}
                            <svg class="urgency-check" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="width: {{ icon_size }}px; height: {{ icon_size }}px;">
                              <path d="M20 6L9 17l-5-5" stroke="{{ primary_color }}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg>
                          {%- endif -%}
                          <span class="urgency-feature-text" style="color: {{ primary_color }}; font-size: {{ block.settings.icon_text_size }}px;">
                            {{ feature_text }}
                          </span>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>

                  <div class="urgency-message">
                    <h3 class="urgency-heading" style="color: {{ primary_color }}; font-size: {{ block.settings.heading_size }}px;">{{ block.settings.headline }}</h3>
                    <p style="font-size: {{ block.settings.subtext_size }}px; margin: 0; line-height: var(--bky-lh, normal); letter-spacing: var(--bky-ls, normal);">{{ block.settings.subtext }}</p>
                  </div>

                  <div class="urgency-progress" style="background-color: {{ third_color }}; border: 1px solid {{ primary_color }}; border-radius: {{ block.settings.bar_radius }}px;" role="progressbar" aria-valuenow="{{ sold_percent }}" aria-valuemin="0" aria-valuemax="100">
                    <div class="urgency-progress-fill" style="width: {{ sold_percent }}%; background-color: {{ primary_color }}; border-top-left-radius: {{ block.settings.bar_radius }}px; border-bottom-left-radius: {{ block.settings.bar_radius }}px;">
                      <span class="urgency-progress-text">{{ sold_percent }}% SOLD</span>
                    </div>
                    <div class="urgency-progress-remaining" style="width: {{ remaining_percent }}%; background-color: {{ third_color }}; border-top-right-radius: {{ block.settings.bar_radius }}px; border-bottom-right-radius: {{ block.settings.bar_radius }}px;" aria-hidden="true"></div>
                  </div>
                </div>
              {%- when 'guarantee_badge' -%}
                {%- liquid
                  assign bg_color = block.settings.bg_color
                  assign accent_color = block.settings.accent_color
                  assign text_color = block.settings.text_color
                  assign heading_color = block.settings.heading_color
                  assign days_number = block.settings.days_number
                  assign day_label = block.settings.day_label
                  assign ring_text = block.settings.ring_text
                  assign heading_text = block.settings.heading
                  assign body_text = block.settings.body
                -%}

                <div
                  class="guarantee-block"
                  style="background-color: {{ bg_color }}; border-radius: {{ block.settings.radius }}px; --gb-badge-size: {{ block.settings.badge_size }}px; --gb-heading-size: {{ block.settings.heading_size }}px; --gb-body-size: {{ block.settings.body_size }}px; --gb-gap: calc(var(--gb-body-size) * 0.75);{% if block.settings.border_color != blank %} --gb-border: {{ block.settings.border_width | default: 1 }}px solid {{ block.settings.border_color }};{% endif %}{% if block.settings.show_shadow %} --gb-shadow: 0 4px 14px rgba(0,0,0,0.12);{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <div class="guarantee-badge">
                    <svg viewBox="0 0 100 100" class="guarantee-badge-svg" aria-hidden="true" focusable="false">
                      <defs>
                        <path id="circle-path-top-{{ block.id }}" d="M 19,50 A 31,31 0 0,1 81,50" fill="none" />
                        <path id="circle-path-bottom-{{ block.id }}" d="M 81,50 A 31,31 0 0,1 19,50" fill="none" />
                      </defs>
                      <circle cx="50" cy="50" r="42" fill="none" stroke="{{ accent_color }}" stroke-width="2" />
                      <circle cx="50" cy="50" r="38" fill="none" stroke="{{ accent_color }}" stroke-width="1.5" />
                      <text fill="{{ accent_color }}" font-size="5" font-weight="700" letter-spacing="0.3"><textPath href="#circle-path-top-{{ block.id }}" startOffset="0%">{{ ring_text }}</textPath></text>
                      <text fill="{{ accent_color }}" font-size="5" font-weight="700" letter-spacing="0.3"><textPath href="#circle-path-bottom-{{ block.id }}" startOffset="0%">{{ ring_text }}</textPath></text>
                      <circle cx="50" cy="50" r="27" fill="{{ accent_color }}" />
                      <text x="50" y="44" text-anchor="middle" dominant-baseline="middle" font-size="22" fill="{{ bg_color }}" font-weight="700">{{ days_number }}</text>
                      <text x="50" y="59" text-anchor="middle" dominant-baseline="middle" font-size="9" fill="{{ bg_color }}" font-weight="400">{{ day_label }}</text>
                    </svg>
                  </div>
                  <div class="guarantee-content" style="color: {{ text_color }};{% if block.settings.line_height > 0 %} --bky-lh: {{ block.settings.line_height }};{% endif %}{% if block.settings.letter_spacing != 0 %} --bky-ls: {{ block.settings.letter_spacing }}px;{% endif %}">
                    <h3 class="guarantee-heading" style="color: {{ heading_color }};">{{ heading_text }}</h3>
                    <div class="guarantee-body">{{ body_text }}</div>
                  </div>
                </div>
              {%- when 'countdown_deals' -%}
                <blocky-countdown-timer
                  class="blocky-countdown-deals"
                  data-id="{{ block.id }}"
                  data-mode="{{ block.settings.timer_mode }}"
                  data-hours="{{ block.settings.hours_duration }}"
                  data-reset-scope="{{ block.settings.reset_scope }}"
                  data-fixed-end="{{ block.settings.fixed_end | escape }}"
                  style="--cd-border-color: {{ block.settings.border_color }}; --cd-border-width: {{ block.settings.border_width }}px; --cd-radius: {{ block.settings.radius }}px; --cd-bg-color: {{ block.settings.bg_color }}; --cd-image-size: {{ block.settings.image_size }}px; --cd-text-color: {{ block.settings.text_color }}; --cd-accent-text-color: {{ block.settings.accent_text_color }}; --cd-text-size: {{ block.settings.text_size }}px; --cd-timer-bg: {% if block.settings.timer_use_gradient %}{{ block.settings.timer_gradient }}{% else %}{{ block.settings.timer_bg_color }}{% endif %}; --cd-timer-radius: {{ block.settings.timer_radius }}px; --cd-timer-number-color: {{ block.settings.timer_number_color }}; --cd-timer-number-size: {{ block.settings.timer_number_size }}px; --cd-timer-label-color: {{ block.settings.timer_label_color }}; --cd-timer-label-size: {{ block.settings.timer_label_size }}px;"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.image != blank -%}
                    <img class="blocky-countdown-deals-image" src="{{ block.settings.image | image_url: width: 200 }}" alt="" loading="lazy" width="60" height="60">
                  {%- endif -%}
                  <div class="blocky-countdown-deals-text">{{ block.settings.text }}</div>
                  <div class="blocky-countdown-deals-timer">
                    {%- if block.settings.show_days -%}
                      <div class="blocky-countdown-deals-timer-cell"><span class="blocky-countdown-deals-timer-number" data-cd-days>00</span><span class="blocky-countdown-deals-timer-label">Days</span></div>
                    {%- endif -%}
                    {%- if block.settings.show_hours -%}
                      <div class="blocky-countdown-deals-timer-cell"><span class="blocky-countdown-deals-timer-number" data-cd-hours>00</span><span class="blocky-countdown-deals-timer-label">Hrs</span></div>
                    {%- endif -%}
                    {%- if block.settings.show_minutes -%}
                      <div class="blocky-countdown-deals-timer-cell"><span class="blocky-countdown-deals-timer-number" data-cd-minutes>00</span><span class="blocky-countdown-deals-timer-label">Min</span></div>
                    {%- endif -%}
                    {%- if block.settings.show_seconds -%}
                      <div class="blocky-countdown-deals-timer-cell"><span class="blocky-countdown-deals-timer-number" data-cd-seconds>00</span><span class="blocky-countdown-deals-timer-label">Sec</span></div>
                    {%- endif -%}
                  </div>
                </blocky-countdown-timer>
              {%- when 'bundle_deals' -%}
                {%- liquid
                  assign has_bundle_deals = false
                  for i in (1..3)
                    assign bd_check_key = 'title_' | append: i
                    if block.settings[bd_check_key] != blank
                      assign has_bundle_deals = true
                      break
                    endif
                  endfor
                -%}
                {%- if has_bundle_deals -%}
                  <blocky-bundle-deals
                    class="blocky-bundle-deals"
                    style="--bd-bg-color: {{ block.settings.bg_color }}; --bd-selected-bg-color: {{ block.settings.selected_bg_color }}; --bd-border-color: {{ block.settings.border_color }}; --bd-selected-border-color: {{ block.settings.selected_border_color }}; --bd-border-width: {{ block.settings.border_width }}px; --bd-radius: {{ block.settings.radius }}px; --bd-title-color: {{ block.settings.title_color }}; --bd-title-size: {{ block.settings.title_size }}px; --bd-price-color: {{ block.settings.price_color }}; --bd-price-size: {{ block.settings.price_size }}px; --bd-compare-color: {{ block.settings.compare_color }}; --bd-compare-size: {{ block.settings.compare_size }}px; --bd-save-bg-color: {{ block.settings.save_bg_color }}; --bd-save-text-color: {{ block.settings.save_text_color }}; --bd-save-text-size: {{ block.settings.save_text_size }}px; --bd-badge-bg: {% if block.settings.badge_use_gradient %}{{ block.settings.badge_gradient }}{% else %}{{ block.settings.badge_bg_color }}{% endif %}; --bd-badge-text-color: {{ block.settings.badge_text_color }}; --bd-badge-text-size: {{ block.settings.badge_text_size }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {%- for i in (1..3) -%}
                      {%- liquid
                        assign bd_title_key = 'title_' | append: i
                        assign bd_price_key = 'price_' | append: i
                        assign bd_compare_key = 'compare_price_' | append: i
                        assign bd_save_key = 'save_text_' | append: i
                        assign bd_badge_key = 'badge_' | append: i
                        assign bd_qty_key = 'quantity_' | append: i
                        assign bd_title = block.settings[bd_title_key]
                      -%}
                      {%- if bd_title != blank -%}
                        <button type="button" class="blocky-bd-card{% if block.settings.default_selected == i %} is-selected{% endif %}" data-bd-quantity="{{ block.settings[bd_qty_key] }}">
                          {%- if block.settings[bd_badge_key] != blank -%}
                            <span class="blocky-bd-badge">{{ block.settings[bd_badge_key] }}</span>
                          {%- endif -%}
                          <span class="blocky-bd-title">{{ bd_title }}</span>
                          <span class="blocky-bd-prices">
                            <span class="blocky-bd-price">{{ block.settings[bd_price_key] }}</span>
                            {%- if block.settings[bd_compare_key] != blank -%}<s class="blocky-bd-compare">{{ block.settings[bd_compare_key] }}</s>{%- endif -%}
                          </span>
                          {%- if block.settings[bd_save_key] != blank -%}
                            <span class="blocky-bd-save">{{ block.settings[bd_save_key] }}</span>
                          {%- endif -%}
                        </button>
                      {%- endif -%}
                    {%- endfor -%}
                  </blocky-bundle-deals>
                {%- endif -%}
              {%- when 'accordion' -%}
                <div
                  class="blocky-accordion"
                  style="--acc-border-color: {{ block.settings.border_color }}; --acc-border-width: {{ block.settings.border_width }}px; --acc-radius: {{ block.settings.radius }}px; --acc-bg-color: {{ block.settings.bg_color }}; --acc-icon-size: {{ block.settings.icon_size }}px; --acc-icon-color: {{ block.settings.icon_color }}; --acc-question-color: {{ block.settings.question_color }}; --acc-question-size: {{ block.settings.question_size }}px; --acc-answer-color: {{ block.settings.answer_color }}; --acc-answer-size: {{ block.settings.answer_size }}px; --acc-toggle-color: {{ block.settings.toggle_color }};"
                  {{ block.shopify_attributes }}
                >
                  {%- for i in (1..5) -%}
                    {%- liquid
                      assign acc_question_key = 'question_' | append: i
                      assign acc_answer_key = 'answer_' | append: i
                      assign acc_image_key = 'icon_image_' | append: i
                      assign acc_code_key = 'icon_code_' | append: i
                      assign acc_question = block.settings[acc_question_key]
                    -%}
                    {%- if acc_question != blank -%}
                      <details class="blocky-acc-item">
                        <summary class="blocky-acc-summary">
                          {%- if block.settings[acc_image_key] != blank -%}
                            <img class="blocky-acc-icon" src="{{ block.settings[acc_image_key] | image_url: width: 120 }}" alt="" loading="lazy" width="{{ block.settings[acc_image_key].width }}" height="{{ block.settings[acc_image_key].height }}">
                          {%- elsif block.settings[acc_code_key] != blank -%}
                            <span class="blocky-acc-icon-code material-icons material-symbols-outlined">{{ block.settings[acc_code_key] }}</span>
                          {%- endif -%}
                          <span class="blocky-acc-question">{{ acc_question }}</span>
                          <span class="blocky-acc-toggle" aria-hidden="true"></span>
                        </summary>
                        <div class="blocky-acc-content">{{ block.settings[acc_answer_key] }}</div>
                      </details>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- when 'review_carousel' -%}
                {%- assign rendered_video_count = 0 -%}
                {%- for i in (1..6) -%}
                  {%- liquid
                    assign video_key = 'video_select_' | append: i
                    assign image_key = 'image_' | append: i
                  -%}
                  {%- if block.settings[video_key] != blank or block.settings[image_key] != blank -%}
                    {%- assign rendered_video_count = rendered_video_count | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                <div class="customer_rev_wrapper" {{ block.shopify_attributes }}>
                  <div class="customer_rev_slider">
                    {%- if block.settings.heading != blank -%}
                      <h4 style="font-size: {{ block.settings.heading_font_size }}px; margin-bottom: {{ block.settings.heading_font_size | divided_by: 2 }}px">
                        {{ block.settings.heading }}
                      </h4>
                    {%- endif -%}
                    {%- if rendered_video_count > 0 -%}
                      <blocky-media-slider
                        class="blocky-review-carousel glide ivs-{{ section.id }}-{{ block.id }}"
                        data-id="{{ section.id }}-{{ block.id }}"
                        data-size="{{ rendered_video_count }}"
                        slide-size="{{ block.settings.slides_to_show | default: 4 }}"
                        mobile-slide-size="3"
                        media-spacing="12"
                        data-anim-duration="350"
                        style="{% if block.settings.card_height > 0 %}--bky-rc-card-h: {{ block.settings.card_height }}px;{% endif %} --bky-rc-play-bg: {{ block.settings.play_circle_color | default: '#ffffff' }}; --bky-rc-play-color: {{ block.settings.play_icon_color | default: '#000000' }};"
                      >
                        <div class="glide__track" data-glide-el="track">
                          <ul class="glide__slides">
                            {%- for i in (1..6) -%}
                              {%- liquid
                                assign video_key = 'video_select_' | append: i
                                assign image_key = 'image_' | append: i
                                assign video = block.settings[video_key]
                                assign fallback_image = block.settings[image_key]
                              -%}
                              {%- if video != blank or fallback_image != blank -%}
                                <li class="glide__slide">
                                  <button
                                    class="blocky-review-video-card"
                                    type="button"
                                    data-review-modal-open="{{ block.id }}"
                                    data-review-modal-index="{{ i }}"
                                    aria-label="Open review video {{ i }}"
                                  >
                                    {%- if fallback_image != blank -%}
                                      <img src="{{ fallback_image | image_url: width: 600 }}" alt="{{ fallback_image.alt | escape }}" loading="lazy" width="600" height="1067">
                                    {%- elsif video.preview_image != blank -%}
                                      <img src="{{ video.preview_image | image_url: width: 600 }}" alt="{{ video.alt | default: block.settings.heading | escape }}" loading="lazy" width="600" height="1067">
                                    {%- else -%}
                                      {{ 'image' | placeholder_svg_tag }}
                                    {%- endif -%}
                                    {%- if video != blank -%}
                                      <span class="blocky-review-video-card__play" aria-hidden="true">
                                        <svg viewBox="0 0 8 10" fill="currentColor" width="8" height="10" xmlns="http://www.w3.org/2000/svg"><polygon points="0,0 8,5 0,10"/></svg>
                                      </span>
                                    {%- endif -%}
                                  </button>
                                </li>
                              {%- endif -%}
                            {%- endfor -%}
                          </ul>
                        </div>
                        {%- if rendered_video_count > 1 -%}
                          <div class="glide__arrows" data-glide-el="controls">
                            <button type="button" class="glide__arrow glide__arrow--prev blocky-product-review__nav blocky-product-review__nav--prev" data-glide-dir="<" aria-label="Previous video">&#8249;</button>
                            <button type="button" class="glide__arrow glide__arrow--next blocky-product-review__nav blocky-product-review__nav--next" data-glide-dir=">" aria-label="Next video">&#8250;</button>
                          </div>
                        {%- endif -%}
                      </blocky-media-slider>
                    {%- endif -%}
                  </div>
                </div>
                {%- if rendered_video_count > 0 -%}
                  <div class="blocky-review-modal" data-review-modal="{{ block.id }}" hidden>
                    <button type="button" class="blocky-review-modal__close" data-review-modal-close aria-label="Close review video">&times;</button>
                    <div class="blocky-review-modal__media">
                      <div class="blocky-review-modal__thumbs" aria-label="Review videos">
                        {%- for i in (1..6) -%}
                          {%- liquid
                            assign video_key = 'video_select_' | append: i
                            assign image_key = 'image_' | append: i
                            assign video = block.settings[video_key]
                            assign fallback_image = block.settings[image_key]
                          -%}
                          {%- if video != blank or fallback_image != blank -%}
                            <button class="blocky-review-modal__thumb" type="button" data-review-modal-thumb="{{ i }}" aria-label="Show review video {{ i }}">
                              {%- if fallback_image != blank -%}
                                <img src="{{ fallback_image | image_url: width: 160 }}" alt="{{ fallback_image.alt | escape }}" loading="lazy" width="80" height="107">
                              {%- elsif video.preview_image != blank -%}
                                <img src="{{ video.preview_image | image_url: width: 160 }}" alt="{{ video.alt | default: block.settings.heading | escape }}" loading="lazy" width="80" height="107">
                              {%- else -%}
                                {{ 'image' | placeholder_svg_tag }}
                              {%- endif -%}
                            </button>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                      <div class="blocky-review-modal__stage">
                        {%- for i in (1..6) -%}
                          {%- liquid
                            assign video_key = 'video_select_' | append: i
                            assign image_key = 'image_' | append: i
                            assign video = block.settings[video_key]
                            assign fallback_image = block.settings[image_key]
                          -%}
                          {%- if video != blank or fallback_image != blank -%}
                            <div class="blocky-review-modal__video-panel" data-review-modal-video="{{ i }}" hidden>
                              {%- if video != blank -%}
                                {{ video | video_tag: controls: false, loop: true, playsinline: true, image_size: '1200x', loading: 'lazy' }}
                              {%- elsif fallback_image != blank -%}
                                <img src="{{ fallback_image | image_url: width: 1200 }}" alt="{{ fallback_image.alt | escape }}" loading="lazy" width="1200" height="1600">
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                      <div class="blocky-review-modal__bottom-products">
                        {%- for i in (1..6) -%}
                          {%- liquid
                            assign collection_key = 'collection_' | append: i
                            assign modal_collection = block.settings[collection_key]
                            if modal_collection == blank
                              assign modal_collection = block.settings.popup_featured_product
                            endif
                          -%}
                          <div class="blocky-review-modal__bottom-panel" data-review-modal-products="{{ i }}" hidden>
                            {%- if modal_collection != blank -%}
                              <a class="blocky-review-modal__view-all" href="{{ modal_collection.url }}">View all products</a>
                            {%- elsif product != blank -%}
                              <a class="blocky-review-modal__view-all" href="{{ product.url }}">View all products</a>
                            {%- endif -%}
                            {%- if modal_collection != blank and modal_collection.products_count > 0 -%}
                              {%- for modal_product in modal_collection.products limit: 6 -%}
                                <a class="blocky-review-modal__bottom-card" href="{{ modal_product.url }}">
                                  {%- if modal_product.featured_image != blank -%}
                                    <img src="{{ modal_product.featured_image | image_url: width: 160 }}" alt="{{ modal_product.featured_image.alt | default: modal_product.title | escape }}" loading="lazy" width="60" height="60">
                                  {%- else -%}
                                    {{ 'product-1' | placeholder_svg_tag }}
                                  {%- endif -%}
                                  <div>
                                    <p class="blocky-review-modal__bottom-title">{{ modal_product.title }}</p>
                                    <p class="blocky-review-modal__bottom-price">{{ modal_product.price | money }}</p>
                                  </div>
                                  <span class="blocky-review-modal__bottom-plus" aria-hidden="true">+</span>
                                </a>
                              {%- endfor -%}
                            {%- elsif product != blank -%}
                              <a class="blocky-review-modal__bottom-card" href="{{ product.url }}">
                                {%- if product.featured_image != blank -%}
                                  <img src="{{ product.featured_image | image_url: width: 160 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="60" height="60">
                                {%- else -%}
                                  {{ 'product-1' | placeholder_svg_tag }}
                                {%- endif -%}
                                <div>
                                  <p class="blocky-review-modal__bottom-title">{{ product.title }}</p>
                                  <p class="blocky-review-modal__bottom-price">{{ product.price | money }}</p>
                                </div>
                                <span class="blocky-review-modal__bottom-plus" aria-hidden="true">+</span>
                              </a>
                            {%- endif -%}
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                    <aside class="blocky-review-modal__products">
                      <h3>Products in video</h3>
                      <div class="blocky-review-modal__product-list">
                        {%- for i in (1..6) -%}
                          {%- liquid
                            assign collection_key = 'collection_' | append: i
                            assign modal_collection = block.settings[collection_key]
                            if modal_collection == blank
                              assign modal_collection = block.settings.popup_featured_product
                            endif
                          -%}
                          <div class="blocky-review-modal__products-panel" data-review-modal-products="{{ i }}" hidden>
                            {%- if modal_collection != blank and modal_collection.products_count > 0 -%}
                              {%- for modal_product in modal_collection.products limit: 6 -%}
                                <div class="blocky-review-modal__product-card">
                                  {%- if modal_product.featured_image != blank -%}
                                    <img src="{{ modal_product.featured_image | image_url: width: 240 }}" alt="{{ modal_product.featured_image.alt | default: modal_product.title | escape }}" loading="lazy" width="88" height="88">
                                  {%- else -%}
                                    {{ 'product-1' | placeholder_svg_tag }}
                                  {%- endif -%}
                                  <div>
                                    <p class="blocky-review-modal__product-title">{{ modal_product.title }}</p>
                                    <p class="blocky-review-modal__product-price">{{ modal_product.price | money }}</p>
                                    <a class="blocky-review-modal__product-button" href="{{ modal_product.url }}">Shop Now</a>
                                  </div>
                                </div>
                              {%- endfor -%}
                            {%- elsif product != blank -%}
                              <div class="blocky-review-modal__product-card">
                                {%- if product.featured_image != blank -%}
                                  <img src="{{ product.featured_image | image_url: width: 240 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="88" height="88">
                                {%- else -%}
                                  {{ 'product-1' | placeholder_svg_tag }}
                                {%- endif -%}
                                <div>
                                  <p class="blocky-review-modal__product-title">{{ product.title }}</p>
                                  <p class="blocky-review-modal__product-price">{{ product.price | money }}</p>
                                  <a class="blocky-review-modal__product-button" href="{{ product.url }}">Shop Now</a>
                                </div>
                              </div>
                            {%- endif -%}
                          </div>
                        {%- endfor -%}
                      </div>
                    </aside>
                  </div>
                {%- endif -%}
              {%- when 'custom_liquid' -%}
                <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
              {%- when 'popup' -%}
                <div class="blocky-popup__opener" style="display: flex; justify-content: {{ block.settings.text_alignment }};" {{ block.shopify_attributes }}>
                  <button
                    type="button"
                    class="blocky-popup__button"
                    data-blocky-popup-open="{{ block.id }}"
                    aria-haspopup="dialog"
                  >
                    {{ block.settings.text | default: block.settings.page.title | escape }}
                  </button>
                </div>
              {%- when 'share' -%}
                {%- assign blocky_share_url = product.url | default: '/' | prepend: request.origin -%}
                <div class="blocky-share" {{ block.shopify_attributes }}>
                  <button
                    type="button"
                    class="blocky-share__button"
                    data-blocky-share
                    data-share-url="{{ blocky_share_url }}"
                    data-share-title="{{ product.title | default: shop.name | escape }}"
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                    <span>{{ block.settings.share_label | default: 'Share' }}</span>
                  </button>
                  <div class="blocky-share__fallback" data-blocky-share-fallback hidden>
                    <input type="text" class="blocky-share__input" data-blocky-share-input value="{{ blocky_share_url }}" readonly onclick="this.select()">
                    <button type="button" class="blocky-share__copy" data-blocky-share-copy>Copy link</button>
                    <span class="blocky-share__success" data-blocky-share-success hidden>Copied!</span>
                  </div>
                </div>
              {%- when 'rating-app' -%}
                {%- if product.metafields.reviews.rating.value != blank -%}
                  {%- liquid
                    assign rating_decimal = 0
                    assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                    if decimal >= 0.3 and decimal <= 0.7
                      assign rating_decimal = 0.5
                    elsif decimal > 0.7
                      assign rating_decimal = 1
                    endif
                  -%}
                  <div class="blocky-rating-wrapper" {{ block.shopify_attributes }}>
                    <div
                      class="blocky-rating"
                      role="img"
                      aria-label="{{ product.metafields.reviews.rating.value }} out of {{ product.metafields.reviews.rating.value.scale_max }} stars"
                    >
                      <span
                        aria-hidden="true"
                        class="blocky-rating-star"
                        style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                      ></span>
                    </div>
                    <p class="blocky-rating-count">
                      <span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>
                    </p>
                  </div>
                {%- endif -%}
              {%- when 'complementary' -%}
                {%- liquid
                  assign comp_ratio = '1 / 1'
                  if block.settings.image_ratio == 'portrait'
                    assign comp_ratio = '3 / 4'
                  endif
                  capture comp_icon
                    if block.settings.icon != blank
                      echo '<span class="blocky-complementary__summary-icon material-symbols-outlined">' | append: block.settings.icon | append: '</span>'
                    endif
                  endcapture
                -%}
                <div
                  class="blocky-complementary"
                  data-blocky-complementary
                  data-product-id="{{ product.id }}"
                  data-limit="{{ block.settings.product_list_limit }}"
                  data-per-page="{{ block.settings.products_per_page }}"
                  data-pagination="{{ block.settings.pagination_style }}"
                  data-quick-add="{% if block.settings.enable_quick_add %}true{% else %}false{% endif %}"
                  data-fallback="true"
                  style="--bky-comp-per-page: {{ block.settings.products_per_page }}; --bky-comp-ratio: {{ comp_ratio }};"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.make_collapsible_row -%}
                    <details open>
                      <summary>
                        <span class="blocky-complementary__summary-title">{{ comp_icon }}{{ block.settings.block_heading }}</span>
                        <svg class="blocky-complementary__summary-caret" viewBox="0 0 10 6" aria-hidden="true" focusable="false"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"></path></svg>
                      </summary>
                      <div data-blocky-complementary-mount></div>
                    </details>
                  {%- else -%}
                    {%- if block.settings.block_heading != blank -%}
                      <h2 class="blocky-complementary__heading">{{ block.settings.block_heading }}</h2>
                    {%- endif -%}
                    <div data-blocky-complementary-mount></div>
                  {%- endif -%}
                </div>
              {%- when 'inventory' -%}
                {%- liquid
                  assign inv_variant = current_variant
                  assign inv_tracked = false
                  if inv_variant.inventory_management == 'shopify'
                    assign inv_tracked = true
                  endif
                  assign inv_justify = 'flex-start'
                  if block.settings.text_alignment == 'center'
                    assign inv_justify = 'center'
                  elsif block.settings.text_alignment == 'right'
                    assign inv_justify = 'flex-end'
                  endif
                -%}
                <p
                  class="blocky-product-inventory{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% endif %}{% unless inv_tracked %} blocky-hidden{% endunless %}"
                  data-blocky-inventory
                  data-inventory-threshold="{{ block.settings.inventory_threshold }}"
                  data-show-quantity="{% if block.settings.show_inventory_quantity %}true{% else %}false{% endif %}"
                  role="status"
                  style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.text_size }}px; justify-content: {{ inv_justify }}; margin-top: {{ block.settings.margin_top }}rem; margin-bottom: {{ block.settings.margin_bottom }}rem;"
                  {{ block.shopify_attributes }}
                >
                  {%- if inv_tracked -%}
                    {%- if inv_variant.inventory_quantity > 0 -%}
                      {%- if inv_variant.inventory_quantity <= block.settings.inventory_threshold -%}
                        <svg class="blocky-product-inventory__dot" width="15" height="15" aria-hidden="true"><circle cx="7.5" cy="7.5" r="7.5" fill="rgba(238,148,65,0.3)"/><circle cx="7.5" cy="7.5" r="5" stroke="#ffffff" stroke-width="1" fill="rgb(238,148,65)"/></svg>
                        <span data-blocky-inventory-text>{% if block.settings.show_inventory_quantity %}Low stock: {{ inv_variant.inventory_quantity }} left{% else %}Low stock{% endif %}</span>
                      {%- else -%}
                        <svg class="blocky-product-inventory__dot" width="15" height="15" aria-hidden="true"><circle cx="7.5" cy="7.5" r="7.5" fill="rgba(62,214,96,0.3)"/><circle cx="7.5" cy="7.5" r="5" stroke="#ffffff" stroke-width="1" fill="rgb(62,214,96)"/></svg>
                        <span data-blocky-inventory-text>{% if block.settings.show_inventory_quantity %}{{ inv_variant.inventory_quantity }} in stock{% else %}In stock{% endif %}</span>
                      {%- endif -%}
                    {%- else -%}
                      {%- if inv_variant.inventory_policy == 'continue' -%}
                        <svg class="blocky-product-inventory__dot" width="15" height="15" aria-hidden="true"><circle cx="7.5" cy="7.5" r="7.5" fill="rgba(62,214,96,0.3)"/><circle cx="7.5" cy="7.5" r="5" stroke="#ffffff" stroke-width="1" fill="rgb(62,214,96)"/></svg>
                        <span data-blocky-inventory-text>In stock</span>
                      {%- else -%}
                        <svg class="blocky-product-inventory__dot" width="15" height="15" aria-hidden="true"><circle cx="7.5" cy="7.5" r="7.5" fill="rgba(200,200,200,0.3)"/><circle cx="7.5" cy="7.5" r="5" stroke="#ffffff" stroke-width="1" fill="rgb(200,200,200)"/></svg>
                        <span data-blocky-inventory-text>Out of stock</span>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endif -%}
                </p>
              {%- when 'sku' -%}
                <p
                  class="blocky-product-sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% endif %}{% if current_variant.sku == blank %} blocky-hidden{% endif %}"
                  data-blocky-sku
                  role="status"
                  style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.text_size }}px; text-align: {{ block.settings.text_alignment }}; margin-top: {{ block.settings.margin_top }}rem; margin-bottom: {{ block.settings.margin_bottom }}rem;"
                  {{ block.shopify_attributes }}
                >
                  <span class="blocky-visually-hidden">SKU:</span>
                  <span data-blocky-sku-text>{{ current_variant.sku }}</span>
                </p>
              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="blocky-product-description{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% endif %}" style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.text_size | default: 14 }}px; text-align: {{ block.settings.text_alignment | default: 'left' }}; margin-top: {{ block.settings.margin_top | default: 0 }}rem; margin-bottom: {{ block.settings.margin_bottom | default: 0 }}rem;{% if block.settings.line_height > 0 %} line-height: {{ block.settings.line_height }};{% endif %}{% if block.settings.letter_spacing != 0 %} letter-spacing: {{ block.settings.letter_spacing }}px;{% endif %}" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {%- endif -%}
              {%- when 'text' -%}
                {%- liquid
                  assign text_content = block.settings.text
                  if text_content == '{{ section.settings.product.vendor }}'
                    assign text_content = product.vendor
                  endif
                -%}
                <div class="blocky-body-text{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% endif %}" style="--body-color: {{ block.settings.text_color }}; --body-font-size: {{ block.settings.text_size }}px; text-align: {{ block.settings.text_alignment | default: 'left' }}; margin-top: {{ block.settings.margin_top | default: 0 }}rem; margin-bottom: {{ block.settings.margin_bottom | default: 0 }}rem;{% if block.settings.line_height > 0 %} line-height: {{ block.settings.line_height }};{% endif %}{% if block.settings.letter_spacing != 0 %} letter-spacing: {{ block.settings.letter_spacing }}px;{% endif %}" {{ block.shopify_attributes }}>
                  {{ text_content }}
                </div>
              {%- when 'title' -%}
                <h2 class="blocky-title" style="--title-color: {{ block.settings.title_color }}; --title-size: {{ block.settings.title_size }};" {{ block.shopify_attributes }}>
                  {%- if product.title != blank -%}{{ product.title | escape }}{%- else -%}Product title{%- endif -%}
                </h2>
              {%- when 'price' -%}
                <div
                  class="blocky-product-price"
                  style="justify-content: {{ block.settings.text_alignment }}; --price-color: {{ block.settings.price_color }}; --compare-price-color: {{ block.settings.compare_price_color }}; --price-size: {{ block.settings.price_size }}px; --price-weight: {% if block.settings.price_bold %}700{% else %}400{% endif %};"
                  {{ block.shopify_attributes }}
                >
                  {%- if current_variant != blank -%}
                    <span data-blocky-current-price>{{ current_variant.price | money }}</span>
                    <s data-blocky-compare-price{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
                    {%- if block.settings.show_sale_badge and current_variant.compare_at_price > current_variant.price -%}
                      <span class="blocky-sale-badge" style="background: {% if block.settings.sale_badge_use_gradient %}{{ block.settings.sale_badge_gradient }}{% else %}{{ block.settings.sale_badge_bg }}{% endif %}; color: {{ block.settings.sale_badge_text_color }}; border-radius: {{ block.settings.sale_badge_border_radius }}px; --bky-sale-badge-size: {{ block.settings.sale_badge_font_size | default: 12 }}px;">{{ block.settings.sale_badge_label }}</span>
                    {%- endif -%}
                  {%- else -%}
                    <span data-blocky-current-price>{{ 0 | money }}</span>
                    <s data-blocky-compare-price hidden>{{ 0 | money }}</s>
                  {%- endif -%}
                </div>
              {%- when 'variant_picker' -%}
                {%- if product != blank and product.has_only_default_variant == false -%}
                  <div
                    class="blocky-product-options"
                    data-blocky-options
                    style="--bky-input-background-color: {{ block.settings.input_background_color | default: '#ffffff' }}; --bky-input-text-color: {{ block.settings.input_text_color | default: '#000000' }}; --bky-input-border-color: {{ block.settings.input_border_color | default: '#d8d8d8' }}; --bky-input-border-radius: {{ block.settings.input_border_radius | default: 6 }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {%- for option in product.options_with_values -%}
                      {%- assign option_index = option.position | minus: 1 -%}
                      {%- assign current_option_value = current_variant.options[option_index] -%}
                      {%- assign option_name = option.name | downcase -%}
                      {%- assign is_color_option = false -%}
                      {%- if option_name contains 'color' or option_name contains 'colour' -%}
                        {%- assign is_color_option = true -%}
                      {%- endif -%}
                      <fieldset class="blocky-product-options">
                        <legend class="blocky-product-option-name">{{ option.name }}</legend>
                        {%- if block.settings.picker_type == 'dropdown' -%}
                          <select class="blocky-product-option-select" data-blocky-option-position="{{ option.position }}">
                            {%- for value in option.values -%}
                              <option value="{{ value | escape }}" {% if current_option_value == value %}selected{% endif %}>{{ value | escape }}</option>
                            {%- endfor -%}
                          </select>
                        {%- else -%}
                          <div class="blocky-product-option-values">
                            {%- for value in option.values -%}
                              {%- liquid
                                assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index
                                assign swatch_color = value | downcase | replace: ' ', ''
                                assign normalized_value = value | strip | downcase
                                assign color_mappings = block.settings.color_swatch_mapping | newline_to_br | split: '<br />'

                                for color_mapping in color_mappings
                                  assign mapping_parts = color_mapping | strip | split: ':'
                                  assign mapping_name = mapping_parts[0] | strip | downcase
                                  assign mapping_color = mapping_parts[1] | strip

                                  if mapping_name == normalized_value and mapping_color != blank
                                    assign swatch_color = mapping_color
                                  endif
                                endfor
                              -%}
                              <input
                                type="radio"
                                id="{{ input_id }}"
                                name="blocky-option-{{ section.id }}-{{ option.position }}"
                                value="{{ value | escape }}"
                                data-blocky-option-position="{{ option.position }}"
                                {% if current_option_value == value %}checked{% endif %}
                              >
                              {%- if is_color_option and block.settings.show_color_swatches -%}
                                <label
                                  class="blocky-product-color-swatch"
                                  for="{{ input_id }}"
                                  title="{{ value | escape }}"
                                  style="--bky-swatch-color: {{ swatch_color | escape }};"
                                >
                                  <span>{{ value | escape }}</span>
                                </label>
                              {%- else -%}
                                <label for="{{ input_id }}">{{ value | escape }}</label>
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                        {%- endif -%}
                      </fieldset>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              {%- when 'quantity_selector' -%}
                <div class="blocky-product-quantity" style="--bky-quantity-color: {{ block.settings.input_text_color | default: '#000000' }}; --bky-quantity-label-size: {{ block.settings.label_size | default: 20 }}px;" {{ block.shopify_attributes }}>
                  <label for="Quantity-{{ section.id }}">Quantity</label>
                  <div class="blocky-product-quantity-control">
                    <button type="button" data-blocky-quantity-minus aria-label="Decrease quantity">
                      <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="none" viewBox="0 0 10 2" width="10" height="10"><path fill-rule="evenodd" clip-rule="evenodd" d="M.5 1C.5.7.7.5 1 .5h8a.5.5 0 110 1H1A.5.5 0 01.5 1z" fill="currentColor"/></svg>
                    </button>
                    <input id="Quantity-{{ section.id }}" type="number" min="1" value="1" data-blocky-quantity-input>
                    <button type="button" data-blocky-quantity-plus aria-label="Increase quantity">
                      <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="none" viewBox="0 0 10 10" width="10" height="10"><path fill-rule="evenodd" clip-rule="evenodd" d="M1 4.51a.5.5 0 000 1h3.5l.01 3.5a.5.5 0 001-.01V5.5l3.5-.01a.5.5 0 00-.01-1H5.5L5.49.99a.5.5 0 00-1 .01v3.5l-3.5.01H1z" fill="currentColor"/></svg>
                    </button>
                  </div>
                </div>
              {%- when 'buy_buttons' -%}
                <div
                  style="margin-top: calc({{ block.settings.margin_top | default: 1.5 }}rem - var(--text-container-gap, 14px)); margin-bottom: calc({{ block.settings.margin_bottom | default: 1.5 }}rem - var(--text-container-gap, 14px)); --bky-buy-button-bg: {{ block.settings.button_background | default: 'transparent' }}; --bky-buy-button-border-color: {{ block.settings.button_border_color | default: '#000000' }}; --bky-buy-button-text-color: {{ block.settings.button_text_color | default: '#000000' }}; --bky-buy-button-height: {{ block.settings.button_height | default: 52 }}px; --bky-buy-button-text-size: {{ block.settings.button_text_size | default: 16 }}px; --bky-dynamic-button-background-color: {{ block.settings.dynamic_button_background_color | default: '#e7cdc8' }}; --bky-dynamic-button-text-color: {{ block.settings.dynamic_button_text_color | default: '#ffffff' }};{% if block.settings.dynamic_button_border_color != blank %} --bky-dynamic-button-border: 1px solid {{ block.settings.dynamic_button_border_color }};{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {%- if product != blank -%}
                    {%- form 'product', product, id: product_form_id, class: 'blocky-product-form' -%}
                      {%- assign bky_buy_price = current_variant.price | money -%}
                      <input type="hidden" name="id" value="{{ current_variant.id }}" data-blocky-variant-id>
                      <input type="hidden" name="quantity" value="1" data-blocky-form-quantity>
                      <div class="blocky-product-buttons">
                        <button
                          type="submit"
                          name="add"
                          class="blocky-product-submit"
                          data-blocky-add-button
                          data-add-text="{{ block.settings.add_to_cart_text | escape }}"
                          data-sold-out-text="{{ block.settings.sold_out_text | escape }}"
                          data-unavailable-text="{{ block.settings.unavailable_text | escape }}"
                          data-cart-action="{{ block.settings.cart_action }}"
                          {% unless current_variant.available %}disabled{% endunless %}
                        >
                          <span data-blocky-add-text>{% if current_variant.available %}{{ block.settings.add_to_cart_text | replace: '[PRICE]', bky_buy_price }}{% else %}{{ block.settings.sold_out_text | replace: '[PRICE]', bky_buy_price }}{% endif %}</span>
                        </button>
                        {%- if block.settings.show_dynamic_checkout -%}
                          {{ form | payment_button }}
                        {%- endif -%}
                      </div>
                    {%- endform -%}
                  {%- else -%}
                    <button class="blocky-product-submit" type="button" disabled>{{ block.settings.add_to_cart_text | replace: '[PRICE]', '' }}</button>
                  {%- endif -%}
                </div>
              {%- when 'icon-with-text' -%}
                <div
                  class="blocky-icon-with-text blocky-icon-with-text--{{ block.settings.layout }}"
                  style="--bky-iwt-icon: {{ block.settings.desktop_icon_size }}px; --bky-iwt-font: {{ block.settings.desktop_font_size }}px; --bky-iwt-mobile-icon: {{ block.settings.mobile_icon_size }}px; --bky-iwt-mobile-font: {{ block.settings.mobile_font_size }}px; --bky-iwt-icon-color: {{ block.settings.icon_color }}; --bky-iwt-text-color: {{ block.settings.text_color }};"
                  {{ block.shopify_attributes }}
                >
                  {%- for i in (1..4) -%}
                    {%- liquid
                      assign icon_key = 'icon_' | append: i
                      assign image_key = 'image_' | append: i
                      assign heading_key = 'heading_' | append: i
                      assign iwt_icon = block.settings[icon_key]
                      assign iwt_image = block.settings[image_key]
                      assign iwt_heading = block.settings[heading_key]
                    -%}
                    {%- if iwt_heading != blank or iwt_image != blank or iwt_icon != blank -%}
                      <div class="blocky-icon-with-text__item">
                        {%- if iwt_image != blank -%}
                          <img src="{{ iwt_image | image_url: width: 120 }}" alt="" loading="lazy" width="40" height="40">
                        {%- elsif iwt_icon != blank -%}
                          <span class="blocky-icon-with-text__icon material-symbols-outlined">{{ iwt_icon }}</span>
                        {%- endif -%}
                        {%- if iwt_heading != blank -%}<span class="blocky-icon-with-text__heading">{{ iwt_heading }}</span>{%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- when 'collapsible_tab' -%}
                <div class="blocky-product-collapsible" style="--bky-collapsible-heading-size: {{ block.settings.heading_size }}px; --bky-collapsible-content-size: {{ block.settings.content_size }}px; --bky-row-pad: {{ block.settings.row_padding | default: 12 }}px;{% if block.settings.bg_color != blank %} --bky-collapsible-bg: {{ block.settings.bg_color }}; --bky-collapsible-pad-x: 12px;{% endif %}{% if block.settings.text_color != blank %} --bky-collapsible-text: {{ block.settings.text_color }};{% endif %}{% if block.settings.letter_spacing != 0 %} --bky-ls: {{ block.settings.letter_spacing }}px;{% endif %}" {{ block.shopify_attributes }}>
                  <details {% if block.settings.open_by_default %}open{% endif %}>
                    <summary>
                      {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                        <span class="blocky-product-collapsible__icon material-symbols-outlined">{{ block.settings.icon }}</span>
                      {%- endif -%}
                      <span class="blocky-product-collapsible__heading">{{ block.settings.heading | default: block.settings.page.title | escape }}</span>
                      <svg aria-hidden="true" focusable="false" class="blocky-product-collapsible__caret icon icon-caret" viewBox="0 0 10 6"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"></path></svg>
                    </summary>
                    <div class="blocky-product-collapsible__content">
                      {{ block.settings.content }}
                      {{ block.settings.page.content }}
                    </div>
                  </details>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  {%- assign blocky_popups = section.blocks | where: 'type', 'popup' -%}
  {%- for block in blocky_popups -%}
    <div class="blocky-popup-modal" data-blocky-popup="{{ block.id }}" {{ block.shopify_attributes }}>
      <div class="blocky-popup-modal__content" role="dialog" aria-label="{{ block.settings.text | escape }}" aria-modal="true" tabindex="-1">
        <button type="button" class="blocky-popup-modal__toggle" data-blocky-popup-close aria-label="Close">
          <svg viewBox="0 0 18 17" fill="none" aria-hidden="true" focusable="false"><path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.433 7.433 7.433a.5.5 0 00.707-.707L9.712 8.545l7.433-7.433A.5.5 0 0016.438.405L9.005 7.838 1.572.405A.5.5 0 00.865 1.112l7.433 7.433-7.433 7.433z" fill="currentColor"></path></svg>
        </button>
        <div class="blocky-popup-modal__content-info">
          {%- if block.settings.page.title != blank -%}<h2>{{ block.settings.page.title | escape }}</h2>{%- endif -%}
          {{ block.settings.page.content }}
        </div>
      </div>
    </div>
  {%- endfor -%}

  <script type="application/json" data-blocky-product-json>
    {%- if product != blank -%}
      {
        "selected_variant_id": {{ current_variant.id | json }},
        "variants": [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id | json }},
              "options": {{ variant.options | json }},
              "available": {{ variant.available | json }},
              "price": {{ variant.price | json }},
              "compare_at_price": {{ variant.compare_at_price | json }},
              "sku": {{ variant.sku | json }},
              "inventory_management": {{ variant.inventory_management | json }},
              "inventory_policy": {{ variant.inventory_policy | json }},
              "inventory_quantity": {{ variant.inventory_quantity | json }},
              "featured_media_id": {%- if variant.featured_media -%}{{ variant.featured_media.id | json }}{%- else -%}null{%- endif -%}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    {%- else -%}
      { "selected_variant_id": null, "variants": [] }
    {%- endif %}
  </script>
</blocky-featured-product>

<script>
  if (!customElements.get('blocky-featured-product')) {
    customElements.define('blocky-featured-product', class extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return;
        this.initialized = true;

        try {
          this.product = JSON.parse(this.querySelector('[data-blocky-product-json]')?.textContent || '{}') || {};
        } catch (error) {
          this.product = {};
        }

        this.moneyFormat = {{ shop.money_format | json }};
        this.mediaByVariant = {};

        (this.product.variants || []).forEach((variant) => {
          const mediaId = variant.featured_media_id || variant.featured_media?.id;
          if (mediaId) {
            this.mediaByVariant[variant.id] = mediaId.toString();
          }
        });

        this.addEventListener('click', (event) => {
          const thumb = event.target.closest('[data-blocky-product-thumb]');
          if (thumb) this.activateMedia(thumb.dataset.blockyProductThumb);
        });

        this.initBeforeAfterButtons();
        this.initScrollToButtons();
        this.initReviewCarouselModals();
        this.initPopupModals();
        this.initShareButtons();
        this.initComplementary();

        this.querySelectorAll('[data-blocky-option-position]').forEach((input) => {
          input.addEventListener('change', () => this.updateVariant());
        });

        this.querySelector('[data-blocky-quantity-minus]')?.addEventListener('click', () => this.changeQuantity(-1));
        this.querySelector('[data-blocky-quantity-plus]')?.addEventListener('click', () => this.changeQuantity(1));
        this.querySelector('[data-blocky-quantity-input]')?.addEventListener('input', () => this.syncQuantity());
        this.querySelectorAll('.blocky-product-form').forEach((form) => {
          form.addEventListener('submit', (event) => this.handleAddToCart(event));
        });

        this.syncQuantity();
        this.updateVariant();
      }

      initBeforeAfterButtons() {
        this.querySelectorAll('.before_after_dual_btn_wrapper').forEach((btnWrapper) => {
          const mediaItems = Array.from(this.querySelectorAll('[data-blocky-product-media]'));

          btnWrapper.querySelectorAll('.before_after_btn').forEach((btn) => {
            btn.addEventListener('click', (event) => {
              event.preventDefault();

              const targetIndex = Number(btn.dataset.index);
              const targetMedia = mediaItems[targetIndex];
              if (!targetMedia) return;

              this.activateMedia(targetMedia.dataset.blockyProductMedia);

              btnWrapper.querySelectorAll('.before_after_btn').forEach((button) => button.classList.remove('active'));
              btn.classList.add('active');
            });
          });
        });
      }

      initReviewCarouselModals() {
        this.querySelectorAll('[data-review-modal-open]').forEach((button) => {
          button.addEventListener('click', () => {
            const modal = this.querySelector(`[data-review-modal="${button.dataset.reviewModalOpen}"]`);
            if (!modal) return;

            this.openReviewModal(modal, button.dataset.reviewModalIndex);
          });
        });

        this.querySelectorAll('[data-review-modal]').forEach((modal) => {
          modal.querySelector('[data-review-modal-close]')?.addEventListener('click', () => this.closeReviewModal(modal));

          modal.addEventListener('click', (event) => {
            if (event.target === modal) this.closeReviewModal(modal);
          });

          modal.querySelectorAll('[data-review-modal-video]').forEach((panel) => {
            panel.addEventListener('click', () => this.toggleReviewModalVideo(panel));
          });

          modal.querySelectorAll('[data-review-modal-thumb]').forEach((thumb) => {
            thumb.addEventListener('click', () => this.selectReviewModalVideo(modal, thumb.dataset.reviewModalThumb));
          });
        });

        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;

          this.querySelectorAll('[data-review-modal]:not([hidden])').forEach((modal) => this.closeReviewModal(modal));
        });
      }

      openReviewModal(modal, index) {
        modal.hidden = false;
        document.documentElement.style.overflow = 'hidden';
        this.selectReviewModalVideo(modal, index);
        modal.querySelector('[data-review-modal-close]')?.focus();
      }

      closeReviewModal(modal) {
        modal.hidden = true;
        modal.querySelectorAll('video').forEach((video) => video.pause());

        if (!document.querySelector('[data-review-modal]:not([hidden])')) {
          document.documentElement.style.overflow = '';
        }
      }

      selectReviewModalVideo(modal, index) {
        modal.querySelectorAll('video').forEach((video) => video.pause());

        modal.querySelectorAll('[data-review-modal-video]').forEach((panel) => {
          const active = panel.dataset.reviewModalVideo === String(index);
          panel.hidden = !active;
          if (active) {
            const video = panel.querySelector('video');
            if (video) video.play().catch(() => {});
          }
        });

        modal.querySelectorAll('[data-review-modal-products]').forEach((panel) => {
          panel.hidden = panel.dataset.reviewModalProducts !== String(index);
        });

        modal.querySelectorAll('[data-review-modal-thumb]').forEach((thumb) => {
          thumb.classList.toggle('is-active', thumb.dataset.reviewModalThumb === String(index));
        });
      }

      toggleReviewModalVideo(panel) {
        const video = panel.querySelector('video');
        if (!video) return;

        if (video.paused) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      }

      initPopupModals() {
        this.querySelectorAll('[data-blocky-popup-open]').forEach((button) => {
          button.addEventListener('click', () => {
            const modal = this.querySelector(`[data-blocky-popup="${button.dataset.blockyPopupOpen}"]`);
            if (modal) this.openPopupModal(modal);
          });
        });

        this.querySelectorAll('[data-blocky-popup]').forEach((modal) => {
          modal.querySelector('[data-blocky-popup-close]')?.addEventListener('click', () => this.closePopupModal(modal));
          modal.addEventListener('click', (event) => {
            if (event.target === modal) this.closePopupModal(modal);
          });
        });

        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          this.querySelectorAll('[data-blocky-popup][open]').forEach((modal) => this.closePopupModal(modal));
        });
      }

      openPopupModal(modal) {
        modal.setAttribute('open', '');
        document.documentElement.style.overflow = 'hidden';
        modal.querySelector('[data-blocky-popup-close]')?.focus();
      }

      closePopupModal(modal) {
        modal.removeAttribute('open');
        if (!document.querySelector('[data-blocky-popup][open]')) {
          document.documentElement.style.overflow = '';
        }
      }

      initShareButtons() {
        this.querySelectorAll('[data-blocky-share]').forEach((button) => {
          const wrapper = button.closest('.blocky-share');
          const fallback = wrapper?.querySelector('[data-blocky-share-fallback]');

          button.addEventListener('click', async () => {
            const shareData = { title: button.dataset.shareTitle, url: button.dataset.shareUrl };
            if (navigator.share) {
              try {
                await navigator.share(shareData);
                return;
              } catch (error) {
                if (error && error.name === 'AbortError') return;
              }
            }
            if (fallback) fallback.hidden = !fallback.hidden;
          });

          wrapper?.querySelector('[data-blocky-share-copy]')?.addEventListener('click', () => {
            const input = wrapper.querySelector('[data-blocky-share-input]');
            const success = wrapper.querySelector('[data-blocky-share-success]');
            if (!input) return;

            const done = () => {
              if (!success) return;
              success.hidden = false;
              setTimeout(() => { success.hidden = true; }, 2000);
            };

            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(input.value).then(done).catch(() => {
                input.select();
                document.execCommand('copy');
                done();
              });
            } else {
              input.select();
              document.execCommand('copy');
              done();
            }
          });
        });
      }

      initComplementary() {
        const block = this.querySelector('[data-blocky-complementary]');
        if (!block) return;

        const mount = block.querySelector('[data-blocky-complementary-mount]');
        const productId = block.dataset.productId;
        const limit = Number(block.dataset.limit) || 10;
        const perPage = Math.max(1, Number(block.dataset.perPage) || 3);
        const pagination = block.dataset.pagination || 'counter';
        const quickAdd = block.dataset.quickAdd === 'true';
        const fallback = block.dataset.fallback === 'true';
        if (!mount || !productId) return;

        const esc = (value) => String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');

        const sized = (url) => {
          if (!url) return '';
          return url + (url.indexOf('?') === -1 ? '?' : '&') + 'width=400';
        };

        const buildCard = (item) => {
          const image = sized(item.featured_image || (item.images && item.images[0]) || '');
          const media = image ? `<img src="${esc(image)}" alt="${esc(item.title)}" loading="lazy">` : '';
          let quickAddHtml = '';
          if (quickAdd) {
            const variants = item.variants || [];
            if (variants.length > 1) {
              quickAddHtml = `<a class="blocky-complementary__quick-add" href="${esc(item.url)}">Choose options</a>`;
            } else if (variants.length === 1 && variants[0].available) {
              quickAddHtml = `<button type="button" class="blocky-complementary__quick-add" data-comp-add="${variants[0].id}">Add to cart</button>`;
            } else {
              quickAddHtml = `<button type="button" class="blocky-complementary__quick-add" disabled>Sold out</button>`;
            }
          }
          return `<div class="blocky-complementary__card"><a class="blocky-complementary__link" href="${esc(item.url)}"><div class="blocky-complementary__media">${media}</div><p class="blocky-complementary__title">${esc(item.title)}</p><p class="blocky-complementary__price">${this.formatMoney(item.price)}</p></a>${quickAddHtml}</div>`;
        };

        const render = (products) => {
          const list = (products || []).slice(0, limit);
          if (!list.length) {
            block.hidden = true;
            return;
          }

          const slides = [];
          for (let i = 0; i < list.length; i += perPage) {
            slides.push(list.slice(i, i + perPage));
          }

          const slidesHtml = slides.map((group) => `<div class="blocky-complementary__slide"><div class="blocky-complementary__grid">${group.map(buildCard).join('')}</div></div>`).join('');

          let navHtml = '';
          if (slides.length > 1) {
            let pagHtml = '';
            if (pagination === 'counter') {
              pagHtml = `<div class="blocky-complementary__pagination"><span data-comp-current>1</span><span>/</span><span>${slides.length}</span></div>`;
            } else if (pagination === 'numbers') {
              pagHtml = `<div class="blocky-complementary__pagination">${slides.map((group, i) => `<button type="button" class="blocky-complementary__num${i === 0 ? ' is-active' : ''}" data-comp-goto="${i}">${i + 1}</button>`).join('')}</div>`;
            } else {
              pagHtml = `<div class="blocky-complementary__pagination">${slides.map((group, i) => `<button type="button" class="blocky-complementary__dot${i === 0 ? ' is-active' : ''}" data-comp-goto="${i}" aria-label="Go to slide ${i + 1}"></button>`).join('')}</div>`;
            }
            navHtml = `<div class="blocky-complementary__nav"><button type="button" class="blocky-complementary__arrow" data-comp-prev aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg></button>${pagHtml}<button type="button" class="blocky-complementary__arrow" data-comp-next aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg></button></div>`;
          }

          mount.innerHTML = `<div class="blocky-complementary__slider"><div class="blocky-complementary__track" data-comp-track>${slidesHtml}</div>${navHtml}</div>`;

          this.initComplementarySlider(mount, slides.length);
          if (quickAdd) this.initComplementaryQuickAdd(mount);
        };

        const fetchRecs = (intent) => fetch(`/recommendations/products.json?product_id=${productId}&limit=${limit}&intent=${intent}`)
          .then((response) => (response.ok ? response.json() : { products: [] }))
          .then((data) => (data && data.products) || []);

        fetchRecs('complementary').then((products) => {
          if (products.length) {
            render(products);
          } else if (fallback) {
            fetchRecs('related').then(render);
          } else {
            block.hidden = true;
          }
        }).catch(() => {
          block.hidden = true;
        });
      }

      initComplementarySlider(mount, count) {
        const track = mount.querySelector('[data-comp-track]');
        if (!track || count <= 1) return;

        let index = 0;
        const update = () => {
          const current = mount.querySelector('[data-comp-current]');
          if (current) current.textContent = String(index + 1);
          mount.querySelectorAll('[data-comp-goto]').forEach((dot, i) => dot.classList.toggle('is-active', i === index));
          const prev = mount.querySelector('[data-comp-prev]');
          const next = mount.querySelector('[data-comp-next]');
          if (prev) prev.disabled = index <= 0;
          if (next) next.disabled = index >= count - 1;
        };

        const goTo = (target) => {
          index = Math.max(0, Math.min(count - 1, target));
          track.scrollTo({ left: track.clientWidth * index, behavior: 'smooth' });
          update();
        };

        mount.querySelector('[data-comp-prev]')?.addEventListener('click', () => goTo(index - 1));
        mount.querySelector('[data-comp-next]')?.addEventListener('click', () => goTo(index + 1));
        mount.querySelectorAll('[data-comp-goto]').forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

        let scrollTimer;
        track.addEventListener('scroll', () => {
          clearTimeout(scrollTimer);
          scrollTimer = setTimeout(() => {
            const i = Math.round(track.scrollLeft / track.clientWidth);
            if (i !== index) {
              index = i;
              update();
            }
          }, 80);
        });

        update();
      }

      initComplementaryQuickAdd(mount) {
        mount.querySelectorAll('[data-comp-add]').forEach((button) => {
          button.addEventListener('click', async (event) => {
            event.preventDefault();
            if (button.disabled) return;

            const original = button.textContent;
            button.disabled = true;
            try {
              const formData = new FormData();
              formData.append('id', button.dataset.compAdd);
              formData.append('quantity', '1');
              await this.openCartDrawer(formData, '');
              button.textContent = 'Added';
              setTimeout(() => {
                button.textContent = original;
                button.disabled = false;
              }, 1500);
            } catch (error) {
              button.textContent = original;
              button.disabled = false;
            }
          });
        });
      }

      initScrollToButtons() {
        this.querySelectorAll('.blocky-scroll-to-btn').forEach((button) => {
          button.addEventListener('click', () => {
            const buttonIndex = button.dataset.btn;
            const target = document.getElementById(`blocky-scroll-to-target-${buttonIndex}`)
              || document.getElementById(`scroll-to-${buttonIndex}`)
              || document.querySelector(`[data-scroll-to-target="${buttonIndex}"], [data-btn-target="${buttonIndex}"]`);
            if (!target) return;

            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        });
      }

      getSelectedOptions() {
        return [1, 2, 3].map((position) => {
          const checked = this.querySelector(`[data-blocky-option-position="${position}"]:checked`);
          const select = this.querySelector(`select[data-blocky-option-position="${position}"]`);
          return checked?.value || select?.value;
        }).filter(Boolean);
      }

      getSelectedVariant() {
        const variants = this.product.variants || [];
        const selectedOptions = this.getSelectedOptions();
        if (!selectedOptions.length) return this.getDefaultVariant();

        return variants.find((variant) => {
          const variantOptions = variant.options || [variant.option1, variant.option2, variant.option3].filter(Boolean);
          if (variantOptions.length !== selectedOptions.length) return false;

          return variantOptions.every((option, index) => {
            return this.normalizeOption(option) === this.normalizeOption(selectedOptions[index]);
          });
        }) || this.getDefaultVariant();
      }

      getDefaultVariant() {
        const variants = this.product.variants || [];
        const selectedVariantId = String(this.product.selected_variant_id || '');
        return variants.find((variant) => String(variant.id) === selectedVariantId) || variants.find((variant) => variant.available) || variants[0];
      }

      normalizeOption(value) {
        return String(value || '').trim();
      }

      updateOptionAvailability() {
        const variants = this.product.variants || [];
        const selectedOptions = this.getSelectedOptions();
        if (!variants.length || !selectedOptions.length) return;

        this.querySelectorAll('[data-blocky-option-position]').forEach((input) => {
          const position = Number(input.dataset.blockyOptionPosition || 0);
          if (!position) return;

          if (input.tagName === 'SELECT') {
            Array.from(input.options).forEach((option) => {
              const candidateOptions = [...selectedOptions];
              candidateOptions[position - 1] = option.value;
              option.classList.toggle('is-sold-out', !this.hasAvailableVariant(candidateOptions));
            });
            return;
          }

          const candidateOptions = [...selectedOptions];
          candidateOptions[position - 1] = input.value;

          input.classList.toggle('is-sold-out', !this.hasAvailableVariant(candidateOptions));
        });
      }

      hasAvailableVariant(candidateOptions) {
        return (this.product.variants || []).some((variant) => {
          if (!variant.available) return false;

          const variantOptions = variant.options || [variant.option1, variant.option2, variant.option3].filter(Boolean);
          return candidateOptions.every((option, index) => {
            return this.normalizeOption(option) === this.normalizeOption(variantOptions[index]);
          });
        });
      }

      updateVariant() {
        if (!(this.product.variants || []).length) return;

        this.updateOptionAvailability();

        const variant = this.getSelectedVariant();
        if (!variant) {
          this.setUnavailableState();
          return;
        }

        const variantInput = this.querySelector('[data-blocky-variant-id]');
        if (variantInput) variantInput.value = variant.id;

        const price = this.querySelector('[data-blocky-current-price]');
        const compare = this.querySelector('[data-blocky-compare-price]');
        if (price) price.textContent = this.formatMoney(variant.price);
        if (compare) {
          compare.textContent = this.formatMoney(variant.compare_at_price || 0);
          compare.hidden = !(variant.compare_at_price && variant.compare_at_price > variant.price);
        }

        const addButton = this.querySelector('[data-blocky-add-button]');
        const addText = this.querySelector('[data-blocky-add-text]');
        const paymentButton = this.querySelector('.shopify-payment-button');
        if (addButton) addButton.disabled = !variant.available;
        if (addText && addButton) addText.innerHTML = (variant.available ? addButton.dataset.addText : addButton.dataset.soldOutText).replace(/\[PRICE\]/g, this.formatMoney(variant.price));
        if (paymentButton) paymentButton.hidden = !variant.available;

        const mediaId = this.mediaByVariant[variant.id];
        if (mediaId) this.activateMedia(mediaId);

        this.updateInventory(variant);
        this.updateSku(variant);
      }

      updateInventory(variant) {
        const element = this.querySelector('[data-blocky-inventory]');
        if (!element) return;

        if (!variant || variant.inventory_management !== 'shopify') {
          element.classList.add('blocky-hidden');
          return;
        }

        const threshold = Number(element.dataset.inventoryThreshold || 0);
        const showQuantity = element.dataset.showQuantity === 'true';
        const quantity = Number(variant.inventory_quantity || 0);

        let color;
        let text;
        if (quantity > 0) {
          if (quantity <= threshold) {
            color = 'rgb(238,148,65)';
            text = showQuantity ? `Low stock: ${quantity} left` : 'Low stock';
          } else {
            color = 'rgb(62,214,96)';
            text = showQuantity ? `${quantity} in stock` : 'In stock';
          }
        } else if (variant.inventory_policy === 'continue') {
          color = 'rgb(62,214,96)';
          text = 'In stock';
        } else {
          color = 'rgb(200,200,200)';
          text = 'Out of stock';
        }

        const faded = color.replace('rgb(', 'rgba(').replace(')', ',0.3)');
        element.classList.remove('blocky-hidden');
        element.innerHTML = `<svg class="blocky-product-inventory__dot" width="15" height="15" aria-hidden="true"><circle cx="7.5" cy="7.5" r="7.5" fill="${faded}"/><circle cx="7.5" cy="7.5" r="5" stroke="#ffffff" stroke-width="1" fill="${color}"/></svg><span data-blocky-inventory-text>${text}</span>`;
      }

      updateSku(variant) {
        const element = this.querySelector('[data-blocky-sku]');
        if (!element) return;

        const text = element.querySelector('[data-blocky-sku-text]');
        const sku = variant && variant.sku ? variant.sku : '';
        if (text) text.textContent = sku;
        element.classList.toggle('blocky-hidden', !sku);
      }

      setUnavailableState() {
        const variantInput = this.querySelector('[data-blocky-variant-id]');
        if (variantInput) variantInput.value = '';

        const addButton = this.querySelector('[data-blocky-add-button]');
        const addText = this.querySelector('[data-blocky-add-text]');
        const paymentButton = this.querySelector('.shopify-payment-button');
        if (addButton) addButton.disabled = true;
        if (addText && addButton) addText.innerHTML = (addButton.dataset.unavailableText || addButton.dataset.soldOutText || 'Unavailable').replace(/\[PRICE\]/g, '');
        if (paymentButton) paymentButton.hidden = true;
      }

      activateMedia(mediaId) {
        if (!this.querySelector(`[data-blocky-product-media="${mediaId}"]`)) return;

        this.querySelectorAll('[data-blocky-product-media]').forEach((media) => {
          media.classList.toggle('is-active', media.dataset.blockyProductMedia === mediaId);
        });

        this.querySelectorAll('[data-blocky-product-thumb]').forEach((thumb) => {
          const active = thumb.dataset.blockyProductThumb === mediaId;
          thumb.classList.toggle('is-active', active);
          thumb.setAttribute('aria-current', active ? 'true' : 'false');
        });
      }

      changeQuantity(delta) {
        const input = this.querySelector('[data-blocky-quantity-input]');
        if (!input) return;

        input.value = Math.max(1, Number(input.value || 1) + delta);
        this.syncQuantity();
      }

      syncQuantity() {
        const input = this.querySelector('[data-blocky-quantity-input]');
        const formQuantity = this.querySelector('[data-blocky-form-quantity]');
        if (!input || !formQuantity) return;

        formQuantity.value = Math.max(1, Number(input.value || 1));
      }

      async handleAddToCart(event) {
        const form = event.currentTarget;
        const addButton = form.querySelector('[data-blocky-add-button]');
        const action = addButton?.dataset.cartAction || 'cart_drawer';

        if (!form || !addButton || addButton.disabled) return;
        event.preventDefault();

        this.syncQuantity();
        addButton.disabled = true;

        try {
          if (action === 'go_to_cart') {
            await this.addToCart(new FormData(form));
            window.location.href = {{ routes.cart_url | json }};
            return;
          }

          if (action === 'go_to_checkout') {
            await this.addToCart(new FormData(form));
            window.location.href = '/checkout';
            return;
          }

          if (action === 'ajax') {
            await this.addToCart(new FormData(form));
            await this.fetchCart();
            return;
          }

          await this.openCartDrawer(new FormData(form), form.getAttribute('id') || '');
        } catch (error) {
          console.error(error);
          if (action === 'cart_drawer') {
            window.location.href = {{ routes.cart_url | json }};
          }
        } finally {
          const variant = this.getSelectedVariant();
          addButton.disabled = !variant?.available;
        }
      }

      async openCartDrawer(formData, sourceId) {
        const cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');

        if (cart?.renderContents) {
          const sections = cart.getSectionsToRender?.().map((section) => section.id).join(',') || 'cart-drawer,cart-icon-bubble';
          formData.append('sections', sections);
          formData.append('sections_url', window.location.pathname);

          const data = await this.addToCart(formData);
          cart.classList.remove('is-empty');
          cart.renderContents(data);
          return;
        }

        const drawer = document.querySelector('cart-drawer-component');
        if (!drawer) {
          window.location.href = {{ routes.cart_url | json }};
          return;
        }

        const sectionIds = this.getCartSectionIds();
        if (sectionIds.length) formData.append('sections', sectionIds.join(','));

        const data = await this.addToCart(formData);
        drawer.classList.remove('cart-drawer--empty');
        document.dispatchEvent(new CustomEvent('cart:update', {
          bubbles: true,
          detail: {
            resource: data,
            sourceId: sourceId || '',
            data: {
              source: 'product-form-component',
              itemCount: Number(formData.get('quantity')) || 1,
              sections: data.sections
            }
          }
        }));
        if (typeof drawer.open !== 'function') {
          window.location.href = {{ routes.cart_url | json }};
          return;
        }

        drawer.open();
      }

      getCartSectionIds() {
        return Array.from(document.querySelectorAll('cart-items-component'))
          .map((item) => item.dataset.sectionId)
          .filter(Boolean);
      }

      async addToCart(formData) {
        const response = await fetch({{ routes.cart_add_url | append: '.js' | json }}, {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json'
          }
        });
        const data = await response.json();
        if (!response.ok || data.status) throw data;
        return data;
      }

      async fetchCart() {
        const response = await fetch({{ routes.cart_url | append: '.js' | json }}, {
          headers: {
            Accept: 'application/json'
          }
        });
        const data = await response.json();
        if (!response.ok) throw data;
        return data;
      }

      formatMoney(cents) {
        if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
          return window.Shopify.formatMoney(cents, this.moneyFormat);
        }

        return (cents / 100).toLocaleString(undefined, { style: 'currency', currency: {{ cart.currency.iso_code | json }} });
      }
    });
  }

  if (!customElements.get('blocky-timer')) {
    customElements.define('blocky-timer', class extends HTMLElement {
      static get observedAttributes() {
        return ['data-text', 'data-hours', 'data-minutes'];
      }

      connectedCallback() {
        this.start();
      }

      attributeChangedCallback() {
        if (this.isConnected) this.start();
      }

      disconnectedCallback() {
        if (this.interval) clearInterval(this.interval);
      }

      start() {
        if (this.interval) clearInterval(this.interval);

        this.template = this.dataset.text || '';
        const hours = parseInt(this.dataset.hours, 10) || 0;
        const minutes = parseInt(this.dataset.minutes, 10) || 0;
        this.remaining = (hours * 3600) + (minutes * 60);
        this.output = this.querySelector('.blocky-timer-text');

        this.render();
        this.interval = setInterval(() => this.tick(), 1000);
      }

      tick() {
        if (this.remaining <= 0) {
          clearInterval(this.interval);
          return;
        }
        this.remaining -= 1;
        this.render();
      }

      render() {
        if (!this.output) return;
        const h = Math.floor(this.remaining / 3600);
        const m = Math.floor((this.remaining % 3600) / 60);
        const s = this.remaining % 60;
        this.output.innerHTML = this.template
          .replace(/\[HOURS\]/g, h)
          .replace(/\[MINUTES\]/g, m)
          .replace(/\[SECONDS\]/g, s);
      }
    });
  }

  if (!customElements.get('blocky-countdown-timer')) {
    customElements.define('blocky-countdown-timer', class extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return;
        this.initialized = true;

        this.start();
        this.boundStart = () => this.start();
        document.addEventListener('shopify:section:load', this.boundStart);
      }

      disconnectedCallback() {
        if (this.interval) clearInterval(this.interval);
        if (this.boundStart) document.removeEventListener('shopify:section:load', this.boundStart);
      }

      getStorage(resetScope) {
        try {
          return resetScope === 'session' ? window.sessionStorage : window.localStorage;
        } catch (error) {
          return null;
        }
      }

      getEndTimestamp() {
        const mode = this.dataset.mode;
        const hours = parseFloat(this.dataset.hours) || 4;
        const fixedEnd = this.dataset.fixedEnd;

        if (mode === 'fixed') {
          if (!fixedEnd) return null;
          return new Date(fixedEnd.replace(' ', 'T')).getTime() || null;
        }

        const resetScope = this.dataset.resetScope;
        const storage = this.getStorage(resetScope);
        const storageKey = 'blocky-countdown-deals:' + this.dataset.id + ':' + hours;

        if (storage) {
          const stored = parseInt(storage.getItem(storageKey), 10);
          if (!isNaN(stored) && stored > Date.now()) return stored;
        }

        const endTimestamp = Date.now() + (hours * 60 * 60 * 1000);
        if (storage) {
          try {
            storage.setItem(storageKey, String(endTimestamp));
          } catch (error) {}
        }
        return endTimestamp;
      }

      start() {
        if (this.interval) clearInterval(this.interval);

        const endTimestamp = this.getEndTimestamp();
        if (!endTimestamp) return;

        const pad = (value) => String(Math.max(0, value)).padStart(2, '0');
        const daysEl = this.querySelector('[data-cd-days]');
        const hoursEl = this.querySelector('[data-cd-hours]');
        const minutesEl = this.querySelector('[data-cd-minutes]');
        const secondsEl = this.querySelector('[data-cd-seconds]');

        const render = () => {
          const secondsRemaining = Math.max(0, Math.floor((endTimestamp - Date.now()) / 1000));
          let secondsLeftToDistribute = secondsRemaining;

          if (daysEl) {
            const days = Math.floor(secondsLeftToDistribute / 86400);
            secondsLeftToDistribute -= days * 86400;
            daysEl.textContent = pad(days);
          }
          if (hoursEl) {
            const hoursLeft = Math.floor(secondsLeftToDistribute / 3600);
            secondsLeftToDistribute -= hoursLeft * 3600;
            hoursEl.textContent = pad(hoursLeft);
          }
          if (minutesEl) {
            const minutesLeft = Math.floor(secondsLeftToDistribute / 60);
            secondsLeftToDistribute -= minutesLeft * 60;
            minutesEl.textContent = pad(minutesLeft);
          }
          if (secondsEl) {
            secondsEl.textContent = pad(secondsLeftToDistribute);
          }

          return secondsRemaining > 0;
        };

        if (!render()) return;
        this.interval = setInterval(() => {
          if (!render()) clearInterval(this.interval);
        }, 1000);
      }
    });
  }

  if (!customElements.get('blocky-bundle-deals')) {
    customElements.define('blocky-bundle-deals', class extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return;
        this.initialized = true;

        this.addEventListener('click', (event) => {
          const card = event.target.closest('.blocky-bd-card');
          if (card) this.selectCard(card);
        });

        const preselected = this.querySelector('.blocky-bd-card.is-selected');
        if (preselected) this.applyQuantity(preselected);
      }

      selectCard(card) {
        this.querySelectorAll('.blocky-bd-card').forEach((item) => {
          item.classList.toggle('is-selected', item === card);
        });
        this.applyQuantity(card);
      }

      applyQuantity(card) {
        const quantity = Math.max(1, parseInt(card.dataset.bdQuantity, 10) || 1);
        const root = this.closest('blocky-featured-product');
        if (!root) return;

        const quantityInput = root.querySelector('[data-blocky-quantity-input]');
        if (quantityInput) {
          quantityInput.value = quantity;
          quantityInput.dispatchEvent(new Event('input', { bubbles: true }));
          return;
        }

        const formQuantity = root.querySelector('[data-blocky-form-quantity]');
        if (formQuantity) formQuantity.value = quantity;
      }
    });
  }
</script>

