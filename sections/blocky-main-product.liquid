{% endcomment %}

<link href="https://cdn.jsdelivr.net/npm/glidejs@2.1.0/dist/css/glide.core.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@glidejs/glide" defer></script>
<script src="{{ 'blocky-image-video-slider.js' | asset_url }}" defer></script>

{%- liquid
  assign current_template_product = product
  assign selected_product = section.settings.product

  if section.settings.product_source == 'current' and current_template_product != blank
    assign product = current_template_product
  else
    assign product = selected_product
  endif

  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign media_ratio = '1 / 1'
  case section.settings.media_aspect_ratio
    when 'adapt'
      if product != blank and product.featured_media.preview_image
        assign media_ratio = product.featured_media.preview_image.aspect_ratio
      endif
    when 'portrait'
      assign media_ratio = '4 / 5'
    when 'landscape'
      assign media_ratio = '4 / 3'
  endcase

  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'blocky-product-form-' | append: section.id
-%}

{%- assign bky_has_iwt = section.blocks | where: 'type', 'icon-with-text' -%}
{%- assign bky_has_comp = section.blocks | where: 'type', 'complementary' -%}
{%- assign bky_has_collapsible = section.blocks | where: 'type', 'collapsible_tab' -%}
{%- assign bky_has_rti = section.blocks | where: 'type', 'rating_text_icon' -%}
{%- assign bky_has_rs = section.blocks | where: 'type', 'review-stars' -%}
{%- assign bky_has_acc = section.blocks | where: 'type', 'accordion' -%}
{%- if bky_has_iwt.size > 0 or bky_has_comp.size > 0 or bky_has_collapsible.size > 0 or bky_has_rti.size > 0 or bky_has_rs.size > 0 or bky_has_acc.size > 0 -%}
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
{%- endif -%}

{% style %}
  #blocky-featured-product-{{ section.id }} {
    --background-color: {{ section.settings.background_color }};
    --padding-top: {{ section.settings.padding_top }};
    --padding-bottom: {{ section.settings.padding_bottom }};
    --section-page-width: {{ section.settings.page_width }}px;
    --text-container-gap: {{ section.settings.content_vertical_gap | default: 14 }}px;
    --bky-gap: {{ section.settings.content_gap }}px;
    display: block;
    width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-flex-container {
    gap: var(--bky-gap);
  }

  #blocky-featured-product-{{ section.id }} .blocky-flex-child {
    min-width: 0;
    flex: 1 1 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__content-col {
    display: flex;
    justify-content: center;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media-col {
    display: flex;
    justify-content: center;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media-col > div {
    width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__content {
    justify-content: center;
    width: 100%;
    max-width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__content > * {
    width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media-wrap {
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.media_border_radius }}px;
    {% if section.settings.media_shadow %}box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);{% endif %}
    {% if section.settings.show_media_border %}border: 1px solid {{ section.settings.media_border_color }};{% endif %}
  }

  #blocky-featured-product-{{ section.id }} .blocky-media-adapt {
    aspect-ratio: var(--bky-media-ratio, 1);
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__main {
    display: grid;
    grid-template-areas: "media";
    width: 100%;
    height: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media {
    display: none;
    grid-area: media;
    width: 100%;
    height: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media.is-active {
    display: block;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media img,
  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.media_fit }};
    background: rgba(0, 0, 0, 0.03);
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumbs {
    list-style: none;
    padding: 0;
    margin-top: 12px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumbs--stack {
    display: grid;
    grid-template-columns: repeat({{ section.settings.thumbnail_slides_per_column | default: 4 }}, minmax(0, 1fr));
    gap: 10px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-slider {
    position: relative;
    width: 100%;
    padding-inline: 2.8rem;
    overflow: hidden;
    display: block;
    height: auto;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-slider .glide__track {
    overflow: hidden;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-slider .glide__slide {
    height: auto;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-review__nav,
  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav{
    position: absolute;
    top: 50%;
    border: 0;
    background: transparent;
    color: currentColor;
    cursor: pointer;
    transform: translateY(-50%);
    font-size: 30px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-review__nav--prev,
  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav--prev {
    left: 8px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-review__nav--next,
  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav--next {
    right: 8px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb {
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    background: transparent;
    border: 1px solid {{ section.settings.thumbnail_border_color }};
    border-radius: {{ section.settings.thumbnail_border_radius }}px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb.is-active {
    border-color: {{ section.settings.thumbnail_active_border_color }};
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #blocky-featured-product-{{ section.id }} .caption-with-letter-spacing {
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.8rem;
    color: var(--price-color);
    font-size: var(--price-size);
    font-weight: var(--price-weight);
    line-height: 1.2;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-price s {
    opacity: 0.55;
    font-size: 15px;
    font-weight: 400;
    color: var(--compare-price-color, var(--price-color));
  }

  #blocky-featured-product-{{ section.id }} .blocky-sale-badge {
    display: inline-flex;
    align-items: center;
    align-self: stretch;
    padding: 0 1.5rem;
    font-size: var(--bky-sale-badge-size, 12px);
    line-height: 1;
    font-weight: 400;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-inventory {
    display: flex;
    align-items: center;
    gap: 5px;
    margin: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-inventory.blocky-hidden {
    visibility: hidden;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-inventory__dot {
    flex-shrink: 0;
    width: 15px;
    height: 15px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-sku {
    margin: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-sku.blocky-hidden {
    visibility: hidden;
  }

  #blocky-featured-product-{{ section.id }} .blocky-visually-hidden {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    word-wrap: normal !important;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup__opener {
    display: inline-block;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup__button {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: text-decoration-thickness 0.1s ease;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup__button:hover {
    text-decoration-thickness: 2px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal {
    box-sizing: border-box;
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    margin: 0 auto;
    overflow: auto;
    opacity: 0;
    visibility: hidden;
    background: rgba(0, 0, 0, 0.2);
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal[open] {
    z-index: 2147483000;
    opacity: 1;
    visibility: visible;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal__content {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 92%;
    height: 80%;
    margin-top: 50px;
    padding: 0 15px 0 30px;
    overflow: auto;
    border-radius: 10px;
    background: #ffffff;
    color: #000000;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  @media screen and (min-width: 750px) {
    #blocky-featured-product-{{ section.id }} .blocky-popup-modal__content {
      width: 70%;
      margin-top: 100px;
      padding: 0 30px;
    }
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal__content img {
    max-width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal__content-info {
    padding-right: 44px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal__content-info > * {
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal__toggle {
    display: flex;
    position: sticky;
    top: 15px;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: 0 0 0 auto;
    padding: 12px;
    z-index: 2;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    background: #ffffff;
    color: rgba(0, 0, 0, 0.55);
    cursor: pointer;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal__toggle:hover {
    color: rgba(0, 0, 0, 0.75);
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal__toggle svg {
    width: 22px;
    height: 22px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rating-wrapper {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rating {
    display: inline-block;
    margin: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rating-star {
    --letter-spacing: 0.8;
    --font-size: 1.7;
    --color-rating-star: currentColor;
    --percent: calc(
      (
          var(--rating) / var(--rating-max) + var(--rating-decimal) * var(--font-size) /
            (var(--rating-max) * (var(--letter-spacing) + var(--font-size)))
        ) * 100%
    );
    display: inline-block;
    font-family: Times, serif;
    font-size: calc(var(--font-size) * 10px);
    letter-spacing: calc(var(--letter-spacing) * 10px);
    line-height: 1;
    margin: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rating-star::before {
    content: '★★★★★';
    background: linear-gradient(
      90deg,
      var(--color-rating-star) var(--percent),
      rgba(128, 128, 128, 0.35) var(--percent)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rating-count {
    display: inline-block;
    margin: 0;
    font-size: 14px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__button svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__fallback {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__fallback[hidden] {
    display: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__input {
    flex: 1 1 200px;
    min-width: 0;
    padding: 8px 10px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    background: #ffffff;
    color: #000000;
    font: inherit;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__copy {
    padding: 8px 12px;
    border: 1px solid currentColor;
    border-radius: 6px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__success {
    font-size: 13px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__success[hidden] {
    display: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary {
    width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary[hidden] {
    display: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__heading {
    margin: 0 0 12px;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary details {
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 0;
    cursor: pointer;
    list-style: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary summary::-webkit-details-marker {
    display: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__summary-title {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__summary-icon {
    flex-shrink: 0;
    font-family: 'Material Symbols Outlined';
    font-weight: normal;
    font-style: normal;
    font-size: 20px;
    line-height: 1;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: 'liga';
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__summary-caret {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary details[open] .blocky-complementary__summary-caret {
    transform: rotate(180deg);
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary details[open] summary {
    margin-bottom: 12px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__slider {
    position: relative;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__track::-webkit-scrollbar {
    display: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__slide {
    flex: 0 0 100%;
    min-width: 100%;
    scroll-snap-align: start;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__grid {
    display: grid;
    grid-template-columns: repeat(var(--bky-comp-per-page, 3), minmax(0, 1fr));
    gap: 12px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__link {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__media {
    width: 100%;
    aspect-ratio: var(--bky-comp-ratio, 1 / 1);
    overflow: hidden;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.04);
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__title {
    margin: 8px 0 2px;
    font-size: 14px;
    line-height: 1.3;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__price {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__quick-add {
    display: block;
    margin-top: 8px;
    padding: 8px 10px;
    border: 1px solid currentColor;
    border-radius: 6px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 13px;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__quick-add[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__arrow svg {
    width: 16px;
    height: 16px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__arrow[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__pagination {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.25);
    cursor: pointer;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__dot.is-active {
    background: currentColor;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__num {
    padding: 0 4px;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    opacity: 0.5;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__num.is-active {
    opacity: 1;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    #blocky-featured-product-{{ section.id }} .blocky-complementary__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border: 0;
    padding: 0;
    margin: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-option-name,
  #blocky-featured-product-{{ section.id }} .blocky-product-quantity label {
    display: block;
    margin-bottom: 0.45rem;
    font-size: var(--bky-quantity-label-size, 1.3rem);
    font-weight: 500;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-option-values input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-option-values label,
