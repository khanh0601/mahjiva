    color: var(--rti-heading-color);
    font-size: var(--rti-heading-size);
  }

  #blocky-featured-product-{{ section.id }} .blocky-rti-features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px 12px;
    width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rti-feature {
