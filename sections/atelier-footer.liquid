<script>
  (function() {
    const footerCurrToggle = document.getElementById('afCurrencyToggle');
    const footerCurrMenu = document.getElementById('afCurrencyMenu');
    const footerCurrBackdrop = document.getElementById('afCurrBackdrop');
    const footerCurrCode = document.getElementById('FooterCountryCode');
    const footerCurrForm = document.getElementById('FooterLocalizationForm');

    function closeFooterCurr() {
      if (footerCurrMenu) footerCurrMenu.setAttribute('hidden', 'true');
      if (footerCurrToggle) footerCurrToggle.setAttribute('aria-expanded', 'false');
      if (footerCurrBackdrop) footerCurrBackdrop.classList.remove('is-active');
      document.body.classList.remove('af-curr-open');
      const chatWidget = document.querySelector('shopify-chat') || document.getElementById('shopify-chat');
      if (chatWidget) {
        chatWidget.style.removeProperty('display');
      }
      if (window.scrollX !== 0) window.scrollTo(0, window.scrollY);
    }

    function openFooterCurr() {
      if (footerCurrMenu) footerCurrMenu.removeAttribute('hidden');
      if (footerCurrToggle) footerCurrToggle.setAttribute('aria-expanded', 'true');
      if (footerCurrBackdrop) footerCurrBackdrop.classList.add('is-active');
      document.body.classList.add('af-curr-open');
      const chatWidget = document.querySelector('shopify-chat') || document.getElementById('shopify-chat');
      if (chatWidget) {
        chatWidget.style.setProperty('display', 'none', 'important');
      }
      const searchInput = document.getElementById('afCurrSearchFooter');
      if (searchInput) {
        setTimeout(() => {
          try {
            searchInput.focus({ preventScroll: true });
          } catch (err) {
            searchInput.focus();
          }
          if (window.scrollX !== 0) {
            window.scrollTo(0, window.scrollY);
          }
        }, 60);
      }
    }

    if (footerCurrToggle && footerCurrMenu) {
      footerCurrToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        const isHidden = footerCurrMenu.hasAttribute('hidden');
        if (isHidden) {
          openFooterCurr();
        } else {
          closeFooterCurr();
        }
      });

      if (footerCurrBackdrop) {
        footerCurrBackdrop.addEventListener('click', function(e) {
          e.stopPropagation();
          closeFooterCurr();
        });
      }

      document.querySelectorAll('.af-curr-select-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const code = this.getAttribute('data-country-code');
          if (code && footerCurrCode && footerCurrForm) {
            footerCurrCode.value = code;
            footerCurrForm.submit();
          }
        });
      });

      const searchInput = document.getElementById('afCurrSearchFooter');
      if (searchInput) {
        searchInput.addEventListener('input', function() {
          const q = this.value.toLowerCase().trim();
          footerCurrMenu.querySelectorAll('.af-curr-option-item').forEach(function(item) {
            const text = item.textContent.toLowerCase();
            item.style.display = text.includes(q) ? '' : 'none';
          });
        });
        searchInput.addEventListener('click', function(e) {
          e.stopPropagation();
        });
      }

      document.addEventListener('click', function(e) {
        if (!footerCurrToggle.contains(e.target) && !footerCurrMenu.contains(e.target)) {
          closeFooterCurr();
        }
      });
    }

    // Footer Newsletter AJAX Submission & Code Copy
    (function initFooterNewsletter() {
      const sectionId = '{{ section.id }}';
      const formWrap = document.getElementById('afNewsletterFormWrap-' + sectionId);
      const successBox = document.getElementById('afNewsletterSuccess-' + sectionId);
      const copyBtn = document.getElementById('afCopyCodeBtn');
      const copyLabel = document.getElementById('afCopyCodeLabel');
      const resetBtn = document.getElementById('afResetNewsletterBtn-' + sectionId);
      const discountCode = 'MAHJIVA15';

      function getFooterForm() {
        if (formWrap) {
          const innerForm = formWrap.querySelector('form');
          if (innerForm) return innerForm;
        }
        return document.getElementById('FooterNewsletterForm') || document.querySelector('.af-newsletter-form');
      }

      function getEmailInput() {
        const f = getFooterForm();
        if (f) {
          const inp = f.querySelector('input[type="email"]');
          if (inp) return inp;
        }
        return document.getElementById('FooterNewsletterEmail');
      }

      function showSuccess(shouldFocus) {
        if (formWrap) formWrap.style.display = 'none';
        if (successBox) {
          successBox.style.display = 'flex';
          const codeEl = document.getElementById('afDiscountCodeText');
          if (codeEl) codeEl.textContent = discountCode;
          if (shouldFocus && copyBtn) {
            try { copyBtn.focus({ preventScroll: true }); } catch(e) {}
          }
        }
      }

      function showForm() {
        if (successBox) successBox.style.display = 'none';
        if (formWrap) {
          formWrap.style.display = 'block';
          const emailInput = getEmailInput();
          if (emailInput) {
            emailInput.value = '';
          }
        }
      }

      // Check on page load if user already claimed discount or submitted footer
      try {
        const hasHash = window.location.hash === '#FooterNewsletterForm';
        const hasQuery = window.location.search && window.location.search.indexOf('customer_posted=true') !== -1;
        const isClaimed = localStorage.getItem('mahjiva_footer_subscribed') === 'true' ||
                          sessionStorage.getItem('mahjiva_footer_subscribed') === 'true' ||
                          hasHash || hasQuery;
        if (isClaimed) {
          showSuccess(false); // NEVER focus or scroll on page load!
        }

        // Clean up hash or customer_posted query to prevent browser jumping on page refresh
        if (hasHash || hasQuery) {
          if (window.history && window.history.replaceState) {
            const cleanSearch = window.location.search
              .replace(/[?&]customer_posted=true/g, '')
              .replace(/^[?&]/, '');
            const cleanUrl = window.location.pathname + (cleanSearch ? '?' + cleanSearch : '');
            window.history.replaceState(null, document.title, cleanUrl);
          }
        }
      } catch(e) {}

      // Reset button: allows entering a different email
      if (resetBtn) {
        resetBtn.addEventListener('click', function(e) {
          e.preventDefault();
          try {
            localStorage.removeItem('mahjiva_footer_subscribed');
            sessionStorage.removeItem('mahjiva_footer_subscribed');
          } catch(err) {}
          showForm();
        });
      }

      // Copy Code functionality
      if (copyBtn) {
        copyBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          const code = discountCode;

          function onCopied() {
            if (copyLabel) copyLabel.innerText = 'COPIED!';
            copyBtn.style.background = '#234D3C';
            copyBtn.style.color = '#FFFFFF';
            setTimeout(function() {
              if (copyLabel) copyLabel.innerText = 'COPY';
              copyBtn.style.background = '';
              copyBtn.style.color = '';
            }, 2500);
          }

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).then(onCopied).catch(function() {
              fallbackCopy(code, onCopied);
            });
          } else {
            fallbackCopy(code, onCopied);
          }

          function fallbackCopy(text, cb) {
            const temp = document.createElement('textarea');
            temp.value = text;
            temp.style.position = 'fixed';
            temp.style.opacity = '0';
            document.body.appendChild(temp);
            temp.select();
            try {
              document.execCommand('copy');
              if (cb) cb();
            } catch(e) {}
            document.body.removeChild(temp);
          }
        });
      }

      // Guaranteed Submit Interceptor
      function handleSubmission(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
          if (e.stopImmediatePropagation) e.stopImmediatePropagation();
        }

        const emailInput = getEmailInput();
        const emailVal = emailInput ? emailInput.value.trim() : '';

        if (!emailVal || emailVal.indexOf('@') === -1) {
          if (emailInput) {
            emailInput.focus();
            if (emailInput.reportValidity) emailInput.reportValidity();
          }
          return false;
        }

        // 1. Immediately switch UI: hide form and show success card with MAHJIVA15 & copy button!
        showSuccess(false);

        // 2. Persist discount to storage & auto-apply to Shopify session
        try {
          localStorage.setItem('mahjiva_discount_code', discountCode);
          sessionStorage.setItem('mahjiva_discount_code', discountCode);
          localStorage.setItem('mahjiva_footer_subscribed', 'true');
          sessionStorage.setItem('mahjiva_footer_subscribed', 'true');
          localStorage.setItem('mahjiva_newsletter_popup_dismissed', 'true');
          sessionStorage.setItem('mahjiva_newsletter_popup_dismissed', 'true');
          localStorage.setItem('mahjiva_footer_email', emailVal);
        } catch(err) {}

        // Apply discount cookie via Shopify native endpoint
        try {
          fetch('/discount/' + encodeURIComponent(discountCode), {
            method: 'GET',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          });
        } catch(err) {}

        // 3. Submit customer form to Shopify in background (fire-and-forget, zero page reload)
        const form = getFooterForm();
        if (form) {
          try {
            const formData = new FormData(form);
            fetch(form.action || '/contact', {
              method: 'POST',
              body: formData,
              headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'text/html' }
            }).catch(function(err) {
              console.warn('Footer newsletter sync notice:', err);
            });
          } catch(err) {}
        }

        return false;
      }

      // Attach direct event listeners
      const initialForm = getFooterForm();
      if (initialForm) {
        initialForm.addEventListener('submit', handleSubmission, true);
      }
      if (formWrap) {
        formWrap.addEventListener('submit', handleSubmission, true);
        const submitBtn = formWrap.querySelector('button[type="submit"]') || document.getElementById('FooterNewsletterSubmit');
        if (submitBtn) {
          submitBtn.addEventListener('click', function(e) {
            const emailInput = getEmailInput();
            if (emailInput && emailInput.checkValidity && !emailInput.checkValidity()) {
              return; // let native tooltip display
            }
            handleSubmission(e);
          });
        }
      }

      // Delegated document-level capture listener ensures zero reload even if elements render dynamically
      document.addEventListener('submit', function(e) {
        const target = e.target;
        if (!target) return;
        if (target.id === 'FooterNewsletterForm' || 
            target.classList.contains('af-newsletter-form') || 
            (formWrap && formWrap.contains(target))) {
          handleSubmission(e);
        }
      }, true);
    })();
  })();
</script>

