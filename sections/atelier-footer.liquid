    font-size: 13.5px;
    line-height: 1.55;
    color: #4A4642;
    margin: 0 0 14px 0;
    text-align: center;
  }

  .af-code-card {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: #FAF8F5;
