<script>
  (function() {
    function initFooterCurrency() {
      var toggle = document.getElementById('afCurrencyToggle');
      var menu = document.getElementById('afCurrencyMenu');
      var codeInput = document.getElementById('FooterCountryCode');
      var form = document.getElementById('FooterLocalizationForm');
      var searchInput = document.getElementById('afCurrSearch');

      if (!toggle || !menu) return;

      toggle.addEventListener('click', function(e) {
        e.stopPropagation();
        var isHidden = menu.hasAttribute('hidden');
        if (isHidden) {
          menu.removeAttribute('hidden');
          toggle.setAttribute('aria-expanded', 'true');
          if (searchInput) {
            setTimeout(function() { searchInput.focus(); }, 60);
          }
        } else {
          menu.setAttribute('hidden', 'true');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });

      menu.addEventListener('click', function(e) {
        e.stopPropagation();
      });

      document.addEventListener('click', function(e) {
        if (!menu.hasAttribute('hidden')) {
          menu.setAttribute('hidden', 'true');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });

      var optionBtns = menu.querySelectorAll('.af-curr-select-btn');
      optionBtns.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var code = this.getAttribute('data-country-code');
          if (code && codeInput && form) {
            codeInput.value = code;
            form.submit();
          }
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', function() {
          var q = this.value.toLowerCase().trim();
          var items = menu.querySelectorAll('.af-curr-option-item');
          items.forEach(function(item) {
            var text = item.textContent.toLowerCase();
            item.style.display = text.indexOf(q) !== -1 ? '' : 'none';
          });
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFooterCurrency);
    } else {
      initFooterCurrency();
    }
  })();
</script>

