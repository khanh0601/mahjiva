{% style %}
  .blocky-hb5-{{ section.id }} {
    position: relative;
    overflow: hidden;
    font-family: Figtree, "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  /* -- Background media -- */
  .blocky-hb5-{{ section.id }} .blocky-hb5__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .blocky-hb5-{{ section.id }} .blocky-hb5__bg img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    aspect-ratio: auto;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position_x }}% center;
    backface-visibility: hidden;
    transform: translateZ(0);
  }
  .blocky-hb5-{{ section.id }} .blocky-hb5__bg svg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140px;
    max-width: 40%;
    height: auto;
    opacity: 0.35;
  }

  .blocky-hb5-{{ section.id }} .blocky-hb5__bg .blocky-hb5__img--mobile { display: none; }

  /* -- Overlay -- */
  .blocky-hb5-{{ section.id }} .blocky-hb5__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: var(--overlay-color);
    opacity: var(--overlay-opacity);
  }

  /* -- Inner -- */
  .blocky-hb5-{{ section.id }} .blocky-hb5__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: var(--inner-min-height);
    max-width: var(--inner-max-width);
    margin: 0 auto;
    padding-left: var(--inner-padding-x);
    padding-right: var(--inner-padding-x);
    gap: var(--columns-gap);
  }
  .blocky-hb5-{{ section.id }} .blocky-hb5__content {
    flex: 1 1 50%;
    max-width: var(--content-max-width);
    width: 100%;
    text-align: {{ section.settings.desktop_content_alignment }};
  }

  /* -- Eyebrow -- */
  .blocky-hb5-{{ section.id }} .blocky-hb5__eyebrow {
    font-size: var(--eyebrow-size);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--eyebrow-color);
    margin: 0 0 var(--eyebrow-gap);
    padding: 0;
  }

  /* -- Title -- */
  .blocky-hb5-{{ section.id }} .blocky-title {
    font-weight: var(--title-weight);
    line-height: var(--title-line-height);
    letter-spacing: 0;
    text-transform: none;
    margin: 0 0 var(--title-gap) !important;
    padding: 0;
    text-align: inherit;
  }
  .blocky-hb5-{{ section.id }} .blocky-title em,
  .blocky-hb5-{{ section.id }} .blocky-title i {
    color: var(--title-accent-color);
    font-style: normal;
  }
  .blocky-hb5-{{ section.id }} .blocky-title strong,
  .blocky-hb5-{{ section.id }} .blocky-title b { font-weight: var(--title-weight); }

  /* -- Subheading -- */
  .blocky-hb5-{{ section.id }} .blocky-hb5__subheading {
    font-size: var(--subheading-size);
    font-weight: var(--subheading-weight);
    line-height: 1.4;
    color: var(--subheading-color);
    margin: 0 0 var(--subheading-gap);
    padding: 0;
  }
  .blocky-hb5-{{ section.id }} .blocky-hb5__subheading em,
  .blocky-hb5-{{ section.id }} .blocky-hb5__subheading i,
  .blocky-hb5-{{ section.id }} .blocky-hb5__subheading span {
    color: var(--subheading-accent-color);
    font-style: normal;
  }

  /* -- Body -- */
  .blocky-hb5-{{ section.id }} .blocky-body-text {
    line-height: var(--body-line-height);
    max-width: var(--body-max-width);
    margin: 0 0 var(--body-gap);
  }
  .blocky-hb5-{{ section.id }} .blocky-body-text > p { margin: 0; padding: 0; }

  /* -- Buttons -- */
  .blocky-hb5-{{ section.id }} .blocky-hb5__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--btn-gap);
    margin-bottom: var(--buttons-gap-bottom);
    justify-content: {% if section.settings.desktop_content_alignment == 'center' %}center{% elsif section.settings.desktop_content_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }
  .blocky-hb5-{{ section.id }} .blocky-hb5__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: var(--btn-padding-v) var(--btn-padding-h);
    border-radius: var(--btn-radius);
    font-size: var(--btn-size);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-style: solid;
    border-width: var(--btn-border-width);
    cursor: pointer;
    transition: opacity 0.2s, transform 0.15s;
  }
  .blocky-hb5-{{ section.id }} .blocky-hb5__btn:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }
  .blocky-hb5-{{ section.id }} .blocky-hb5__btn--primary {
    background-color: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_color }};
    border-color: {{ section.settings.btn_border_color }};
  }
  .blocky-hb5-{{ section.id }} .blocky-hb5__btn--secondary {
    background-color: {{ section.settings.btn2_bg }};
    color: {{ section.settings.btn2_color }};
    border-color: {{ section.settings.btn2_border_color }};
  }

  /* -- Trust icons -- */
  .blocky-hb5-{{ section.id }} .blocky-hb5__icons {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--icons-gap);
    justify-content: {% if section.settings.desktop_content_alignment == 'center' %}center{% elsif section.settings.desktop_content_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }
  .blocky-hb5-{{ section.id }} .blocky-hb5__icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--icon-item-gap);
    min-width: var(--icon-item-min-width);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .blocky-hb5-{{ section.id }} .blocky-hb5__icon-circle {
    width: var(--icon-circle-size);
    height: var(--icon-circle-size);
    border-radius: 50%;
    background-color: var(--icon-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .blocky-hb5-{{ section.id }} .blocky-hb5__icon-circle img {
    display: block;
    width: var(--icon-size);
    height: var(--icon-size);
    max-width: 100%;
    aspect-ratio: auto;
    object-fit: contain;
  }
  .blocky-hb5-{{ section.id }} .blocky-hb5__icon-circle .blocky-hb5__icon-glyph {
    font-size: var(--icon-size) !important;
    line-height: 1;
    color: var(--icon-color);
  }
  .blocky-hb5-{{ section.id }} .blocky-hb5__icon-label {
    font-size: var(--icon-label-size);
    font-weight: 600;
    color: var(--icon-label-color);
    text-align: center;
    line-height: 1.3;
  }

  /* -- Responsive (standard Blocky 749px breakpoint) -- */
  @media screen and (max-width: 749px) {
    .blocky-hb5-{{ section.id }}.blocky-padding {
      --padding-top: {{ section.settings.mobile_padding_top }};
      --padding-bottom: {{ section.settings.mobile_padding_bottom }};
    }
    .blocky-hb5-{{ section.id }} {
      display: flex;
      flex-direction: column;
    }
    .blocky-hb5-{{ section.id }} .blocky-hb5__bg {
      position: relative;
      inset: auto;
      width: 100%;
      height: var(--mobile-image-height);
      order: {% if section.settings.mobile_layout == 'col' %}2{% else %}0{% endif %};
    }
    .blocky-hb5-{{ section.id }} .blocky-hb5__bg img {
      object-fit: {{ section.settings.mobile_image_fit }};
      object-position: {{ section.settings.mobile_image_position_x }}% center;
    }
    {%- if section.settings.mobile_image != blank -%}
      .blocky-hb5-{{ section.id }} .blocky-hb5__bg .blocky-hb5__img--desktop { display: none; }
      .blocky-hb5-{{ section.id }} .blocky-hb5__bg .blocky-hb5__img--mobile { display: block; }
    {%- endif -%}
    .blocky-hb5-{{ section.id }} .blocky-hb5__overlay { display: none; }
    .blocky-hb5-{{ section.id }} .blocky-hb5__inner {
      order: 1;
      min-height: var(--mobile-inner-min-height);
      padding-left: var(--mobile-inner-padding-x);
      padding-right: var(--mobile-inner-padding-x);
    }
    .blocky-hb5-{{ section.id }} .blocky-hb5__content {
      max-width: 100%;
      text-align: {{ section.settings.mobile_content_alignment }};
    }
    .blocky-hb5-{{ section.id }} .blocky-title {
      --title-size: {{ section.settings.mobile_title_size }} !important;
      line-height: var(--mobile-title-line-height);
    }
    .blocky-hb5-{{ section.id }} .blocky-body-text {
      --body-font-size: {{ section.settings.mobile_body_size }}px !important;
      margin-left: {% if section.settings.mobile_content_alignment == 'center' %}auto{% else %}0{% endif %};
      margin-right: {% if section.settings.mobile_content_alignment == 'center' %}auto{% else %}0{% endif %};
    }
    .blocky-hb5-{{ section.id }} .blocky-hb5__subheading { font-size: var(--mobile-subheading-size); }
    .blocky-hb5-{{ section.id }} .blocky-hb5__buttons {
      justify-content: {% if section.settings.mobile_content_alignment == 'center' %}center{% elsif section.settings.mobile_content_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
      {%- if section.settings.mobile_btn_full_width %}flex-direction: column;{%- endif %}
    }
    {%- if section.settings.mobile_btn_full_width -%}
      .blocky-hb5-{{ section.id }} .blocky-hb5__btn { width: 100%; }
    {%- endif -%}
    .blocky-hb5-{{ section.id }} .blocky-hb5__icons {
      display: {% if section.settings.show_icons_mobile %}flex{% else %}none{% endif %};
      justify-content: {% if section.settings.mobile_content_alignment == 'center' %}center{% elsif section.settings.mobile_content_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
    }
  }
{% endstyle %}

<div
  class="blocky blocky-hb5 blocky-hb5-{{ section.id }} blocky-padding background-wrapper"
  style="--padding-top: {{ section.settings.padding_top }}; --padding-bottom: {{ section.settings.padding_bottom }}; --background-color: {{ section.settings.background_color }}; --section-page-width: {{ section.settings.page_width | divided_by: 10 }}rem; --inner-max-width: {{ section.settings.page_width }}px; --inner-min-height: {{ section.settings.min_height }}px; --mobile-inner-min-height: {{ section.settings.mobile_min_height }}px; --mobile-image-height: {{ section.settings.mobile_image_height }}px; --inner-padding-x: {{ section.settings.inner_padding_x }}px; --mobile-inner-padding-x: {{ section.settings.mobile_inner_padding_x }}px; --columns-gap: {{ section.settings.columns_gap }}px; --content-max-width: {{ section.settings.content_max_width }}px; --overlay-color: {{ section.settings.overlay_color }}; --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --eyebrow-size: {{ section.settings.eyebrow_size }}px; --eyebrow-color: {{ section.settings.eyebrow_color }}; --eyebrow-gap: {{ section.settings.eyebrow_gap }}px; --title-accent-color: {{ section.settings.title_accent_color }}; --title-weight: {{ section.settings.title_weight }}; --title-line-height: {{ section.settings.title_line_height }}; --mobile-title-line-height: {{ section.settings.mobile_title_line_height }}; --title-gap: {{ section.settings.title_gap }}px; --subheading-size: {{ section.settings.subheading_size }}px; --mobile-subheading-size: {{ section.settings.mobile_subheading_size }}px; --subheading-color: {{ section.settings.subheading_color }}; --subheading-accent-color: {{ section.settings.subheading_accent_color }}; --subheading-weight: {{ section.settings.subheading_weight }}; --subheading-gap: {{ section.settings.subheading_gap }}px; --body-line-height: {{ section.settings.body_line_height }}; --body-max-width: {{ section.settings.body_max_width }}px; --body-gap: {{ section.settings.body_gap }}px; --btn-gap: {{ section.settings.btn_gap }}px; --buttons-gap-bottom: {{ section.settings.buttons_gap_bottom }}px; --btn-size: {{ section.settings.btn_size }}px; --btn-radius: {{ section.settings.btn_radius }}px; --btn-padding-v: {{ section.settings.btn_padding_v }}px; --btn-padding-h: {{ section.settings.btn_padding_h }}px; --btn-border-width: {{ section.settings.btn_border_width }}px; --icons-gap: {{ section.settings.icons_gap }}px; --icon-item-gap: {{ section.settings.icon_item_gap }}px; --icon-item-min-width: {{ section.settings.icon_item_min_width }}px; --icon-circle-size: {{ section.settings.icon_circle_size }}px; --icon-size: {{ section.settings.icon_size }}px; --icon-label-size: {{ section.settings.icon_label_size }}px; --icon-label-color: {{ section.settings.icon_label_color }};"
>
  <!-- -- Background hero image (desktop + mobile) -- -->
  <div class="blocky-hb5__bg">
    {%- if section.settings.image != blank -%}
      <img
        class="blocky-hb5__img--desktop"
        src="{{ section.settings.image | image_url: width: 2400 }}"
        width="{{ section.settings.image.width | default: 1800 }}"
        height="{{ section.settings.image.height | default: 610 }}"
        alt="{{ section.settings.image.alt | escape }}"
        loading="eager"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'blocky-hb5__img--desktop' }}
    {%- endif -%}
    {%- if section.settings.mobile_image != blank -%}
      <img
        class="blocky-hb5__img--mobile"
        src="{{ section.settings.mobile_image | image_url: width: 1200 }}"
        width="{{ section.settings.mobile_image.width | default: 981 }}"
        height="{{ section.settings.mobile_image.height | default: 1404 }}"
        alt="{{ section.settings.mobile_image.alt | escape }}"
        loading="eager"
      >
    {%- endif -%}
  </div>

  <div class="blocky-hb5__overlay"></div>

  <div class="blocky-page-width blocky-hb5__inner">
    <div class="blocky-hb5__content">
      {%- if section.settings.eyebrow_text != blank -%}
        <p class="blocky-hb5__eyebrow">{{ section.settings.eyebrow_text }}</p>
      {%- endif -%}

      {% render 'blocky-titlel', block: section %}

      {%- if section.settings.subheading != blank -%}
        <p class="blocky-hb5__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {% render 'blocky-bodyl', block: section %}

      {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
        <div class="blocky-hb5__buttons">
          {%- if section.settings.button_label != blank -%}
            <a
              href="{{ section.settings.button_url | default: '#' }}"
              class="blocky-hb5__btn blocky-hb5__btn--primary"
            >
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.button2_label != blank -%}
            <a
              href="{{ section.settings.button2_url | default: '#' }}"
              class="blocky-hb5__btn blocky-hb5__btn--secondary"
            >
              {{ section.settings.button2_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="blocky-hb5__icons">
          {%- for block in section.blocks -%}
            <li
              class="blocky-hb5__icon-item"
              style="--icon-color: {{ block.settings.icon_color }}; --icon-bg: {{ block.settings.icon_bg_color }};"
              {{ block.shopify_attributes }}
            >
              <div class="blocky-hb5__icon-circle">
                {%- if block.settings.icon_choice == 'image' and block.settings.icon_image != blank -%}
                  <img
                    src="{{ block.settings.icon_image | image_url: width: 120 }}"
                    width="{{ block.settings.icon_image.width | default: 60 }}"
                    height="{{ block.settings.icon_image.height | default: 60 }}"
                    alt="{{ block.settings.icon_label | strip_html | escape }}"
                    loading="lazy"
                  >
                {%- elsif block.settings.icon_code != blank -%}
                  <span class="material-icons material-symbols-outlined blocky-hb5__icon-glyph">{{ block.settings.icon_code }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.icon_label != blank -%}
                <span class="blocky-hb5__icon-label">{{ block.settings.icon_label }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

