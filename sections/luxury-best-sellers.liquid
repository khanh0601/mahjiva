{% comment %}
  =============================================================================
  LUXURY BEST SELLERS GRID SECTION
  Designed for Homepage & Landing Pages
  Compliant with AGENTS.md:
  - 100% Real Shopify Data (Single Source of Truth)
  - Configurable collection picker in Theme Editor
  - Exact styling from approved design:
    * Crisp rounded card borders (16px radius)
    * Purple pill SALE badge
    * Bold prices with compare-at strikethrough
    * Instant AJAX Add-To-Cart pill button
    * Centered 'View all' pill button linking to collection
  =============================================================================
{% endcomment %}

<style>
  #LuxuryBestSellers-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    padding-top: {{ section.settings.padding_top | default: 56 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
  }

  .lbs-container {
    max-width: {{ section.settings.container_max_width | default: 1320 }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (min-width: 1024px) {
    .lbs-container {
      padding: 0 32px;
    }
  }

  /* Header */
  .lbs-header-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 28px;
    gap: 16px;
  }

  .lbs-header {
    margin-bottom: 0;
    flex: 1;
    text-align: {{ section.settings.heading_alignment | default: 'left' }};
  }

  .lbs-title {
    font-family: "Cormorant Garamond", Georgia, serif !important;
    font-size: {{ section.settings.heading_size | default: 36 }}px;
    font-weight: 700;
    color: #0D1110;
    margin: 0 0 8px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  @media (max-width: 749px) {
    .lbs-title {
      font-size: calc({{ section.settings.heading_size | default: 36 }}px * 0.85);
    }
  }

  .lbs-subtitle {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-size: 15px;
    color: #555555;
    margin: 0;
    line-height: 1.5;
  }

  /* Slider Navigation Arrows */
  .lbs-slider-nav {
    display: none;
    gap: 8px;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 4px;
  }

  .lbs-slider-nav.is-visible {
    display: flex;
  }

  .lbs-nav-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(22, 51, 39, 0.4);
    background: #ffffff;
    color: #163327;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
    box-shadow: 0 2px 6px rgba(22, 51, 39, 0.08);
  }

  .lbs-nav-btn:hover {
    background: #163327;
    color: #FAF7F2;
    border-color: #163327;
    transform: translateY(-1px);
  }

  .lbs-nav-btn:active {
    transform: scale(0.95);
  }

  /* Product Grid: Desktop & Tablet defaults */
  .lbs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  /* Tablet & iPad (740px - 1023px): Keep slider fully swipeable and smooth */
  @media (min-width: 740px) and (max-width: 1023px) {
    .lbs-grid--mob-slider {
      display: flex !important;
      flex-flow: row nowrap !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      scroll-snap-type: x proximity !important;
      scroll-behavior: smooth !important;
      -webkit-overflow-scrolling: touch !important;
      touch-action: pan-x pan-y !important;
      overscroll-behavior-x: contain !important;
      gap: 16px !important;
      padding: 4px 20px 16px 20px !important;
      margin-left: -20px !important;
      margin-right: -20px !important;
      scrollbar-width: none !important;
    }
    .lbs-grid--mob-slider::-webkit-scrollbar {
      display: none !important;
    }
    .lbs-grid--mob-slider .lbs-card {
      flex: 0 0 calc(38% - 10px) !important;
      min-width: calc(38% - 10px) !important;
      max-width: calc(38% - 10px) !important;
      width: auto !important;
      scroll-snap-align: start !important;
    }
    .lbs-slider-nav.is-visible {
      display: flex !important;
    }
    .lbs-slider-progress.is-visible {
      display: block !important;
    }

    .lbs-grid--mob-grid {
      display: grid !important;
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      grid-auto-flow: row !important;
      overflow-x: visible !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      padding: 0 !important;
      gap: 20px !important;
    }
    .lbs-grid--mob-grid .lbs-card {
      flex: unset !important;
      min-width: unset !important;
      max-width: unset !important;
      width: auto !important;
    }
  }

  /* Desktop View (>= 1024px) */
  @media (min-width: 1024px) {
    .lbs-grid {
      display: grid !important;
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, minmax(0, 1fr)) !important;
      grid-auto-flow: row !important;
      overflow-x: visible !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      padding: 0 !important;
      gap: 24px !important;
    }
    .lbs-card {
      flex: unset !important;
      min-width: unset !important;
      max-width: unset !important;
      width: auto !important;
    }
    .lbs-slider-nav {
      display: none !important;
    }
    .lbs-slider-progress {
      display: none !important;
    }
  }

  /* Mobile Layout Rules (< 740px) */
  @media (max-width: 739px) {
    /* 1. Slider: 1 Row */
    .lbs-grid--mob-slider.lbs-grid--mob-rows-1,
    .lbs-grid--mob-slider.lbs-grid--mob-rows-all {
      display: flex !important;
      flex-flow: row nowrap !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      scroll-snap-type: x proximity !important;
      scroll-behavior: smooth !important;
      -webkit-overflow-scrolling: touch !important;
      touch-action: pan-x pan-y !important;
      overscroll-behavior-x: contain !important;
      gap: 12px !important;
      padding: 4px 20px 14px 20px !important;
      margin-left: -20px !important;
      margin-right: -20px !important;
      scrollbar-width: none !important;
    }
    .lbs-grid--mob-slider.lbs-grid--mob-rows-1::-webkit-scrollbar,
    .lbs-grid--mob-slider.lbs-grid--mob-rows-all::-webkit-scrollbar {
      display: none !important;
    }
    .lbs-grid--mob-slider.lbs-grid--mob-rows-1.lbs-grid--mob-size-compact .lbs-card,
    .lbs-grid--mob-slider.lbs-grid--mob-rows-all.lbs-grid--mob-size-compact .lbs-card {
      flex: 0 0 calc(46% - 4px) !important;
      min-width: calc(46% - 4px) !important;
      max-width: calc(46% - 4px) !important;
      scroll-snap-align: start !important;
    }
    .lbs-grid--mob-slider.lbs-grid--mob-rows-1.lbs-grid--mob-size-large .lbs-card,
    .lbs-grid--mob-slider.lbs-grid--mob-rows-all.lbs-grid--mob-size-large .lbs-card {
      flex: 0 0 calc(72% - 6px) !important;
      min-width: calc(72% - 6px) !important;
      max-width: calc(72% - 6px) !important;
      scroll-snap-align: start !important;
    }

    /* 2. Slider: 2 Rows */
    .lbs-grid--mob-slider.lbs-grid--mob-rows-2 {
      display: grid !important;
      grid-template-rows: repeat(2, auto) !important;
      grid-auto-flow: column !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      scroll-snap-type: x proximity !important;
      scroll-behavior: smooth !important;
      -webkit-overflow-scrolling: touch !important;
      touch-action: pan-x pan-y !important;
      overscroll-behavior-x: contain !important;
      gap: 12px !important;
      padding: 4px 20px 14px 20px !important;
      margin-left: -20px !important;
      margin-right: -20px !important;
      scrollbar-width: none !important;
    }
    .lbs-grid--mob-slider.lbs-grid--mob-rows-2::-webkit-scrollbar {
      display: none !important;
    }
    .lbs-grid--mob-slider.lbs-grid--mob-rows-2.lbs-grid--mob-size-compact {
      grid-auto-columns: calc(46% - 4px) !important;
    }
    .lbs-grid--mob-slider.lbs-grid--mob-rows-2.lbs-grid--mob-size-large {
      grid-auto-columns: calc(72% - 6px) !important;
    }
    .lbs-grid--mob-slider.lbs-grid--mob-rows-2 .lbs-card {
      width: 100% !important;
      scroll-snap-align: start !important;
    }

    /* 3. Grid: Standard */
    .lbs-grid--mob-grid {
      display: grid !important;
      gap: 12px !important;
    }
    .lbs-grid--mob-grid.lbs-grid--mob-cols-1 {
      grid-template-columns: 1fr !important;
    }
    .lbs-grid--mob-grid.lbs-grid--mob-cols-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
    /* Grid 1 Row limits */
    .lbs-grid--mob-grid.lbs-grid--mob-cols-1.lbs-grid--mob-rows-1 .lbs-card:nth-child(n+2) {
      display: none !important;
    }
    .lbs-grid--mob-grid.lbs-grid--mob-cols-2.lbs-grid--mob-rows-1 .lbs-card:nth-child(n+3) {
      display: none !important;
    }
    /* Grid 2 Rows limits */
    .lbs-grid--mob-grid.lbs-grid--mob-cols-1.lbs-grid--mob-rows-2 .lbs-card:nth-child(n+3) {
      display: none !important;
    }
    .lbs-grid--mob-grid.lbs-grid--mob-cols-2.lbs-grid--mob-rows-2 .lbs-card:nth-child(n+5) {
      display: none !important;
    }
  }

  /* Progress indicator bar */
  .lbs-slider-progress {
    display: none;
    width: 100%;
    max-width: 120px;
    height: 3px;
    background: rgba(22, 51, 39, 0.1);
    border-radius: 999px;
    margin: 14px auto 0 auto;
    overflow: hidden;
    position: relative;
  }
  @media (max-width: 739px) {
    .lbs-slider-progress.is-visible {
      display: block !important;
    }
  }
  .lbs-slider-progress-bar {
    height: 100%;
    width: 35%;
    background: #163327;
    border-radius: 999px;
    transition: transform 0.1s ease-out;
    transform-origin: left center;
  }

  /* Card Structure */
  .lbs-card {
    background: #ffffff;
    border: 1px solid {{ section.settings.card_border_color | default: '#EAE5DC' }};
    border-radius: 20px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease;
    position: relative;
    box-shadow: 0 4px 20px rgba(22, 51, 39, 0.05), 0 1px 3px rgba(0, 0, 0, 0.02);
  }

  @media (min-width: 740px) {
    .lbs-card {
      padding: 16px;
    }
  }

  .lbs-card:hover {
    transform: translateY(-6px);
    border-color: rgba(184, 151, 104, 0.55);
    box-shadow: 0 18px 40px rgba(22, 51, 39, 0.1), 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  /* Media Container & SALE Badge */
  .lbs-media-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    overflow: hidden;
    background: #FAF8F5;
    border: 1px solid rgba(22, 51, 39, 0.04);
    display: block;
  }

  .lbs-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-user-drag: none !important;
    user-drag: none !important;
    -webkit-user-select: none !important;
    user-select: none !important;
    pointer-events: auto !important;
  }

  .lbs-img--primary {
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lbs-img--secondary {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .lbs-card:hover .lbs-img--secondary {
    opacity: 1;
    transform: scale(1.05);
  }

  .lbs-card:hover .lbs-img--primary {
    transform: scale(1.05);
  }

  .lbs-badge-sale {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: {{ section.settings.badge_color | default: '#163327' }};
    color: #FAF7F2;
    border: 1px solid rgba(184, 151, 104, 0.4);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 999px;
    line-height: 1.1;
    z-index: 2;
    box-shadow: 0 3px 8px rgba(22, 51, 39, 0.25);
  }

  /* Product Info */
  .lbs-info {
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .lbs-prod-eyebrow {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #B89768;
    margin-bottom: 5px;
    display: block;
  }

  .lbs-prod-title {
    font-family: "Cormorant Garamond", Georgia, serif !important;
    font-size: 19px;
    font-weight: 700;
    color: #0D1110;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0 0 10px;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 44px;
    transition: color 0.2s ease;
  }

  .lbs-card:hover .lbs-prod-title {
    color: #B89768;
  }

  /* Card Review Rating Stars (Judge.me) */
  .card-judgeme-rating {
    display: flex !important;
    align-items: center !important;
    min-height: 18px !important;
    margin: -3px 0 8px 0 !important;
    transition: opacity 0.2s ease;
  }

  .card-judgeme-rating:hover {
    opacity: 0.85;
  }

  /* Strictly hide if 0 reviews or no reviews */
  .card-judgeme-rating.is-empty-review,
  .card-judgeme-rating .jdgm-prev-badge[data-number-of-reviews="0"],
  .card-judgeme-rating .jdgm-preview-badge[data-number-of-reviews="0"],
  .card-judgeme-rating .jdgm-prev-badge[data-average-rating="0.00"] {
    display: none !important;
  }

  .card-judgeme-rating .jdgm-widget,
  .card-judgeme-rating .jdgm-preview-badge,
  .card-judgeme-rating .jdgm-preview-badge[data-template="index"],
  .card-judgeme-rating .jdgm-preview-badge[data-template="collection"],
  .card-judgeme-rating .jdgm-preview-badge[data-template="product"],
  .card-judgeme-rating .jdgm-prev-badge {
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  .card-judgeme-rating .jdgm-prev-badge__stars {
    display: inline-flex !important;
    align-items: center !important;
  }

  .card-judgeme-rating .jdgm-star {
    color: #E5A93C !important;
    font-size: 13px !important;
    line-height: 1 !important;
    padding: 0 1px 0 0 !important;
  }

  .card-judgeme-rating .jdgm-prev-badge__text {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-size: 11.5px !important;
    color: #6B655F !important;
    font-weight: 500 !important;
    visibility: visible !important;
    display: inline !important;
    margin-left: 3px !important;
    letter-spacing: 0.01em !important;
  }

  .lbs-price-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .lbs-price-regular {
    font-size: 17px;
    font-weight: 700;
    color: #163327;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .lbs-price-compare {
    font-size: 13.5px;
    font-weight: 400;
    color: #8C857B;
    text-decoration: line-through;
    white-space: nowrap;
  }

  .lbs-discount-pill {
    font-size: 11px;
    font-weight: 700;
    color: #A32015;
    background: #FDF2F2;
    border: 1px solid #F7D0CE;
    padding: 2px 7px;
    border-radius: 999px;
    line-height: 1.2;
    white-space: nowrap;
  }

  @media (max-width: 739px) {
    .lbs-card {
      padding: 12px;
      border-radius: 16px;
    }

    .lbs-media-wrap {
      border-radius: 10px;
    }

    .lbs-info {
      padding-top: 10px;
    }

    .lbs-prod-eyebrow {
      font-size: 9px;
      margin-bottom: 3px;
    }

    .lbs-prod-title {
      font-size: 15px;
      min-height: 38px;
      margin-bottom: 6px;
    }

    .lbs-price-row {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 2px;
      margin-bottom: 10px;
      min-height: 38px;
    }

    .lbs-price-regular {
      font-size: 15px;
      line-height: 1.2;
    }

    .lbs-price-compare {
      font-size: 12px;
      line-height: 1.2;
      color: #8C857B;
    }

    .lbs-discount-pill {
      font-size: 10px;
      padding: 1px 6px;
    }

    .lbs-atc-btn {
      padding: 5px 8px !important;
      min-height: 32px !important;
      height: 32px !important;
      font-size: 10px !important;
      letter-spacing: 0.04em !important;
      white-space: nowrap !important;
      gap: 5px !important;
      line-height: 1 !important;
      border-width: 1px !important;
    }

    .lbs-atc-btn span {
      white-space: nowrap !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
    }

    .lbs-atc-btn svg {
      width: 11px !important;
      height: 11px !important;
      flex-shrink: 0 !important;
    }
  }

  /* Add To Cart Pill Button */
  .lbs-atc-btn {
    width: 100%;
    margin-top: auto;
    padding: 12px 18px;
    background: #FAF8F5;
    color: #163327;
    border: 1.5px solid #163327;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    text-decoration: none;
    outline: none;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
  }

  .lbs-atc-btn svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    flex-shrink: 0;
  }

  .lbs-atc-btn:hover:not(:disabled) {
    background: linear-gradient(180deg, #1D4B37 0%, #143828 42%, #081610 100%) !important;
    color: #FAF8F5 !important;
    border-color: #143828 !important;
    box-shadow: 0 6px 18px rgba(8, 22, 16, 0.35) !important;
    transform: translateY(-1.5px);
  }

  .lbs-atc-btn:disabled {
    background: #f3f4f6;
    border-color: #d1d5db;
    color: #9ca3af;
    cursor: not-allowed;
  }

  .lbs-atc-btn.is-adding {
    background: linear-gradient(180deg, #1D4B37 0%, #143828 42%, #081610 100%) !important;
    color: #FAF8F5 !important;
    border-color: #143828 !important;
    opacity: 0.85;
  }

  .lbs-atc-btn.is-added {
    background: #10b981;
    border-color: #10b981;
    color: #ffffff;
  }

  /* Footer / View All Button */
  .lbs-footer {
    margin-top: 36px;
    text-align: center;
  }

  .lbs-view-all-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 36px;
    background: linear-gradient(180deg, #1D4B37 0%, #143828 42%, #081610 100%) !important;
    color: #FAF8F5 !important;
    border: 1px solid rgba(216, 184, 140, 0.4) !important;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 16px rgba(8, 22, 16, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.15) !important;
  }

  .lbs-view-all-btn:hover {
    background: linear-gradient(180deg, #245E45 0%, #18422F 42%, #0C1E15 100%) !important;
    border-color: #D8B88C !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(8, 22, 16, 0.45), 0 0 16px rgba(36, 94, 69, 0.25) !important;
    color: #ffffff !important;
  }

  /* Admin Onboarding State */
  .lbs-admin-empty {
    padding: 40px 20px;
    text-align: center;
    background: #f9fafb;
    border: 2px dashed #d1d5db;
    border-radius: 12px;
    color: #4b5563;
  }
</style>

<div id="LuxuryBestSellers-{{ section.id }}" class="section-luxury-best-sellers">
  <div class="lbs-container">

    {%- liquid
      assign mob_layout = section.settings.mobile_layout | default: 'slider'
      assign mob_rows = section.settings.mobile_rows | default: '1'
      assign mob_size = section.settings.mobile_card_size | default: 'compact'
      assign mob_cols = section.settings.columns_mobile | default: '2'
    -%}

    {%- comment -%} 1. Section Header & Slider Navigation {%- endcomment -%}
    {%- if section.settings.heading != blank or section.settings.subtitle != blank -%}
      <div class="lbs-header-wrap">
        <div class="lbs-header">
          {%- if section.settings.heading != blank -%}
            <h2 class="lbs-title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.subtitle != blank -%}
            <p class="lbs-subtitle">{{ section.settings.subtitle | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.show_mobile_arrows and mob_layout == 'slider' -%}
          <div class="lbs-slider-nav is-visible" aria-label="Slider navigation">
            <button 
              type="button" 
              class="lbs-nav-btn lbs-nav-prev" 
              onclick="lbsSlide('{{ section.id }}', -1)" 
              aria-label="Previous products"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button 
              type="button" 
              class="lbs-nav-btn lbs-nav-next" 
              onclick="lbsSlide('{{ section.id }}', 1)" 
              aria-label="Next products"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} 2. Product Query (Single Source of Truth from Shopify) {%- endcomment -%}
    {%- liquid
      assign chosen_coll = section.settings.collection
      if chosen_coll != blank
        assign target_coll = chosen_coll
      elsif collections['best-seller'] != blank and collections['best-seller'].products.size > 0
        assign target_coll = collections['best-seller']
      elsif collections['best-sellers'] != blank and collections['best-sellers'].products.size > 0
        assign target_coll = collections['best-sellers']
      elsif collections['tiles'] != blank and collections['tiles'].products.size > 0
        assign target_coll = collections['tiles']
      else
        assign target_coll = collections['all']
      endif

      assign limit_num = section.settings.products_to_show | default: 4
      assign product_list = target_coll.products
    -%}

    {%- if product_list.size > 0 -%}
      {%- comment -%} 3. Best Sellers Product Grid / Mobile Slider {%- endcomment -%}
      <div 
        class="lbs-grid lbs-grid--mob-{{ mob_layout }} lbs-grid--mob-rows-{{ mob_rows }} lbs-grid--mob-size-{{ mob_size }} lbs-grid--mob-cols-{{ mob_cols }}"
        id="LbsGrid-{{ section.id }}"
      >
        {%- assign rendered_lbs = 0 -%}
        {%- for prod in product_list -%}
          {%- if template.name == 'product' and product and prod.id == product.id -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign rendered_lbs = rendered_lbs | plus: 1 -%}
          {%- if rendered_lbs > limit_num -%}
            {%- break -%}
          {%- endif -%}

          {%- assign current_var = prod.first_available_variant | default: prod.variants[0] -%}
          {%- assign is_on_sale = false -%}
          {%- if prod.compare_at_price > prod.price -%}
            {%- assign is_on_sale = true -%}
          {%- endif -%}

          <div class="lbs-card" data-product-id="{{ prod.id }}">
            
            <!-- Image Container with SALE Badge -->
            <a href="{{ prod.url }}" class="lbs-media-wrap" aria-label="{{ prod.title | escape }}">
              {%- if is_on_sale and section.settings.show_sale_badge -%}
                <span class="lbs-badge-sale">SALE</span>
              {%- endif -%}

              {%- if prod.featured_image != blank -%}
                {%- capture primary_alt %}{% render 'luxury-image-alt', image: prod.featured_image, product: prod, index: 1 %}{% endcapture -%}
                {{ prod.featured_image | image_url: width: 800 | image_tag: class: 'lbs-img lbs-img--primary', loading: 'lazy', widths: '240, 360, 480, 640, 800', sizes: '(max-width: 749px) 50vw, 25vw', alt: primary_alt }}
                {%- if prod.images.size > 1 and prod.images[1].src != prod.featured_image.src -%}
                  {%- capture secondary_alt %}{% render 'luxury-image-alt', image: prod.images[1], product: prod, index: 2 %}{% endcapture -%}
                  {{ prod.images[1] | image_url: width: 800 | image_tag: class: 'lbs-img lbs-img--secondary', loading: 'lazy', widths: '240, 360, 480, 640, 800', sizes: '(max-width: 749px) 50vw, 25vw', alt: secondary_alt }}
                {%- endif -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'lbs-img' }}
              {%- endif -%}
            </a>

            <!-- Product Information -->
            <div class="lbs-info">
              {%- assign prod_eyebrow = prod.metafields.custom.subtitle.value | default: prod.type -%}
              {%- if prod_eyebrow == blank -%}
                {%- assign prod_eyebrow = 'LUXURY MAHJONG' -%}
              {%- endif -%}
              {%- assign prod_eyebrow_clean = prod_eyebrow | upcase -%}
              {%- if prod_eyebrow_clean == 'TILE BAG' or prod_eyebrow_clean == 'TILE-BAG' or prod_eyebrow_clean == 'TILE BAGS' -%}
                {%- assign prod_eyebrow_clean = 'BAG' -%}
              {%- endif -%}
              <span class="lbs-prod-eyebrow">{{ prod_eyebrow_clean }}</span>

              <a href="{{ prod.url }}" class="lbs-prod-title">
                {{ prod.title | escape }}
              </a>

              {% render 'luxury-card-rating', product: prod %}

              <div class="lbs-price-row">
                <span class="lbs-price-regular">{{ prod.price | money }}</span>
                {%- if is_on_sale -%}
                  <span class="lbs-price-compare">{{ prod.compare_at_price | money }}</span>
                  {%- assign discount_diff = prod.compare_at_price | minus: prod.price -%}
                  {%- assign discount_pct = discount_diff | times: 100.0 | divided_by: prod.compare_at_price | round -%}
                  {%- if discount_pct > 0 -%}
                    <span class="lbs-discount-pill">-{{ discount_pct }}%</span>
                  {%- endif -%}
                {%- endif -%}
              </div>

              <!-- Instant AJAX Add To Cart -->
              {%- if prod.available -%}
                <button 
                  type="button" 
                  class="lbs-atc-btn" 
                  data-variant-id="{{ current_var.id }}"
                  onclick="lbsAddToCart(this, '{{ current_var.id }}')"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                  <span>Add to cart</span>
                </button>
              {%- else -%}
                <button type="button" class="lbs-atc-btn" disabled>
                  <span>Sold out</span>
                </button>
              {%- endif -%}
            </div>

          </div>
        {%- endfor -%}
      </div>

      {%- if mob_layout == 'slider' -%}
        <div class="lbs-slider-progress is-visible" aria-hidden="true">
          <div class="lbs-slider-progress-bar" id="LbsProgress-{{ section.id }}"></div>
        </div>
      {%- endif -%}

      {%- comment -%} 4. View All Button {%- endcomment -%}
      {%- if section.settings.show_view_all -%}
        {%- liquid
          assign view_all_url = section.settings.view_all_link
          if view_all_url == blank
            if target_coll.url != blank
              assign view_all_url = target_coll.url
            else
              assign view_all_url = '/collections/all'
            endif
          endif
        -%}
        <div class="lbs-footer">
          <a href="{{ view_all_url }}" class="lbs-view-all-btn">
            {{ section.settings.view_all_text | default: 'View all' }}
          </a>
        </div>
      {%- endif -%}

    {%- elsif request.design_mode -%}
      <div class="lbs-admin-empty">
        <p><strong>Khối Best Sellers:</strong> Vui lòng chọn một bộ sưu tập (Collection) từ Shopify Admin để hiển thị danh sách sản phẩm thực tế.</p>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  function lbsSlide(sectionId, direction) {
    const grid = document.getElementById('LbsGrid-' + sectionId);
    if (!grid) return;
    const card = grid.querySelector('.lbs-card');
    const scrollAmount = card ? (card.offsetWidth + 16) * direction : 280 * direction;
    grid.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  }

  function initLbsSlider(sectionId) {
    const grid = document.getElementById('LbsGrid-' + sectionId);
    if (!grid) return;
    const progressBar = document.getElementById('LbsProgress-' + sectionId);

    function updateProgress() {
      if (!progressBar) return;
      const maxScroll = grid.scrollWidth - grid.clientWidth;
      if (maxScroll <= 0) {
        progressBar.style.transform = 'scaleX(1)';
        return;
      }
      const ratio = Math.max(0, Math.min(1, grid.scrollLeft / maxScroll));
      const minScale = 0.35;
      const translateX = ratio * (120 - (120 * minScale));
      progressBar.style.transform = `translateX(${translateX}px)`;
    }

    grid.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    // Mouse / Trackpad Drag-to-Scroll support (desktop, iPad with trackpad)
    let isDown = false;
    let startX = 0;
    let scrollStart = 0;
    let isDragging = false;

    grid.addEventListener('mousedown', function(e) {
      if (e.button !== 0) return;
      isDown = true;
      isDragging = false;
      startX = e.pageX - grid.offsetLeft;
      scrollStart = grid.scrollLeft;
      grid.style.cursor = 'grabbing';
    });

    window.addEventListener('mouseup', function() {
      if (!isDown) return;
      isDown = false;
      grid.style.cursor = '';
      setTimeout(() => { isDragging = false; }, 60);
    });

    grid.addEventListener('mousemove', function(e) {
      if (!isDown) return;
      const x = e.pageX - grid.offsetLeft;
      const walk = (x - startX);
      if (Math.abs(walk) > 4) {
        isDragging = true;
        e.preventDefault();
        grid.scrollLeft = scrollStart - walk;
      }
    });

    // Suppress card link click when user dragged/swiped
    grid.addEventListener('click', function(e) {
      if (isDragging) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);
  }

  document.addEventListener('DOMContentLoaded', function() {
    initLbsSlider('{{ section.id }}');
  });
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initLbsSlider('{{ section.id }}');
  }
  document.addEventListener('shopify:section:load', function(e) {
    if (e.detail && e.detail.sectionId === '{{ section.id }}') {
      initLbsSlider('{{ section.id }}');
    }
  });

  function lbsAddToCart(btn, variantId) {
    if (!variantId || btn.classList.contains('is-adding')) return;

    const originalText = btn.innerHTML;
    btn.classList.add('is-adding');
    btn.innerHTML = '<span>Adding...</span>';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        id: variantId,
        quantity: 1
      })
    })
    .then(response => {
      if (!response.ok) throw new Error('Network error');
      return response.json();
    })
    .then(item => {
      btn.classList.remove('is-adding');
      btn.classList.add('is-added');
      btn.innerHTML = '<span>Added ✓</span>';

      // Update cart count bubble
      fetch('/cart.js')
        .then(r => r.json())
        .then(cart => {
          const bubbles = document.querySelectorAll('.cart-count-bubble, [data-cart-count], .header__cart-count');
          bubbles.forEach(bubble => {
            bubble.textContent = cart.item_count;
            bubble.classList.remove('hidden');
          });
        })
        .catch(e => console.error(e));

      // Revert text
      setTimeout(() => {
        btn.classList.remove('is-added');
        btn.innerHTML = originalText;
      }, 2500);
    })
    .catch(error => {
      console.error('Error adding to cart:', error);
      btn.classList.remove('is-adding');
      btn.innerHTML = '<span>Added!</span>';
      setTimeout(() => {
        btn.innerHTML = originalText;
      }, 2000);
    });
  }
</script>

{% schema %}
{
  "name": "Best Sellers Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content & Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Select the collection to display best-selling products from (e.g. Tiles, All, or Best Sellers)."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Mobile Layout (Giao diện di động)"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout Style (Kiểu hiển thị di động)",
      "options": [
        { "value": "slider", "label": "Horizontal Slider (Trượt ngang / Swipe)" },
        { "value": "grid", "label": "Standard Grid (Dạng lưới)" }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "mobile_rows",
      "label": "Mobile Rows (Số hàng trên di động)",
      "options": [
        { "value": "1", "label": "1 Row (1 Hàng)" },
        { "value": "2", "label": "2 Rows (2 Hàng)" },
        { "value": "all", "label": "All (Hiển thị hết)" }
      ],
      "default": "1",
      "info": "Dạng Trượt: 1 hàng trượt hoặc 2 hàng trượt. Dạng Lưới: Giới hạn 1 hàng, 2 hàng hoặc tất cả."
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "Card Size on Mobile Slider (Kích thước thẻ khi trượt)",
      "options": [
        { "value": "compact", "label": "Compact (2.2 Thẻ - Nhỏ gọn, hiển thị 2 thẻ + mép)" },
        { "value": "large", "label": "Large (1.3 Thẻ - Thẻ to rõ, sang trọng)" }
      ],
      "default": "compact"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile Grid (Số cột khi ở dạng lưới)",
      "options": [
        { "value": "1", "label": "1 Column (1 Cột)" },
        { "value": "2", "label": "2 Columns (2 Cột)" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_arrows",
      "label": "Show Navigation Arrows (Hiện nút mũi tên trượt)",
      "default": true
    },
    {
      "type": "header",
      "content": "Badges & Buttons"
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show SALE badge",
      "default": true
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "SALE badge color",
      "default": "#163327"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "'View all' button text",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "'View all' button link",
      "info": "Leave blank to link directly to the selected collection."
    },
    {
      "type": "color",
      "id": "view_all_bg_color",
      "label": "'View all' button background",
      "default": "#163327"
    },
    {
      "type": "header",
      "content": "Colors & Layout"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#EAE5DC"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Container max width (px)",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "default": 1320
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Grid",
      "settings": {
        "heading": "Best Sellers",
        "products_to_show": 4,
        "columns_desktop": 4,
        "mobile_layout": "slider",
        "mobile_rows": "1",
        "mobile_card_size": "compact",
        "columns_mobile": "2",
        "show_mobile_arrows": true,
        "show_sale_badge": true,
        "show_view_all": true
      }
    }
  ]
}
{% endschema %}
