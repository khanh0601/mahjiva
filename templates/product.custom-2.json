    "luxury_custom_mat_faq_mK7d4Q": {
      "type": "luxury-custom-mat-faq",
      "blocks": {
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "How can I start designing my mat?",
            "subtitle": "",
            "answer": "<p>Choose a Mahjiva design to personalize, upload your own artwork, or simply share your ideas and let us create something for you.</p>",
            "is_open_by_default": true
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "What can I personalize?",
            "subtitle": "",
            "answer": "<p>Add names, monograms, club names, dates, colors, or special motifs. You can also request a design that coordinates with your favorite Mahjong tiles.</p>",
            "is_open_by_default": false
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I upload my own design?",
            "subtitle": "",
            "answer": "<p>Absolutely! Upload your artwork or reference images. Our team will review your design and help prepare it for printing.</p>",
            "is_open_by_default": false
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "What if I don't have a design idea?",
            "subtitle": "",
            "answer": "<p>No problem! Share your favorite colors, themes, or inspirations. We'll create 3 unique design concepts within 24 hours of receiving your brief.</p>",
            "is_open_by_default": false
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Will I see my design before printing?",
            "subtitle": "",
            "answer": "<p>Yes! You'll review your design, request refinements, and approve the final version before production begins.</p>",
            "is_open_by_default": false
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "What happens after I approve my design?",
            "subtitle": "",
            "answer": "<p>Once approved, your custom mat moves into production. We'll print, carefully package, and ship it to your address.</p>",
            "is_open_by_default": false
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "What is the size, and how should I care for it?",
            "subtitle": "",
            "answer": "<p>Our mats measure 31.5″ × 31.5″ (80 × 80 cm). Gently wipe the surface with a soft, damp cloth and let it air-dry completely before storing.</p>",
            "is_open_by_default": false
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "question": "How long does a custom mat take?",
            "subtitle": "",
            "answer": "<p>Design concepts are created within 24 hours for idea-based requests. Production time depends on your final design and any revisions. We'll confirm the estimated timeline before printing.</p>",
            "is_open_by_default": false
          }
        },
        "faq_item_9": {
          "type": "faq_item",
          "settings": {
            "question": "How long does shipping take?",
            "subtitle": "",
