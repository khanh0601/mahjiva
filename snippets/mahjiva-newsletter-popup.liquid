{%- comment -%}
  -----------------------------------------------------------------------------
  MAHJIVA LUXURY NEWSLETTER POPUP
  - Displayed exclusively on Homepage for first-time visitors
  - Stores 'mahjiva_newsletter_popup_dismissed' in localStorage (shows only once)
  - Native Shopify Customer Form with 'newsletter,welcome-10-popup' tags
  - Inline AJAX submission with instant code display ('MAHJIVA10') & copy button
  - Fallback to standard Liquid posted_successfully? handling
  - Luxury Atelier styling matching the Haute Horlogerie Mahjong aesthetic
  -----------------------------------------------------------------------------
{%- endcomment -%}

<div id="MahjivaNewsletterModal" class="mnp-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="mnpTitle" style="display: none;">
  <div class="mnp-backdrop" id="mnpBackdrop"></div>

  <div class="mnp-dialog">
    <!-- Close Button -->
    <button type="button" class="mnp-close" id="mnpCloseBtn" aria-label="Close newsletter popup">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M1 1L13 13M1 13L13 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Standard Form Content -->
    <div class="mnp-content" id="mnpMainContent">
      <div class="mnp-badge">
        <span class="mnp-badge-spark">✦</span>
        <span>EXCLUSIVE WELCOME PRIVILEGE</span>
        <span class="mnp-badge-spark">✦</span>
      </div>

      <h2 id="mnpTitle" class="mnp-title">Enjoy 15% Off Your First Order</h2>
      
      <p class="mnp-subtext">
        Join the Mahjiva circle for new arrivals, table inspiration, and special offers. Sign up with your email to receive your 15% off welcome code.
      </p>

      {%- form 'customer', id: 'HomeNewsletterPopupForm', class: 'mnp-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,welcome-15-popup">
        
        <div class="mnp-input-row">
          <input 
            type="email" 
            name="contact[email]" 
            id="mnpEmailInput"
            class="mnp-input" 
            placeholder="Enter your email" 
            aria-label="Enter your email"
            value="{{ form.email }}"
            autocorrect="off" 
            autocapitalize="off" 
            autocomplete="email" 
            required
          >
          <button type="submit" class="mnp-submit-btn" id="mnpSubmitBtn">
            <span>GET MY 15% OFF</span>
            <span class="mnp-arrow" aria-hidden="true">→</span>
          </button>
        </div>

        <div class="mnp-error-message" id="mnpErrorMsg" style="display: none;" role="alert"></div>

        {%- if form.errors -%}
          <div class="mnp-error-message" role="alert" style="display: block;">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </div>
        {%- endif -%}
      {%- endform -%}

      <p class="mnp-footnote">
        No spam, ever. Unsubscribe with one click at any time.
      </p>
    </div>

    <!-- Success Content (Celebratory Screen) -->
    <div class="mnp-success" id="mnpSuccessContent" style="display: {% if form.posted_successfully? %}block{% else %}none{% endif %};">
      <div class="mnp-success-icon" aria-hidden="true">✦</div>
      <div class="mnp-applied-badge">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>15% DISCOUNT ACTIVATED FOR YOUR ORDER</span>
      </div>
      <h2 class="mnp-title">Welcome to the Mahjiva Circle</h2>
      <p class="mnp-subtext">
        Your welcome privilege has been unlocked. <strong>15% off</strong> is now automatically applied to your checkout session! If needed, you can also use this code:
      </p>

      <div class="mnp-code-box">
        <span class="mnp-code-text" id="mnpDiscountCode"></span>
        <button type="button" class="mnp-copy-btn" id="mnpCopyBtn" aria-label="Copy discount code">
          <span id="mnpCopyText">COPY</span>
        </button>
      </div>

      <div class="mnp-success-actions">
        <button type="button" class="mnp-continue-btn" id="mnpExploreBtn">
          START SHOPPING WITH 15% OFF →
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* ==========================================================================
     MAHJIVA NEWSLETTER POPUP (HAUTE HORLOGERIE / ATELIER AESTHETICS)
     ========================================================================== */
  .mnp-modal,
  .mnp-modal * {
    box-sizing: border-box !important;
  }

  .mnp-modal {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.38s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.38s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mnp-modal.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* Frosted Glass Backdrop */
  .mnp-backdrop {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(14, 31, 23, 0.65) 0%, rgba(7, 16, 12, 0.82) 100%);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: opacity 0.38s ease;
  }

  /* Dialog Card */
  .mnp-dialog {
    position: relative;
    width: 100%;
    max-width: 530px;
    background: #FAF8F5;
    border: 1.5px solid rgba(184, 151, 104, 0.35);
    border-radius: 20px;
    padding: 42px 36px 34px;
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.35),
                0 0 0 1px rgba(255, 255, 255, 0.7) inset,
                0 10px 30px rgba(184, 151, 104, 0.08);
    text-align: center;
    transform: scale(0.93) translateY(12px);
    opacity: 0;
    transition: transform 0.42s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.35s ease;
  }

  .mnp-modal.is-active .mnp-dialog {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  /* Close Button */
  .mnp-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(22, 51, 39, 0.12);
    background: rgba(255, 255, 255, 0.75);
    color: #163327;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.22s ease;
    padding: 0;
  }

  .mnp-close:hover {
    background: #163327;
    color: #FFFFFF;
    border-color: #163327;
    transform: rotate(90deg);
  }

  /* Badge */
  .mnp-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 14px;
    background: rgba(184, 151, 104, 0.12);
    border: 1px solid rgba(184, 151, 104, 0.28);
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #8C6D3B;
    margin-bottom: 16px;
  }

  .mnp-badge-spark {
    font-size: 9px;
    color: #B89768;
  }

  /* Title */
  .mnp-title {
    font-family: "Cormorant Garamond", Georgia, serif !important;
    font-size: 33px;
    font-weight: 600;
    line-height: 1.15;
    color: #163327;
    margin: 0 0 12px 0;
    letter-spacing: -0.01em;
  }

  @media (min-width: 600px) {
    .mnp-title {
      font-size: 37px;
    }
  }

  /* Subtext */
  .mnp-subtext {
    font-size: 13.5px;
    line-height: 1.6;
    color: #5A5650;
    margin: 0 auto 24px;
    max-width: 440px;
    font-weight: 400;
  }

  /* Input Row */
  .mnp-input-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    margin-bottom: 12px;
  }

  @media (min-width: 480px) {
    .mnp-input-row {
      flex-direction: row;
      gap: 10px;
      align-items: stretch;
    }
  }

  .mnp-input {
    flex: 1 1 auto;
    height: 48px;
    padding: 0 20px;
    background: #FFFFFF;
    border: 1.5px solid #D8D2C5;
    border-radius: 999px !important;
    font-size: 13.5px;
    color: #163327;
    outline: none;
    transition: all 0.22s ease;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.04);
  }

  .mnp-input::placeholder {
    color: #8C867A;
  }

  .mnp-input:focus {
    border-color: #163327;
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(22, 51, 39, 0.12);
  }

  .mnp-submit-btn {
    height: 48px;
    padding: 0 26px;
    border-radius: 999px !important;
    background: linear-gradient(180deg, #1D4B37 0%, #143828 42%, #081610 100%) !important;
    border: 1px solid rgba(216, 184, 140, 0.45) !important;
    color: #FAF8F5 !important;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 4px 14px rgba(8, 22, 16, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mnp-submit-btn:hover {
    background: linear-gradient(180deg, #245E45 0%, #18422F 42%, #0C1E15 100%) !important;
    border-color: #D8B88C !important;
    color: #FFFFFF !important;
    transform: translateY(-1.5px);
    box-shadow: 0 6px 20px rgba(8, 22, 16, 0.45);
  }

  .mnp-submit-btn:active {
    transform: translateY(0);
  }

  .mnp-arrow {
    font-size: 14px;
    transition: transform 0.2s ease;
  }

  .mnp-submit-btn:hover .mnp-arrow {
    transform: translateX(3px);
  }

  /* Footnote */
  .mnp-footnote {
    font-size: 11px;
    color: #8C867A;
    margin: 10px 0 0 0;
    line-height: 1.4;
  }

  /* Error Message */
  .mnp-error-message {
    font-size: 12px;
    color: #B3261E;
    background: rgba(179, 38, 30, 0.08);
    border: 1px solid rgba(179, 38, 30, 0.25);
    border-radius: 8px;
    padding: 8px 14px;
    margin-top: 8px;
    text-align: left;
  }

  /* Success Screen */
  .mnp-applied-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    background: rgba(35, 77, 60, 0.1);
    border: 1px solid rgba(35, 77, 60, 0.28);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #163327;
    margin: 4px auto 14px;
  }

  .mnp-applied-badge svg {
    color: #234D3C;
    flex-shrink: 0;
  }

  .mnp-success-icon {
    font-size: 28px;
    color: #B89768;
    margin-bottom: 4px;
    animation: mnpPulse 2s infinite ease-in-out;
  }

  @keyframes mnpPulse {
    0%, 100% { transform: scale(1); opacity: 0.9; }
    50% { transform: scale(1.15); opacity: 1; }
  }

  .mnp-code-box {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: #FFFFFF;
    border: 1.5px dashed #B89768;
    border-radius: 12px;
    padding: 10px 18px;
    margin: 18px 0 24px;
    box-shadow: 0 4px 16px rgba(184, 151, 104, 0.12);
  }

  .mnp-code-text {
    font-family: monospace;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #163327;
  }

  .mnp-copy-btn {
    background: #163327;
    color: #FAF8F5;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mnp-copy-btn:hover {
    background: #B89768;
    color: #163327;
  }

  .mnp-continue-btn {
    height: 46px;
    padding: 0 28px;
    border-radius: 999px;
    background: transparent;
    border: 1.5px solid #163327;
    color: #163327;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.22s ease;
  }

  .mnp-continue-btn:hover {
    background: #163327;
    color: #FFFFFF;
  }

  /* Mobile Luxury Bottom Sheet (Non-intrusive, does NOT block the Hero section) */
  @media (max-width: 768px) {
    .mnp-modal {
      align-items: flex-end !important;
      padding: 0 !important;
    }
    .mnp-backdrop {
      background: rgba(10, 22, 17, 0.45) !important;
      backdrop-filter: blur(4px) !important;
      -webkit-backdrop-filter: blur(4px) !important;
    }
    .mnp-dialog {
      max-width: 100% !important;
      width: 100% !important;
      margin: 0 !important;
      border-radius: 24px 24px 0 0 !important;
      padding: 24px 20px 20px !important;
      border-bottom: none !important;
      border-left: none !important;
      border-right: none !important;
      box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.22) !important;
      transform: translateY(100%) !important;
      max-height: 85vh;
      overflow-y: auto;
    }
    .mnp-modal.is-active .mnp-dialog {
      transform: translateY(0) !important;
    }
    .mnp-close {
      top: 12px !important;
      right: 12px !important;
      width: 36px !important;
      height: 36px !important;
      background: #FFFFFF !important;
      border: 1px solid rgba(22, 51, 39, 0.2) !important;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08) !important;
    }
    .mnp-close svg {
      width: 14px !important;
      height: 14px !important;
    }
    .mnp-badge {
      font-size: 9px !important;
      padding: 3px 10px !important;
      margin-bottom: 8px !important;
    }
    .mnp-title {
      font-size: 22px !important;
      margin-bottom: 6px !important;
      line-height: 1.2 !important;
    }
    .mnp-subtext {
      font-size: 13px !important;
      line-height: 1.4 !important;
      margin-bottom: 14px !important;
      padding: 0 10px !important;
    }
    .mnp-input-row {
      flex-direction: column !important;
      gap: 8px !important;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
    }
    .mnp-input {
      width: 100% !important;
      background: #FFFFFF !important;
      border: 1.5px solid rgba(22, 51, 39, 0.2) !important;
      border-radius: 10px !important;
      height: 46px !important;
      padding: 0 14px !important;
      font-size: 14px !important;
    }
    .mnp-submit-btn {
      width: 100% !important;
      border-radius: 10px !important;
      height: 46px !important;
      font-size: 13px !important;
      justify-content: center !important;
    }
    .mnp-footnote {
      font-size: 10.5px !important;
      margin-top: 8px !important;
    }
  }
</style>

<script>
  (function() {
    const STORAGE_KEY = 'mahjiva_newsletter_popup_dismissed';
    const modal = document.getElementById('MahjivaNewsletterModal');
    const backdrop = document.getElementById('mnpBackdrop');
    const closeBtn = document.getElementById('mnpCloseBtn');
    const form = document.getElementById('HomeNewsletterPopupForm') || (modal ? modal.querySelector('form') : null);
    const mainContent = document.getElementById('mnpMainContent');
    const successContent = document.getElementById('mnpSuccessContent');
    const exploreBtn = document.getElementById('mnpExploreBtn');
    const copyBtn = document.getElementById('mnpCopyBtn');
    const copyText = document.getElementById('mnpCopyText');
    const discountCode = document.getElementById('mnpDiscountCode');
    const errorMsg = document.getElementById('mnpErrorMsg');

    if (!modal) return;

    // Open Modal
    function openPopup() {
      modal.style.display = 'flex';
      // Force reflow for CSS transition
      void modal.offsetWidth;
      modal.classList.add('is-active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    // Close Modal
    function closePopup() {
      modal.classList.remove('is-active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(function() {
        modal.style.display = 'none';
      }, 400);
      try {
        localStorage.setItem(STORAGE_KEY, Date.now().toString());
        sessionStorage.setItem(STORAGE_KEY, 'true');
      } catch (e) {}
    }

    const DISCOUNT_CODE = 'MAHJIVA15';

    // Auto-apply discount to Shopify session
    function applyDiscountToSession(code) {
      try {
        localStorage.setItem('mahjiva_discount_code', code);
        sessionStorage.setItem('mahjiva_discount_code', code);
      } catch (e) {}

      // Ping Shopify's native /discount/{code} route which sets the discount cookie
      return fetch('/discount/' + encodeURIComponent(code), {
        method: 'GET',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      }).catch(function(e) {
        console.warn('Shopify discount auto-apply error:', e);
      });
    }

    // Check if user already dismissed (within 7 days) or already subscribed
    var isDismissed = false;
    try {
      var dismissedTime = localStorage.getItem(STORAGE_KEY);
      if (dismissedTime) {
        // If stored as timestamp, honor 7-day cooldown (604800000 ms)
        var parsed = parseInt(dismissedTime, 10);
        if (!isNaN(parsed) && (Date.now() - parsed < 7 * 24 * 60 * 60 * 1000)) {
          isDismissed = true;
        } else if (dismissedTime === 'true') {
          isDismissed = true;
        }
      }
      if (sessionStorage.getItem(STORAGE_KEY) === 'true' ||
          localStorage.getItem('mahjiva_footer_subscribed') === 'true' ||
          localStorage.getItem('mahjiva_discount_code') === DISCOUNT_CODE) {
        isDismissed = true;
      }
    } catch (e) {}

    // Allow testing with ?popup=true, #popup, #privilege, #test-popup
    var urlParams = new URLSearchParams(window.location.search);
    var isTestMode = urlParams.get('popup') === 'true' || 
                     window.location.hash === '#test-popup' || 
                     window.location.hash === '#popup' || 
                     window.location.hash === '#privilege';

    {%- if form.posted_successfully? -%}
      // If submitted via standard POST reload, show success immediately & apply discount
      applyDiscountToSession(DISCOUNT_CODE);
      if (mainContent) mainContent.style.display = 'none';
      if (successContent) {
        successContent.style.display = 'block';
        var codeEl = document.getElementById('mnpDiscountCode');
        if (codeEl) codeEl.textContent = DISCOUNT_CODE;
      }
      try {
        localStorage.setItem(STORAGE_KEY, 'true');
        sessionStorage.setItem(STORAGE_KEY, 'true');
      } catch(e) {}
      openPopup();
    {%- else -%}
      // Only show on homepage for first-time visitors who haven't subscribed or dismissed
      if (!isDismissed || isTestMode) {
        var hasTriggered = false;
        var pageLoadTime = Date.now();
        var isMobile = (window.innerWidth <= 768) || /Mobi|Android|iPhone/i.test(navigator.userAgent);

        function triggerPopupOnce() {
          if (hasTriggered) return;
          hasTriggered = true;
          openPopup();
        }

        if (isMobile) {
          // ===================================================================
          // MOBILE SMART TRIGGERS (NEVER BLOCKS HERO SECTION)
          // ===================================================================
          // 1. Scroll-depth trigger: Only activates after visitor scrolled at least
          //    50% down the page AND spent at least 10s exploring the store.
          window.addEventListener('scroll', function() {
            if (!hasTriggered && (Date.now() - pageLoadTime) > 10000) {
              var scrollPercent = (window.scrollY + window.innerHeight) / (document.documentElement.scrollHeight || 1);
              if (scrollPercent >= 0.50) {
                if (timerId) clearTimeout(timerId);
                triggerPopupOnce();
              }
            }
          }, { passive: true });

          // 2. Gentle timer trigger on mobile: 25 seconds of engaged browsing
          var timerId = setTimeout(function() {
            triggerPopupOnce();
          }, 25000);

        } else {
          // ===================================================================
          // DESKTOP LUXURY TRIGGERS
          // ===================================================================
          // 1. Exit-intent trigger: Activates when cursor moves to browser tabs/URL bar
          document.addEventListener('mouseleave', function(e) {
            if (e.clientY <= 12 && (Date.now() - pageLoadTime) > 6000) {
              if (timerId) clearTimeout(timerId);
              triggerPopupOnce();
            }
          });

          // 2. Scroll-depth trigger on desktop: 50% scroll depth after 8s
          window.addEventListener('scroll', function() {
            if (!hasTriggered && (Date.now() - pageLoadTime) > 8000) {
              var scrollPercent = (window.scrollY + window.innerHeight) / (document.documentElement.scrollHeight || 1);
              if (scrollPercent >= 0.50) {
                if (timerId) clearTimeout(timerId);
                triggerPopupOnce();
              }
            }
          }, { passive: true });

          // 3. Fallback timer on desktop: 20 seconds
          var timerId = setTimeout(function() {
            triggerPopupOnce();
          }, 20000);
        }
      }
    {%- endif -%}

    // Reopen popup if URL hash changes to #popup or #privilege
    window.addEventListener('hashchange', function() {
      if (window.location.hash === '#popup' || window.location.hash === '#privilege') {
        openPopup();
      }
    });

    // Event Listeners for Close
    if (closeBtn) closeBtn.addEventListener('click', closePopup);
    if (backdrop) {
      backdrop.addEventListener('click', function() {
        // Do not accidentally dismiss while success screen with discount code is showing
        if (successContent && successContent.style.display === 'block') {
          return;
        }
        closePopup();
      });
    }
    if (exploreBtn) {
      exploreBtn.addEventListener('click', function() {
        closePopup();
        window.location.href = '/collections/all';
      });
    }

    // ESC key closes modal
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal.classList.contains('is-active')) {
        closePopup();
      }
    });

    // Copy Code functionality
    if (copyBtn && discountCode) {
      copyBtn.addEventListener('click', function() {
        var code = discountCode.innerText.trim();
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(code).then(function() {
            copyText.innerText = 'COPIED!';
            setTimeout(function() {
              copyText.innerText = 'COPY';
            }, 2500);
          });
        } else {
          // Fallback
          var tempInput = document.createElement('input');
          tempInput.value = code;
          document.body.appendChild(tempInput);
          tempInput.select();
          document.execCommand('copy');
          document.body.removeChild(tempInput);
          copyText.innerText = 'COPIED!';
          setTimeout(function() {
            copyText.innerText = 'COPY';
          }, 2500);
        }
      });
    }

    // AJAX Form Submission - Guaranteed to show code & never reload the page
    function handlePopupSubmit(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();
      }

      var activeForm = form || document.getElementById('HomeNewsletterPopupForm') || (modal ? modal.querySelector('form') : null);
      var emailInput = activeForm ? activeForm.querySelector('input[type="email"]') : document.getElementById('mnpEmailInput');
      var emailVal = emailInput ? emailInput.value.trim() : '';

      if (!emailVal || emailVal.indexOf('@') === -1) {
        if (emailInput) {
          emailInput.focus();
          if (emailInput.reportValidity) emailInput.reportValidity();
        }
        return false;
      }

      var submitBtn = document.getElementById('mnpSubmitBtn');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>ACTIVATING 15% OFF...</span>';
      }
      if (errorMsg) errorMsg.style.display = 'none';

      // 1. Immediately display the success state with the discount code & copy button
      if (mainContent) mainContent.style.display = 'none';
      if (successContent) {
        successContent.style.display = 'block';
        var codeEl = document.getElementById('mnpDiscountCode');
        if (codeEl) codeEl.textContent = DISCOUNT_CODE;
        if (copyBtn) {
          try { copyBtn.focus({ preventScroll: true }); } catch(err) {}
        }
      }

      // 2. Concurrently auto-apply MAHJIVA15 discount to Shopify session
      applyDiscountToSession(DISCOUNT_CODE);
      try {
        localStorage.setItem(STORAGE_KEY, 'true');
        sessionStorage.setItem(STORAGE_KEY, 'true');
        localStorage.setItem('mahjiva_footer_subscribed', 'true');
        sessionStorage.setItem('mahjiva_footer_subscribed', 'true');
      } catch(err) {}

      // 3. Submit email to customer newsletter via background fetch
      if (activeForm) {
        try {
          var formData = new FormData(activeForm);
          fetch(activeForm.action || '/contact', {
            method: 'POST',
            body: formData,
            headers: {
              'X-Requested-With': 'XMLHttpRequest',
              'Accept': 'text/html'
            }
          }).catch(function(err) {
            console.warn('Customer newsletter fetch notice:', err);
          });
        } catch(err) {}
      }

      return false;
    }

    if (form) {
      form.addEventListener('submit', handlePopupSubmit, true);
    }

    // Delegated submit listener for popup
    document.addEventListener('submit', function(e) {
      var target = e.target;
      if (!target) return;
      if (target.id === 'HomeNewsletterPopupForm' || target.classList.contains('mnp-form') || (modal && modal.contains(target))) {
        handlePopupSubmit(e);
      }
    }, true);
  })();
</script>
