  }

  .mp-container p {
    margin: 0 0 14px 0;
  }

  .mp-container strong {
    color: #163327;
    font-weight: 700;
  }

  .mp-container a {
    color: #163327;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .mp-container a:hover {
    color: #8C7355;
  }

  /* Callout Warning / Note Boxes */
  .mp-callout {
    background: #FDF9F2;
    border-left: 3.5px solid #8C7355;
