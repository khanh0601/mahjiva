  .mp-alert {
    background: #FFF8F7;
    border: 1px solid rgba(200, 60, 40, 0.25);
    border-radius: 12px;
    padding: 18px 22px;
    margin: 16px 0;
  }

  .mp-alert-list {
    list-style: none;
    padding: 0;
    margin: 8px 0 0 0;
  }

  .mp-alert-list li {
    position: relative;
    padding-left: 24px;
    margin-bottom: 8px;
    font-size: 14.5px;
    color: #4A4642;
  }

  .mp-alert-list li::before {
    content: "✕";
    position: absolute;
    left: 0;
    top: 0;
    color: #B83A2E;
    font-weight: 800;
    font-size: 13px;
  }

