{%- comment -%}
  -----------------------------------------------------------------------------
  SNIPPET: LUXURY ADD THESE TO YOUR ORDER (CAROUSEL / ADD-ONS)
  - 100% Harmonized Atelier Aesthetic: Imperial Jade (#163327) & Champagne Bronze (#B89768)
  - Balanced 3-column grid when <= 3 items (zero awkward right-side empty space)
  - Responsive horizontal carousel with arrow nav when > 3 items or on mobile
  - 100% Real Shopify Data (Zero Mock)
  - Interactive variant selector (updates price, image with srcset swap, variant ID)
  - One-click AJAX "Add & Save" button with cart drawer sync
  - Filtered specifically for Mahjong Set products
  -----------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign sec_id = section_id | default: section.id | default: 'add-to-order'
  assign only_sets = only_mahjong_sets
  if only_sets == nil
    assign only_sets = true
  endif

  # Mahjong Set detection
  assign is_mahjong_set = false
  if product.type == 'Tiles' or product.tags contains 'Mahjong Set' or product.handle contains 'mahjong-set'
    assign is_mahjong_set = true
  else
    for c in product.collections
      if c.handle == 'mahjong-set' or c.handle contains 'mahjong-set'
        assign is_mahjong_set = true
        break
      endif
    endfor
  endif

  # Products list
  assign prod_items = products
  assign prod_count = prod_items.size | default: 0
  if prod_items == blank or prod_count == 0
    assign default_handles = 'handcrafted-natural-gemstone-mahjong-dice-set,classic-canvas-mahjong-tile-carrying-bag,leopard-print-quilted-mahjong-tile-bag,leopard-print-mahjong-racks-set-of-4,palm-paradise-mahjong-mat' | split: ','
    assign item_count = default_handles.size
  else
    assign item_count = prod_count
  endif

  assign heading_text = heading | default: 'Add These to Your Order'
  assign subheading_text = subheading | default: 'Choose any coordinating piece to complete your setup. Each one is 10% off.'
  assign disc_pct = discount_percent | default: 10
  assign btn_label = button_text | default: 'Add & Save'
  assign btn_bg = button_color | default: '#163327'
  if btn_bg == '#6F266A' or btn_bg == '#4A154B' or btn_bg == blank
    assign btn_bg = '#163327'
  endif
  assign card_bg_color = card_bg | default: '#FAF8F5'
  if card_bg_color == '#FAF8F6' or card_bg_color == blank
    assign card_bg_color = '#FAF8F5'
  endif

  # Multiplier for 10% off: (100 - disc_pct) / 100
  assign multiplier = 100 | minus: disc_pct
-%}

{%- if only_sets and is_mahjong_set == false -%}
  {%- if request.design_mode -%}
    <div class="ato-admin-note" style="max-width:1200px;margin:16px auto;padding:14px 20px;background:#FAF8F5;border:1px dashed #D6D0C9;border-radius:12px;font-size:12.5px;color:#7A7571;text-align:center;">
      <strong style="color:#163327;">[Theme Editor Notice]</strong> "Add These to Your Order" is configured to appear only on <strong>Mahjong Set</strong> products. This notice is hidden from customers.
    </div>
  {%- endif -%}
{%- else -%}

<div class="ato-section-wrapper" id="AddTheseToOrder-{{ sec_id }}" data-section-id="{{ sec_id }}">
  <div class="ato-container" style="background-color: {{ card_bg_color }};">
    <!-- Header Area -->
    <div class="ato-header">
      <h2 class="ato-title">{{ heading_text | escape }}</h2>
      {%- if subheading_text != blank -%}
        <p class="ato-subtitle">{{ subheading_text | escape }}</p>
      {%- endif -%}
    </div>

    <!-- Carousel / Grid Relative Wrapper -->
    <div class="ato-carousel-relative">
      <!-- Navigation Prev Button (for > 3 items or overflow) -->
      <button 
        type="button" 
        class="ato-nav-btn ato-nav-prev" 
        aria-label="Previous add-ons" 
        title="Previous add-ons"
        style="display: none;"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>

      <!-- Cards Track (Responsive moderate cards fitting 4-5 per view on desktop) -->
      <div 
        class="ato-track" 
        role="region" 
        aria-label="Add-on products collection"
      >
        {%- if prod_items != blank and prod_count > 0 -%}
          {%- for item in prod_items -%}
            {%- if item != blank and item.title != blank -%}
              {%- render 'luxury-add-to-order-card', item_product: item, discount_percent: disc_pct, multiplier: multiplier, btn_label: btn_label, btn_bg: btn_bg -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for h in default_handles -%}
            {%- assign item = all_products[h] -%}
            {%- if item != blank and item.title != blank -%}
              {%- render 'luxury-add-to-order-card', item_product: item, discount_percent: disc_pct, multiplier: multiplier, btn_label: btn_label, btn_bg: btn_bg -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      <!-- Navigation Next Button -->
      <button 
        type="button" 
        class="ato-nav-btn ato-nav-next" 
        aria-label="Next add-ons" 
        title="Next add-ons"
        style="display: none;"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </button>
    </div>

    <!-- Scrollbar Indicator Pill (shown only on mobile / small screens when horizontally scrollable) -->
    <div class="ato-scrollbar-wrapper" aria-hidden="true" style="display: none;">
      <div class="ato-scrollbar-track">
        <div class="ato-scrollbar-pill"></div>
      </div>
    </div>
  </div>
</div>

