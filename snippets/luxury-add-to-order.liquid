<script>
(function() {
  const container = document.getElementById('AddTheseToOrder-{{ sec_id }}');
  if (!container) return;

  const track = container.querySelector('.ato-track');
  const prevBtn = container.querySelector('.ato-nav-prev');
  const nextBtn = container.querySelector('.ato-nav-next');
  const pill = container.querySelector('.ato-scrollbar-pill');

  // 1. Scroll & Navigation Indicator
  function updateScrollState() {
    if (!track) return;
    const maxScroll = track.scrollWidth - track.clientWidth;
    const currentScroll = track.scrollLeft;
    const scrollWrapper = container.querySelector('.ato-scrollbar-wrapper');

    if (maxScroll <= 8) {
      if (prevBtn) prevBtn.style.display = 'none';
      if (nextBtn) nextBtn.style.display = 'none';
      if (scrollWrapper) scrollWrapper.style.display = 'none';
      return;
    } else {
      if (scrollWrapper) scrollWrapper.style.display = 'flex';
    }

    if (prevBtn) {
      prevBtn.style.display = currentScroll > 15 ? 'flex' : 'none';
    }
    if (nextBtn) {
      nextBtn.style.display = currentScroll < maxScroll - 15 ? 'flex' : 'none';
    }

    if (pill && maxScroll > 0) {
      const scrollPct = Math.min(Math.max(currentScroll / maxScroll, 0), 1);
      const maxTranslate = 120; // percent
      pill.style.transform = `translateX(${scrollPct * maxTranslate}%)`;
    }
  }

  if (track) {
    track.addEventListener('scroll', updateScrollState, { passive: true });
    window.addEventListener('resize', updateScrollState, { passive: true });
    setTimeout(updateScrollState, 200);
  }

  function getScrollStep() {
    const firstCard = track ? track.querySelector('.ato-card') : null;
    return firstCard ? (firstCard.offsetWidth + 14) : 280;
  }

  if (prevBtn && track) {
    prevBtn.addEventListener('click', function() {
      track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
    });
  }

  if (nextBtn && track) {
    nextBtn.addEventListener('click', function() {
      track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
    });
  }

  // 2. Interactive Variant Selector Change (Flawless Image Swap with srcset)
  container.querySelectorAll('.ato-variant-select').forEach(function(select) {
    function handleVariantChange() {
      const selectedOpt = select.options[select.selectedIndex];
      const card = select.closest('.ato-card');
      if (!card || !selectedOpt) return;

      const variantId = selectedOpt.value;
      const priceText = selectedOpt.dataset.price;
      const origPriceText = selectedOpt.dataset.originalPrice;
      const isAvailable = selectedOpt.dataset.available === '1';
      const imgSrc = selectedOpt.dataset.img;
      const imgSrcset = selectedOpt.dataset.srcset;

      // Update price display
      const discEl = card.querySelector('.ato-price-discounted');
      if (discEl && priceText) discEl.textContent = priceText;

      const origEl = card.querySelector('.ato-price-original');
      if (origEl && origPriceText) origEl.textContent = origPriceText;

      // Update Image (clearing and updating srcset ensures browser paints the new image)
      let imgEl = card.querySelector('.ato-card-img');
      if (imgSrc) {
        if (!imgEl) {
          const wrap = card.querySelector('.ato-card-image-link');
          if (wrap) {
            wrap.innerHTML = `<img class="ato-card-img" src="${imgSrc}" alt="${selectedOpt.textContent.trim()}">`;
            imgEl = wrap.querySelector('.ato-card-img');
          }
        }

        if (imgEl) {
          imgEl.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
          imgEl.style.opacity = '0.35';
          imgEl.style.transform = 'scale(0.96)';

          let applied = false;
          const applyNewImage = function() {
            if (applied) return;
            applied = true;
            if (imgSrcset) {
              imgEl.setAttribute('srcset', imgSrcset);
            } else {
              imgEl.removeAttribute('srcset');
            }
            imgEl.src = imgSrc;
            imgEl.alt = (card.dataset.productTitle || '') + ' - ' + selectedOpt.text.trim();
            imgEl.style.opacity = '1';
            imgEl.style.transform = 'scale(1)';
          };

          const preloader = new Image();
          preloader.onload = applyNewImage;
          preloader.onerror = applyNewImage;
          preloader.src = imgSrc;

          setTimeout(applyNewImage, 250);
        }
      }

      // Update Links with variant query parameter
      const imageLink = card.querySelector('.ato-card-image-link');
      if (imageLink && variantId) {
        const baseHref = imageLink.getAttribute('href').split('?')[0];
        imageLink.setAttribute('href', `${baseHref}?variant=${variantId}`);
      }
      const titleLink = card.querySelector('.ato-card-title');
      if (titleLink && variantId) {
        const baseHref = titleLink.getAttribute('href').split('?')[0];
        titleLink.setAttribute('href', `${baseHref}?variant=${variantId}`);
      }

      // Update Button
      const btn = card.querySelector('.ato-add-btn');
      if (btn) {
        btn.dataset.variantId = variantId;
        const btnText = btn.querySelector('.ato-btn-text') || btn;
        btn.disabled = false;
        btnText.textContent = {{ btn_label | json }};
      }
    }

    select.addEventListener('change', handleVariantChange);
    select.addEventListener('input', handleVariantChange);
  });

  // 3. Add & Save AJAX Click
  container.querySelectorAll('.ato-add-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      const variantId = btn.dataset.variantId;
      if (!variantId || btn.disabled) return;

      const btnText = btn.querySelector('.ato-btn-text') || btn;
      const originalText = btnText.textContent;

      btn.classList.add('is-loading');
      btnText.textContent = 'Adding...';

      const requestPayload = {
        id: parseInt(variantId, 10),
        quantity: 1,
        properties: {
          '_add_to_order_discount': '{{ disc_pct }}% Off'
        },
        sections: ['cart-drawer', 'cart-icon-bubble']
      };

      const addUrl = (window.routes && window.routes.cart_add_url) ? window.routes.cart_add_url : '/cart/add.js';

      fetch(addUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(requestPayload)
      })
      .then(function(res) {
        if (!res.ok) {
          return res.json().then(function(err) { throw err; });
        }
        return res.json();
      })
      .then(function(data) {
        btn.classList.remove('is-loading');
        btn.classList.add('is-success');
        btnText.textContent = '✓ Added to Order';

        // Revert button text after 2.2s
        setTimeout(function() {
          btn.classList.remove('is-success');
          btnText.textContent = originalText;
        }, 2200);

        // Notify Cart Drawer
        const cartDrawer = document.querySelector('cart-drawer');
        if (cartDrawer && typeof cartDrawer.renderContents === 'function' && data.sections) {
          cartDrawer.renderContents(data);
        } else {
          // Fallback: update cart bubble
          fetch('/cart.js')
            .then(function(r) { return r.json(); })
            .then(function(cart) {
              const bubbles = document.querySelectorAll('.cart-count-bubble, #cart-icon-bubble');
              bubbles.forEach(function(b) {
                const countSpan = b.querySelector('[aria-hidden="true"]') || b;
                if (countSpan) countSpan.textContent = cart.item_count;
              });
            })
            .catch(function(e) { console.warn('Cart sync warning:', e); });
        }

        // Dispatch standard Shopify cart events
        document.documentElement.dispatchEvent(new CustomEvent('cart:item-added', { detail: data }));
        document.body.dispatchEvent(new CustomEvent('cart:refresh'));
      })
      .catch(function(err) {
        btn.classList.remove('is-loading');
        console.error('Add to order error:', err);
        btnText.textContent = err.description || 'Unavailable';
        setTimeout(function() {
          btnText.textContent = originalText;
        }, 2500);
      });
    });
  });
})();
</script>

{%- endif -%}
