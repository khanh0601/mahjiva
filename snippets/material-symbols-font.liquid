{%- comment -%}
  Loads the Material Symbols icon font (non-blocking).
  Rendered only by sections that output `.material-symbols-outlined` icons,
  so pages without those sections do not download the font.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1&display=swap"
  media="print"
  onload="this.media='all'"
>
