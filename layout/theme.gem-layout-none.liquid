    {%- liquid
      assign seo_description = page_description
      if request.page_type == 'index'
        if seo_description == blank or seo_description == page_title or seo_description contains 'Luxury American Mahjong Sets' or seo_description contains 'Shop Mahjiva American Mahjong'
          assign seo_description = "Luxury American Mahjong sets and bespoke accessories crafted to NMJL standards. Discover artful tile designs, complimentary worldwide shipping, and dedicated concierge care."
        endif
      elsif seo_description contains 'Spooky Haven' or seo_description contains 'DASON' or request.path contains 'refund' or page.handle contains 'refund'
        assign seo_description = "Read Mahjiva's official 30-day return and exchange policy. Handcrafted luxury American Mahjong sets, mats, and accessories with dedicated client care."
      elsif template.name == 'product' and product.handle contains 'tiger-peony'
        assign seo_description = "Inspired by Asian artistry, the Tiger & Peony Mahjong Mat features majestic tigers, blooming peonies, and water-resistant neoprene with non-slip rubber backing."
      elsif template.name == 'product' and product.handle contains 'classic-canvas'
        assign seo_description = "Explore the Everyday Mahjong Tile Bag by Mahjiva. Handcrafted with durable quilted canvas, padded lining, and elegant storage for your tiles."
      elsif template.name == 'product' and product.handle contains 'clear-acrylic'
        assign seo_description = "Explore the Crystal Clear Mahjong Racks (Set of 4) by Mahjiva. Handcrafted high-clarity acrylic with integrated brass pushers."
      elsif seo_description == blank
        if request.page_type == 'index'
          assign seo_description = "Luxury American Mahjong sets and bespoke accessories crafted to NMJL standards. Discover artful tile designs, complimentary worldwide shipping, and dedicated concierge care."
        elsif request.page_type == 'collection'
          capture seo_description
            echo 'Shop '
            echo collection.title
            echo ' from '
            echo shop.name
            echo '.'
          endcapture
        else
          assign seo_description = shop.description
        endif
      endif
    -%}
