        margin: 0;
        font-size: 1.5rem;
        letter-spacing: 0.06rem;
        line-height: calc(1 + 0.8 / var(--font-body-scale));
        font-family: var(--font-body-family);
        font-style: var(--font-body-style);
        font-weight: var(--font-body-weight);
      }

      @media screen and (min-width: 750px) {
        body {
          font-size: 1.6rem;
        }
      }

      /* =========================================================================
         GLOBAL LUXURY TYPOGRAPHY SYSTEM:
         - All Headings & Titles: Serif ("Cormorant Garamond") for Luxury Elegance
         - All Content & Descriptions: Sans-Serif for Clean Readability
         ========================================================================= */
      h1, h2, h3, h4, h5, h6,
      .h0, .h1, .h2, .h3, .h4, .h5, .h6,
      .heading,
      .title,
      .main-page-title,
      .collection-hero__title,
      .product__title,
      .card__heading,
      .card__heading a,
      .pdp-title,
      .lbs-title,
      .lbs-prod-title,
      .lcr-heading,
      .lcr-spec-title,
      .lfc-heading,
      .lfc-card-title,
      .lwm-heading,
      .lwm-card-title,
      .alc-title,
      .alc-card-title,
      .af-newsletter-heading,
      .af-about-title,
      .af-col-title,
      .af-contact-title,
      .faq-title,
      .mrp-title,
      .mrp-section-title {
        font-family: var(--font-heading-family) !important;
      }

      body,
      p,
      .rte,
      .description,
      .subheading,
      .subtitle,
      .lbs-subtitle,
      .lbs-price,
      .lcr-desc,
      .lcr-spec-desc,
      .lfc-description,
      .lfc-card-desc,
      .lwm-subheading,
      .lwm-card-desc,
      .alc-subtitle,
      .alc-card-desc,
      .af-newsletter-sub,
      .af-about-text,
      .af-nav-link,
      .af-contact-row,
      .af-contact-sub,
      .af-contact-biz-desc,
      .af-contact-note,
      .header__menu-item,
      input,
      textarea,
      select,
      button,
      .button,
      .btn,
      .badge,
      .price,
      .caption {
        font-family: var(--font-body-family) !important;
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'blocky-lys.css' | asset_url | stylesheet_tag }}
    {{ 'responsive-fixes.css' | asset_url | stylesheet_tag }}

    {%- unless settings.type_body_font.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}
    {%- unless settings.type_header_font.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}

    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      {{ 'component-localization-form.css' | asset_url | stylesheet_tag: preload: true }}
      <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.predictive_search_enabled -%}
      <link
        rel="stylesheet"
        href="{{ 'component-predictive-search.css' | asset_url }}"
        media="print"
        onload="this.media='all'"
      >
    {%- endif -%}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
  </head>

  <body>
<div class="gem-container">
	{{ content_for_layout }}
</div><!-- end .gem-container --></body>
</html>
